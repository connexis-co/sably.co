# Copy to /opt/stacks/sably-emdash/.env; never commit the real file.
SABLY_IMAGE=127.0.0.1:5051/sably-emdash:production
SABLY_PORT=4323
SOURCE_REVISION=unversioned
SABLY_CMS_READY=true
SABLY_PRODUCTION_ACTIVATED=true

# Preserve the existing values from the Cloudflare production deployment.
EMDASH_ENCRYPTION_KEY=
SABLY_IP_SALT=
SABLY_SETUP_PASSWORD=
# Add the existing application secrets (Brevo, Hotmart, webhook verification,
# JWT, email, etc.) under their original variable names; do not rename them.
