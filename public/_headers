# Cloudflare Pages — cabeceras de los estáticos. No alcanza a /api/*: esas
# respuestas salen de Functions y ponen su propio X-Robots-Tag (_shared.ts).

# Índice del buscador del sitio: lo pide el modal de búsqueda, no es una página.
# Se rastrea como URL suelta y no tiene nada que mostrar en un resultado.
/search-index.json
  X-Robots-Tag: noindex

# Fotos, logos e iconos públicos: en producción salen directamente de Workers
# Static Assets (ver PRODUCTION_ASSET_BYPASS). Sin hash en el nombre, así que
# una semana de caché y una de margen para revalidar en segundo plano.
/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/covers/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/creadores/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/heroes/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/certificado-sably.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=86400
