# Credenciales de la API de Hotmart (developers.hotmart.com)
# Nunca commitees el .env real. Estas credenciales alimentarán además
# el futuro backend Laravel (webhooks de ventas, reportes, membresías).
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=

# Token de Cloudflare para deploys manuales con wrangler (opcional;
# en CI se usa el secreto CLOUDFLARE_API_TOKEN de GitHub Actions).
CLOUDFLARE_API_TOKEN=
