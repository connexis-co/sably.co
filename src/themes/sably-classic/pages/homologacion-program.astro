---
import { Image as OptimizedImage } from 'astro:assets';
import { cmsImageUrl } from '@/lib/cms-media';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { categoryCover } from '@/lib/categories';
import type { load } from '@/lib/page-loaders/homologacion-program';
type Props = Exclude<Awaited<ReturnType<typeof load>>, Response>;
const {country, PROGRAMAS, programa, SEDES, waUrl, faqs, title, description, schemas} = Astro.props;
---

<BaseLayout {title} {description} {country} pathAfterCountry="/" {schemas} pageType="homologacion_programa" whatsappContext={`Homologación de ${programa.name}`}>
  <!-- Hero -->
  <section class="relative overflow-hidden py-20">
    <OptimizedImage
      src={cmsImageUrl(programa.coverImage) ?? categoryCover(programa.coverCategory)}
      alt=""
      width={800}
      height={533}
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-primary/85" aria-hidden="true"></div>
    <div class="container-site relative">
      <nav aria-label="Breadcrumb" class="text-sm text-white/60">
        <a href="/co/" class="hover:text-white">Inicio</a> <span aria-hidden="true">›</span>
        <a href="/homologaciones/" class="hover:text-white">Homologaciones</a>
        <span aria-hidden="true">›</span>
        <span class="text-white">{programa.name}</span>
      </nav>
      <h1 class="mt-4 max-w-3xl text-3xl leading-tight font-extrabold text-white sm:text-5xl">
        Homologa tu experiencia en <span class="text-accent-on-dark">{programa.name}</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-white/85">{programa.shortDescription}</p>
      <a
        href={waUrl}
        target="_blank"
        rel="noopener nofollow"
        data-cta-hotmart
        data-cta-position="hero_programa"
        class="animate-pulse-soft mt-8 inline-flex items-center gap-2 rounded-md bg-[#00e676] px-7 py-4 font-bold text-white transition hover:brightness-95"
      >
        <svg viewBox="0 0 24 24" class="size-5 fill-current" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Z"/></svg>
        Consultar por WhatsApp
      </a>
      <p class="mt-4 text-sm text-white/60">Te contamos requisitos y costos el mismo día · Sin compromiso</p>
    </div>
  </section>

  <div class="container-site grid gap-12 py-14 lg:grid-cols-[1fr_360px]">
    <div class="space-y-12">
      <section aria-labelledby="audiencia">
        <h2 id="audiencia" class="text-2xl font-bold">¿Es para ti?</h2>
        <ul class="mt-5 space-y-3" role="list">
          {
            programa.audience.map((item) => (
              <li class="flex items-start gap-3 rounded-md border border-surface-200 p-4 text-sm text-heading">
                <span aria-hidden="true">🎯</span>
                {item}
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="evaluacion">
        <h2 id="evaluacion" class="text-2xl font-bold">Qué evalúa la institución</h2>
        <ul class="mt-5 grid gap-3" role="list">
          {
            programa.evaluacion.map((item) => (
              <li class="flex items-start gap-2.5 rounded-md bg-off-white p-3.5 text-sm text-heading">
                <span class="text-success" aria-hidden="true">✅</span>
                {item}
              </li>
            ))
          }
        </ul>
        <p class="mt-4 rounded-md bg-accent-soft p-4 text-sm text-heading">
          La certificación está <strong>sujeta a la evaluación de saberes</strong> que realiza la institución aliada
          autorizada. Nuestro equipo te acompaña en todo el proceso por WhatsApp.
        </p>
      </section>

      <section aria-labelledby="faq-title">
        <h2 id="faq-title" class="text-2xl font-bold">Preguntas frecuentes</h2>
        <div class="mt-5">
          <FaqAccordion {faqs} />
        </div>
      </section>
    </div>

    <aside class="space-y-6 lg:sticky lg:top-24 lg:h-fit">
      <div class="rounded-lg border border-surface-200 p-6">
        <h2 class="text-sm font-bold tracking-wide text-muted uppercase">Sedes aliadas</h2>
        <ul class="mt-4 space-y-2" role="list">
          {SEDES.map((s) => <li class="text-sm text-body">📍 {s.city}, {s.region}</li>)}
        </ul>
        <p class="mt-3 text-xs text-muted">Asesoría remota por WhatsApp para todo Colombia.</p>
      </div>
      <a
        href={waUrl}
        target="_blank"
        rel="noopener nofollow"
        class="block rounded-lg bg-[#00e676] p-5 text-center font-bold text-white transition hover:brightness-95"
      >
        💬 Iniciar mi homologación
      </a>
      <div class="rounded-lg bg-off-white p-5 text-sm text-body">
        <p class="font-semibold text-primary">¿Prefieres estudiar desde cero?</p>
        <p class="mt-1">
          Mira nuestros <a href="/co/cursos/" class="font-semibold text-accent underline">cursos online con certificado</a>.
        </p>
      </div>
    </aside>
  </div>

  <!-- Otros programas -->
  <section class="bg-off-white py-14">
    <div class="container-site">
      <h2 class="text-2xl font-bold">Otros programas de homologación</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-3">
        {
          PROGRAMAS.filter((p) => p.slug !== programa.slug).map((p) => (
            <a
              href={`/homologaciones/${p.slug}/`}
              class="group rounded-lg border border-surface-200 bg-white p-5 transition hover:-translate-y-0.5 hover:shadow-lg"
            >
              <h3 class="font-display font-bold text-primary group-hover:text-accent">
                {p.emoji} {p.name}
              </h3>
              <p class="mt-1.5 line-clamp-2 text-sm text-body">{p.shortDescription}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
