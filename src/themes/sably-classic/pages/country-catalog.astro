---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CourseCard } from '@/themes';
import { SectionHeading } from '@/themes';
import { countryAlternates } from '@/lib/seo';
import type { load } from '@/lib/page-loaders/country-catalog';
type Props = Exclude<Awaited<ReturnType<typeof load>>, Response>;
const {country, base, courses, creators, byCategory, title, description, schemas} = Astro.props;
---

<BaseLayout
  {title}
  {description}
  {country}
  pathAfterCountry="/cursos/"
  alternates={await countryAlternates('/cursos/')}
  {schemas}
  pageType="catalog"
>
  <section class="bg-primary py-14">
    <div class="container-site">
      <nav aria-label="Breadcrumb" class="text-sm text-white/60">
        <a href={`${base}/`} class="hover:text-white">Inicio</a> <span aria-hidden="true">›</span>
        <span class="text-white">Cursos</span>
      </nav>
      <h1 class="mt-4 text-3xl font-extrabold text-white sm:text-4xl">
        Todos los cursos online para {country.name} {country.flag}
      </h1>
      <p class="mt-3 max-w-2xl text-white/80">
        Aprende un oficio con demanda real. Precios en {country.currency}, certificado incluido y acceso de por vida.
      </p>
    </div>
  </section>

  {
    byCategory.map(({ cat, courses: catCourses }) => (
      <section class="container-site py-10" id={cat.slug}>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <SectionHeading eyebrow={cat.emoji} title={cat.name} subtitle={cat.description} />
          <a href={`${base}/cursos/${cat.slug}/`} class="font-semibold text-accent hover:text-accent-hover">
            Ver categoría →
          </a>
        </div>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {catCourses.slice(0, 4).map((course) => (
            <CourseCard {course} {country} />
          ))}
        </div>
        {catCourses.length > 4 && (
          <div class="mt-6 rounded-lg border border-surface-200 p-5">
            <h3 class="font-bold text-heading">Más cursos de {cat.name.toLowerCase()}</h3>
            <ul class="mt-3 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3" role="list">
              {catCourses.slice(4).map((course) => (
                <li><a href={`${base}/${course.id}/`} class="text-body underline decoration-surface-200 underline-offset-4 hover:text-accent">{course.data.title}</a></li>
              ))}
            </ul>
          </div>
        )}
      </section>
    ))
  }
  {creators.length > 0 && (
    <section class="container-site py-10">
      <h2 class="text-2xl font-bold text-heading">Creadores de nuestros cursos</h2>
      <ul class="mt-4 flex flex-wrap gap-4" role="list">
        {creators.map(creator => <li><a href={`${base}/creadores/${creator.slug}/`} class="font-semibold text-accent underline underline-offset-4">{creator.nombre}</a></li>)}
      </ul>
    </section>
  )}
</BaseLayout>
