---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { load } from '@/lib/page-loaders/site-map';
type Props = Exclude<Awaited<ReturnType<typeof load>>, Response>;
const {country, COUNTRIES, PROGRAMAS, courses, comprables, posts, byCategory, title, description,videos} = Astro.props;
---

<BaseLayout {title} {description} {country} pathAfterCountry="/" pageType="sitemap">
  <section class="bg-primary py-12">
    <div class="container-site">
      <h1 class="text-3xl font-extrabold text-white">Mapa del sitio</h1>
      <p class="mt-2 text-white/80">{description}</p>
    </div>
  </section>

  <div class="container-site space-y-14 py-14">
    <!-- Por país: home y catálogo de cada uno -->
    <section aria-labelledby="sm-paises">
      <h2 id="sm-paises" class="text-xl font-bold">Sably en tu país</h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          COUNTRIES.map((c) => (
            <li>
              <a href={`/${c.code}/`} class="font-semibold text-accent hover:underline">
                {c.flag} Cursos online en {c.name}
              </a>
              <ul class="mt-1.5 pl-5" role="list">
                <li>
                  <a href={`/${c.code}/cursos/`} class="text-sm text-body hover:text-accent">
                    Catálogo de cursos en {c.name}
                  </a>
                </li>
              </ul>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Todas las fichas comprables de /co/, por categoría -->
    <section aria-labelledby="sm-cats">
      <h2 id="sm-cats" class="text-xl font-bold">Cursos por categoría</h2>
      <ul class="mt-4 grid gap-8 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {
          byCategory.map(({ cat, courses: enCategoria }) => (
            <li>
              <a href={`/${country.code}/cursos/${cat.slug}/`} class="font-semibold text-accent hover:underline">
                {cat.emoji} {cat.name} ({enCategoria.length})
              </a>
              <ul class="mt-1.5 space-y-1 pl-5" role="list">
                {enCategoria.map((c) => (
                  <li>
                    <a href={`/${country.code}/${c.id}/`} class="text-sm text-body hover:text-accent">
                      {c.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </section>

    {videos.length>0&&<section aria-labelledby="sm-videos"><h2 id="sm-videos" class="text-xl font-bold">Presentaciones en vídeo</h2><ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{videos.map(video=><li><a href={video.path} class="text-sm text-accent hover:underline">{video.title}</a></li>)}</ul></section>}
    <div class="grid gap-12 lg:grid-cols-3">
      <!-- Blog -->
      <section aria-labelledby="sm-blog">
        <h2 id="sm-blog" class="text-xl font-bold">Blog</h2>
        <ul class="mt-4 space-y-1.5" role="list">
          <li><a href="/blog/" class="text-sm font-semibold text-accent hover:underline">Todos los artículos</a></li>
          {
            posts.map((p) => (
              <li>
                <a href={`/blog/${p.id}/`} class="text-sm text-body hover:text-accent">
                  {p.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Homologaciones -->
      <section aria-labelledby="sm-homologaciones">
        <h2 id="sm-homologaciones" class="text-xl font-bold">Homologaciones</h2>
        <ul class="mt-4 space-y-1.5" role="list">
          <li>
            <a href="/homologaciones/" class="text-sm font-semibold text-accent hover:underline">Todos los programas</a>
          </li>
          {
            PROGRAMAS.map((p) => (
              <li>
                <a href={`/homologaciones/${p.slug}/`} class="text-sm text-body hover:text-accent">
                  {p.name}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Institucional y legales -->
      <section aria-labelledby="sm-pages">
        <h2 id="sm-pages" class="text-xl font-bold">Sably</h2>
        <ul class="mt-4 space-y-1.5" role="list">
          <li><a href="/nosotros/" class="text-sm text-body hover:text-accent">Sobre nosotros</a></li>
          <li><a href="/contacto/" class="text-sm text-body hover:text-accent">Contacto</a></li>
          <li><a href="/legal/terminos/" class="text-sm text-body hover:text-accent">Términos y condiciones</a></li>
          <li><a href="/legal/privacidad/" class="text-sm text-body hover:text-accent">Política de privacidad</a></li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
