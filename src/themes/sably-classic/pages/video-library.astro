---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image as OptimizedImage } from 'astro:assets';
import type { load } from '@/lib/page-loaders/video-library';
type Props = Exclude<Awaited<ReturnType<typeof load>>, Response>;
const { country, videos, title, description, schemas } = Astro.props;
---
<BaseLayout {country} {title} {description} {schemas} pageType="video_library">
  <section class="bg-primary py-12 text-white">
    <div class="container-site">
      <h1 class="text-3xl font-bold">Presentaciones de cursos en vídeo</h1>
      <p class="mt-3 max-w-2xl text-white/80">Mira cada presentación en su página de vídeo. Después puedes consultar el temario, el precio y la inscripción para tu país.</p>
    </div>
  </section>
  <ul class="container-site grid gap-6 py-12 sm:grid-cols-2 lg:grid-cols-3" role="list">
    {videos.map(video => <li>
      <a href={video.path} class="block overflow-hidden rounded-lg border border-surface-200 hover:border-accent">
        <OptimizedImage src={video.thumbnail} alt="" width={640} height={360} loading="lazy" class="aspect-video w-full object-cover" />
        <div class="p-5">
          <h2 class="font-bold text-heading">{video.course.data.title}</h2>
          <p class="mt-2 text-sm text-body">Presentación · {video.seconds} segundos</p>
          <span class="mt-3 block text-sm font-semibold text-accent">Ver vídeo →</span>
        </div>
      </a>
    </li>)}
  </ul>
</BaseLayout>
