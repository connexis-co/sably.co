---
import { Image as OptimizedImage } from 'astro:assets';
import { getHomeEditorial } from '@/lib/home-editorial';
import { cmsImageUrl } from '@/lib/cms-media';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TrustBar from '@/components/TrustBar.astro';
import { CourseCard } from '@/themes';
import { SectionHeading } from '@/themes';
import { TestimonialCard } from '@/themes';
import PromoBanner from '@/components/PromoBanner.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { countryAlternates, faqSchema } from '@/lib/seo';
import { CDN_URL } from '@/lib/site';
import { HERO_ASSETS } from '@/lib/hero-assets';
import type { load } from '@/lib/page-loaders/country-home';
type Props = Exclude<Awaited<ReturnType<typeof load>>, Response>;
const {stats, country, CATEGORIES, base, featured, testimonials, posts, title, description} = Astro.props;
const editorial = await getHomeEditorial(country);
const copy = Object.fromEntries(Object.entries(editorial).map(([key,value])=>[key,value.fields])) as {[K in keyof typeof editorial]: typeof editorial[K]['fields']};
const faqs = editorial.faq.groups.map(group=>({q:group.title,a:group.body}));
const benefits = editorial.benefits.groups.map(group=>{const [icon,...title]=group.title.split(' ');return {icon,title:title.join(' '),text:group.body};});
---

<BaseLayout
  {title}
  {description}
  {country}
  pathAfterCountry="/"
  alternates={await countryAlternates('/')}
  schemas={[faqSchema(faqs)]}
  pageType="home"
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-primary">
    <div class="absolute -top-24 -right-24 size-96 rounded-full bg-accent/20 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-32 -left-16 size-80 rounded-full bg-info/10 blur-3xl" aria-hidden="true"></div>
    <div class="container-site relative grid items-center gap-6 py-12 sm:py-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,520px)] lg:gap-10 lg:py-24">
      <div class="max-w-2xl">
        <p class="animate-fade-up text-sm font-bold tracking-wide text-accent uppercase">
          {country.flag} {copy.hero.eyebrow}
        </p>
        <h1 class="animate-fade-up mt-4 text-4xl leading-tight font-extrabold text-white sm:text-5xl">
          {copy.hero.title}<br />
          <span class="text-accent">{copy.hero.accent}</span>
        </h1>
        <p class="animate-fade-up mt-5 max-w-xl text-lg text-white/80" style="animation-delay: 0.1s">
          {copy.hero.description}
        </p>
        <div class="animate-fade-up mt-8 flex flex-wrap gap-3" style="animation-delay: 0.2s">
          <a
            href={`${base}/cursos/`}
            class="animate-pulse-soft rounded-md bg-accent px-6 py-3.5 font-bold text-white transition hover:bg-accent-hover"
          >
            {copy.hero.button}
          </a>
          <a
            href="#categorias"
            class="rounded-md border border-white/30 px-6 py-3.5 font-semibold text-white transition hover:bg-white/10"
          >
            {copy.hero.secondary}
          </a>
        </div>
        <p class="mt-6 text-sm text-white/60">
          {stats.rating && <>⭐ {stats.rating}/5 en valoraciones de Hotmart · </>}Disponible en {stats.countries} países
        </p>
      </div>

      <!-- Collage de oficios: WebP con alfa real (chroma-key), distinto por país.
           En móvil va debajo del texto y algo más ancho que el contenedor para
           que se sienta inmersivo sin empujar el CTA fuera del pliegue. -->
      <div class="relative -mx-4 mt-2 sm:mx-0 lg:mt-0">
        <div class="absolute inset-x-4 inset-y-0 -z-10 rounded-full bg-accent/15 blur-3xl" aria-hidden="true"></div>
        <OptimizedImage
          sizes="(min-width: 1024px) 600px, (min-width: 640px) 512px, 100vw"
          src={cmsImageUrl(country.heroImage) ?? `${CDN_URL}/heroes/${HERO_ASSETS[country.code]}`}
          alt={`Profesionales de distintos oficios que estudian en Sably desde ${country.name}`}
          width={900}
          height={491}
          fetchpriority="high"
          decoding="async"
          class="animate-fade-up mx-auto w-full max-w-md drop-shadow-2xl sm:max-w-lg lg:max-w-none"
        />
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- Categorías chips -->
  <section id="categorias" class="container-site py-14">
    <SectionHeading
      eyebrow={copy.categories.eyebrow}
      title={copy.categories.title}
      subtitle={copy.categories.description}
    />
    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      {
        CATEGORIES.map((cat) => (
          <a
            href={cat.externalUrl ?? `${base}/cursos/${cat.slug}/`}
            class="group flex flex-col items-center gap-2 rounded-lg border border-surface-200 p-5 text-center transition hover:-translate-y-0.5 hover:border-accent hover:shadow-lg"
            {...(cat.externalUrl ? { target: '_blank', rel: 'noopener' } : {})}
          >
            <span class="text-3xl transition-transform group-hover:scale-110" aria-hidden="true">
              {cat.emoji}
            </span>
            <span class="text-sm font-bold text-heading group-hover:text-accent">{cat.name}</span>
            {cat.externalUrl && <span class="rounded-full bg-accent-soft px-2 py-0.5 text-[10px] font-bold text-accent">Academia especializada</span>}
          </a>
        ))
      }
    </div>
  </section>

  <!-- Cursos destacados -->
  {
    featured.length > 0 && (
      <section class="bg-off-white py-14">
        <div class="container-site">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <SectionHeading
              eyebrow={copy.courses.eyebrow}
              title={copy.courses.title}
              subtitle={copy.courses.description}
            />
            <a href={`${base}/cursos/`} class="font-semibold text-accent hover:text-accent-hover">
              Ver todos →
            </a>
          </div>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {featured.map((course) => (
              <CourseCard {course} {country} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ¿Por qué Sably? -->
  <section class="container-site py-14">
    <SectionHeading align="center" eyebrow={copy['benefits-heading'].eyebrow} title={copy['benefits-heading'].title} />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        benefits.map((item) => (
          <div class="rounded-lg border border-surface-200 p-6 text-center">
            <p class="text-3xl" aria-hidden="true">{item.icon}</p>
            <h3 class="mt-3 font-bold text-primary">{item.title}</h3>
            <p class="mt-2 text-sm text-body">{item.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Testimonios -->
  {
    testimonials.length > 0 && (
      <section class="bg-off-white py-14">
        <div class="container-site">
          <SectionHeading
            align="center"
            eyebrow={copy.testimonials.eyebrow}
            title={copy.testimonials.title}
          />
          <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {testimonials.map((t) => (
              <TestimonialCard
                name={t.data.name}
                citySlug={t.data.citySlug}
                countryCode={t.data.countryCode}
                text={t.data.text}
                rating={t.data.rating}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <PromoBanner variante="bloque" />

  <!-- Ciudades -->
  <section class="container-site py-14">
    <SectionHeading
      eyebrow={copy.cities.eyebrow}
      title={copy.cities.title}
      subtitle={copy.cities.description}
    />
    <div class="mt-8 flex flex-wrap gap-3">
      {
        country.cities.map((city) => (
          <a
            href={`${base}/${city.slug}/`}
            class="rounded-full border border-surface-200 px-5 py-2.5 text-sm font-semibold text-heading transition hover:border-accent hover:bg-accent-soft hover:text-accent"
          >
            📍 {city.name}
          </a>
        ))
      }
    </div>
  </section>

  <!-- Blog -->
  {
    posts.length > 0 && (
      <section class="bg-off-white py-14">
        <div class="container-site">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <SectionHeading eyebrow={copy.blog.eyebrow} title={copy.blog.title} />
            <a href="/blog/" class="font-semibold text-accent hover:text-accent-hover">
              Ver blog →
            </a>
          </div>
          <div class="mt-8 grid gap-5 md:grid-cols-3">
            {posts.map((post) => (
              <a
                href={`/blog/${post.id}/`}
                class="group rounded-lg border border-surface-200 bg-white p-6 transition hover:-translate-y-0.5 hover:shadow-lg"
              >
                <p class="text-xs font-bold tracking-wide text-accent uppercase">{post.data.category ?? 'Guía'}</p>
                <h3 class="mt-2 font-display text-lg font-bold text-primary group-hover:text-accent">
                  {post.data.title}
                </h3>
                <p class="mt-2 line-clamp-3 text-sm text-body">{post.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <section class="container-site py-14">
    <SectionHeading align="center" eyebrow={copy['faq-heading'].eyebrow} title={copy['faq-heading'].title} />
    <div class="mx-auto mt-8 max-w-3xl">
      <FaqAccordion {faqs} />
    </div>
  </section>
</BaseLayout>
