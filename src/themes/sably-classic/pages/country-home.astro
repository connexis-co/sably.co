---
import { Image as OptimizedImage } from 'astro:assets';
import { getHomeEditorial } from '@/lib/home-editorial';
import { monedasCobradas } from '@/lib/moneda-catalogo';
import { cmsImageUrl } from '@/lib/cms-media';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TrustBar from '@/components/TrustBar.astro';
import { CourseCard } from '@/themes';
import { SectionHeading } from '@/themes';
import PromoBanner from '@/components/PromoBanner.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { countryAlternates, faqSchema } from '@/lib/seo';
import { CDN_URL } from '@/lib/site';
import { HERO_ASSETS } from '@/lib/hero-assets';
import type { load } from '@/lib/page-loaders/country-home';
type Props = Exclude<Awaited<ReturnType<typeof load>>, Response>;
const {stats, country, CATEGORIES, base, featured, posts, title, description, allCourses} = Astro.props;
// {moneda} en los textos del CMS: la que muestran las tarjetas, no la que se supone del país.
const editorial = await getHomeEditorial({ name: country.name, currency: await monedasCobradas(allCourses.map(c => c.id), country, Astro.locals) });
const copy = Object.fromEntries(Object.entries(editorial).map(([key,value])=>[key,value.fields])) as {[K in keyof typeof editorial]: typeof editorial[K]['fields']};
const faqs = editorial.faq.groups.map(group=>({q:group.title,a:group.body}));
/* Quién hace qué en una inscripción. Los mismos hechos que /nosotros/ y
   /legal/terminos/: no promete nada que el checkout no cumpla. */
const COMO_FUNCIONA = [
  { titulo: 'Eliges el curso', texto: 'Cada ficha muestra qué aprenderás, el temario, la duración y el precio para tu país.' },
  { titulo: 'Te inscribes en Hotmart', texto: 'El pago se hace en Hotmart, la plataforma donde el creador publica su curso.' },
  { titulo: 'Estudias a tu ritmo', texto: 'Recibes el acceso por correo y ves las clases en video desde el celular o el computador.' },
  { titulo: 'Tienes 7 días de garantía', texto: 'Si no es lo que esperabas, pides el reembolso en Hotmart dentro de ese plazo.' },
];
const benefits = editorial.benefits.groups.map(group=>{const [icon,...title]=group.title.split(' ');return {icon,title:title.join(' '),text:group.body};});
---

<BaseLayout
  {title}
  {description}
  {country}
  pathAfterCountry="/"
  alternates={await countryAlternates('/')}
  schemas={[faqSchema(faqs)]}
  pageType="home"
>
  <!-- Hero -->
  <section class="home-hero relative overflow-hidden bg-primary">
    <div class="container-site relative grid items-center gap-6 py-12 sm:py-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,520px)] lg:gap-10 lg:py-24">
      <div class="max-w-2xl">
        <p class="text-sm font-bold tracking-wide text-accent-on-dark uppercase">
          {country.flag} {copy.hero.eyebrow}
        </p>
        <h1 class="mt-4 text-4xl leading-tight font-extrabold text-white sm:text-5xl">
          {copy.hero.title}<br />
          <span class="text-accent-on-dark">{copy.hero.accent}</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg text-white/80">
          {copy.hero.description}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={`${base}/cursos/`}
            class="rounded-md bg-accent px-6 py-3.5 font-bold text-white transition hover:bg-accent-hover"
          >
            {copy.hero.button}
          </a>
          <a
            href="#categorias"
            class="rounded-md border border-white/30 px-6 py-3.5 font-semibold text-white transition hover:bg-white/10"
          >
            {copy.hero.secondary}
          </a>
        </div>
        <p class="mt-6 text-sm text-white/60">
          {stats.rating && <>⭐ {stats.rating}/5 en valoraciones de Hotmart · </>}Disponible en {stats.countries} países
        </p>
      </div>

      <!-- Collage de oficios: WebP con alfa real (chroma-key), distinto por país.
           En móvil va debajo del texto y algo más ancho que el contenedor para
           que se sienta inmersivo sin empujar el CTA fuera del pliegue. -->
      <div class="relative -mx-4 mt-2 sm:mx-0 lg:mt-0">
        <OptimizedImage
          sizes="(min-width: 1024px) 600px, (min-width: 640px) 512px, 100vw"
          src={cmsImageUrl(country.heroImage) ?? `${CDN_URL}/heroes/${HERO_ASSETS[country.code]}`}
          alt={`Profesionales de distintos oficios que estudian en Sably desde ${country.name}`}
          width={900}
          height={491}
          fetchpriority="high"
          decoding="async"
          class="mx-auto w-full max-w-md sm:max-w-lg lg:max-w-none lg:drop-shadow-2xl"
        />
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- Categorías chips -->
  <section id="categorias" class="container-site py-14">
    <SectionHeading
      eyebrow={copy.categories.eyebrow}
      title={copy.categories.title}
      subtitle={copy.categories.description}
    />
    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      {
        CATEGORIES.map((cat) => (
          <a
            href={cat.externalUrl ?? `${base}/cursos/${cat.slug}/`}
            class="group flex flex-col items-center gap-2 rounded-lg border border-surface-200 p-5 text-center transition hover:-translate-y-0.5 hover:border-accent hover:shadow-lg"
            {...(cat.externalUrl ? { target: '_blank', rel: 'noopener' } : {})}
          >
            <span class="text-3xl transition-transform group-hover:scale-110" aria-hidden="true">
              {cat.emoji}
            </span>
            <span class="text-sm font-bold text-heading group-hover:text-accent">{cat.name}</span>
            {cat.externalUrl && <span class="rounded-full bg-accent-soft px-2 py-0.5 text-[10px] font-bold text-accent">Academia especializada</span>}
          </a>
        ))
      }
    </div>
  </section>

  <!-- Cursos destacados -->
  {
    featured.length > 0 && (
      <section class="bg-off-white py-14">
        <div class="container-site">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <SectionHeading
              eyebrow={copy.courses.eyebrow}
              title={copy.courses.title}
              subtitle={copy.courses.description}
            />
            <a href={`${base}/cursos/`} class="font-semibold text-accent hover:text-accent-hover">
              Ver todos →
            </a>
          </div>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {featured.map((course) => (
              <CourseCard {course} {country} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ¿Por qué Sably? -->
  <section class="container-site py-14">
    <SectionHeading align="center" eyebrow={copy['benefits-heading'].eyebrow} title={copy['benefits-heading'].title} />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        benefits.map((item) => (
          <div class="rounded-lg border border-surface-200 p-6 text-center">
            <p class="text-3xl" aria-hidden="true">{item.icon}</p>
            <h3 class="mt-3 font-bold text-primary">{item.title}</h3>
            <p class="mt-2 text-sm text-body">{item.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container-site pb-10">
    <h2 class="text-xl font-bold text-heading">Conoce los cursos en vídeo</h2>
    <p class="mt-2 text-body">Mira las presentaciones antes de consultar el programa y elegir tu curso.</p>
    <a href="/videos/" class="mt-3 inline-block font-semibold text-accent hover:underline">Ver presentaciones →</a>
  </section>
  <PromoBanner variante="bloque" />

  <!-- Blog -->
  {
    posts.length > 0 && (
      <section class="bg-off-white py-14">
        <div class="container-site">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <SectionHeading eyebrow={copy.blog.eyebrow} title={copy.blog.title} />
            <a href="/blog/" class="font-semibold text-accent hover:text-accent-hover">
              Ver blog →
            </a>
          </div>
          <div class="mt-8 grid gap-5 md:grid-cols-3">
            {posts.map((post) => (
              <a
                href={`/blog/${post.id}/`}
                class="group rounded-lg border border-surface-200 bg-white p-6 transition hover:-translate-y-0.5 hover:shadow-lg"
              >
                <p class="text-xs font-bold tracking-wide text-accent uppercase">{post.data.category ?? 'Guía'}</p>
                <h3 class="mt-2 font-display text-lg font-bold text-primary group-hover:text-accent">
                  {post.data.title}
                </h3>
                <p class="mt-2 line-clamp-3 text-sm text-body">{post.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Cómo funciona Sably: quién hace qué. La portada es lo que se lee para
       responder «¿qué es Sably?», y hasta ahora no lo decía en ningún sitio. -->
  <section class="bg-off-white py-14" aria-labelledby="como-funciona-title">
    <div class="container-site">
      <div class="mx-auto max-w-2xl text-center">
        <p class="mb-3 font-semibold text-accent">Con transparencia</p>
        <h2 id="como-funciona-title" class="text-2xl font-bold sm:text-3xl">Cómo funciona Sably</h2>
        <p class="mt-3 text-body">
          Sably es un catálogo de cursos online de oficios en español. Reúne cursos de creadores independientes,
          ordenados por oficio y por país.
        </p>
      </div>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          COMO_FUNCIONA.map((paso, i) => (
            <li class="rounded-lg border border-surface-200 bg-white p-6">
              <span class="inline-flex size-9 items-center justify-center rounded-full bg-accent text-sm font-bold text-white" aria-hidden="true">
                {i + 1}
              </span>
              <h3 class="mt-4 font-bold text-primary">{paso.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-body">{paso.texto}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-8 text-center text-sm text-body">
        Sably es un proyecto de Connexis, agencia colombiana de desarrollo web y marketing digital.{' '}
        <a href="/nosotros/" class="font-semibold text-accent underline underline-offset-4">Conoce quién está detrás</a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-site py-14">
    <SectionHeading align="center" eyebrow={copy['faq-heading'].eyebrow} title={copy['faq-heading'].title} />
    <div class="mx-auto mt-8 max-w-3xl">
      <FaqAccordion {faqs} />
    </div>
  </section>
</BaseLayout>
