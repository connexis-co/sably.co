---
import { Image as OptimizedImage } from 'astro:assets';
import { cmsImageUrl } from '@/lib/cms-media';
import CmsRichBody from '@/components/CmsRichBody.astro';
import { renderMarkdown } from '@/lib/markdown';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ReadingProgress from '@/components/ReadingProgress.astro';
import ArticleRating from '@/components/ArticleRating.astro';
import Comentarios from '@/components/Comentarios.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { blogCover } from '@/lib/blog';
import type { load } from '@/lib/page-loaders/blog-article';
type Props = Exclude<Awaited<ReturnType<typeof load>>, Response>;
const {post, country, toc, related, minutes, title, schemas, articleSchema, articleMeta} = Astro.props;
---

<BaseLayout
  {title}
  description={post.data.description}
  {country}
  pathAfterCountry="/"
  {schemas}
  {articleSchema}
  {articleMeta}
  pageType="article"
  image={(cmsImageUrl(post.coverImage) ?? blogCover(post.data.category, 'hero'))}
>
  <ReadingProgress />

  <!-- Hero -->
  <section class="relative overflow-hidden py-16 sm:py-20">
    <OptimizedImage
      src={(cmsImageUrl(post.coverImage) ?? blogCover(post.data.category, 'hero'))}
      alt=""
      width={800}
      height={533}
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-primary/80" aria-hidden="true"></div>
    <div class="container-site relative max-w-3xl">
      <nav aria-label="Breadcrumb" class="text-sm text-white/60">
        <a href="/co/" class="hover:text-white">Inicio</a> <span aria-hidden="true">›</span>
        <a href="/blog/" class="hover:text-white">Blog</a>
      </nav>
      <p class="mt-5 text-xs font-bold tracking-wide text-accent-on-dark uppercase">{post.data.category ?? 'Guía'}</p>
      <h1 {...post.edit.title} class="mt-3 text-3xl leading-tight font-extrabold text-white sm:text-4xl">{post.data.title}</h1>
      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-white/70">
        <span>Por el equipo Sably</span>
        <span aria-hidden="true">·</span>
        <span>{post.data.publishedAt.toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
        <span aria-hidden="true">·</span>
        <span>{minutes} min de lectura</span>
      </p>
    </div>
  </section>

  <div class="container-site grid gap-10 py-12 lg:grid-cols-[minmax(0,1fr)_260px] lg:gap-14">
    <article class="min-w-0 max-w-3xl">
      <p class="mb-8 rounded-lg bg-off-white p-5 text-[15px] leading-relaxed text-heading">{post.data.description}</p>

      <!-- TOC en móvil: colapsable arriba del contenido -->
      {
        toc.length > 2 && (
          <details class="mb-8 rounded-lg border border-surface-200 p-4 lg:hidden">
            <summary class="cursor-pointer list-none text-sm font-bold text-primary">
              📑 Tabla de contenidos ({toc.length})
            </summary>
            <ol class="mt-3 space-y-1.5" role="list">
              {toc.map((h) => (
                <li class={h.depth === 3 ? 'ml-4' : ''}>
                  <a href={`#${h.slug}`} class="text-sm text-body hover:text-accent">
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      <div
        class="space-y-5 text-[15px] leading-relaxed text-body [&_a]:text-accent [&_a]:underline [&_h2]:mt-10 [&_h2]:scroll-mt-28 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-primary [&_h3]:mt-6 [&_h3]:scroll-mt-28 [&_h3]:text-lg [&_h3]:font-bold [&_h3]:text-primary [&_li]:ml-5 [&_li]:list-disc [&_strong]:text-heading"
      >
        {post.richBody ? <CmsRichBody value={post.richBody} /> : <Fragment set:html={renderMarkdown(post.body ?? '')} />}
      </div>

      {
        post.data.faq && post.data.faq.length > 0 && (
          <section class="mt-12">
            <h2 class="text-2xl font-bold text-primary">Preguntas frecuentes</h2>
            <div class="mt-5">
              <FaqAccordion faqs={post.data.faq} />
            </div>
          </section>
        )
      }

      <ArticleRating slug={post.id} />

      <!-- CTA -->
      <aside class="mt-10 rounded-lg bg-primary p-8 text-center">
        <h2 class="text-2xl font-extrabold text-white">¿Listo para aprender un oficio de verdad?</h2>
        <p class="mx-auto mt-2 max-w-md text-white/80">
          Cursos online con certificado, acceso de por vida y garantía de 7 días.
        </p>
        <a
          href={`/${country.code}/cursos/`}
          class="animate-pulse-soft mt-6 inline-block rounded-md bg-accent px-7 py-3.5 font-bold text-white transition hover:bg-accent-hover"
        >
          Explorar cursos
        </a>
      </aside>

      <Comentarios subject={`blog:${post.id}`} />
    </article>

    <!-- TOC sticky en desktop -->
    {
      toc.length > 2 && (
        <aside class="hidden lg:block">
          <nav aria-label="Tabla de contenidos" class="sticky top-24">
            <p class="text-xs font-bold tracking-wide text-muted uppercase">En este artículo</p>
            <ol class="mt-3 space-y-2 border-l border-surface-200" role="list">
              {toc.map((h) => (
                <li class={h.depth === 3 ? 'pl-6' : 'pl-3'}>
                  <a
                    href={`#${h.slug}`}
                    data-toc-link={h.slug}
                    class="-ml-px block border-l-2 border-transparent py-0.5 text-sm text-body transition hover:border-accent hover:text-accent data-[current]:border-accent data-[current]:font-semibold data-[current]:text-accent"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )
    }
  </div>

  <!-- Relacionados -->
  {
    related.length > 0 && (
      <section class="bg-off-white py-12 sm:py-14">
        <div class="container-site">
          <h2 class="text-2xl font-bold">Sigue leyendo</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <a
                href={`/blog/${p.id}/`}
                class="group flex flex-col overflow-hidden rounded-xl border border-surface-200 bg-white transition hover:-translate-y-0.5 hover:shadow-lg"
              >
                <div class="h-36 overflow-hidden">
                  <OptimizedImage
                    src={(cmsImageUrl(p.cardImage) ?? cmsImageUrl(p.coverImage) ?? blogCover(p.data.category, 'card'))}
                    alt=""
                    width={480}
                    height={320}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                <div class="p-5">
                  <p class="text-xs font-bold tracking-wide text-accent uppercase">{p.data.category ?? 'Guía'}</p>
                  <h3 class="mt-1.5 font-display font-bold text-primary group-hover:text-accent">{p.data.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  /* Resalta en el TOC el encabezado que se está leyendo. */
  const links = [...document.querySelectorAll<HTMLElement>('[data-toc-link]')];
  if (links.length) {
    const byId = new Map(links.map((l) => [l.dataset.tocLink!, l]));
    const targets = [...byId.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((l) => delete l.dataset.current);
          const active = byId.get(entry.target.id);
          if (active) active.dataset.current = 'true';
        }
      },
      { rootMargin: '-96px 0px -70% 0px', threshold: 0 },
    );
    targets.forEach((t) => observer.observe(t));
  }
</script>
