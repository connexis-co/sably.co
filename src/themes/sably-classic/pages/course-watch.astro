---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {breadcrumbSchema,videoSchema} from '@/lib/seo';
import {conciseTitle} from '@/lib/seo-title';
import {SITE} from '@/lib/site';
import type {load} from '@/lib/page-loaders/course-watch';
type Props=Exclude<Awaited<ReturnType<typeof load>>,Response>;
const {country,video,markets,related}=Astro.props;
const title=conciseTitle(video.title);
const schema=videoSchema({name:video.title,description:video.description,thumbnailUrl:video.thumbnail,uploadDate:video.uploadedAt,duration:video.duration,contentUrl:video.contentUrl,pageUrl:video.url});
const breadcrumbs=[{name:'Inicio',url:`${SITE.url}/${country.code}/`},{name:video.title,url:video.url}];
---
<BaseLayout {country} {title} description={video.description} canonical={video.url} image={video.thumbnail} pageType="video" schemas={[schema,breadcrumbSchema(breadcrumbs)]}>
 <section class="bg-primary py-8 text-white">
  <div class="container-site max-w-5xl">
   <p class="text-sm text-white/70">Presentación del curso · {video.seconds} segundos</p>
   <h1 class="mt-2 text-2xl font-bold md:text-3xl">{video.title}</h1>
   <video controls playsinline preload="metadata" poster={video.thumbnail} width="1280" height="720" class="mt-5 aspect-video w-full rounded-lg bg-black" aria-label={video.title}>
    <source src={video.contentUrl} type="video/mp4"/>
    <p><a href={video.contentUrl}>Abrir el vídeo de presentación</a></p>
   </video>
  </div>
 </section>
 <div class="container-site max-w-5xl space-y-8 py-10">
  <section><h2 class="text-xl font-bold">Acerca de esta presentación</h2><p class="mt-3 text-body">{video.course.data.shortDescription}</p><p class="mt-3 text-body">Este vídeo presenta el curso. Consulta la ficha de tu país para ver el programa completo, la duración y el precio disponible.</p></section>
  <section><h2 class="text-xl font-bold">Ver temario e inscripción</h2><ul class="mt-4 flex flex-wrap gap-3">{markets.map(m=><li><a class="inline-flex rounded-md border border-surface-200 px-4 py-2 font-semibold text-primary hover:border-accent" href={`/${m.code}/${video.course.id}/`}>{m.flag} {m.name}</a></li>)}</ul></section>
  {related.length>0&&<section><h2 class="text-xl font-bold">Otras presentaciones</h2><ul class="mt-4 grid gap-4 sm:grid-cols-2">{related.map(v=><li><a href={v.path} class="font-semibold text-accent hover:underline">{v.title}</a></li>)}</ul></section>}
 </div>
</BaseLayout>
