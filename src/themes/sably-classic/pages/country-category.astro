---
import { Image as OptimizedImage } from 'astro:assets';
import { cmsImageUrl } from '@/lib/cms-media';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CourseCard } from '@/themes';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { categoryCover } from '@/lib/categories';
import { countryAlternates } from '@/lib/seo';
import type { load } from '@/lib/page-loaders/country-category';
type Props = Exclude<Awaited<ReturnType<typeof load>>, Response>;
const {country, category, base, catName, courses, bySubcategory, uncategorized, faqs, title, description, schemas} = Astro.props;
---

<BaseLayout
  {title}
  {description}
  {country}
  pathAfterCountry={`/cursos/${category.slug}/`}
  alternates={await countryAlternates(`/cursos/${category.slug}/`)}
  {schemas}
  pageType="category"
  whatsappContext={`Cursos de ${category.name}`}
>
  <section class="relative overflow-hidden py-16">
    <OptimizedImage
      src={cmsImageUrl(category.coverImage) ?? categoryCover(category.slug)}
      alt=""
      width={800}
      height={533}
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      class="absolute inset-0"
      style={`background-image: linear-gradient(135deg, ${category.gradient[0]}e6, ${category.gradient[1]}cc)`}
      aria-hidden="true"
    >
    </div>
    <div class="container-site relative">
      <nav aria-label="Breadcrumb" class="text-sm text-white/70">
        <a href={`${base}/`} class="hover:text-white">Inicio</a> <span aria-hidden="true">›</span>
        <a href={`${base}/cursos/`} class="hover:text-white">Cursos</a> <span aria-hidden="true">›</span>
        <span class="text-white">{category.name}</span>
      </nav>
      <h1 class="mt-4 text-3xl font-extrabold text-white sm:text-4xl">
        <span aria-hidden="true">{category.emoji}</span> Cursos de {catName} online en {country.name}
      </h1>
      <p class="mt-3 max-w-2xl text-lg text-white/85">{category.description}</p>
      <p class="mt-4 inline-block rounded-full bg-white/15 px-4 py-1.5 text-sm font-semibold text-white">
        {courses.length} {courses.length === 1 ? 'curso disponible' : 'cursos disponibles'} · Certificado incluido
      </p>
    </div>
  </section>

  {
    courses.length === 0 && (
      <section class="container-site py-16 text-center">
        <p class="text-lg text-body">Estamos preparando los cursos de esta categoría. ¡Muy pronto!</p>
      </section>
    )
  }

  {
    bySubcategory.map(({ sub, courses: subCourses }) => (
      <section class="container-site scroll-mt-24 py-10" id={sub.slug}>
        <h2 class="text-2xl font-bold">{sub.name}</h2>
        <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {subCourses.map((course) => (
            <CourseCard {course} {country} />
          ))}
        </div>
      </section>
    ))
  }

  {
    uncategorized.length > 0 && (
      <section class="container-site py-10">
        <h2 class="text-2xl font-bold">Más cursos de {category.name}</h2>
        <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {uncategorized.map((course) => (
            <CourseCard {course} {country} />
          ))}
        </div>
      </section>
    )
  }

  <section class="bg-off-white py-14">
    <div class="container-site">
      <h2 class="text-center text-2xl font-bold">Preguntas frecuentes sobre {catName.toLowerCase()}</h2>
      <div class="mx-auto mt-8 max-w-3xl">
        <FaqAccordion {faqs} />
      </div>
    </div>
  </section>
</BaseLayout>
