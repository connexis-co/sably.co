---
import type {VerifiedReviews} from '@/lib/verified-course-reviews';
interface Props { data:VerifiedReviews }
const {data}=Astro.props;
---
{data.rating && <section id="opiniones-verificadas" aria-labelledby="verified-reviews-title" class="rounded-lg border border-surface-200 p-6">
 <h2 id="verified-reviews-title" class="text-2xl font-bold">Opiniones de compradores en Sably</h2>
 <p class="mt-3 text-body"><strong class="text-primary">{data.rating.value.toLocaleString('es',{maximumFractionDigits:2})} / 5</strong> · {data.rating.count} {data.rating.count===1?'valoración':'valoraciones'} con compra verificada.</p>
 <div class="mt-5 grid gap-4 md:grid-cols-2">{data.reviews.map(review=><article class="rounded-lg bg-surface-50 p-5">
  <p class="text-warning" aria-label={`${review.rating} de 5 estrellas`}>{'★'.repeat(review.rating)}</p>
  <p class="mt-3 whitespace-pre-line text-body">{review.body}</p>
  <p class="mt-4 font-semibold text-primary">{review.author}</p>
  <p class="text-xs text-muted">Compra verificada · Publicada en Sably</p>
 </article>)}</div>
</section>}
