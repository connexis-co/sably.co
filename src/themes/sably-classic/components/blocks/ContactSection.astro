---
import {getCountries} from '@/lib/emdash-content';
import {contactContent} from '@/lib/contact-page.mjs';
import {safeEditorialUrl,marketMenuUrl} from '@/lib/sably-theme';
import type {BlockValue} from 'emdash/ui';
interface Props {value:BlockValue}
const contact=contactContent(Astro.props.value);
const COUNTRIES=await getCountries();
const country=COUNTRIES.find(c=>c.code==='co')??COUNTRIES[0];
const phone=(contact.whatsapp || country?.whatsapp || '').replace(/[^0-9]/g,'');
const whatsapp=/^\d{7,15}$/.test(phone)?`https://wa.me/${phone}`:null;
const email=/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(contact.email)?contact.email:null;
const privacyUrl=safeEditorialUrl(contact.privacy_url)??'/legal/privacidad/';
const helpUrl=marketMenuUrl(contact.help_button_url,country?.code??'co');
---
<div class="container-site grid items-start gap-8 py-12 sm:py-16 lg:grid-cols-[minmax(0,1fr)_340px]">
    <form method="post" data-contacto class="rounded-lg border border-surface-200 bg-white p-6" novalidate>
      <fieldset disabled data-contact-fields class="min-w-0">
      <legend class="font-display text-xl font-bold text-primary">{contact.form_title}</legend>

      <div aria-hidden="true" style="position:absolute;left:-9999px;height:0;overflow:hidden">
        <label>Deja este campo vacío <input type="text" name="trampa" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1 block text-xs font-semibold text-heading">{contact.name_label}</span>
          <input
            name="name" required minlength="2" maxlength="80" autocomplete="name"
            class="w-full rounded-md border border-surface-300 px-3 py-2.5 text-sm"
            aria-describedby="err-name"
          />
          <span id="err-name" data-err="name" class="mt-1 hidden text-xs text-error"></span>
        </label>
        <label class="block">
          <span class="mb-1 block text-xs font-semibold text-heading">{contact.email_label}</span>
          <input
            name="email" type="email" required autocomplete="email"
            class="w-full rounded-md border border-surface-300 px-3 py-2.5 text-sm"
            aria-describedby="err-email"
          />
          <span id="err-email" data-err="email" class="mt-1 hidden text-xs text-error"></span>
        </label>
        <label class="block">
          <span class="mb-1 block text-xs font-semibold text-heading">
            {contact.phone_label}
          </span>
          <input
            name="phone" type="tel" autocomplete="tel"
            class="w-full rounded-md border border-surface-300 px-3 py-2.5 text-sm"
          />
        </label>
        <label class="block">
          <span class="mb-1 block text-xs font-semibold text-heading">{contact.country_label}</span>
          <select name="country" class="w-full rounded-md border border-surface-300 px-3 py-2.5 text-sm">
            {COUNTRIES.map((c) => <option value={c.code} selected={c.code === country?.code}>{c.flag} {c.name}</option>)}
          </select>
        </label>
      </div>

      <label class="mt-4 block">
        <span class="mb-1 block text-xs font-semibold text-heading">{contact.message_label}</span>
        <textarea
          name="message" required minlength="10" maxlength="2000" rows="6"
          placeholder={contact.message_placeholder}
          class="w-full rounded-md border border-surface-300 px-3 py-2.5 text-sm"
          aria-describedby="err-message"></textarea>
        <span id="err-message" data-err="message" class="mt-1 hidden text-xs text-error"></span>
      </label>

      <label class="mt-4 flex items-start gap-2 text-xs text-body">
        <input type="checkbox" name="consent" required class="mt-0.5 shrink-0" />
        <span>
          <span data-consent-text>{contact.consent_text}</span>{' '}
          <a data-privacy-link href={privacyUrl} class="underline">{contact.privacy_label}</a>.
        </span>
      </label>
      <span data-err="consent" class="mt-1 hidden text-xs text-error"></span>

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <button
          type="submit" data-enviar
          class="rounded-md bg-accent px-5 py-3 text-sm font-bold text-white transition hover:bg-accent-hover disabled:opacity-60"
        >{contact.submit_label}</button>
        <span data-aviso role="status" class="text-sm"></span>
      </div>

      </fieldset>
      <noscript>
        <p class="mt-4 rounded-md bg-surface-100 p-3 text-sm">
          El formulario necesita JavaScript. Escríbenos por WhatsApp mientras tanto.
        </p>
      </noscript>
    </form>

    <aside class="space-y-6">
      <div class="rounded-lg border border-surface-200 bg-off-white p-6">
        <h2 class="text-xl font-bold">{contact.channels_title}</h2>
        {whatsapp && <div class="mt-5"><a href={whatsapp} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center rounded-md bg-accent px-5 py-3 text-sm font-bold text-white hover:bg-accent-hover">{contact.whatsapp_label}</a><p class="mt-3 text-sm leading-relaxed">{contact.whatsapp_description}</p></div>}
        {email && <a class="mt-5 block break-words font-semibold text-accent underline underline-offset-4" href={`mailto:${email}`}>{email}</a>}
        {contact.hours && <p class="mt-4 whitespace-pre-line text-sm leading-relaxed">{contact.hours}</p>}
      </div>
      {contact.help_title && <div class="rounded-lg border border-surface-200 p-6"><h2 class="text-lg font-bold">{contact.help_title}</h2><p class="mt-3 whitespace-pre-line text-sm leading-relaxed">{contact.help_text}</p>{helpUrl && contact.help_button_label && <a href={helpUrl} class="mt-4 inline-flex min-h-11 items-center font-semibold text-accent underline underline-offset-4">{contact.help_button_label}</a>}</div>}
    </aside>
</div>
<script>
  // La lógica del formulario es común a los dos temas: src/lib/formulario-contacto.ts.
  import { iniciarContacto } from '@/lib/formulario-contacto';
  iniciarContacto();
</script>
