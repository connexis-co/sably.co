---
import { Image, type BlockValue } from 'emdash/ui';
import type { MediaValue } from 'emdash';
import type { RichBlock } from '@/lib/emdash-content';
import CmsRichBody from '@/components/CmsRichBody.astro';
interface Props { value: BlockValue & {eyebrow?:string;title?:string;content?:RichBlock[];image?:MediaValue} }
const {value}=Astro.props;
---
<section class="container-site grid items-center gap-10 py-12 sm:py-16" class:list={{'lg:grid-cols-2':!!value.image}}>
  <div>
    {value.eyebrow && <p class="mb-3 font-semibold text-accent">{value.eyebrow}</p>}
    {value.title && <h2 class="text-2xl font-bold sm:text-3xl">{value.title}</h2>}
    <div class="prose-sably mt-5"><CmsRichBody value={value.content ?? []} /></div>
  </div>
  {value.image && <Image image={value.image} class="aspect-[3/2] w-full rounded-lg object-cover" loading="lazy" />}
</section>
