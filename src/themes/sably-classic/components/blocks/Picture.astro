---
import { Image } from 'emdash/ui';
import type { MediaValue } from 'emdash';
import type { BlockValue } from 'emdash/ui';
interface Props { value: BlockValue & { image?: MediaValue; caption?: string }; }
const { value } = Astro.props;
---
{value.image && <figure class="container-site py-6"><Image image={value.image} class="mx-auto max-h-[600px] w-full rounded-xl object-cover" /><figcaption class="mt-3 text-center text-sm text-muted">{value.caption}</figcaption></figure>}
