---
/**
 * Hilo de comentarios de un artículo.
 *
 * Los comentarios aprobados llegan en el HTML del Worker. El cliente actualiza
 * el hilo y activa respuestas/votos al acercarse al viewport.
 *
 * El cuerpo de un comentario es texto de un desconocido. En todo el módulo se
 * construye el DOM con `<template>` y `textContent`; no hay un solo
 * `innerHTML`, así que el XSS no depende de acordarse de escapar.
 */
interface Props {
  /** Identificador del subject en D1: `blog:<slug>`. */
  subject: string;
}
const { subject } = Astro.props;
import { CONSENTIMIENTO, POLITICA_URL } from '@/lib/consentimiento';
import { env } from 'cloudflare:workers';
import { readPublicComments } from '@/plugins/sably-operations/public';
const comments = await readPublicComments((env as unknown as {SABLY_DB:D1Database}).SABLY_DB,subject).catch(()=>[]);
const commentCount = comments.reduce((n,c)=>n+1+(c.respuestas?.length??0),0);
const commentDate = (value:number)=>new Intl.DateTimeFormat('es-CO',{dateStyle:'long',timeZone:'America/Bogota'}).format(value*1000);
---

<section id="comentarios" aria-labelledby="comentarios-titulo" class="mt-12 border-t border-surface-200 pt-10" data-comentarios data-subject={subject}>
  <h2 id="comentarios-titulo" class="font-display text-2xl font-bold text-primary">
    Comentarios <span data-total class="font-normal text-muted">{commentCount?`(${commentCount})`:''}</span>
  </h2>

  <p class="mt-2 max-w-prose text-sm leading-relaxed text-body">Comparte tu experiencia o deja una pregunta sobre este artículo.</p>

  <p data-estado hidden={comments.length>0} class="mt-5 rounded-xl bg-off-white px-5 py-4 text-sm text-body">Todavía no hay comentarios. Sé la primera persona en escribir.</p>

  <ol data-lista class="mt-6 space-y-6" aria-live="polite">
    {comments.map(c=><li class="rounded-xl border border-surface-200 bg-white p-5">
      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1"><strong class="text-sm font-semibold text-heading">{c.author_name}</strong><time class="text-xs text-muted" datetime={new Date(c.created_at*1000).toISOString()}>{commentDate(c.created_at)}</time></div>
      <p class="mt-2 whitespace-pre-line text-sm text-body">{c.body}</p>
      {c.utiles>0&&<p class="mt-3 text-xs text-muted">{c.utiles} personas lo encontraron útil</p>}
      {!!c.respuestas?.length&&<ol class="mt-4 space-y-3 border-l-2 border-surface-200 pl-4">{c.respuestas.map(r=><li><strong class="text-sm font-semibold text-heading">{r.author_name}</strong><time class="ml-2 text-xs text-muted" datetime={new Date(r.created_at*1000).toISOString()}>{commentDate(r.created_at)}</time><p class="mt-2 whitespace-pre-line text-sm text-body">{r.body}</p></li>)}</ol>}
    </li>)}
  </ol>

  <form data-form class="mt-8 rounded-xl border border-surface-200 bg-off-white p-5 sm:p-6" novalidate>
    <fieldset data-fields disabled class="min-w-0 disabled:opacity-60">
    <h3 class="font-display text-lg font-bold text-primary">Deja tu comentario</h3>
    <p class="mt-1 text-sm text-body">
      Se publica cuando lo revisemos. Tu correo no se muestra en ningún momento.
    </p>

    <input type="hidden" name="parent_id" value="" />

    <!--
      Campo trampa. No lleva un nombre que el autocompletado del navegador
      reconozca, y queda fuera del orden de tabulación y del árbol de
      accesibilidad: quien lo rellena es un guion.
    -->
    <div aria-hidden="true" style="position:absolute;left:-9999px;height:0;overflow:hidden">
      <label>Deja este campo vacío <input type="text" name="trampa" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <label class="block">
        <span class="mb-1 block text-xs font-semibold text-heading">Nombre</span>
        <input
          name="author_name" required minlength="2" maxlength="60" autocomplete="name"
          class="w-full rounded-md border border-surface-300 bg-white px-3 py-3 text-sm text-heading transition focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none"
          aria-describedby="err-nombre"
        />
        <span id="err-nombre" data-err="author_name" class="mt-1 hidden text-xs text-error"></span>
      </label>
      <label class="block">
        <span class="mb-1 block text-xs font-semibold text-heading">
          Correo <span class="font-normal text-muted">(opcional, no se publica)</span>
        </span>
        <input
          name="author_email" type="email" autocomplete="email"
          class="w-full rounded-md border border-surface-300 bg-white px-3 py-3 text-sm text-heading transition focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none"
          aria-describedby="err-email"
        />
        <span id="err-email" data-err="author_email" class="mt-1 hidden text-xs text-error"></span>
      </label>
    </div>

    <label class="mt-3 block">
      <span class="mb-1 block text-xs font-semibold text-heading">Comentario</span>
      <textarea
        name="body" required minlength="10" maxlength="1200" rows="4"
        class="w-full rounded-md border border-surface-300 bg-white px-3 py-3 text-sm text-heading transition focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none"
        placeholder="Escribe tu duda o experiencia…" aria-describedby="comment-limit err-body"></textarea>
      <span id="comment-limit" class="mt-1 block text-right text-xs text-body" data-counter>0 / 1200 caracteres</span>
      <span id="err-body" data-err="body" class="mt-1 hidden text-xs text-error"></span>
    </label>

    <label class="mt-3 flex items-start gap-2 text-xs text-body">
      <input type="checkbox" name="consent" required class="mt-0.5 size-4 shrink-0 accent-accent" />
      <span>
        <span data-consent-text>{CONSENTIMIENTO.comentario}</span>{' '}
        <a href={POLITICA_URL} class="underline">Leer la política de privacidad</a>.
      </span>
    </label>
    <span data-err="consent" class="mt-1 hidden text-xs text-error"></span>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <button
        type="submit" data-enviar
        class="min-h-11 rounded-md bg-accent px-5 py-3 text-sm font-bold text-white transition hover:bg-accent-hover disabled:opacity-60"
      >Enviar comentario</button>
      <button type="button" data-cancelar-respuesta class="hidden text-sm text-muted underline">
        Cancelar respuesta
      </button>
      <span data-aviso role="status" class="text-sm"></span>
    </div>
    </fieldset>
  </form>

  <noscript>
    <p class="mt-4 rounded-md bg-surface-100 p-4 text-sm text-body">
      Puedes leer los comentarios publicados. Activa JavaScript para responder o enviar uno nuevo.
    </p>
  </noscript>

  <!-- Plantilla de comentario. Se clona y se rellena con textContent. -->
  <template data-plantilla>
    <li class="rounded-xl border border-surface-200 bg-white p-5">
      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
        <strong data-autor class="text-sm font-semibold text-heading"></strong>
        <time data-fecha class="text-xs text-muted"></time>
      </div>
      <p data-cuerpo class="mt-2 whitespace-pre-line text-sm text-body"></p>
      <div class="mt-3 flex items-center gap-3">
        <button
          type="button" data-util
          class="min-h-11 rounded-full border border-surface-200 px-3 py-2 text-xs text-muted transition hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:text-accent"
          aria-pressed="false"
        >👍 Útil <span data-utiles></span></button>
        <button type="button" data-responder class="min-h-11 px-1 text-xs font-semibold text-body underline hover:text-accent">
          Responder
        </button>
      </div>
      <ol data-respuestas class="mt-4 space-y-3 border-l-2 border-surface-200 pl-4"></ol>
    </li>
  </template>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-comentarios]');
  if (section) {
    const mount = () => void import('@/lib/comentarios').then(({montarComentarios}) => montarComentarios(section)).catch(() => {
      const status = section.querySelector<HTMLElement>('[data-estado]');
      if (status) { status.hidden=false; status.textContent='No se pudo activar el formulario. Recarga la página para intentarlo de nuevo.'; }
    });
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        if (!entries.some(entry => entry.isIntersecting)) return;
        observer.disconnect(); mount();
      }, {rootMargin:'400px'});
      observer.observe(section);
    } else mount();
  }
</script>
