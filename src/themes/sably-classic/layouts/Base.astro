---
import '@/styles/global.css';
import { EmDashBodyStart, EmDashBodyEnd, WidgetArea } from 'emdash/ui';
import { createPublicPageContext } from 'emdash/page';
import { getSeoMeta, type PublicPageContext } from 'emdash';
import { getLiveSiteSettings } from '@/lib/live-site-settings';
import { SITE } from '@/lib/site';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PromoBanner from '@/components/PromoBanner.astro';
import PruebaSocial from '@/components/PruebaSocial.astro';
import GeoDialog from '@/components/GeoDialog.astro';
import SearchModal from '@/components/SearchModal.astro';
import type { Country, City } from '@/lib/countries';
import type { HreflangAlternate } from '@/lib/seo';
import { organizationSchema } from '@/lib/seo';

export interface Props {
  title: string;
  description: string;
  country: Country;
  city?: City;
  /** Ruta después del código de país, para hreflang/switcher. */
  pathAfterCountry?: string;
  alternates?: HreflangAlternate[];
  schemas?: object[];
  pageType?: string;
  articleMeta?: PublicPageContext['articleMeta'];
  articleSchema?: Record<string, unknown>;
  /**
   * Marca la página como «sin cupón»: su creador no acepta el descuento del
   * sitio. Va en el <body> y no en cada enlace porque los CTA salen de cuatro
   * componentes distintos —ficha, barra fija, popup de salida, banner— y
   * olvidarse de uno significa prometer un descuento que el checkout no aplica.
   */
  sinCupon?: boolean;
  /**
   * Id del proveedor del curso (ver src/lib/proveedores.ts). Va en el <body>
   * para que el banner y el repintado de precio sepan a qué proveedor pertenece
   * la página y apliquen solo las promociones que lo tienen como objetivo. En
   * páginas que no son de curso queda vacío y no se usa.
   */
  proveedor?: string;
  whatsappContext?: string;
  noindex?: boolean;
  /** Imagen social de la página (og:image). */
  image?: string;
  /** Canonical explícito (override). Las variantes de ciudad canonican a país. */
  canonical?: string;
  /**
   * Noindex solo para Googlebot (ver Seo.astro). Es explícito y no se deduce de
   * `city`: las fichas ciudad+curso también pasan `city` y no deben llevarlo.
   */
  noindexGoogle?: boolean;
}

const {
  title,
  description,
  country,
  city,
  pathAfterCountry = '/',
  alternates = [],
  schemas = [],
  pageType = 'page',
  articleMeta,
  articleSchema,
  sinCupon = false,
  proveedor,
  whatsappContext,
  noindex = false,
  image,
  canonical,
  noindexGoogle = false,
} = Astro.props;

const allSchemas = [await organizationSchema(), ...schemas];

/* og:locale del mercado (es_MX en /mx/…) en todo lo que cuelga de /xx/; antes
   era es_CO fijo en los 8 países. El blog, los legales y /nosotros reciben el
   país por defecto pero no son de ningún mercado: se quedan con es_CO.
   <html lang> sigue en «es» a propósito: PromoBanner deduce el país de
   `documentElement.lang` («es-MX» → mx) para elegir la promoción y el cupón de
   los CTA, y hoy, con «es», resuelve siempre Colombia. Cambiarlo movería qué
   promoción ve cada país, que es una decisión de negocio y no de SEO. */
const dePais = Astro.url.pathname.startsWith(`/${country.code}/`);
const ogLocale = dePais ? country.hreflang.replace('-', '_') : 'es_CO';
const settings = await getLiveSiteSettings();
const seo = getSeoMeta({ data: { seo: Astro.locals.sablySeo } }, {
  siteUrl: SITE.url, defaultTitle: title, defaultDescription: description,
  defaultOgImage: new URL(image || settings.seo?.defaultOgImage?.url || '/covers/oficios.jpg', SITE.url).href,
  path: Astro.url.pathname,
});
const development = import.meta.env.SITE?.replace(/\/+$/, '') !== 'https://sably.co';
const pageContext = { ...createPublicPageContext({
  Astro, kind: Astro.locals.sablyContent ? 'content' : 'custom',
  content: Astro.locals.sablyContent, pageType, title: seo.title,
  pageTitle: seo.title, description: seo.description,
  canonical: seo.canonical && Astro.locals.sablySeo?.canonical ? seo.canonical : canonical ?? new URL(Astro.url.pathname, SITE.url).href,
  image: seo.ogImage, siteName: settings.title || SITE.name, siteUrl: SITE.url,
  articleMeta,
  seo: { robots: development ? 'noindex, nofollow, noarchive' : noindex ? 'noindex, follow' : seo.robots || 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' },
}), ...(articleSchema ? { sablyArticle: articleSchema } : {}) };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {!settings.favicon?.url && <><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" /><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" /></>}
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1B1B3A" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={seo.title} page={pageContext} {alternates} schemas={allSchemas} {noindexGoogle} {ogLocale} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body
    data-theme="sably-classic"
    data-country={country.code}
    data-page-type={pageType}
    data-sin-cupon={sinCupon ? '' : undefined}
    data-proveedor={proveedor || undefined}
  >
    <EmDashBodyStart page={pageContext} />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-100 focus:bg-white focus:px-4 focus:py-2 focus:text-primary"
    >
      Saltar al contenido
    </a>
    <PromoBanner variante="barra" />
    <Header {country} {city} {pathAfterCountry} />
    <WidgetArea name="header_after" />
    <main id="main">
      <slot />
    </main>
    <Footer {country} />
    <WidgetArea name="footer_after" />
    <PruebaSocial />
    <GeoDialog {pathAfterCountry} />
    <SearchModal {country} />
    <EmDashBodyEnd page={pageContext} />
  </body>
</html>
