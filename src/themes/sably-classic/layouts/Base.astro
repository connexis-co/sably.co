---
import '@/styles/global.css';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import outfitFont from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';
import { env } from 'virtual:sably-runtime';
import { canCachePublicPage, earliestBoundary, pageMaxAge, PUBLIC_PAGE_SWR, PUBLIC_PAGE_TAGS } from '@/lib/public-delivery';
import { readNextPromoBoundary } from '@/plugins/sably-operations/public';
import { EmDashBodyStart, EmDashBodyEnd, WidgetArea } from 'emdash/ui';
import { createPublicPageContext } from 'emdash/page';
import { getSeoMeta, type PublicPageContext } from 'emdash';
import { getLiveSiteSettings } from '@/lib/live-site-settings';
import { SITE } from '@/lib/site';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PromoBanner from '@/components/PromoBanner.astro';
import PruebaSocial from '@/components/PruebaSocial.astro';
import GeoDialog from '@/components/GeoDialog.astro';
import SearchModal from '@/components/SearchModal.astro';
import type { Country, City } from '@/lib/countries';
import type { HreflangAlternate } from '@/lib/seo';
import { organizationSchema } from '@/lib/seo';
import { temaDeLaPeticion } from '@/lib/ajustes-tema';
import CabeceraV2 from '@/themes/sably-v2/components/Cabecera.astro';
import BarraCampanaV2 from '@/themes/sably-v2/components/BarraCampana.astro';
import BuscadorV2 from '@/themes/sably-v2/components/Buscador.astro';
import PieV2, { type VariantePie } from '@/themes/sably-v2/components/Pie.astro';
import { datosNavegacion } from '@/themes/sably-v2/navegacion';
import { promoDeLaPagina } from '@/themes/sably-v2/promo-v2';

export interface Props {
  title: string;
  description: string;
  country: Country;
  city?: City;
  /** Ruta después del código de país, para hreflang/switcher. */
  pathAfterCountry?: string;
  alternates?: HreflangAlternate[];
  schemas?: object[];
  pageType?: string;
  articleMeta?: PublicPageContext['articleMeta'];
  articleSchema?: Record<string, unknown>;
  /**
   * Marca la página como «sin cupón»: su creador no acepta el descuento del
   * sitio. Va en el <body> y no en cada enlace porque los CTA salen de cuatro
   * componentes distintos —ficha, barra fija, popup de salida, banner— y
   * olvidarse de uno significa prometer un descuento que el checkout no aplica.
   */
  sinCupon?: boolean;
  /**
   * La página lleva su propio cupón (la caja de compra de la ficha V2, que deja
   * quitarlo y reponerlo): la barra de campaña se ve, pero no toca los enlaces de pago.
   */
  cuponPropio?: boolean;
  /**
   * Id del proveedor del curso (ver src/lib/proveedores.ts). Va en el <body>
   * para que el banner y el repintado de precio sepan a qué proveedor pertenece
   * la página y apliquen solo las promociones que lo tienen como objetivo. En
   * páginas que no son de curso queda vacío y no se usa.
   */
  proveedor?: string;
  whatsappContext?: string;
  noindex?: boolean;
  /** Imagen social de la página (og:image). */
  image?: string;
  /** Canonical explícito (override). Las variantes de ciudad canonican a país. */
  canonical?: string;
  /**
   * Noindex solo para Googlebot (ver Seo.astro). Es explícito y no se deduce de
   * `city`: las fichas ciudad+curso también pasan `city` y no deben llevarlo.
   */
  noindexGoogle?: boolean;
  /**
   * Momento (ms) a partir del cual la página ya no puede servirse de caché
   * porque pinta un dato con caducidad propia: la cotización de Hotmart de la
   * ficha. Sin él la página vive lo que diga la próxima promoción.
   */
  freshUntil?: number | null;
  /**
   * La página se pintó con el tema V2 (hoy solo la ficha de curso). Marca el
   * <body> y el estilo de campo; las demás páginas siguen en el clásico aunque
   * V2 sea el tema por defecto, hasta que tengan su plantilla V2.
   */
  temaV2?: boolean;
  /** Solo V2: pie «completo» (por defecto) o «compacto» (ficha de curso). */
  pie?: VariantePie;
}

const {
  title,
  description,
  country,
  city,
  pathAfterCountry = '/',
  alternates = [],
  schemas = [],
  pageType = 'page',
  articleMeta,
  articleSchema,
  sinCupon = false,
  cuponPropio = false,
  proveedor,
  whatsappContext,
  noindex = false,
  image,
  canonical,
  noindexGoogle = false,
  freshUntil = null,
  temaV2 = false,
  pie,
} = Astro.props;

const [organization, settings, temaPeticion] = await Promise.all([organizationSchema(), getLiveSiteSettings(), temaDeLaPeticion(Astro)]);
/* ?tema=v2 / ?tema=clasico: vista de revisión. Nunca se indexa (la canónica ya
   es la URL sin parámetros) y nunca se cachea (lleva query). La cabecera
   X-Robots-Tag la pone la frontera de Node (request-handler.ts): un layout no
   puede fijar cabeceras de la respuesta. */
const temaForzado = temaPeticion.forzado;
const allSchemas = [organization, ...schemas];

/* og:locale del mercado (es_MX en /mx/…) en todo lo que cuelga de /xx/; antes
   era es_CO fijo en los 8 países. El blog, los legales y /nosotros reciben el
   país por defecto pero no son de ningún mercado: se quedan con es_CO.
   <html lang> sigue en «es» a propósito: PromoBanner deduce el país de
   `documentElement.lang` («es-MX» → mx) para elegir la promoción y el cupón de
   los CTA, y hoy, con «es», resuelve siempre Colombia. Cambiarlo movería qué
   promoción ve cada país, que es una decisión de negocio y no de SEO. */
const dePais = Astro.url.pathname.startsWith(`/${country.code}/`);
const ogLocale = dePais ? country.hreflang.replace('-', '_') : 'es_CO';
const seo = getSeoMeta({ data: { seo: Astro.locals.sablySeo } }, {
  siteUrl: SITE.url, defaultTitle: title, defaultDescription: description,
  defaultOgImage: new URL(image || settings.seo?.defaultOgImage?.url || '/covers/oficios.jpg', SITE.url).href,
  path: Astro.url.pathname,
});
const development = import.meta.env.SITE?.replace(/\/+$/, '') !== 'https://sably.co';
if (canCachePublicPage(Astro.request, development ? 'development' : 'production')) {
  // La barra de promoción se pinta en el servidor: la copia no puede sobrevivir a su inicio o fin.
  const boundary = await readNextPromoBoundary((env as unknown as { SABLY_DB: D1Database }).SABLY_DB, country.code).catch(() => null);
  // Tampoco a la cotización de Hotmart que pinta la ficha (`freshUntil`).
  Astro.cache?.set({ maxAge: pageMaxAge(earliestBoundary(boundary, freshUntil)), swr: PUBLIC_PAGE_SWR, tags: PUBLIC_PAGE_TAGS });
} else Astro.cache?.set(false); // sin caché de ruta al reescribir a /404 desde el middleware
for (const font of [interFont, outfitFont]) Astro.response.headers.append('Link', `<${font}>; rel=preload; as=font; type="font/woff2"; crossorigin`);
/* Tema V2: cabecera, megamenú, buscador, barra de campaña y pie propios
   (src/themes/sably-v2/components). Los mismos enlaces que los del clásico. */
const [navV2, promoV2] = temaV2
  ? await Promise.all([datosNavegacion(country, Astro.locals), promoDeLaPagina(Astro, { pais: country.code, proveedor, sinCupon })])
  : [null, null];
const pieV2: VariantePie = pie ?? (pageType === 'course' ? 'compacto' : 'completo');
const pageContext = { ...createPublicPageContext({
  Astro, kind: Astro.locals.sablyContent ? 'content' : 'custom',
  content: Astro.locals.sablyContent, pageType, title: seo.title,
  pageTitle: seo.title, description: seo.description,
  canonical: seo.canonical && Astro.locals.sablySeo?.canonical ? seo.canonical : canonical ?? new URL(Astro.url.pathname, SITE.url).href,
  image: seo.ogImage, siteName: settings.title || SITE.name, siteUrl: SITE.url,
  articleMeta,
  seo: { robots: development ? 'noindex, nofollow, noarchive' : noindex || temaForzado ? 'noindex, follow' : seo.robots || 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' },
}), ...(articleSchema ? { sablyArticle: articleSchema } : {}) };
---

<!doctype html>
<html lang="es" data-field={temaV2 ? temaPeticion.ajustes.estiloCampo : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={outfitFont} as="font" type="font/woff2" crossorigin />
    {!settings.favicon?.url && <><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" /><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" /></>}
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1B1B3A" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={seo.title} page={pageContext} {alternates} schemas={allSchemas} {noindexGoogle} {ogLocale} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Navegación casi instantánea: el navegador pide la página de un enlace interno al pasar el
        cursor o empezar a tocarlo, y la respuesta sale de la caché del borde. Speed Brain de
        Cloudflare solo precarga con el clic ya iniciado. */}
    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "source": "document",
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": ["/_emdash/*", "/admin/*", "/api/*", "/*.xml", "/*.txt"] } },
                { "not": { "selector_matches": "[rel~=nofollow], [target=_blank], [download], [data-no-prefetch]" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
  </head>
  <body
    data-theme={temaV2 ? 'sably-v2' : 'sably-classic'}
    data-tema={temaV2 ? 'v2' : undefined}
    data-country={country.code}
    data-page-type={pageType}
    data-sin-cupon={sinCupon ? '' : undefined}
    data-cupon-propio={cuponPropio && !sinCupon ? '' : undefined}
    data-proveedor={proveedor || undefined}
  >
    <EmDashBodyStart page={pageContext} />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-100 focus:bg-white focus:px-4 focus:py-2 focus:text-primary"
    >
      Saltar al contenido
    </a>
    {navV2 ? (
      <>
        <BarraCampanaV2 promo={promoV2} cierre={temaPeticion.ajustes.barraCampana.cierre} fija={temaPeticion.ajustes.barraCampana.fija} />
        <CabeceraV2 {country} {pathAfterCountry} nav={navV2} promo={promoV2} />
      </>
    ) : (
      <>
        <PromoBanner variante="barra" pais={country.code} {proveedor} {sinCupon} />
        <Header {country} {city} {pathAfterCountry} />
      </>
    )}
    <WidgetArea name="header_after" />
    <main id="main">
      <slot />
    </main>
    {navV2 ? <PieV2 {country} nav={navV2} variante={pieV2} {pathAfterCountry} /> : <Footer {country} />}
    <WidgetArea name="footer_after" />
    <PruebaSocial temaV2={!!navV2} />
    {navV2 ? <BuscadorV2 nav={navV2} /> : (
      <>
        <GeoDialog {pathAfterCountry} />
        <SearchModal {country} />
      </>
    )}
    <EmDashBodyEnd page={pageContext} />
    {temaForzado && (
      /* Vista de revisión: los enlaces internos conservan ?tema= para seguir
         navegando en el mismo tema. Solo existe en páginas forzadas. */
      <script is:inline define:vars={{ tema: Astro.url.searchParams.get('tema') }}>
        for (const a of document.querySelectorAll('a[href^="/"]')) {
          const u = new URL(a.href);
          if (u.origin !== location.origin || u.pathname.startsWith('/_') || u.pathname.startsWith('/api/')) continue;
          u.searchParams.set('tema', tema);
          a.href = u.pathname + u.search + u.hash;
        }
      </script>
    )}
  </body>
</html>
