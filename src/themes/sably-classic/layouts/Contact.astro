---
/**
 * Página de contacto. Ruta global, no por país: igual que /nosotros/ y /blog/,
 * según docs/ARQUITECTURA_URLS.md — canonical propio y sin hreflang, porque no
 * hay ocho versiones que diferenciar.
 *
 * Reutiliza `POST /api/v1/leads` en vez de un endpoint nuevo: la tabla `lead`
 * ya tiene el consentimiento, el límite por IP y la purga, y un mensaje de
 * contacto es un lead sin curso asociado.
 *
 * NOTA PARA JP — lo que falta aquí es dato tuyo, no código:
 * `CONTACTO.correo` está vacío a propósito. En cuanto exista una dirección
 * real (por ejemplo hola@sably.co) se rellena aquí y aparecen solos el bloque
 * de correo, el `ContactPoint` del marcado y la vía para ejercer habeas data.
 * No pongo una inventada porque acabaría en la política de privacidad y en el
 * registro legal de consentimientos.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCountries, type CmsPage, type CmsCountry } from '@/lib/emdash-content';
import { PageBlocks } from '@/themes';
import type { BlockValue } from 'emdash/ui';
interface Props {page:CmsPage;country:CmsCountry;}
import { CONSENTIMIENTO, POLITICA_URL } from '@/lib/consentimiento';
import { breadcrumbSchema } from '@/lib/seo';
import { SITE } from '@/lib/site';

const {page,country}=Astro.props;
const COUNTRIES=await getCountries();
Astro.locals.sablyContent=page.contentRef;
Astro.locals.sablySeo=page.seo;

/** Canales reales. Lo que esté vacío no se pinta. */
const CONTACTO = {
  /** TODO(JP): dirección real de contacto. */
  correo: '',
  whatsapp: country.whatsapp,
  /** TODO(JP): solo rellenar si hay alguien que lo cumpla. */
  horario: '',
};

const title=page.title;
const description=page.description;

const schemas = [
  breadcrumbSchema([
    { name: 'Inicio', url: `${SITE.url}/co/` },
    { name: 'Contacto', url: `${SITE.url}/contacto/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: title,
    description,
    url: `${SITE.url}/contacto/`,
    inLanguage: 'es',
    about: { '@id': `${SITE.url}/#organization` },
  },
];
---

<BaseLayout {title} {description} {country} pathAfterCountry="/" {schemas} pageType="contacto">
  <section class="bg-primary py-14">
    <div class="container-site">
      <nav aria-label="Breadcrumb" class="text-sm text-white/60">
        <a href="/co/" class="hover:text-white">Inicio</a> <span aria-hidden="true">›</span>
        <span class="text-white">Contacto</span>
      </nav>
      <h1 class="mt-4 text-3xl font-extrabold text-white sm:text-4xl" {...page.edit.hero_heading}>{page.heroHeading}</h1>

    </div>
  </section>

  <div class="container-site grid gap-10 py-12 lg:grid-cols-[1fr_320px]">
    <!-- Formulario -->
    <form data-contacto class="rounded-lg border border-surface-200 bg-white p-6" novalidate>
      <h2 class="font-display text-lg font-bold text-primary">Envíanos un mensaje</h2>

      <div aria-hidden="true" style="position:absolute;left:-9999px;height:0;overflow:hidden">
        <label>Deja este campo vacío <input type="text" name="trampa" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1 block text-xs font-semibold text-heading">Nombre</span>
          <input
            name="name" required minlength="2" maxlength="80" autocomplete="name"
            class="w-full rounded-md border border-surface-300 px-3 py-2.5 text-sm"
            aria-describedby="err-name"
          />
          <span id="err-name" data-err="name" class="mt-1 hidden text-xs text-error"></span>
        </label>
        <label class="block">
          <span class="mb-1 block text-xs font-semibold text-heading">Correo</span>
          <input
            name="email" type="email" required autocomplete="email"
            class="w-full rounded-md border border-surface-300 px-3 py-2.5 text-sm"
            aria-describedby="err-email"
          />
          <span id="err-email" data-err="email" class="mt-1 hidden text-xs text-error"></span>
        </label>
        <label class="block">
          <span class="mb-1 block text-xs font-semibold text-heading">
            Teléfono <span class="font-normal text-muted">(opcional)</span>
          </span>
          <input
            name="phone" type="tel" autocomplete="tel"
            class="w-full rounded-md border border-surface-300 px-3 py-2.5 text-sm"
          />
        </label>
        <label class="block">
          <span class="mb-1 block text-xs font-semibold text-heading">País</span>
          <select name="country" class="w-full rounded-md border border-surface-300 px-3 py-2.5 text-sm">
            {COUNTRIES.map((c) => <option value={c.code} selected={c.code === country.code}>{c.flag} {c.name}</option>)}
          </select>
        </label>
      </div>

      <label class="mt-4 block">
        <span class="mb-1 block text-xs font-semibold text-heading">Mensaje</span>
        <textarea
          name="message" required minlength="10" maxlength="2000" rows="6"
          placeholder="Cuéntanos en qué podemos ayudarte."
          class="w-full rounded-md border border-surface-300 px-3 py-2.5 text-sm"
          aria-describedby="err-message"></textarea>
        <span id="err-message" data-err="message" class="mt-1 hidden text-xs text-error"></span>
      </label>

      <label class="mt-4 flex items-start gap-2 text-xs text-body">
        <input type="checkbox" name="consent" required class="mt-0.5 shrink-0" />
        <span>
          <span data-consent-text>{CONSENTIMIENTO.contacto}</span>{' '}
          <a href={POLITICA_URL} class="underline">Leer la política de privacidad</a>.
        </span>
      </label>
      <span data-err="consent" class="mt-1 hidden text-xs text-error"></span>

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <button
          type="submit" data-enviar
          class="rounded-md bg-accent px-5 py-3 text-sm font-bold text-white transition hover:bg-accent-hover disabled:opacity-60"
        >Enviar mensaje</button>
        <span data-aviso role="status" class="text-sm"></span>
      </div>

      <noscript>
        <p class="mt-4 rounded-md bg-surface-100 p-3 text-sm">
          El formulario necesita JavaScript. Escríbenos por WhatsApp mientras tanto.
        </p>
      </noscript>
    </form>

    <!-- Canales -->
    <aside><PageBlocks value={page.layout as unknown as BlockValue[]} /><a href={`https://wa.me/${country.whatsapp}`} target="_blank" rel="noopener" class="inline-block rounded-md bg-accent px-5 py-3 font-bold text-white">Escribir por WhatsApp</a></aside>
  </div>
</BaseLayout>

<script>
  import { trackEvent } from '@/lib/analytics';

  const form = document.querySelector<HTMLFormElement>('[data-contacto]');
  if (form) {
    const abiertoEn = Date.now();
    const aviso = form.querySelector<HTMLElement>('[data-aviso]')!;
    const enviar = form.querySelector<HTMLButtonElement>('[data-enviar]')!;

    const mostrarError = (campo: string, texto: string) => {
      const el = form.querySelector<HTMLElement>(`[data-err="${campo}"]`);
      if (!el) return;
      el.textContent = texto;
      el.classList.toggle('hidden', !texto);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      for (const c of ['name', 'email', 'message', 'consent']) mostrarError(c, '');
      aviso.textContent = '';

      const datos = new FormData(form);
      const nombre = String(datos.get('name') ?? '').trim();
      const correo = String(datos.get('email') ?? '').trim();
      const mensaje = String(datos.get('message') ?? '').trim();

      const fallos: string[] = [];
      const fallar = (campo: string, msg: string) => {
        mostrarError(campo, msg);
        fallos.push(campo);
      };
      if (nombre.length < 2) fallar('name', 'Escribe tu nombre.');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(correo)) fallar('email', 'Ese correo no parece válido.');
      if (mensaje.length < 10) fallar('message', 'Cuéntanos un poco más (mínimo 10 caracteres).');
      if (!datos.get('consent')) fallar('consent', 'Necesitamos tu autorización para responderte.');
      if (fallos.length) {
        form.querySelector<HTMLElement>(`[name="${fallos[0]}"]`)?.focus();
        return;
      }

      enviar.disabled = true;
      aviso.textContent = 'Enviando…';
      aviso.className = 'text-sm text-muted';

      try {
        const r = await fetch('/api/v1/leads', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            name: nombre,
            email: correo,
            phone: String(datos.get('phone') ?? '') || undefined,
            message: mensaje,
            source: 'contacto',
            consent_text: form.querySelector('[data-consent-text]')?.textContent?.trim(),
            trampa: String(datos.get('trampa') ?? ''),
            abierto_ms: Date.now() - abiertoEn,
          }),
          signal: AbortSignal.timeout(12000),
        });
        const d = (await r.json().catch(() => ({}))) as { error?: string; mensaje?: string };
        if (!r.ok) throw new Error(d.error || 'no se pudo enviar');

        form.reset();
        // El texto lo decide el servidor: solo él sabe si salió un correo.
        aviso.textContent = d.mensaje ?? 'Recibimos tu mensaje.';
        aviso.className = 'text-sm font-semibold text-success';
        trackEvent('submit_contact_form', { source: 'contacto' });
      } catch (err) {
        aviso.textContent =
          err instanceof DOMException && err.name === 'TimeoutError'
            ? 'La conexión tardó demasiado. Inténtalo otra vez o escríbenos por WhatsApp.'
            : (err as Error).message;
        aviso.className = 'text-sm font-semibold text-error';
      } finally {
        enviar.disabled = false;
      }
    });
  }
</script>
