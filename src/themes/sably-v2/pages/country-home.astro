---
/**
 * Portada de país V2 (diseno/exportes/v2/rHWVU y J8gubd). Mismo loader, mismos
 * textos del CMS, mismo título, descripción, hreflang y FAQPage que la portada
 * clásica (src/themes/sably-classic/pages/country-home.astro); cambia el aspecto.
 * Todo el texto y todos los enlaces de la clásica siguen en el HTML inicial.
 */
import { env } from 'virtual:sably-runtime';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Preguntas from '../components/Preguntas.astro';
import BandaPromo from '../components/BandaPromo.astro';
import Heroe, { type OficioMosaico } from '../components/portada/Heroe.astro';
import Cifras from '../components/portada/Cifras.astro';
import Categorias from '../components/portada/Categorias.astro';
import CategoriasPila from '../components/portada/categorias/Pila.astro';
import CategoriasFilas from '../components/portada/categorias/Filas.astro';
import Destacados from '../components/portada/Destacados.astro';
import Oficio from '../components/portada/Oficio.astro';
import ComoFunciona from '../components/portada/ComoFunciona.astro';
import Escenas, { type TextosEscenas } from '../components/portada/Escenas.astro';
import Beneficios from '../components/portada/Beneficios.astro';
import Videos from '../components/portada/Videos.astro';
import Guias from '../components/portada/Guias.astro';
import Cierre from '../components/portada/Cierre.astro';
import { temaDeLaPeticion } from '@/lib/ajustes-tema';
import { inventarioMosaico, mejorValorados, ordenarPorVisitas, repartirEnCeldas } from '../portada';
import Valorados from '../components/portada/Valorados.astro';
import { CSS_FILAS_COMPLETAS } from '../rejilla-tarjetas';
import Convergen from '../components/portada/Convergen.astro';
import Movimiento from '../components/portada/Movimiento.astro';
import { getHomeEditorial, getHomeSectionOptional } from '@/lib/home-editorial';
import { monedasCobradas } from '@/lib/moneda-catalogo';
import { countryAlternates, faqSchema } from '@/lib/seo';
import { preciosDeTarjetas } from '@/lib/precio-hoy';
import { notaHotmart } from '@/lib/opiniones';
import { readOperationalRatings } from '@/plugins/sably-operations/public';
import { cifrasPortada } from '../cifras';
import { duracionesNarradas } from '@/lib/narracion';
import { datosNavegacion, comprable } from '../navegacion';
import { promoDeLaPagina } from '../promo-v2';
import { fotoDeCurso, OFICIOS_MOSAICO, OFICIOS_HEROE, type NombreFoto } from '../fotos';
import type { load } from '@/lib/page-loaders/country-home';
import '../estilos.css';
type Props = Exclude<Awaited<ReturnType<typeof load>>, Response>;
const { country, CATEGORIES, base, featured, posts, videos, title, description, allCourses } = Astro.props;

const db = (env as unknown as { SABLY_DB: D1Database }).SABLY_DB;
const moneda = await monedasCobradas(allCourses.map(c => c.id), country, Astro.locals);
const editorial = await getHomeEditorial({ name: country.name, currency: moneda });
const copy = Object.fromEntries(Object.entries(editorial).map(([key, value]) => [key, value.fields])) as { [K in keyof typeof editorial]: typeof editorial[K]['fields'] };
const faqs = editorial.faq.groups.map(group => ({ q: group.title, a: group.body }));
/* Los beneficios del CMS empiezan por un emoji («🎓 Título»): V2 no pinta emojis de interfaz, se queda el texto. */
const benefits = editorial.benefits.groups.map(group => { const [, ...t] = group.title.split(' '); return { title: t.join(' ') || group.title, text: group.body }; });
const [nav, promo, cifras, valoraciones, { ajustes }, seccionEscenas] = await Promise.all([
  datosNavegacion(country, Astro.locals),
  promoDeLaPagina(Astro, { pais: country.code }),
  cifrasPortada(Astro.locals),
  readOperationalRatings(db, Astro.locals).catch(() => ({} as Awaited<ReturnType<typeof readOperationalRatings>>)),
  temaDeLaPeticion(Astro),
  getHomeSectionOptional('escenas', { name: country.name, currency: moneda }),
]);
/* Textos del scroll narrativo desde Secciones → sably-home-escenas; sin sección, los de fábrica del componente. */
const textosEscenas: TextosEscenas | null = seccionEscenas && {
  eyebrow: seccionEscenas.fields.eyebrow, title: seccionEscenas.fields.title, description: seccionEscenas.fields.description,
  capitulos: seccionEscenas.groups.map(g => ({ titulo: g.title, texto: g.body })),
};
const portada = ajustes.portada;
/* Mosaico del héroe (D1): 10–12 cursos con inscripción abierta, uno por oficio, repartidos en tres celdas.
   El primero (la foto grande, LCP) es el mismo curso que antes iba en la tarjeta flotante cuando no se elige
   otro en el panel. Precio de cada tarjeta y de cada oficio: el mismo que su ficha da como precio a pagar hoy
   (src/lib/precio-hoy.ts), nunca la captura vieja ni el de catálogo. */
/* Foto del mosaico: la de su oficio hecha para el mosaico (fotos.ts, OFICIOS_MOSAICO) o, si no hay, la de su área. */
const fotoMosaico = (id: string, area: string) => (OFICIOS_HEROE.find(o => o.curso === id) ?? OFICIOS_MOSAICO.find(o => o.curso === id))?.foto ?? fotoDeCurso(id, area);
/* Sin lista en el panel, los 12 oficios que eligió JP (HEROES-X §10.1), en su orden; si alguno cierra inscripción,
   se completan con los de foto propia (por visitas) y los destacados. La variante «mosaico» sigue con su lista. */
const elegidos = portada.heroe.cursos.length ? portada.heroe.cursos
  : portada.heroe.variante === 'mosaico' && !portada.pruebaHeroe ? ordenarPorVisitas(OFICIOS_MOSAICO.map(o => o.curso))
  : [...OFICIOS_HEROE.map(o => o.curso), ...ordenarPorVisitas(OFICIOS_MOSAICO.map(o => o.curso))];
const enMosaico = inventarioMosaico(allCourses.map(c => ({
  id: c.id, destacado: Boolean(c.data.featured), valoraciones: valoraciones[c.id]?.total ?? 0, comprable: comprable(c), foto: fotoMosaico(c.id, c.data.category),
})), elegidos, undefined, !portada.heroe.cursos.length).map(m => allCourses.find(c => c.id === m.id)!);
/* «Los mejor valorados»: por nota de Hotmart con un mínimo de valoraciones (panel). */
const valorados = portada.bloques.includes('valorados') ? mejorValorados(allCourses.map(c => ({ id: c.id, comprable: comprable(c), c })), valoraciones, portada.valoradosMinimo).map(x => x.c) : [];
const conPrecio = [...new Map([...featured, ...enMosaico, ...valorados].map(c => [c.id, c])).values()];
const { precios, freshUntil } = await preciosDeTarjetas(conPrecio, country, { url: Astro.url, locals: Astro.locals });
const oficiosHeroe: OficioMosaico[] = enMosaico.map(c => ({
  id: c.id, titulo: c.data.title, foto: fotoMosaico(c.id, c.data.category)!, precio: precios.get(c.id) ?? null, nota: notaHotmart(valoraciones[c.id] ?? null),
}));
const celdas = repartirEnCeldas(oficiosHeroe);
/* Línea de prueba del héroe: las mismas cifras reales del bloque de cifras (fecha en su nota de fuente). */
const pruebaHeroe = cifras.calificaciones > 0 && cifras.mediaTexto
  ? `${cifras.mediaTexto} de media en ${cifras.calificaciones.toLocaleString('es-CO')} valoraciones reales en Hotmart · ${cifras.cursos} cursos`
  : null;
/* Sugerencias del buscador del héroe: además de los cursos, las áreas y las guías del blog. */
const extraBusqueda = [
  ...nav.areas.map(a => ({ t: a.nombre, u: `${base}/cursos/${a.slug}/`, c: 'Área' as const })),
  ...posts.map(p => ({ t: p.data.title, u: `/blog/${p.id}/`, c: 'Guía' as const })),
];
/* Áreas: las seis primeras con foto grande y el resto como enlaces. */
const conFoto = nav.areas.slice(0, 6);
const resto = nav.areas.slice(6);
const externas = CATEGORIES.filter(c => c.externalUrl);
/* Oficio destacado: tres cursos destacados con nota publicada en Hotmart, cada uno con la foto de su área,
   sin repetir las tres que el mosaico enseña al cargar ni las de «Cómo funciona» y «Por qué Sably». */
const EN_HEROE = new Set<NombreFoto>([...celdas.map(c => c[0]!.foto), 'foto-portada-practica-vertical-1', 'foto-portada-aprende-vertical-1', 'foto-estudiar-celular-2']);
const usadas = new Set<NombreFoto>(EN_HEROE);
const oficios = featured.filter(comprable).flatMap(c => {
  const foto = fotoDeCurso(c.id, c.data.category);
  if (!foto || usadas.has(foto)) return [];
  usadas.add(foto);
  return [{ c, nota: notaHotmart(valoraciones[c.id] ?? null), foto }];
}).slice(0, 3);
const guiasDestacadas = posts.slice(0, 3);
const masGuias = posts.slice(3);
/* «Escúchalo · N min» en las tarjetas de guías: solo las que tienen narración publicada (una consulta). */
const narradas = portada.guiasVariante === 'tarjetas' ? await duracionesNarradas('blog') : new Map<string, number>();
---
<BaseLayout {title} {description} {country} pathAfterCountry="/" alternates={await countryAlternates('/')} schemas={[faqSchema(faqs)]} pageType="home" {freshUntil} temaV2>
  <Heroe textos={copy.hero} {base} locale={country.hreflang} areas={nav.areas} {celdas} oficios={oficiosHeroe} rotacion={portada.heroe} variante={portada.heroe.variante} fondo={portada.heroe.fondo} pruebaAB={portada.pruebaHeroe} movil={portada.heroeMovil} antetituloMovil={portada.antetituloMovil} botones={portada.heroe.botones} tachar={portada.heroe.tachar} prueba={pruebaHeroe} extra={extraBusqueda} />
  {/* Filas completas de las rejillas de tarjetas entre 1024 y 1279 px: una regla, en línea y solo si hace falta. */}
  {ajustes.columnasTarjetas === 'tres-completas' && (portada.bloques.includes('destacados') || portada.bloques.includes('valorados')) && <style is:inline set:html={CSS_FILAS_COMPLETAS}></style>}
  <!-- Interruptores de movimiento de la portada (panel → Portada): un envoltorio sin caja que no cambia la maqueta. -->
  <div class="contents" data-portada-bloques data-aparicion={portada.aparicion ? '' : undefined} data-cifras-cuentan={portada.cifrasCuentan ? '' : undefined} data-paralaje={portada.paralaje ? '' : undefined}>
  {portada.bloques.map(bloque => (
    bloque === 'cifras' ? <Cifras {cifras} {country} />
    : bloque === 'categorias' ? (portada.categoriasVariante === 'pila' ? <CategoriasPila copy={copy.categories} {base} {conFoto} {resto} {externas} total={nav.areas.length} />
      : portada.categoriasVariante === 'filas' ? <CategoriasFilas copy={copy.categories} {base} {conFoto} {resto} {externas} total={nav.areas.length} />
      : <Categorias copy={copy.categories} {base} {conFoto} {resto} {externas} total={nav.areas.length} />)
    : bloque === 'convergen' ? <Convergen oficios={oficiosHeroe} {base} cursos={nav.totalCursos} areas={nav.areas.length} paises={cifras.paises} hoy={cifras.hoy} />
    : bloque === 'destacados' ? <Destacados copy={copy.courses} {featured} {country} {precios} {base} {moneda} totalCursos={nav.totalCursos} columnas={ajustes.columnasTarjetas} />
    : bloque === 'promo' ? <BandaPromo {promo} {base} class="pt-20 lg:pt-24" />
    : bloque === 'escenas' ? <Escenas textos={textosEscenas} {base} areas={nav.areas} atenuar={portada.escenasAtenuar} variante={portada.escenasVariante} />
    : bloque === 'oficio' ? <Oficio {oficios} {base} modo={portada.oficioModo} intervalo={portada.oficioIntervalo} />
    : bloque === 'como-funciona' ? <ComoFunciona animado={portada.comoFuncionaAnimado} />
    : bloque === 'valorados' ? <Valorados cursos={valorados} {country} {precios} minimo={portada.valoradosMinimo} leidas={cifras.leidas} columnas={ajustes.columnasTarjetas} />
    : bloque === 'beneficios' ? <Beneficios copy={copy['benefits-heading']} {benefits} modo={portada.beneficiosModo} {cifras} />
    : bloque === 'videos' ? <Videos {videos} />
    : bloque === 'guias' ? <Guias copy={copy.blog} {guiasDestacadas} {masGuias} variante={portada.guiasVariante} {narradas} />
    : bloque === 'preguntas' ? <Preguntas antetitulo={copy['faq-heading'].eyebrow} titulo={copy['faq-heading'].title} {faqs} whatsapp={nav.whatsapp} class="pt-24 lg:pt-32" />
    : bloque === 'cierre' ? <Cierre {base} totalCursos={nav.totalCursos} />
    : null
  ))}
  </div>
  <Movimiento />
</BaseLayout>

<style is:global>
  @layer components {
    [data-pie='completo'] { margin-top: 0; padding-top: 64px; }
  }
</style>
