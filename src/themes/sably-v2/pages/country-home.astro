---
/**
 * Portada de país V2 (diseno/exportes/v2/rHWVU y J8gubd). Mismo loader, mismos
 * textos del CMS, mismo título, descripción, hreflang y FAQPage que la portada
 * clásica (src/themes/sably-classic/pages/country-home.astro); cambia el aspecto.
 * Todo el texto y todos los enlaces de la clásica siguen en el HTML inicial.
 */
import { env } from 'virtual:sably-runtime';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Preguntas from '../components/Preguntas.astro';
import BandaPromo from '../components/BandaPromo.astro';
import Heroe, { type OficioMosaico } from '../components/portada/Heroe.astro';
import Cifras from '../components/portada/Cifras.astro';
import Categorias from '../components/portada/Categorias.astro';
import Destacados from '../components/portada/Destacados.astro';
import Oficio from '../components/portada/Oficio.astro';
import ComoFunciona from '../components/portada/ComoFunciona.astro';
import Beneficios from '../components/portada/Beneficios.astro';
import Videos from '../components/portada/Videos.astro';
import Guias from '../components/portada/Guias.astro';
import Cierre from '../components/portada/Cierre.astro';
import { temaDeLaPeticion } from '@/lib/ajustes-tema';
import { inventarioMosaico, repartirEnCeldas } from '../portada';
import { getHomeEditorial } from '@/lib/home-editorial';
import { monedasCobradas } from '@/lib/moneda-catalogo';
import { countryAlternates, faqSchema } from '@/lib/seo';
import { preciosDeTarjetas } from '@/lib/precio-hoy';
import { notaHotmart } from '@/lib/opiniones';
import { readOperationalRatings } from '@/plugins/sably-operations/public';
import { cifrasPortada } from '../cifras';
import { datosNavegacion, comprable } from '../navegacion';
import { promoDeLaPagina } from '../promo-v2';
import { fotoDeCurso, type NombreFoto } from '../fotos';
import type { load } from '@/lib/page-loaders/country-home';
import '../estilos.css';
type Props = Exclude<Awaited<ReturnType<typeof load>>, Response>;
const { country, CATEGORIES, base, featured, posts, videos, title, description, allCourses } = Astro.props;

const db = (env as unknown as { SABLY_DB: D1Database }).SABLY_DB;
const moneda = await monedasCobradas(allCourses.map(c => c.id), country, Astro.locals);
const editorial = await getHomeEditorial({ name: country.name, currency: moneda });
const copy = Object.fromEntries(Object.entries(editorial).map(([key, value]) => [key, value.fields])) as { [K in keyof typeof editorial]: typeof editorial[K]['fields'] };
const faqs = editorial.faq.groups.map(group => ({ q: group.title, a: group.body }));
/* Los beneficios del CMS empiezan por un emoji («🎓 Título»): V2 no pinta emojis de interfaz, se queda el texto. */
const benefits = editorial.benefits.groups.map(group => { const [, ...t] = group.title.split(' '); return { title: t.join(' ') || group.title, text: group.body }; });
const [nav, promo, cifras, valoraciones, { ajustes }] = await Promise.all([
  datosNavegacion(country, Astro.locals),
  promoDeLaPagina(Astro, { pais: country.code }),
  cifrasPortada(Astro.locals),
  readOperationalRatings(db, Astro.locals).catch(() => ({} as Awaited<ReturnType<typeof readOperationalRatings>>)),
  temaDeLaPeticion(Astro),
]);
const portada = ajustes.portada;
/* Mosaico del héroe (D1): 10–12 cursos con inscripción abierta, uno por oficio, repartidos en tres celdas.
   El primero (la foto grande, LCP) es el mismo curso que antes iba en la tarjeta flotante cuando no se elige
   otro en el panel. Precio de cada tarjeta y de cada oficio: el mismo que su ficha da como precio a pagar hoy
   (src/lib/precio-hoy.ts), nunca la captura vieja ni el de catálogo. */
const enMosaico = inventarioMosaico(allCourses.map(c => ({
  id: c.id, destacado: Boolean(c.data.featured), valoraciones: valoraciones[c.id]?.total ?? 0, comprable: comprable(c), foto: fotoDeCurso(c.id, c.data.category),
})), portada.heroe.cursos).map(m => allCourses.find(c => c.id === m.id)!);
const conPrecio = [...new Map([...featured, ...enMosaico].map(c => [c.id, c])).values()];
const { precios, freshUntil } = await preciosDeTarjetas(conPrecio, country, { url: Astro.url, locals: Astro.locals });
const celdas: OficioMosaico[][] = repartirEnCeldas(enMosaico.map(c => ({
  id: c.id, titulo: c.data.title, foto: fotoDeCurso(c.id, c.data.category)!, precio: precios.get(c.id) ?? null, nota: notaHotmart(valoraciones[c.id] ?? null),
})));
/* Áreas: las seis primeras con foto grande y el resto como enlaces. */
const conFoto = nav.areas.slice(0, 6);
const resto = nav.areas.slice(6);
const externas = CATEGORIES.filter(c => c.externalUrl);
/* Oficio destacado: tres cursos destacados con nota publicada en Hotmart, cada uno con la foto de su área,
   sin repetir las tres que el mosaico enseña al cargar ni las de «Cómo funciona» y «Por qué Sably». */
const EN_HEROE = new Set<NombreFoto>([...celdas.map(c => c[0]!.foto), 'foto-heroe-1', 'foto-estudiar-celular-1', 'foto-estudiar-celular-2']);
const usadas = new Set<NombreFoto>(EN_HEROE);
const oficios = featured.filter(comprable).flatMap(c => {
  const foto = fotoDeCurso(c.id, c.data.category);
  if (!foto || usadas.has(foto)) return [];
  usadas.add(foto);
  return [{ c, nota: notaHotmart(valoraciones[c.id] ?? null), foto }];
}).slice(0, 3);
const guiasDestacadas = posts.slice(0, 3);
const masGuias = posts.slice(3);
---
<BaseLayout {title} {description} {country} pathAfterCountry="/" alternates={await countryAlternates('/')} schemas={[faqSchema(faqs)]} pageType="home" {freshUntil} temaV2>
  <Heroe textos={copy.hero} {base} locale={country.hreflang} areas={nav.areas} {celdas} rotacion={portada.heroe} />
  {portada.bloques.map(bloque => (
    bloque === 'cifras' ? <Cifras {cifras} {country} />
    : bloque === 'categorias' ? <Categorias copy={copy.categories} {base} {conFoto} {resto} {externas} total={nav.areas.length} />
    : bloque === 'destacados' ? <Destacados copy={copy.courses} {featured} {country} {precios} {base} {moneda} totalCursos={nav.totalCursos} />
    : bloque === 'promo' ? <BandaPromo {promo} {base} class="pt-20 lg:pt-24" />
    : bloque === 'oficio' ? <Oficio {oficios} {base} />
    : bloque === 'como-funciona' ? <ComoFunciona animado={portada.comoFuncionaAnimado} />
    : bloque === 'beneficios' ? <Beneficios copy={copy['benefits-heading']} {benefits} />
    : bloque === 'videos' ? <Videos {videos} />
    : bloque === 'guias' ? <Guias copy={copy.blog} {guiasDestacadas} {masGuias} />
    : bloque === 'preguntas' ? <Preguntas antetitulo={copy['faq-heading'].eyebrow} titulo={copy['faq-heading'].title} {faqs} whatsapp={nav.whatsapp} class="pt-24 lg:pt-32" />
    : bloque === 'cierre' ? <Cierre {base} totalCursos={nav.totalCursos} />
    : null
  ))}
</BaseLayout>

<style is:global>
  @layer components {
    [data-pie='completo'] { margin-top: 0; padding-top: 64px; }
  }
</style>
