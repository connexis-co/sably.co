---
/**
 * Páginas editoriales del CMS en V2 (/nosotros/, /contacto/, /legal/…, y las
 * páginas propias). Mismos schemas (BreadcrumbList + AboutPage, ContactPage o
 * WebPage), título y descripción que src/themes/sably-classic/layouts/Page.astro;
 * los bloques sably_* se pintan con BloquesPagina (aspecto V2).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import CmsRichBody from '@/components/CmsRichBody.astro';
import CabezaPagina from '../components/CabezaPagina.astro';
import BloquesPagina from '../components/BloquesPagina.astro';
import type { CmsPage, CmsCountry } from '@/lib/emdash-content';
import type { BlockValue } from 'emdash/ui';
import { breadcrumbSchema } from '@/lib/seo';
import { SITE } from '@/lib/site';
import '../estilos.css';
interface Props { page: CmsPage; country: CmsCountry }
const { page, country } = Astro.props;
Astro.locals.sablyContent = page.contentRef;
Astro.locals.sablySeo = page.seo;
const hasContact = page.layout.some(block => block._type === 'sably_contact');
const kind = hasContact ? 'ContactPage' : page.path === '/nosotros/' ? 'AboutPage' : 'WebPage';
const nombre = page.heroLabel || page.heroHeading;
const schemas = [breadcrumbSchema([{ name: 'Inicio', url: `${SITE.url}/${country.code}/` }, { name: nombre, url: new URL(page.path, SITE.url).href }]), { '@context': 'https://schema.org', '@type': kind, name: page.title, description: page.description, url: new URL(page.path, SITE.url).href, inLanguage: 'es', about: { '@id': `${SITE.url}/#organization` } }];
const migas = [{ name: 'Inicio', url: `/${country.code}/` }, { name: nombre, url: page.path }];
const legal = page.path.startsWith('/legal/');
---
<BaseLayout title={page.title} description={page.description} {country} {schemas} pageType="page" temaV2>
  <CabezaPagina titulo={page.heroHeading} antetitulo={page.heroLabel || undefined} entradilla={page.heroText || undefined} {migas} editarTitulo={page.edit.hero_heading} editarEntradilla={page.edit.hero_text} editarAntetitulo={page.edit.hero_label} clara={legal} />
  {page.layout.length
    ? <BloquesPagina value={page.layout as unknown as BlockValue[]} />
    : <section class="v2-contenedor py-12 lg:py-16" data-cms><div class="v2-prosa mx-auto max-w-[720px]"><CmsRichBody value={page.richBody ?? []} /></div></section>}
</BaseLayout>
