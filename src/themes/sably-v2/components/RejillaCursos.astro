---
/**
 * Rejilla de cursos V2 con orden y «Ver más» sin JavaScript (diseno/exportes/v2/
 * ZD0OZ, listado). El orden lo cambian tres radios con `:has()` y la propiedad
 * `order`; «Ver N cursos más» es una casilla. Todas las tarjetas están en el
 * HTML (los buscadores y los asistentes ven todos los enlaces). La franja de
 * promoción va después de la duodécima tarjeta (fila completa con 2, 3 o 4 columnas). Con `filtrable`, el campo de
 * búsqueda de la página filtra las tarjetas al escribir (~0,5 KB).
 * Movimiento (I1): cambiar el orden mantiene los mismos 24 visibles —los primeros de ese orden (`data-mas-nota`,
 * `data-mas-precio`)— y funde con una View Transition; «Ver más» hace aparecer las nuevas con un fundido corto y
 * lleva el foco a la primera; el filtro funde al escribir. Sin View Transitions o con `reduce`, el mismo cambio en seco.
 */
import TarjetaCurso from '@/components/v2/TarjetaCurso.astro';
import Ico from './Ico.astro';
import ContadorCampana from './ContadorCampana.astro';
import type { Course } from '@/lib/emdash-content';
import type { Country } from '@/lib/countries';
import type { PrecioTarjeta } from '@/lib/precio-tarjeta';
import type { PromoV2 } from '../promo-v2';
import { env } from 'virtual:sably-runtime';
import { readOperationalRatings } from '@/plugins/sably-operations/public';
import { fuenteDeNotas } from '@/lib/opiniones';
interface Props {
  id: string;
  cursos: Course[];
  country: Country;
  /** Orden por nota y por precio: posiciones ya calculadas por slug. */
  ordenNota: Map<string, number>;
  ordenPrecio: Map<string, number>;
  /** Precio de cada tarjeta, el mismo de su ficha (`preciosDeTarjetas`). */
  precios: Map<string, PrecioTarjeta | null>;
  /** Texto con el que se filtra cada tarjeta (título, área, palabras clave). */
  buscable: Map<string, string>;
  promo?: PromoV2 | null;
  base: string;
  visibles?: number;
  conOrden?: boolean;
  filtrable?: boolean;
}
const { id, cursos, country, ordenNota, ordenPrecio, precios, buscable, promo = null, base, visibles = 24, conOrden = true, filtrable = false } = Astro.props;
// Puesto de cada curso dentro de ESTA rejilla en cada orden (los mapas pueden venir del catálogo entero, como en
// las categorías): con él se marca qué tarjetas quedan tras «Ver más» al ordenar por nota o por precio.
const puestoLocal = (orden: Map<string, number>) => new Map(
  cursos.map((c, i) => [c.id, orden.get(c.id) ?? i] as const).sort((x, y) => x[1] - y[1]).map(([id], puesto) => [id, puesto]),
);
const puestoNota = puestoLocal(ordenNota);
const puestoPrecio = puestoLocal(ordenPrecio);
const ocultos = Math.max(0, cursos.length - visibles);
const conFranja = !!promo && cursos.length > 12;
/* Fuente y fecha de las notas, una vez para todo el listado (las tarjetas solo dicen «4,4 · 27»). */
const valoraciones = await readOperationalRatings((env as unknown as { SABLY_DB: D1Database }).SABLY_DB, Astro.locals).catch(() => ({} as Record<string, never>));
const fuenteNotas = fuenteDeNotas(cursos.map(c => valoraciones[c.id] ?? null));
---
<div class="v2-rejilla-raiz" data-rejilla={filtrable ? id : undefined}>
  {conOrden && cursos.length > 2 && (
    <fieldset class="v2-orden v2-fundido-x -mx-5 flex min-w-0 items-center gap-2 overflow-x-auto px-5 [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:px-0 sm:[mask-image:none] [&>label]:flex-none">
      <legend class="sr-only">Ordenar los cursos</legend>
      <span class="mr-1 flex items-center gap-1.5 text-t15 text-navy-500" aria-hidden="true"><Ico nombre="arrow-up-down" tamano={16} />Ordenar</span>
      <input type="radio" name={`${id}-orden`} id={`${id}-rec`} value="rec" checked class="peer/rec sr-only" /><label for={`${id}-rec`} class="v2-chip">Recomendados</label>
      <input type="radio" name={`${id}-orden`} id={`${id}-nota`} value="nota" class="sr-only" /><label for={`${id}-nota`} class="v2-chip">Mejor calificados en Hotmart</label>
      <input type="radio" name={`${id}-orden`} id={`${id}-precio`} value="precio" class="sr-only" /><label for={`${id}-precio`} class="v2-chip">Precio más bajo</label>
    </fieldset>
  )}
  <ul class="v2-rejilla mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" role="list" id={id}>
    {cursos.map((course, i) => (
      <li class="v2-celda" style={`--o-rec:${i * 2};--o-nota:${(ordenNota.get(course.id) ?? i) * 2};--o-precio:${(ordenPrecio.get(course.id) ?? i) * 2}`} data-mas={i >= visibles ? '' : undefined} data-mas-nota={puestoNota.get(course.id)! >= visibles ? '' : undefined} data-mas-precio={puestoPrecio.get(course.id)! >= visibles ? '' : undefined} data-buscar={filtrable ? buscable.get(course.id) : undefined}>
        <TarjetaCurso {course} {country} precio={precios.get(course.id) ?? null} filaEnMovil />
      </li>
    ))}
    {conFranja && promo && (
      <li class="v2-franja col-span-full" data-promo-v2="franja" data-promo-ssr={promo.ssr} style="--o-rec:23;--o-nota:23;--o-precio:23">
        <div class="flex flex-wrap items-center gap-x-8 gap-y-3 rounded-c-lg bg-coral-50 px-6 py-5 ring-1 ring-coral-100">
          <p class="font-display text-d40 font-semibold text-coral-600"><span data-promo-pct-v2>{promo.pct} %</span></p>
          <div class="min-w-0 flex-1">
            <p class="text-t17 font-semibold text-navy-950">{(promo.muestra.listado === 'cupon' || promo.muestra.listado === 'ambos') ? <>Con el cupón <span data-promo-codigo>{promo.cupon}</span>, en cursos seleccionados</> : 'En cursos seleccionados: el precio de cada ficha ya lleva el descuento'}</p>
            {(promo.muestra.listado === 'contador' || promo.muestra.listado === 'ambos') && promo.finMs ? <p class="mt-2 flex flex-wrap items-center gap-2.5 text-t13 text-navy-500">Termina en <ContadorCampana finMs={promo.finMs} fin={promo.fin} tono="claro" /></p> : promo.fin && <p data-promo-fin class="text-t13 text-navy-500">Hasta el <span data-promo-fecha>{promo.fin}</span> (hora de Colombia). El precio de cada ficha ya lo indica.</p>}
          </div>
          {(promo.muestra.listado === 'cupon' || promo.muestra.listado === 'ambos') && (
            <button type="button" data-promo-cupon class="v2-tique-mini bg-white" aria-label={`Copiar el cupón ${promo.cupon}`}>
              <span class="v2-num font-semibold tracking-wide" data-promo-codigo>{promo.cupon}</span>
              <span class="gap-1 font-semibold text-coral-700"><Ico nombre="copy" tamano={14} /><span data-promo-copiar-texto>Copiar</span></span>
            </button>
          )}
        </div>
      </li>
    )}
  </ul>
  {fuenteNotas && <p class="v2-rejilla-fuente mt-6 max-w-[720px] text-t13 text-navy-500">{fuenteNotas}</p>}
  {filtrable && <p class="py-10 text-t17 text-navy-700" data-rejilla-vacia hidden>Ningún curso de esta lista coincide con «<span data-rejilla-termino></span>». <a href={`${base}/cursos/`} class="font-semibold text-navy-950 underline underline-offset-4">Ver todos los cursos</a></p>}
  {ocultos > 0 && (
    <div class="v2-ver-mas mt-10 flex flex-col items-center gap-3">
      <p class="text-t15 text-navy-500">Has visto {visibles} de {cursos.length} cursos</p>
      <span class="h-1 w-40 overflow-hidden rounded-full bg-navy-100" aria-hidden="true"><span class="block h-full rounded-full bg-navy-950" style={`width:${Math.round(visibles / cursos.length * 100)}%`}></span></span>
      <input type="checkbox" id={`${id}-mas`} class="peer sr-only" />
      <label for={`${id}-mas`} class="v2-btn v2-btn-secundario max-sm:w-full" data-alto="52">Ver {ocultos} cursos más</label>
    </div>
  )}
</div>

<script>
  type ConTransicion = Document & { startViewTransition?: (f: () => void) => { skipTransition(): void; finished: Promise<void> } };
  const reducido = matchMedia('(prefers-reduced-motion: reduce)');
  let enCurso: { skipTransition(): void } | null = null;
  // Cambio de contenido con fundido: View Transition donde exista y sin `reduce`; si no, en seco.
  const suave = (fn: () => void) => {
    const d = document as ConTransicion;
    if (!d.startViewTransition || reducido.matches) { fn(); return; }
    enCurso?.skipTransition();
    const t = d.startViewTransition(fn);
    enCurso = t;
    t.finished.finally(() => { if (enCurso === t) enCurso = null; });
  };
  const ordenVisual = (li: HTMLElement) => Number(getComputedStyle(li).order) || 0;
  document.querySelectorAll<HTMLElement>('.v2-rejilla-raiz').forEach(raiz => {
    // Orden: el clic se anula y se repite dentro de la transición, para que funda el antes y el después.
    const radios = [...raiz.querySelectorAll<HTMLInputElement>('.v2-orden input[type="radio"]')];
    let actual = radios.find(r => r.checked) ?? null;
    for (const r of radios) r.addEventListener('click', (e) => {
      if (r === actual) return;
      e.preventDefault();
      suave(() => { r.checked = true; actual = r; });
    });
    // «Ver más»: el foco pasa a la primera tarjeta nueva (el botón desaparece al pulsarlo).
    const mas = raiz.querySelector<HTMLInputElement>('.v2-ver-mas input[type="checkbox"]');
    mas?.addEventListener('change', () => {
      if (!mas.checked) return;
      const attr = actual?.value === 'nota' ? 'data-mas-nota' : actual?.value === 'precio' ? 'data-mas-precio' : 'data-mas';
      const nuevas = [...raiz.querySelectorAll<HTMLElement>(`.v2-rejilla > li[${attr}]:not([hidden])`)].sort((a, b) => ordenVisual(a) - ordenVisual(b));
      nuevas[0]?.querySelector<HTMLAnchorElement>('a[href]')?.focus();
    });
    // Filtro al escribir: oculta las tarjetas que no coinciden. Sin JavaScript, el formulario GET filtra en el servidor.
    if (!raiz.dataset.rejilla) return;
    const campo = document.querySelector<HTMLInputElement>(`[data-filtra="${raiz.dataset.rejilla}"]`);
    if (!campo) return;
    const celdas = [...raiz.querySelectorAll<HTMLElement>('[data-buscar]')];
    const vacia = raiz.querySelector<HTMLElement>('[data-rejilla-vacia]');
    const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    let ultimo = '';
    const filtrar = () => {
      const q = norm(campo.value.trim());
      const terminos = q.split(/\s+/).filter(Boolean);
      let n = 0;
      for (const c of celdas) { const ok = q.length < 2 || terminos.every(t => c.dataset.buscar!.includes(t)); c.hidden = !ok; if (ok) n++; }
      raiz.toggleAttribute('data-filtrando', q.length >= 2);
      if (vacia) { vacia.hidden = n > 0; vacia.querySelector('[data-rejilla-termino]')!.textContent = campo.value.trim(); }
    };
    // Solo funde cuando cambia el resultado efectivo (≥ 2 letras), no en cada tecla que no filtra.
    campo.addEventListener('input', () => {
      const q = norm(campo.value.trim());
      const clave = q.length < 2 ? '' : q;
      if (clave === ultimo) { filtrar(); return; }
      ultimo = clave;
      suave(filtrar);
    });
    ultimo = norm(campo.value.trim()).length < 2 ? '' : norm(campo.value.trim());
    filtrar();
  });
</script>

<style is:global>
  @layer components {
    .v2-rejilla > li { order: var(--o-rec); }
    .v2-rejilla-raiz:has(input[value='nota']:checked) .v2-rejilla > li { order: var(--o-nota); }
    .v2-rejilla-raiz:has(input[value='precio']:checked) .v2-rejilla > li { order: var(--o-precio); }
    /* «Ver más»: ocultos hasta marcar la casilla; con otro orden o filtrando se ven todos. */
    /* «Ver más»: con cada orden se ven sus primeros `visibles` (data-mas, -nota, -precio); con la casilla
       marcada o filtrando, todas. Cambiar el orden ya no despliega las 120 de golpe. */
    .v2-rejilla > li[data-mas] { display: none; }
    .v2-rejilla-raiz:has(input[value='nota']:checked) .v2-rejilla > li[data-mas],
    .v2-rejilla-raiz:has(input[value='precio']:checked) .v2-rejilla > li[data-mas] { display: list-item; }
    .v2-rejilla-raiz:has(input[value='nota']:checked) .v2-rejilla > li[data-mas-nota],
    .v2-rejilla-raiz:has(input[value='precio']:checked) .v2-rejilla > li[data-mas-precio] { display: none; }
    .v2-rejilla-raiz:has(.v2-ver-mas input:checked) .v2-rejilla > li:is([data-mas], [data-mas-nota], [data-mas-precio]),
    .v2-rejilla-raiz[data-filtrando] .v2-rejilla > li:is([data-mas], [data-mas-nota], [data-mas-precio]) { display: list-item; }
    .v2-rejilla > li[hidden] { display: none !important; }
    .v2-rejilla-raiz:has(.v2-ver-mas input:checked) .v2-ver-mas,
    .v2-rejilla-raiz[data-filtrando] :is(.v2-ver-mas, .v2-franja) { display: none; }
    @supports not selector(:has(*)) { .v2-rejilla > li:is([data-mas], [data-mas-nota], [data-mas-precio]) { display: list-item; } .v2-ver-mas, .v2-orden { display: none; } }
    .v2-orden input:checked + label { background: var(--color-navy-950); color: #fff; box-shadow: none; font-weight: 600; }
    .v2-orden input:focus-visible + label { outline: 3px solid var(--color-coral-600); outline-offset: 2px; }
    .v2-ver-mas input:focus-visible + label { outline: 3px solid var(--color-coral-600); outline-offset: 3px; }
  }
  /* Las tarjetas que «Ver más» descubre entran con un fundido corto (solo opacidad y desplazamiento). */
  @media (prefers-reduced-motion: no-preference) {
    .v2-rejilla-raiz:has(.v2-ver-mas input:checked) .v2-rejilla > li:is([data-mas], [data-mas-nota], [data-mas-precio]) {
      transition: opacity var(--t-base) var(--e-sale), translate var(--t-base) var(--e-sale);
    }
    @starting-style {
      .v2-rejilla-raiz:has(.v2-ver-mas input:checked) .v2-rejilla > li:is([data-mas], [data-mas-nota], [data-mas-precio]) { opacity: 0; translate: 0 8px; }
    }
  }
  /* Móvil: la tarjeta pasa a fila (`filaEnMovil` del kit); aquí solo el separador entre filas. */
    @media (width < 640px) {
      .v2-rejilla { gap: 0; }
      .v2-rejilla > li.v2-celda { border-bottom: 1px solid var(--color-navy-100); }
      .v2-franja { margin: 16px 0; }
    }
</style>
