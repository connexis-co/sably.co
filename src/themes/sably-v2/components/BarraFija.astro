---
/**
 * Aparece cuando el botón de la caja sale de la pantalla y se va al volver o al
 * llegar al cierre. En móvil, dos piezas: pestañas de secciones de 48 px bajo la
 * cabecera y barra inferior de 72 px (precio, WhatsApp e «Inscribirme»); en
 * escritorio, una sola subnavegación bajo la cabecera con las secciones, el
 * precio y el botón. El precio y el enlace los actualiza la caja
 * al quitar o reaplicar el cupón (data-pago, data-precio-fijo).
 */
import Boton from '@/components/v2/Boton.astro';
import type { Importe } from '@/lib/presentacion-v2';
interface Props {
  secciones: { id: string; etiqueta: string }[];
  precio: Importe | null;
  moneda: string;
  nota: string;
  href: string;
  boton: string;
  whatsapp: string;
}
const { secciones, precio, moneda, nota, href, boton, whatsapp } = Astro.props;
---
<div class="v2-fija" data-barra-fija data-oculta inert>
  <div class="v2-contenedor v2-fija-fila">
    <nav aria-label="Secciones de la ficha" class="v2-fija-nav">
      <ul class="v2-fija-lista">
        {secciones.map(s => <li class="flex-none"><a href={`#${s.id}`} data-subnav={s.id} class="v2-fija-pestana">{s.etiqueta}</a></li>)}
      </ul>
    </nav>
    <div class="v2-fija-compra">
      {precio && (
        <p class="min-w-0 lg:text-right">
          <span class="v2-num block font-display text-t20 leading-tight font-semibold whitespace-nowrap text-navy-950"><span aria-hidden="true"><span data-precio-fijo>{precio.visible}</span> <span class="text-t13 font-medium">{moneda}</span></span><span class="sr-only" data-precio-fijo-hablado>{precio.hablado}</span></span>
          <span class="block text-t13 text-navy-500" data-precio-fijo-nota>{nota}</span>
        </p>
      )}
      <a href={whatsapp} target="_blank" rel="noopener nofollow" class="ml-auto grid size-12 flex-none place-items-center rounded-full bg-white ring-1 ring-navy-100 lg:hidden" aria-label="Escríbenos por WhatsApp"><img src="/v2/logos/whatsapp.svg" alt="" width="24" height="24" /></a>
      <Boton variante="principal" alto={48} href={href} target="_blank" rel="noopener nofollow sponsored" data-cta-hotmart data-cta-position="barra" data-pago class="flex-none">{boton}</Boton>
    </div>
  </div>
</div>
<style>
  /* Móvil: dos piezas fijas e independientes. Las pestañas cuelgan bajo la cabecera
     (56 px) y la barra de compra va abajo (72 px); no se pisan. El contenedor
     no pinta nada (display: contents) para que `position: fixed` no dependa de un
     ancestro con transform. */
  .v2-fija, .v2-fija-fila { display: contents; }
  .v2-fija-nav {
    position: fixed; inset: 56px 0 auto 0; z-index: 39; height: 48px; background: #fff;
    box-shadow: inset 0 -1px 0 var(--color-navy-100), 0 12px 24px -16px rgb(27 27 58 / 0.22);
    translate: 0 -100%; visibility: hidden;
    transition: translate var(--t-base) var(--e-sale), visibility 0s linear var(--t-base);
  }
  .v2-fija:not([data-oculta]) .v2-fija-nav { translate: 0 0; visibility: visible; transition-delay: 0s; }
  .v2-fija-lista {
    display: flex; gap: 8px; height: 100%; padding-inline: 12px 20px; margin: 0; list-style: none;
    overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .v2-fija-lista::-webkit-scrollbar { display: none; }
  .v2-fija-pestana {
    display: flex; height: 100%; align-items: center; padding-inline: 8px; white-space: nowrap;
    border-bottom: 3px solid transparent; font-size: var(--text-t15); font-weight: 500; color: var(--color-navy-700);
    transition: color var(--t-rapido) ease, border-color var(--t-rapido) ease;
  }
  .v2-fija-pestana:focus-visible { outline: 3px solid var(--color-coral-600); outline-offset: -3px; border-radius: 4px; }
  .v2-fija-pestana[aria-current='true'] { color: var(--color-navy-950); border-color: var(--color-coral-600); font-weight: 600; }
  .v2-fija-compra {
    position: fixed; inset: auto 0 0 0; z-index: 40; height: 72px; padding-inline: 20px; display: flex; align-items: center; gap: 16px;
    background: #fff; box-shadow: 0 -24px 56px -12px rgb(27 27 58 / 0.3);
    translate: 0 100%; visibility: hidden;
    transition: translate var(--t-base) var(--e-sale), visibility 0s linear var(--t-base);
  }
  .v2-fija:not([data-oculta]) .v2-fija-compra { translate: 0 0; visibility: visible; transition-delay: 0s; }
  @media (prefers-reduced-motion: reduce) {
    .v2-fija-nav, .v2-fija-compra, .v2-fija-pestana { transition: none; }
  }
  @media (width >= 1024px) {
    .v2-fija {
      display: block; position: fixed; inset: 60px 0 auto 0; z-index: 45; background: #fff; box-shadow: var(--shadow-s2); border-top: 1px solid var(--color-navy-100);
      translate: 0 -100%; visibility: hidden;
      transition: translate var(--t-base) var(--e-sale), visibility 0s linear var(--t-base);
    }
    .v2-fija:not([data-oculta]) { translate: 0 0; visibility: visible; transition-delay: 0s; }
    .v2-fija-fila { display: flex; height: 64px; align-items: center; gap: 16px; }
    .v2-fija-nav { position: static; z-index: auto; height: auto; min-width: 0; flex: 1; background: none; box-shadow: none; translate: none; visibility: visible; transition: none; }
    .v2-fija-lista { gap: 28px; padding-inline: 0; }
    .v2-fija-pestana { padding: 20px 0; font-size: 15px; }
    .v2-fija-compra { display: contents; }
  }
</style>
<script>
  const barra = document.querySelector<HTMLElement>('div[data-barra-fija]');
  const boton = document.querySelector('#compra a[data-pago]');
  const cierre = document.querySelector('[data-cierre]');
  if (barra && boton) {
    let fueraCaja = false, enCierre = false;
    const actualizar = () => {
      const visible = fueraCaja && !enCierre;
      barra.toggleAttribute('data-oculta', !visible);
      barra.inert = !visible;
      document.body.toggleAttribute('data-con-barra', visible);
    };
    new IntersectionObserver(([e]) => { fueraCaja = !e!.isIntersecting && e!.boundingClientRect.top < 0; actualizar(); }).observe(boton);
    if (cierre) new IntersectionObserver(([e]) => { enCierre = e!.isIntersecting; actualizar(); }).observe(cierre);
    // La pestaña activa sigue a la sección en lectura.
    const reducido = matchMedia('(prefers-reduced-motion: reduce)');
    const enlaces = [...barra.querySelectorAll<HTMLAnchorElement>('[data-subnav]')];
    const secciones = enlaces.map(a => document.getElementById(a.dataset.subnav!)).filter(Boolean) as HTMLElement[];
    // La pestaña activa se desliza a la vista, centrada, sin mover la página en vertical.
    const mostrarActiva = () => {
      const activa = enlaces.find(a => a.getAttribute('aria-current') === 'true');
      activa?.scrollIntoView({ inline: 'center', block: 'nearest', behavior: reducido.matches ? 'auto' : 'smooth' });
    };
    const observador = new IntersectionObserver(entradas => {
      let cambio = false;
      for (const e of entradas) if (e.isIntersecting) { cambio = true; enlaces.forEach(a => a.setAttribute('aria-current', String(a.dataset.subnav === e.target.id))); }
      if (cambio && !barra.hasAttribute('data-oculta')) mostrarActiva();
    }, { rootMargin: '-140px 0px -60% 0px' });
    new MutationObserver(() => { if (!barra.hasAttribute('data-oculta')) mostrarActiva(); }).observe(barra, { attributes: true, attributeFilter: ['data-oculta'] });
    secciones.forEach(s => observador.observe(s));
  }
</script>
