---
/**
 * «Guías para seguir aprendiendo» de la ficha (C8 del pulido de JP): las tarjetas de guía del blog, con foto (la
 * propia de la guía o la de su categoría), categoría, título, resumen, minutos de lectura y «Escúchalo · N min» solo
 * si la guía tiene narración publicada. Se ve bien con una, dos o tres guías (`relatedGuides` da tres como máximo):
 * una sola va en horizontal a lo ancho; dos o tres, en columnas. En el celular, una guía va con la foto arriba y
 * varias pasan a filas con miniatura, para no alargar la ficha. Todo el texto en el HTML; 0 KB de JavaScript.
 * Estilos propios (la hoja del blog no se carga en la ficha).
 */
import { Image as OptimizedImage } from 'astro:assets';
import { cmsImageUrl } from '@/lib/cms-media';
import { blogCover, minutosLectura } from '@/lib/blog';
import { richText } from '@/lib/rich-content';
import { duracionesNarradas } from '@/lib/narracion';
import type { BlogPost } from '@/lib/emdash-content';
import Ico from './Ico.astro';
interface Props { guias: BlogPost[]; aparece?: string }
const { guias, aparece } = Astro.props;
const narradas = guias.length ? await duracionesNarradas('blog') : new Map<string, number>();
const tarjetas = guias.map(post => {
  const segundos = narradas.get(post.id);
  return {
    post,
    foto: cmsImageUrl(post.cardImage) ?? cmsImageUrl(post.coverImage) ?? blogCover(post.data.category, 'card'),
    minutos: minutosLectura(post.richBody ? richText(post.richBody) : post.body ?? ''),
    escuchar: segundos ? `Escúchalo · ${Math.max(1, Math.round(segundos / 60))} min` : null,
  };
});
---
{tarjetas.length > 0 && (
  <section class="py-16 lg:py-24" aria-labelledby="titulo-guias" data-aparece={aparece} data-guias-ficha>
    <div class="v2-contenedor">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="titulo-guias" class="font-display text-d28 lg:text-d40">Guías para seguir aprendiendo</h2>
          <p class="mt-3 max-w-2xl text-t15 text-navy-700">Del blog de Sably, gratis y sin registro.</p>
        </div>
        <a href="/blog/" class="v2-enlace">Ver todas las guías <Ico nombre="arrow-right" tamano={16} class="v2-flecha" /></a>
      </div>
      <ul class="v2-guias mt-8" data-cuantas={tarjetas.length} role="list">
        {tarjetas.map(({ post, foto, minutos, escuchar }) => (
          <li class="min-w-0">
            <a href={`/blog/${post.id}/`} class="v2-guia group">
              <span class="v2-guia-foto">
                <OptimizedImage src={foto} alt="" width={640} height={400} loading="lazy" decoding="async" sizes="(min-width: 1024px) 560px, (min-width: 640px) 50vw, 112px" />
                {escuchar && <span class="v2-guia-narrada v2-guia-narrada-foto"><Ico nombre="headphones" tamano={14} />{escuchar}</span>}
              </span>
              <span class="v2-guia-cuerpo">
                <span class="v2-guia-cat">{post.data.category ?? 'Guía'}</span>
                <h3 class="v2-guia-titulo">{post.data.title}</h3>
                {post.data.description && <span class="v2-guia-resumen">{post.data.description}</span>}
                <span class="v2-guia-datos">{minutos} min de lectura{escuchar && <span class="v2-guia-narrada v2-guia-narrada-linea"><Ico nombre="headphones" tamano={14} />{escuchar}</span>}</span>
                <span class="v2-guia-mas" aria-hidden="true">Leer la guía <Ico nombre="arrow-right" tamano={16} class="v2-flecha" /></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
  .v2-guias { display: grid; gap: 24px; margin: 0; padding: 0; list-style: none; }
  .v2-guia {
    position: relative; display: flex; flex-direction: column; height: 100%; overflow: hidden; border-radius: var(--radius-c-lg);
    background: #fff; color: var(--color-navy-950); text-decoration: none; box-shadow: 0 0 0 1px var(--color-navy-100);
    transition: box-shadow var(--t-base) var(--e-sale);
  }
  .v2-guia:focus-visible { outline: 3px solid var(--color-coral-600); outline-offset: 3px; }
  .v2-guia-foto { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--color-navy-50); }
  .v2-guia-foto :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; transition: scale var(--t-lento) var(--e-sale); }
  .v2-guia-cuerpo { display: flex; flex: 1; flex-direction: column; gap: 8px; padding: 20px 24px 24px; }
  .v2-guia-cat { font: 600 13px/18px var(--font-sans); color: var(--color-coral-700); }
  .v2-guia-titulo { font: 600 20px/27px var(--font-display); color: var(--color-navy-950); text-wrap: balance; }
  .v2-guia-resumen { font-size: 15px; line-height: 22px; color: var(--color-navy-700); }
  /* En columnas, tres líneas para que las tarjetas queden parejas; una sola guía tiene sitio para el resumen entero. */
  .v2-guias:not([data-cuantas='1']) .v2-guia-resumen { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .v2-guia-datos { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; font-size: 13px; line-height: 20px; color: var(--color-navy-500); }
  .v2-guia-mas { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 8px; font: 600 15px/22px var(--font-sans); color: var(--color-navy-950); }
  .v2-guia-narrada {
    display: inline-flex; align-items: center; gap: 6px; min-height: 24px; padding: 0 10px; border-radius: 99px;
    background: var(--color-coral-50, #fdf0f3); color: var(--color-coral-700); font: 600 12px/16px var(--font-sans); white-space: nowrap;
  }
  .v2-guia-narrada-foto { position: absolute; left: 12px; bottom: 12px; }
  .v2-guia-narrada-linea { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .v2-guia:hover { box-shadow: var(--shadow-s2); }
    .v2-guia:hover .v2-guia-foto :global(img) { scale: 1.03; }
    .v2-guia:hover :global(.v2-flecha) { translate: 3px 0; }
  }
  @media (prefers-reduced-motion: reduce) { .v2-guia, .v2-guia-foto :global(img) { transition: none; } .v2-guia:hover .v2-guia-foto :global(img) { scale: none; } }

  /* Celular con varias guías: filas con miniatura, sin resumen; el distintivo de audio pasa a la línea de datos. */
  @media (width < 640px) {
    .v2-guias:not([data-cuantas='1']) { gap: 0; border-block: 1px solid var(--color-navy-100); }
    .v2-guias:not([data-cuantas='1']) li + li { border-top: 1px solid var(--color-navy-100); }
    .v2-guias:not([data-cuantas='1']) .v2-guia { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 14px; padding: 16px 0; border-radius: 0; box-shadow: none; background: transparent; }
    .v2-guias:not([data-cuantas='1']) .v2-guia-foto { align-self: start; border-radius: 12px; }
    .v2-guias:not([data-cuantas='1']) .v2-guia-cuerpo { gap: 4px; padding: 0; }
    .v2-guias:not([data-cuantas='1']) .v2-guia-titulo { font-size: 17px; line-height: 23px; }
    .v2-guias:not([data-cuantas='1']) :is(.v2-guia-resumen, .v2-guia-mas, .v2-guia-narrada-foto) { display: none; }
    .v2-guias:not([data-cuantas='1']) .v2-guia-narrada-linea { display: inline-flex; }
  }
  @media (width >= 640px) {
    .v2-guias[data-cuantas='2'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .v2-guias[data-cuantas='3'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* Una sola guía: horizontal y a lo ancho (foto a la izquierda), sin el hueco de media rejilla vacía. */
    .v2-guias[data-cuantas='1'] .v2-guia { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); }
    .v2-guias[data-cuantas='1'] .v2-guia-foto { aspect-ratio: auto; min-height: 260px; }
    .v2-guias[data-cuantas='1'] .v2-guia-cuerpo { justify-content: center; padding: 32px 40px; }
    .v2-guias[data-cuantas='1'] .v2-guia-titulo { font-size: 28px; line-height: 34px; }
  }
  @media (width >= 1024px) {
    .v2-guias[data-cuantas='3'] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .v2-guias[data-cuantas='1'] .v2-guia-foto { min-height: 320px; }
    .v2-guias[data-cuantas='1'] .v2-guia-cuerpo { padding: 48px 56px; }
  }
  /* Tres guías a 640–1023: la tercera ocupa la fila entera en horizontal, no deja media fila vacía. */
  @media (640px <= width < 1024px) {
    .v2-guias[data-cuantas='3'] li:last-child { grid-column: 1 / -1; }
    .v2-guias[data-cuantas='3'] li:last-child .v2-guia { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .v2-guias[data-cuantas='3'] li:last-child .v2-guia-foto { aspect-ratio: auto; min-height: 220px; }
  }
</style>
