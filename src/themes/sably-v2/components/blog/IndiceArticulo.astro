---
/**
 * Índice del artículo (DISENO §4.4 y §12.8). Los enlaces salen del servidor (ids de los encabezados) y el script
 * del artículo marca el apartado activo con aria-current="location". Estilos:
 *   lateral   → carril derecho con cabeza «En este artículo», porcentaje leído e indicador coral que se desliza
 *   plegable  → <details> cerrado al inicio del texto (la lista sigue en el HTML)
 *   abierto   → <details open>
 *   tarjeta   → tarjeta navy-50 numerada, siempre abierta
 */
import Ico from '../Ico.astro';
import type { Apartado } from '@/lib/blog';
interface Props { apartados: Apartado[]; estilo: 'lateral' | 'plegable' | 'abierto' | 'tarjeta'; solo?: 'escritorio' | 'movil'; porcentaje?: boolean; movil?: boolean }
const { apartados, estilo, solo, porcentaje = true, movil = false } = Astro.props;
const principales = apartados.filter(a => a.depth === 2).length || apartados.length;
---
{estilo === 'lateral' && (
  <nav class="v2-indice-lateral" aria-labelledby="indice-lateral-titulo" data-indice-lateral data-indice-solo={solo}>
    <p class="v2-il-cabeza"><span id="indice-lateral-titulo">En este artículo</span>{porcentaje && <span data-porcentaje aria-hidden="true">0 %</span>}</p>
    <ol class="v2-indice-lista" role="list">{apartados.map(a => <li data-nivel={a.depth}><a href={`#${a.slug}`} data-indice-enlace={a.slug}>{a.text}</a></li>)}<span data-indicador aria-hidden="true"></span></ol>
    <a href="#main" class="v2-il-subir"><Ico nombre="arrow-up" tamano={16} />Volver arriba</a>
  </nav>
)}
{(estilo === 'plegable' || estilo === 'abierto') && (
  <details class="v2-indice-inicio" open={estilo === 'abierto' || undefined} data-indice-inicio={movil || undefined} data-indice-solo={solo}>
    <summary><Ico nombre="list" tamano={18} /><span>En este artículo · {principales} {principales === 1 ? 'apartado' : 'apartados'}</span><Ico nombre="chevron-down" tamano={20} class="v2-giro" /></summary>
    <nav aria-label="En este artículo"><ol class="v2-indice-lista" role="list">{apartados.map(a => <li data-nivel={a.depth}><a href={`#${a.slug}`}>{a.text}</a></li>)}</ol></nav>
  </details>
)}
{estilo === 'tarjeta' && (
  <nav class="v2-indice-inicio" data-estilo="tarjeta" aria-labelledby="indice-tarjeta-titulo" data-indice-inicio={movil || undefined} data-indice-solo={solo}>
    <p id="indice-tarjeta-titulo">En este artículo</p>
    <ol class="v2-indice-lista" role="list">{apartados.map(a => <li data-nivel={a.depth}><a href={`#${a.slug}`}>{a.text}</a></li>)}</ol>
  </nav>
)}
