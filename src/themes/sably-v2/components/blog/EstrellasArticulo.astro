---
/**
 * Estrellas bajo el título del artículo (DISENO §12.2; pedido de JP del 26-nov).
 * - Con media publicable (≥ 5 votos de ≥ 5 personas): la media real y «· N valoraciones», enlace al bloque de cierre.
 * - Sin ella: cinco estrellas que se pulsan aquí mismo y «Puntúa este artículo». Al pasar se llenan hasta la elegida;
 *   al puntuar dan un pequeño salto en cadena y queda «Gracias · tu nota: 4». Si ya votaste, se ve tu nota.
 *   Una sola invitación al cargar (ola suave) y nada de movimiento con «reducir movimiento». Solo transform y opacity.
 * Horneado en el HTML con su alto fijo (sin CLS). Nada de esto va al JSON-LD.
 */
import Estrellas from '@/components/v2/Estrellas.astro';
import { notaCorta, type PulsoArticulo } from '@/lib/blog-pulso';
interface Props { pulso?: PulsoArticulo; slug: string }
const { pulso: p, slug } = Astro.props;
const con = p?.publicable && p.media !== null;
const ROTULOS = ['Nada útil', 'Poco útil', 'Útil a medias', 'Útil', 'Muy útil'];
const d = 'M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z';
---
{con ? (
  <a href="#valorar" class="v2-ba-estrellas" aria-label={`Valoración media ${notaCorta(p!.media!)} de 5, ${p!.votos} valoraciones. Ir a valorar`}>
    <Estrellas nota={p!.media!} tamano={16} />
    <span><b>{notaCorta(p!.media!)}</b> · {p!.votos} valoraciones</span>
  </a>
) : (
  <div class="v2-ba-estrellas v2-ba-puntuar" data-puntuar={slug}>
    <span class="v2-bp-estrellas" role="radiogroup" aria-labelledby="puntuar-rotulo">
      {ROTULOS.map((r, i) => (
        <button type="button" role="radio" aria-checked="false" tabindex={i === 0 ? 0 : -1} data-estrella={i + 1} aria-label={`${i + 1} de 5 · ${r}`} style={`--i:${i}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={d} /></svg>
        </button>
      ))}
    </span>
    <span class="v2-bp-rotulo" id="puntuar-rotulo" data-puntuar-rotulo>Puntúa este artículo</span>
    <span class="sr-only" role="status" aria-live="polite" data-puntuar-estado></span>
  </div>
)}
{!con && (
  <script>
    import { enviarVoto, votoGuardado, EVENTO_VOTO, ROTULOS } from './votar';
    const raiz = document.querySelector<HTMLElement>('[data-puntuar]');
    if (raiz) {
      const slug = raiz.dataset.puntuar!;
      const botones = [...raiz.querySelectorAll<HTMLButtonElement>('[data-estrella]')];
      const rotulo = raiz.querySelector<HTMLElement>('[data-puntuar-rotulo]')!;
      const estado = raiz.querySelector<HTMLElement>('[data-puntuar-estado]')!;
      const base = 'Puntúa este artículo';
      let nota = votoGuardado(slug);
      const texto = () => (nota ? `Tu nota: ${nota} de 5` : base);
      const pintar = (n: number, foco = false) => botones.forEach((b, i) => {
        b.toggleAttribute('data-llena', i < n);
        b.setAttribute('aria-checked', String(i + 1 === n));
        b.tabIndex = (n ? i + 1 === n : i === 0) ? 0 : -1;
        if (foco && i + 1 === n) b.focus();
      });
      const saltar = () => {
        raiz.removeAttribute('data-salto');
        void raiz.offsetWidth; // reinicia la animación si se vuelve a puntuar
        raiz.setAttribute('data-salto', '');
      };
      const poner = (n: number) => { nota = n; pintar(n); rotulo.textContent = texto(); raiz.toggleAttribute('data-votado', n > 0); };
      poner(nota);
      // Una sola invitación al cargar, si aún no has votado (el CSS la anula con «reducir movimiento»).
      if (!nota) setTimeout(() => raiz.setAttribute('data-invita', ''), 1200);
      botones.forEach((b, i) => {
        b.addEventListener('click', async () => {
          const n = i + 1;
          pintar(n); rotulo.textContent = 'Guardando…';
          try {
            await enviarVoto(slug, n, 'cabecera');
            poner(n); rotulo.textContent = `Gracias · tu nota: ${n} de 5`; estado.textContent = `Valoración guardada: ${n} de 5.`; saltar();
          } catch (e) { pintar(nota); rotulo.textContent = (e as Error).message; estado.textContent = (e as Error).message; }
        });
        b.addEventListener('mouseenter', () => { raiz.setAttribute('data-vista', String(i + 1)); rotulo.textContent = ROTULOS[i]!; });
        b.addEventListener('focus', () => { rotulo.textContent = ROTULOS[i]!; });
        b.addEventListener('keydown', e => {
          const paso = e.key === 'ArrowRight' || e.key === 'ArrowUp' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowDown' ? -1 : 0;
          if (paso) { e.preventDefault(); const n = Math.min(5, Math.max(1, i + 1 + paso)); pintar(n, true); rotulo.textContent = ROTULOS[n - 1]!; }
        });
      });
      raiz.addEventListener('mouseleave', () => { raiz.removeAttribute('data-vista'); rotulo.textContent = texto(); });
      raiz.addEventListener('focusout', e => { if (!raiz.contains(e.relatedTarget as Node)) { pintar(nota); rotulo.textContent = texto(); } });
      document.addEventListener(EVENTO_VOTO, e => {
        const v = (e as CustomEvent<{ slug: string; n: number; origen: string }>).detail;
        if (v.slug === slug && v.origen !== 'cabecera') { poner(v.n); saltar(); }
      });
    }
  </script>
)}
