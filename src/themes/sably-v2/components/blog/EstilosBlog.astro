---
/**
 * CSS del blog en línea, solo en la portada del blog y en los artículos. Importado como hoja entraría en el CSS
 * común que descargan todas las páginas del sitio (+30 KB). Va en dos partes: «cabeza» antes del título (lo justo
 * para pintarlo pronto: es el LCP en móvil) y «cuerpo» después de la cabecera. Sin comentarios ni espacios de
 * sobra; los tokens (colores, radios, movimiento) vienen de v2.css.
 */
import cabeza from '../../blog-cabeza.css?raw';
import cuerpo from '../../blog.css?raw';
interface Props { parte: 'cabeza' | 'cuerpo' }
const css = Astro.props.parte === 'cabeza' ? cabeza : cuerpo;
const estilos = css.replace(/\/\*[\s\S]*?\*\//g, '').replace(/\s+/g, ' ').replace(/\s*([{};,>])\s*/g, '$1').replace(/:\s+/g, ':').replace(/;}/g, '}').trim();
---
<style is:inline set:html={estilos}></style>
