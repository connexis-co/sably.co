---
/**
 * Bloque de pasos del CMS (sably_cards «Paso a paso») en «Nosotros» narrativo: tarjetas apiladas (prototipo 09 de
 * docs/equipo/2026-11-25/animacion): cada paso se queda pegado bajo la cabecera, un poco más abajo que el anterior,
 * y el siguiente sube por encima; los de atrás se encogen un 4 % y se oscurecen (solo scale y opacity, y sin
 * encoger con «reducir movimiento»). Sin `sticky` o sin JavaScript, se leen en flujo. Texto y enlaces del CMS; una
 * foto de la serie «elige, aprende, practica, ofrece» por paso.
 */
import type { BlockValue } from 'emdash/ui';
import { safeEditorialUrl } from '@/lib/sably-theme';
import { relDe } from '@/lib/enlaces-propios';
import Ico from '../Ico.astro';
import Foto from '../Foto.astro';
import type { NombreFoto } from '../../fotos';
interface Props { value: BlockValue & { eyebrow?: string; title?: string; cards?: Array<{ title?: string; text?: string; button_label?: string; button_url?: string }> } }
const { value } = Astro.props;
const cards = value.cards ?? [];
const FOTOS: NombreFoto[] = ['foto-serie-1-elige-ancha', 'foto-estudiar-celular-2', 'foto-serie-2-aprende-ancha', 'foto-serie-4-ofrece-ancha', 'foto-serie-3-practica-ancha'];
const FONDOS = ['#ffffff', 'var(--color-coral-50)', 'var(--color-navy-50)', '#ffffff'];
const total = String(cards.length).padStart(2, '0');
---
<section class="v2-nos-pasos bg-navy-950 py-20 text-white lg:py-28" data-cms>
  <div class="v2-contenedor">
    {value.eyebrow && <p class="v2-antetitulo text-white/80">{value.eyebrow}</p>}
    {value.title && <h2 class:list={['max-w-[720px] font-display text-d28 !text-white lg:text-d40', value.eyebrow && 'mt-3']}>{value.title}</h2>}
    <ol class="v2-nos-pila mt-12" role="list" data-nos-pila>
      {cards.map((card, i) => {
        const href = safeEditorialUrl(card.button_url);
        return (
          <li class="v2-nos-carta" style={`--i: ${i}; --fondo: ${FONDOS[i % FONDOS.length]}`} data-carta={i}>
            <div class="v2-nos-cara">
              <div>
                <p class="v2-num text-t13 font-semibold text-coral-600">{String(i + 1).padStart(2, '0')} <span class="text-navy-500">/ {total}</span></p>
                <h3 class="mt-3 font-display text-t20 font-semibold lg:text-d40">{card.title}</h3>
                <p class="mt-3 max-w-[460px] text-t17 whitespace-pre-line text-navy-700">{card.text}</p>
                {href && card.button_label && <a href={href} rel={relDe(href)} class="v2-enlace mt-5 min-h-11">{card.button_label} <Ico nombre="arrow-right" tamano={18} class="v2-flecha" /></a>}
              </div>
              <div class="v2-nos-carta-foto"><Foto nombre={FOTOS[i % FOTOS.length]!} sizes="(min-width: 900px) 520px, 88vw" decorativa class="h-full w-full object-cover" /></div>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .v2-nos-pila { display: grid; gap: 24px; padding-bottom: clamp(24px, 6vh, 64px); }
  .v2-nos-carta { position: sticky; top: calc(var(--fijo-superior, 72px) + 16px + var(--i) * 14px); }
  .v2-nos-cara {
    position: relative; display: grid; gap: 20px; padding: 20px; border-radius: var(--radius-c-xl); background: var(--fondo); color: var(--color-navy-950);
    box-shadow: 0 -1px 0 rgb(27 27 58 / .06), var(--shadow-s3); transform-origin: 50% 0; transition: scale var(--t-lento) var(--e-sale);
  }
  .v2-nos-cara::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: var(--color-navy-950); opacity: 0; pointer-events: none; transition: opacity var(--t-lento) var(--e-sale); }
  .v2-nos-carta-foto { overflow: hidden; border-radius: var(--radius-c-lg); aspect-ratio: 16 / 9; }
  .v2-nos-carta-foto :global(picture) { display: block; height: 100%; }
  .v2-nos-carta[data-atras] .v2-nos-cara::after { opacity: .28; }
  @media (prefers-reduced-motion: no-preference) { .v2-nos-carta[data-atras] .v2-nos-cara { scale: .96; } }
  @media (min-width: 900px) {
    .v2-nos-pila { gap: 40px; }
    .v2-nos-cara { grid-template-columns: minmax(0, 1fr) minmax(0, 520px); align-items: center; gap: 48px; padding: 40px 40px 40px 56px; min-height: min(480px, calc(100vh - var(--fijo-superior, 72px) - 120px)); }
    .v2-nos-carta-foto { aspect-ratio: auto; height: 100%; min-height: 340px; }
  }
</style>

<script>
  /* Alto de lo fijo arriba (cabecera y barra de campaña) y qué tarjeta queda «atrás»: cuando la siguiente llega a su sitio. */
  for (const pila of document.querySelectorAll<HTMLElement>('[data-nos-pila]')) {
    const seccion = pila.closest<HTMLElement>('.v2-nos-pasos')!;
    const arriba = () => {
      if (getComputedStyle(document.documentElement).getPropertyValue('--fijo-superior').trim()) return;
      const cab = document.querySelector<HTMLElement>('[data-cabecera]');
      seccion.style.setProperty('--fijo-superior', `${Math.ceil(cab ? Math.max(cab.getBoundingClientRect().bottom, cab.offsetHeight) : 72)}px`);
    };
    arriba();
    if (!('IntersectionObserver' in window)) continue;
    const cartas = [...pila.querySelectorAll<HTMLElement>('[data-carta]')];
    let io: IntersectionObserver | null = null;
    const montar = () => {
      io?.disconnect();
      const top = parseFloat(getComputedStyle(cartas[cartas.length - 1]!).top) || 120;
      io = new IntersectionObserver(es => {
        for (const e of es) {
          const i = cartas.indexOf(e.target as HTMLElement);
          if (i > 0) cartas[i - 1]!.toggleAttribute('data-atras', e.isIntersecting);
        }
      }, { rootMargin: `0px 0px -${Math.max(0, innerHeight - top - 40)}px 0px` });
      cartas.forEach(c => io!.observe(c));
    };
    montar();
    let t: ReturnType<typeof setTimeout>;
    addEventListener('resize', () => { clearTimeout(t); t = setTimeout(() => { arriba(); montar(); }, 200); });
  }
</script>
