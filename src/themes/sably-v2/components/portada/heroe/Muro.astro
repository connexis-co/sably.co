---
/**
 * Héroe E · «Muro inclinado» (prototipo 18, idea de la referencia gurwi.com: solo el mecanismo). Cuatro filas de
 * tarjetas con foto, giradas −7°, que se deslizan en horizontal en sentidos alternos (marquesina CSS sobre pistas
 * duplicadas) detrás de un velo que las apaga hacia el texto. Cursor o foco en una fila la detiene y endereza la
 * tarjeta, que enseña curso, nota y precio; el muro se puede arrastrar (Pointer Events, solo `translate`).
 * Escritorio: capa absoluta en la mitad derecha de la banda, sangrando al borde, con alto fijo (CLS 0).
 * Móvil: dos filas BAJO los botones, con el precio siempre a la vista; un toque abre el curso.
 * Con «reducir movimiento»: filas quietas, sin copias, sin botón de pausa y sin giro animado.
 * Los 12 cursos van enlazados en el HTML (primera copia de cada pista); las copias del bucle son aria-hidden.
 * Orden aleatorio (D1, ajuste «Orden» de la portada, de fábrica): lo decide el navegador, no el servidor, para que la
 * página siga siendo la misma en la caché del borde. Un script en línea, justo tras el muro y antes de pintarlo,
 * baraja las tarjetas dentro de cada fila (igual en todas sus copias, para que el bucle siga sin costura), baraja las
 * filas y da a cada una un punto de arranque al azar. Hasta entonces el muro está oculto (`visibility`, sin
 * ocupar otro sitio): ni salto ni CLS. Sin JavaScript se ve en el orden fijo del HTML.
 */
import Foto from '../../Foto.astro';
import Ico from '../../Ico.astro';
import PrecioOficio from './PrecioOficio.astro';
import { corto, notaCorta } from './comun';
import type { OficioMosaico } from '../Heroe.astro';
interface Props { oficios: OficioMosaico[]; base: string; locale: string; tachar: boolean; rota: boolean; intervalo: number; aleatorio: boolean }
const { oficios, base, locale, tachar, aleatorio } = Astro.props;
const FILAS = 4;
const filas = Array.from({ length: FILAS }, (_, f) => oficios.filter((_, i) => i % FILAS === f)).filter(f => f.length > 0);
/* Copias de cada pista: bastan para cubrir el muro entero aunque se arrastre (la primera es la de los enlaces). */
const copiasDe = (n: number) => Math.max(4, Math.ceil(12 / n));
const DURACION = [30, 36, 33, 39];
---
<!-- CSS antes del HTML: si va después, con la CPU lenta se pinta sin él y luego salta (CLS de 0,45 a 390 y 0,75 a 1440 con el muro, 26-nov). -->
<style is:inline>
  /* Orden aleatorio: oculto (sin cambiar de tamaño) hasta que el script en línea lo baraja. Sin JS, visible. */
  @media (scripting: enabled) { .v2-muro[data-muro-aleatorio]:not([data-ordenado]) .v2-muro-giro { visibility: hidden; } }
  @layer components {
    /* ── Maqueta de la banda: el muro es una capa a la derecha y el texto queda encima ── */
    @media (min-width: 1024px) {
      [data-heroe='muro'] .v2-heroe-caja { position: static; min-height: 680px; }
      [data-heroe='muro'] .v2-heroe-texto { position: relative; z-index: 3; }
    }
    /* Sangra al borde comiéndose el relleno del contenedor (20 px bajo 1024), no con 100vw: 100vw cuenta la barra de
       desplazamiento clásica y el muro sobresalía de la página (desborde horizontal, ronda 5). */
    .v2-muro { --ang: -6deg; --rec: 6deg; position: relative; height: 300px; margin-inline: -20px; overflow: clip; touch-action: pan-y; cursor: grab; user-select: none; -webkit-user-select: none; }
    .v2-muro[data-arrastre] { cursor: grabbing; }
    .v2-muro a { -webkit-user-drag: none; }
    .v2-muro-giro { position: absolute; left: -8%; width: 116%; top: calc(50% - 22px); translate: 0 -50%; rotate: var(--ang); display: grid; gap: 12px; }
    .v2-muro-fila { position: relative; }
    .v2-muro-pista { display: flex; gap: 12px; width: max-content; margin: 0; padding: 0; list-style: none; }
    .v2-muro-tar { position: relative; flex: none; z-index: 1; }
    @media (max-width: 1023.98px) {
      /* «Tras los botones» (panel → Portada): el muro, más bajo, va entre los botones y la línea de valoraciones; así
         asoma en la primera pantalla. Las reglas que abren la caja y el texto van en Heroe.astro, ANTES del texto. */
      [data-heroe='muro'][data-heroe-movil='tras-botones'] .v2-muro { order: 1; height: 236px; margin-top: 18px; }
      [data-heroe='muro'][data-heroe-movil='tras-botones'] .v2-muro-tar > a { width: 132px; }
      .v2-muro { mask-image: linear-gradient(90deg, transparent, #000 18px, #000 calc(100% - 18px), transparent); }
      [data-heroe='muro'] .v2-heroe-caja { padding-bottom: 20px; }
    }
    .v2-muro-tar > a { position: relative; display: block; width: 150px; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius-c-md); background: var(--color-navy-700); color: #fff; box-shadow: var(--shadow-s2); }
    .v2-muro-tar > a:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
    .v2-muro-foto, .v2-muro-tar picture { display: block; width: 100%; height: 100%; }
    .v2-muro-foto { object-fit: cover; }
    .v2-muro-rot { position: absolute; left: 8px; bottom: 8px; max-width: calc(100% - 16px); padding: 3px 9px; border-radius: 10px; background: rgb(27 27 58 / .78); font-size: 11.5px; font-weight: 600; line-height: 1.3; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 1; overflow: hidden; }
    /* Ficha: móvil = solo el precio, siempre a la vista, como un chip arriba a la derecha. */
    .v2-muro-ficha { position: absolute; top: 6px; right: 6px; padding: 1px 7px; border-radius: 999px; background: #fff; color: var(--color-navy-950); box-shadow: 0 1px 4px rgb(27 27 58 / .25); }
    .v2-muro-ficha .v2-muro-precio [class*='text-t13'] { font-size: 9.5px; }
    .v2-muro-chip { display: none; }
    .v2-muro-det { display: none; }
    .v2-muro-precio { font-size: 11px; line-height: 1.45; }
    .v2-muro-precio > span:not(:first-child) { display: none; }
    .v2-muro-fila:nth-child(n+3) { display: none; }
    .v2-muro-pausa { position: absolute; z-index: 6; right: 20px; bottom: 0; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px 0 14px; border-radius: 999px; background: #fff; color: var(--color-navy-950); font-size: 14px; font-weight: 600; box-shadow: var(--shadow-s2); cursor: pointer; }
    .v2-muro-pausa:focus-visible { outline: 3px solid var(--color-coral-500); outline-offset: 2px; }
    .v2-muro-pausa .v2-ico-seguir, .v2-muro-pausa[aria-pressed='true'] .v2-ico-pausa { display: none; }
    .v2-muro-pausa[aria-pressed='true'] .v2-ico-seguir { display: block; }

    /* Tarjeta enderezada (cursor, foco por teclado o toque): gira lo que gira el muro, al revés. */
    .v2-muro-tar:focus-within, .v2-muro-tar[data-activa] { rotate: var(--rec); scale: 1.12; z-index: 5; }
    .v2-muro-tar:focus-within > a, .v2-muro-tar[data-activa] > a { box-shadow: 0 0 0 3px var(--color-coral-500), var(--shadow-s3); }
    @media (hover: hover) {
      .v2-muro-tar:hover { rotate: var(--rec); scale: 1.12; z-index: 5; }
      .v2-muro-tar:hover > a { box-shadow: 0 0 0 3px var(--color-coral-500), var(--shadow-s3); }
    }
    .v2-muro-fila:is(:hover, :focus-within, :has([data-activa])) { z-index: 4; }

    @media (min-width: 1024px) {
      .v2-muro { position: absolute; z-index: 1; top: 0; right: 0; bottom: 0; left: 51%; height: auto; margin-inline: 0; --ang: -7deg; --rec: 7deg; }
      .v2-muro::after { content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none; background: linear-gradient(0deg, var(--color-navy-950) 0, rgb(27 27 58 / 0) 14%), linear-gradient(90deg, var(--color-navy-950) 0 12%, rgb(27 27 58 / 0) 36%); }
      .v2-muro { mask-image: linear-gradient(90deg, #000 calc(100% - 64px), transparent); }
      .v2-muro-giro { top: 50%; }
      .v2-muro-giro { left: -12%; width: 130%; gap: 16px; }
      .v2-muro-pista { gap: 16px; }
      .v2-muro-tar > a { width: 250px; border-radius: var(--radius-c-lg); }
      .v2-muro-rot { left: 10px; bottom: 10px; font-size: 14px; -webkit-line-clamp: 1; background: rgb(27 27 58 / .85); }
      .v2-muro-chip { position: absolute; top: 10px; right: 10px; display: flex; padding: 3px 10px; border-radius: 999px; background: #fff; color: var(--color-navy-950); font-size: 14px; font-weight: 700; line-height: 1.4; box-shadow: 0 2px 8px rgb(27 27 58 / .25); }
      .v2-muro-chip [class*='text-t13'] { font-size: 11px; }
      .v2-muro-fila:nth-child(n+3) { display: block; }
      .v2-muro-tar:focus-within, .v2-muro-tar[data-activa] { scale: 1.3; }
      @media (hover: hover) { .v2-muro-tar:hover { scale: 1.3; } }
      .v2-muro-ficha { top: auto; right: 8px; left: 8px; bottom: 8px; padding: 8px 10px; border-radius: var(--radius-c-md); opacity: 0; translate: 0 6px; }
      .v2-muro-det { display: grid; gap: 2px; margin-bottom: 2px; }
      .v2-muro-precio { font-size: 15px; }
      .v2-muro-precio > span:not(:first-child) { display: inline; }
      .v2-muro-tar:focus-within :is(.v2-muro-rot, .v2-muro-chip), .v2-muro-tar[data-activa] :is(.v2-muro-rot, .v2-muro-chip) { opacity: 0; }
      .v2-muro-tar:focus-within .v2-muro-ficha, .v2-muro-tar[data-activa] .v2-muro-ficha { opacity: 1; translate: 0 0; }
      @media (hover: hover) {
        .v2-muro-tar:hover :is(.v2-muro-rot, .v2-muro-chip) { opacity: 0; }
        .v2-muro-tar:hover .v2-muro-ficha { opacity: 1; translate: 0 0; }
      }
      .v2-muro-pausa { right: 24px; bottom: 24px; }
    }

    @media (prefers-reduced-motion: no-preference) {
      .v2-muro-tar { transition: rotate var(--t-lento) var(--e-mueve), scale var(--t-lento) var(--e-mueve); }
      .v2-muro-ficha, .v2-muro-rot, .v2-muro-chip { transition: opacity var(--t-base) var(--e-sale), translate var(--t-base) var(--e-sale); }
      @keyframes v2-muro-desliza { to { translate: calc(-100% / var(--c)) 0; } }
      .v2-muro-pista { animation-name: v2-muro-desliza; animation-duration: calc(var(--d) / var(--m, 1)); animation-timing-function: linear; animation-iteration-count: infinite; }
      .v2-muro-fila:nth-child(even) .v2-muro-pista { animation-direction: reverse; }
      /* Pausa: botón, arrastre, fuera de pantalla, pestaña oculta; y la fila que se toca o enfoca. */
      .v2-muro[data-quieto] .v2-muro-pista, .v2-muro[data-auto] .v2-muro-pista, .v2-muro[data-arrastre] .v2-muro-pista,
      .v2-muro-fila:is(:hover, :focus-within, :has([data-activa])) .v2-muro-pista { animation-play-state: paused; }
      .v2-muro-fila[data-salto] { transition: translate var(--t-lento) var(--e-mueve); }
    }
    @media (prefers-reduced-motion: reduce) {
      .v2-muro { cursor: auto; }
      .v2-muro-tar[data-copia] { display: none; }
      .v2-muro-pausa { display: none; }
    }
  }
</style>
<div class="v2-muro" data-muro data-muro-aleatorio={aleatorio ? '' : undefined} role="group" aria-label="Muro de cursos: pasa el cursor o enfoca para ver el precio; arrástralo para moverlo">
  <div class="v2-muro-giro">
    {filas.map((fila, f) => (
      <div class="v2-muro-fila" data-fila={f}>
        <ul class="v2-muro-pista" role="list" style={`--c: ${copiasDe(fila.length)}; --d: ${DURACION[f % DURACION.length]}s`}>
          {Array.from({ length: copiasDe(fila.length) }, (_, copia) => fila.map(o => (
            <li class="v2-muro-tar" aria-hidden={copia ? 'true' : undefined} data-copia={copia ? '' : undefined}>
              <a href={`${base}/${o.id}/`} class="v2-heroe-curso" tabindex={copia ? '-1' : undefined} draggable="false">
                <Foto nombre={o.foto} sizes="(min-width: 1024px) 250px, 150px" decorativa class="v2-muro-foto" />
                <span class="v2-muro-rot">{corto(o.titulo)}</span>
                <span class="v2-muro-ficha">
                  <span class="v2-muro-det">
                    <strong class="line-clamp-2 text-t15 font-semibold">{corto(o.titulo)}</strong>
                    {o.nota && <span class="flex items-center gap-1 text-t13 text-navy-500"><Ico nombre="star" tamano={13} class="text-[#B87300]" />{notaCorta(o.nota)}</span>}
                  </span>
                  <PrecioOficio precio={o.precio} {locale} {tachar} class="v2-muro-precio text-t15 text-navy-950" />
                </span>
                {/* Chip de precio siempre visible en escritorio (va detrás de la ficha: el verificador lee la primera cifra). */}
                <PrecioOficio precio={o.precio} {locale} tachar={false} class="v2-muro-chip" />
              </a>
            </li>
          )))}
        </ul>
      </div>
    ))}
  </div>
  <button type="button" class="v2-muro-pausa" data-muro-pausa aria-pressed="false">
    <Ico nombre="pause" tamano={14} class="v2-ico-pausa" /><Ico nombre="play" tamano={14} class="v2-ico-seguir" />
    <span data-muro-pausa-texto>Pausar el muro</span>
  </button>
</div>
{aleatorio && (
  <script is:inline>
    (function () {
      var raiz = document.currentScript && document.currentScript.previousElementSibling;
      if (!raiz || !raiz.matches('[data-muro-aleatorio]')) return;
      try {
        var barajar = function (a) { for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; };
        var filas = [].slice.call(raiz.querySelectorAll('.v2-muro-fila'));
        var pistas = filas.map(function (f) { return f.querySelector('.v2-muro-pista'); });
        // Las filas intercambian su pista entera (cada una con su número de copias y su duración).
        barajar(pistas.slice()).forEach(function (pista, i) { filas[i].appendChild(pista); });
        pistas.forEach(function (pista) {
          var tarjetas = [].slice.call(pista.children);
          var copias = Number(pista.style.getPropertyValue('--c')) || 1;
          var n = Math.round(tarjetas.length / copias);
          if (n < 2 || n * copias !== tarjetas.length) return;
          var orden = barajar(Array.from({ length: n }, function (_, k) { return k; }));
          for (var c = 0; c < copias; c++) orden.forEach(function (k) { pista.appendChild(tarjetas[c * n + k]); });
          // Punto de arranque al azar dentro de su vuelta (solo cambia en qué tarjeta empieza la marquesina).
          var d = parseFloat(pista.style.getPropertyValue('--d')) || 0;
          if (d) pista.style.animationDelay = (-Math.random() * d).toFixed(2) + 's';
        });
      } catch (e) { /* si algo falla, el orden fijo del HTML */ }
      raiz.setAttribute('data-ordenado', '');
    })();
  </script>
)}


<script>
  for (const raiz of document.querySelectorAll<HTMLElement>('[data-muro]')) {
    if (!raiz.checkVisibility()) continue;
    const reducido = matchMedia('(prefers-reduced-motion: reduce)');
    const escritorio = matchMedia('(min-width: 1024px)');
    const filas = [...raiz.querySelectorAll<HTMLElement>('.v2-muro-fila')];
    const pistas = filas.map(f => f.querySelector<HTMLElement>('.v2-muro-pista')!);
    const boton = raiz.querySelector<HTMLButtonElement>('[data-muro-pausa]');
    const texto = raiz.querySelector<HTMLElement>('[data-muro-pausa-texto]');
    const desfase = filas.map(() => 0);             // arrastre acumulado de cada fila (px), solo `translate`
    const copias = (i: number) => Number(pistas[i]!.style.getPropertyValue('--c')) || 4;
    const periodo = (i: number) => pistas[i]!.scrollWidth / copias(i);
    const grados = () => (escritorio.matches ? 7 : 6);
    const pinta = (i: number) => { filas[i]!.style.translate = `${desfase[i]}px 0`; };

    /* Pausa: botón + fuera de pantalla + pestaña oculta (el cursor y el foco los resuelve el CSS por fila). */
    let enVista = true;
    const auto = () => raiz.toggleAttribute('data-auto', !enVista || document.hidden);
    new IntersectionObserver(([e]) => { enVista = !!e?.isIntersecting; auto(); }).observe(raiz);
    document.addEventListener('visibilitychange', auto);
    boton?.addEventListener('click', () => {
      const p = !raiz.hasAttribute('data-quieto');
      raiz.toggleAttribute('data-quieto', p);
      boton.setAttribute('aria-pressed', String(p));
      if (texto) texto.textContent = p ? 'Seguir con el muro' : 'Pausar el muro';
    });

    /* Tarjeta destacada (se endereza); en táctil, un toque abre el curso directamente (el precio ya se ve). */
    let activa: HTMLElement | null = null;
    const activar = (li: HTMLElement | null) => {
      if (activa === li) return;
      activa?.removeAttribute('data-activa');
      activa = li;
      li?.setAttribute('data-activa', '');
    };

    /* Arrastre con Pointer Events: el movimiento se proyecta sobre el eje de las filas y envuelve cada periodo. */
    let ar: { x: number; y: number; base: number[]; mov: number; id: number; d: number; t: number; v: number } | null = null;
    /* Inercia al soltar: la velocidad del último tramo se apaga en ~0,6 s (solo `translate`). */
    let inercia = 0;
    const mueve = (d: number) => filas.forEach((_, i) => { const w = periodo(i); desfase[i] = (((desfase[i]! + d) % w) - w) % w; pinta(i); });
    const desliza = (v: number) => {
      cancelAnimationFrame(inercia);
      let t0 = performance.now();
      const paso = (t: number) => {
        const dt = Math.min(48, t - t0); t0 = t;
        v *= Math.pow(0.94, dt / 16);
        if (Math.abs(v) < 0.02) { raiz.removeAttribute('data-arrastre'); return; }
        mueve(v * dt);
        inercia = requestAnimationFrame(paso);
      };
      raiz.setAttribute('data-arrastre', '');
      inercia = requestAnimationFrame(paso);
    };
    let movio = false;
    raiz.addEventListener('dragstart', e => e.preventDefault());
    raiz.addEventListener('pointerdown', e => {
      if (e.button !== 0 || reducido.matches || (e.target as Element).closest('button')) return;
      cancelAnimationFrame(inercia);
      ar = { x: e.clientX, y: e.clientY, base: [...desfase], mov: 0, id: e.pointerId, d: 0, t: e.timeStamp, v: 0 };
    });
    raiz.addEventListener('pointermove', e => {
      if (!ar || e.pointerId !== ar.id) return;
      const dx = e.clientX - ar.x, dy = e.clientY - ar.y;
      ar.mov = Math.max(ar.mov, Math.hypot(dx, dy));
      if (ar.mov <= 6) return;                        // umbral: por debajo es un clic
      if (!raiz.hasAttribute('data-arrastre')) { raiz.setAttribute('data-arrastre', ''); raiz.setPointerCapture(e.pointerId); activar(null); }
      const a = grados() * Math.PI / 180;
      const d = dx * Math.cos(a) - dy * Math.sin(a);  // eje de las filas, girado −grados
      filas.forEach((_, i) => { const w = periodo(i); desfase[i] = (((ar!.base[i]! + d) % w) - w) % w; pinta(i); });
      const dt = e.timeStamp - ar.t;
      if (dt > 0) { ar.v = 0.7 * ((d - ar.d) / dt) + 0.3 * ar.v; ar.d = d; ar.t = e.timeStamp; }
    });
    const suelta = () => {
      if (!ar) return;
      movio = ar.mov > 6;
      const v = ar.v;
      ar = null;
      raiz.removeAttribute('data-arrastre');
      if (movio && Math.abs(v) > 0.1) desliza(Math.max(-3, Math.min(3, v)));
      if (movio) setTimeout(() => { movio = false; }, 0);
    };
    raiz.addEventListener('pointerup', suelta);
    raiz.addEventListener('pointercancel', suelta);
    raiz.addEventListener('click', e => {
      if (movio) { e.preventDefault(); e.stopPropagation(); return; }
      const li = (e.target as Element).closest<HTMLElement>('.v2-muro-tar');
      if (!li) activar(null);
    }, true);
    document.addEventListener('pointerdown', e => { if (!raiz.contains(e.target as Node)) activar(null); });

    /* Teclado: al enfocar una tarjeta, su fila se para (CSS) y la tarjeta se lleva al centro del muro. */
    raiz.addEventListener('focusin', e => {
      const li = (e.target as Element).closest<HTMLElement>('.v2-muro-tar');
      const fila = li?.closest<HTMLElement>('.v2-muro-fila');
      if (!li || !fila || reducido.matches) return;
      const i = filas.indexOf(fila), pista = pistas[i]!, w = periodo(i);
      const anim = pista.getAnimations()[0];
      const progreso = Number(anim?.effect?.getComputedTiming().progress ?? 0);
      const p = -progreso * w;                         // dónde está la pista por su animación
      const r = li.getBoundingClientRect(), c = raiz.getBoundingClientRect();
      const d = (c.left + c.width * (escritorio.matches ? 0.62 : 0.5) - (r.left + r.width / 2)) / Math.cos(grados() * Math.PI / 180);
      const total = Math.min(0, Math.max(-(copias(i) - 2) * w, p + desfase[i]! + d));
      desfase[i] = total - p;
      fila.setAttribute('data-salto', '');
      pinta(i);
      setTimeout(() => fila.removeAttribute('data-salto'), 600);
    });
  }
</script>
