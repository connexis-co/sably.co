---
/** Cierre con el buscador (bloque `cierre`). */
import Ico from '../Ico.astro';
import Buscar from '../BuscarFrase.astro';
interface Props { base: string; totalCursos: number }
const { base, totalCursos } = Astro.props;
const nav = { totalCursos };
---
<!-- Cierre -->
<section class="v2-contenedor relative z-10 pt-24 lg:pt-32" aria-labelledby="cierre-titulo">
  <div class="-mb-24 grid grid-cols-[minmax(0,1fr)] items-center gap-6 rounded-c-xl bg-navy-50 p-6 shadow-s1 lg:grid-cols-[minmax(0,1fr)_minmax(0,600px)] lg:p-16">
    <div>
      <h2 id="cierre-titulo" class="font-display text-d28 lg:text-d40">Encuentra tu curso</h2>
      <a href={`${base}/cursos/`} class="v2-enlace mt-3 min-h-11">O mira los {nav.totalCursos} cursos <Ico nombre="arrow-right" tamano={18} class="v2-flecha" /></a>
    </div>
    <Buscar base={base} id="buscar-cierre" claro />
  </div>
</section>
