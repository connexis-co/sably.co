---
/** Cifras reales con fuente y fecha, y cómo se paga (bloque `cifras`). */
import LogoHotmart from '@/components/v2/LogoHotmart.astro';
import LogosPago from '@/components/v2/LogosPago.astro';
import NotaFuente from '@/components/v2/NotaFuente.astro';
import type { Country } from '@/lib/countries';
import type { cifrasPortada } from '../../cifras';
interface Props { cifras: Awaited<ReturnType<typeof cifrasPortada>>; country: Country }
const { cifras, country } = Astro.props;
---
<!-- Cifras reales con fuente y fecha, y cómo se paga -->
<section class="v2-contenedor pt-12 lg:pt-16" aria-label="Sably en cifras">
  <dl class="grid grid-cols-3 gap-x-4 gap-y-6 lg:flex lg:gap-x-12" data-entra="grupo">
    <div><dt class="sr-only">Cursos</dt><dd class="v2-num font-display text-d28 max-[359px]:text-[24px] font-semibold text-navy-950 lg:text-d56" data-cuenta={cifras.cursos}>{cifras.cursos}</dd><dd class="text-t13 text-navy-700 lg:text-t15">cursos en vídeo con inscripción abierta</dd></div>
    <div class="border-navy-100 lg:border-l lg:pl-12"><dt class="sr-only">Países</dt><dd class="v2-num font-display text-d28 max-[359px]:text-[24px] font-semibold text-navy-950 lg:text-d56">{cifras.paises}</dd><dd class="text-t13 text-navy-700 lg:text-t15">Disponible en {cifras.paises} países</dd></div>
    {cifras.calificaciones > 0 && cifras.mediaTexto && (
      <div class="border-navy-100 lg:border-l lg:pl-12"><dt class="sr-only">Valoraciones</dt><dd class="v2-num font-display text-d28 max-[359px]:text-[24px] font-semibold text-navy-950 lg:text-d56" data-cuenta={cifras.calificaciones}>{cifras.calificaciones.toLocaleString('es-CO')}</dd><dd class="text-t13 text-navy-700 lg:text-t15">{cifras.mediaTexto} de media en {cifras.calificaciones.toLocaleString('es-CO')} valoraciones reales en Hotmart</dd></div>
    )}
  </dl>
  <NotaFuente class="mt-4">Cursos y países contados el {cifras.hoy}.{cifras.leidas && ` Valoraciones leídas en Hotmart el ${cifras.leidas}: son las que Hotmart publica en la página de cada curso.`}</NotaFuente>
  <!-- Cómo se paga (E2, ronda 5): compacto, logotipos en fichas iguales, y los medios locales verificados del país. -->
  <div class="mt-8 grid gap-4 rounded-c-lg bg-navy-50 p-4 sm:p-5 lg:grid-cols-[auto_minmax(0,1fr)] lg:items-center lg:gap-8">
    <div>
      <p class="flex items-center gap-2 text-t15 font-semibold text-navy-950">Pagas seguro en <LogoHotmart alto={20} /></p>
      <p class="mt-1 text-t13 text-navy-700">Tarjeta, PayPal y los medios de {country.name} que tenga activados cada curso.</p>
    </div>
    <LogosPago pais={country.code} alto={22} fichas class="lg:justify-end" />
  </div>
</section>
