---
/**
 * Guías gratuitas del blog (bloque `guias`). Panel → Portada → «Bloque de guías del blog»:
 * - «Tarjetas» (de fábrica): las guías destacadas en tarjetas con su foto (la propia del artículo o la de su
 *   categoría), la categoría con su color, «Escúchalo · N min» solo si la guía tiene narración publicada, y el
 *   resto en la lista «Más guías». CSS propio y corto: no carga la hoja del blog en la portada.
 * - «Lista»: solo texto, como antes.
 * Los enlaces son los mismos en las dos variantes.
 */
import Ico from '../Ico.astro';
import { cmsImageUrl } from '@/lib/cms-media';
import { blogCover, tonoDeCategoria } from '@/lib/blog';
type Post = { id: string; data: { title: string; description?: string; category?: string | null }; cardImage?: unknown; coverImage?: unknown };
interface Props { copy: { eyebrow: string; title: string }; guiasDestacadas: Post[]; masGuias: Post[]; variante?: 'tarjetas' | 'lista'; narradas?: Map<string, number> }
const { copy: c, guiasDestacadas, masGuias, variante = 'tarjetas', narradas = new Map() } = Astro.props;
const copy = { blog: c };
const fotoDe = (p: Post) => cmsImageUrl(p.cardImage) ?? cmsImageUrl(p.coverImage) ?? blogCover(p.data.category ?? undefined, 'card');
const minutos = (p: Post) => { const s = narradas.get(p.id); return s ? Math.max(1, Math.round(s / 60)) : 0; };
---
<!-- Guías gratuitas del blog -->
{guiasDestacadas.length > 0 && (
  <section class:list={['v2-contenedor grid gap-10 pt-24 lg:gap-16 lg:pt-32', variante === 'tarjetas' ? 'v2-guias-tarjetas grid-cols-[minmax(0,1fr)]' : 'lg:grid-cols-[360px_minmax(0,1fr)]']} aria-labelledby="guias-titulo">
    <div class:list={[variante === 'tarjetas' && 'lg:flex lg:items-end lg:justify-between lg:gap-10']}>
      <div>
        <p class="v2-antetitulo text-navy-700">{copy.blog.eyebrow}</p>
        <h2 id="guias-titulo" class="mt-3 font-display text-d28 lg:text-d40">{copy.blog.title}</h2>
        <p class="mt-3 max-w-[560px] text-t17 text-navy-700">Artículos del blog para entender un oficio antes de elegir curso.</p>
      </div>
      <a href="/blog/" class="v2-enlace mt-6 min-h-11 flex-none">Ver blog <Ico nombre="arrow-right" tamano={18} class="v2-flecha" /></a>
    </div>
    <div class="min-w-0">
      {variante === 'tarjetas' ? (
        <ul class="v2-guias-fila" role="list" data-entra="grupo">
          {guiasDestacadas.map(post => (
            <li><a href={`/blog/${post.id}/`} class="v2-guia group" data-tono={tonoDeCategoria(post.data.category ?? undefined)}>
              <span class="v2-guia-foto"><img src={fotoDe(post)} alt="" width="640" height="400" loading="lazy" decoding="async" /></span>
              <span class="v2-guia-cuerpo">
                <span class="flex flex-wrap items-center gap-2">
                  <span class="v2-guia-cat">{post.data.category ?? 'Guía'}</span>
                  {minutos(post) > 0 && <span class="v2-guia-audio"><Ico nombre="headphones" tamano={14} />Escúchalo · {minutos(post)} min</span>}
                </span>
                <strong class="mt-3 block font-display text-t20 font-semibold text-navy-950 group-hover:underline group-hover:underline-offset-4">{post.data.title}</strong>
                <span class="mt-2 line-clamp-2 text-t15 text-navy-700">{post.data.description}</span>
                <span class="mt-auto inline-flex items-center gap-1 pt-4 text-t15 font-semibold text-navy-950">Leer la guía <Ico nombre="arrow-right" tamano={16} class="v2-flecha" /></span>
              </span>
            </a></li>
          ))}
        </ul>
      ) : (
        <ul class="border-t border-navy-100" role="list" data-entra="grupo">
          {guiasDestacadas.map(post => (
            <li><a href={`/blog/${post.id}/`} class="group flex items-center gap-5 border-b border-navy-100 py-5">
              <span class="min-w-0 flex-1">
                <span class="text-t13 text-navy-500">{post.data.category ?? 'Guía'}</span>
                <strong class="mt-1 block font-display text-t20 font-semibold text-navy-950 group-hover:underline group-hover:underline-offset-4">{post.data.title}</strong>
                <span class="mt-1 line-clamp-2 text-t15 text-navy-700">{post.data.description}</span>
              </span>
              <Ico nombre="arrow-right" class="flex-none text-navy-950 transition-transform duration-(--t-rapido) group-hover:translate-x-[3px]" />
            </a></li>
          ))}
        </ul>
      )}
      {masGuias.length > 0 && (
        <div class="mt-8">
          <h3 class="text-t13 font-medium text-navy-500">Más guías</h3>
          <ul class:list={['mt-3 grid gap-x-8 gap-y-1 sm:grid-cols-2', variante === 'tarjetas' && 'lg:grid-cols-3']} role="list" data-entra="grupo">
            {masGuias.map(post => <li><a href={`/blog/${post.id}/`} class="v2-subrayado inline-flex min-h-11 items-center text-t15 font-medium text-navy-950">{post.data.title}</a></li>)}
          </ul>
        </div>
      )}
    </div>
  </section>
)}

<style is:global>
  @layer components {
    .v2-guias-fila { display: flex; gap: 16px; margin: 0; padding: 4px 0 8px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; list-style: none; }
    .v2-guias-fila > li { flex: none; width: min(300px, 80vw); scroll-snap-align: start; }
    @media (min-width: 900px) { .v2-guias-fila { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 0; padding: 0; overflow: visible; } .v2-guias-fila > li { width: auto; } }
    .v2-guia { --tono: var(--color-navy-950); --tono-suave: var(--color-navy-50); display: flex; flex-direction: column; height: 100%; overflow: hidden; border-radius: var(--radius-c-xl); background: #fff; box-shadow: inset 0 0 0 1px var(--color-navy-100); text-decoration: none; transition: box-shadow var(--t-rapido) var(--e-sale), translate var(--t-base) var(--e-sale); }
    .v2-guia[data-tono='coral'] { --tono: var(--color-coral-700); --tono-suave: var(--color-coral-50); }
    .v2-guia[data-tono='ambar'] { --tono: #8a5300; --tono-suave: #fdf3e1; }
    .v2-guia[data-tono='verde'] { --tono: #1f6b45; --tono-suave: #e9f5ee; }
    .v2-guia[data-tono='noche'] { --tono: var(--color-navy-950); --tono-suave: var(--color-navy-100); }
    .v2-guia-foto { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--tono-suave); }
    .v2-guia-foto img { width: 100%; height: 100%; object-fit: cover; transition: scale var(--t-lento) var(--e-sale); }
    .v2-guia-cuerpo { display: flex; flex: 1; flex-direction: column; padding: 20px; }
    .v2-guia-cat { display: inline-flex; align-items: center; min-height: 26px; padding: 0 10px; border-radius: 999px; background: var(--tono-suave); color: var(--tono); font-size: 13px; font-weight: 600; }
    .v2-guia-audio { display: inline-flex; align-items: center; gap: 5px; min-height: 26px; padding: 0 10px; border-radius: 999px; background: var(--color-navy-950); color: #fff; font-size: 13px; font-weight: 600; }
    .v2-guia:focus-visible { outline: 3px solid var(--color-coral-600); outline-offset: 3px; }
    @media (hover: hover) and (pointer: fine) {
      .v2-guia:hover { box-shadow: inset 0 0 0 1px var(--color-navy-300), var(--shadow-s3); translate: 0 -3px; }
      .v2-guia:hover .v2-guia-foto img { scale: 1.04; }
    }
  }
</style>
