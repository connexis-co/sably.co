---
/**
 * Oficio destacado (bloque `oficio`), con el comportamiento del bloque de visitvalle.travel que pidió JP:
 * - las tarjetas forman una pila; con «siguiente» la de encima cae (gira desde su esquina y baja fuera del
 *   marco) y deja ver la de debajo, cuyas piezas (antetítulo, título, texto y botón) entran en cascada;
 *   con «anterior» la tarjeta vuelve a subir;
 * - la foto de fondo cambia con un fundido sobre la anterior (la siguiente se precarga antes de fundir).
 * Flechas, teclas ← y →, deslizar con el dedo y contador «1 de N» con aviso a lectores de pantalla. Panel →
 * Portada: «Automático» (rueda sola cada `intervalo` ms, con botón visible de pausa; se para con el cursor encima,
 * con el foco dentro, fuera de pantalla o con la pestaña oculta) o «Estático» (solo flechas). Con «reducir movimiento» el cambio es inmediato. Todos los oficios y sus enlaces van en el HTML.
 * Solo se animan `transform` (translate/rotate) y `opacity`.
 */
import Ico from '../Ico.astro';
import Foto from '../Foto.astro';
import type { Course } from '@/lib/emdash-content';
import { FOTOS, type NombreFoto } from '../../fotos';
interface Props { oficios: { c: Course; nota: { cifra: string; texto: string } | null; foto: NombreFoto }[]; base: string; modo?: 'automatico' | 'estatico'; intervalo?: number }
const { oficios, base, modo = 'automatico', intervalo = 9000 } = Astro.props;
const auto = modo === 'automatico' && oficios.length > 1;
const n = oficios.length;
---
{n > 0 && (
  <section class="v2-contenedor pt-24 lg:pt-32" aria-labelledby="oficio-titulo">
    <h2 id="oficio-titulo" class="sr-only">Oficio destacado</h2>
    <div class="v2-ofi" data-ofi data-ofi-auto={auto ? intervalo : undefined} aria-roledescription="carrusel" aria-label="Oficios destacados">
      <div class="v2-ofi-fotos">
        {oficios.map((o, i) => (
          <div class="v2-ofi-foto" data-i={i} data-activa={i === 0 ? '' : undefined} aria-hidden={i === 0 ? undefined : 'true'}>
            <Foto nombre={o.foto} sizes="(min-width: 1024px) 1200px, 100vw" class="h-full w-full object-cover" />
          </div>
        ))}
      </div>
      <div class="v2-ofi-pila">
        {oficios.map((o, i) => (
          <article class="v2-ofi-tar" data-i={i} data-lado={FOTOS[o.foto].tarjeta === 'derecha' ? 'derecha' : undefined} data-estado={i === 0 ? 'activa' : 'debajo'} style={`z-index: ${n - i}`} role="group" aria-roledescription="diapositiva" aria-label={`${i + 1} de ${n}`}>
            <p class="v2-ofi-pieza flex items-center justify-between gap-2 border-b border-white/15 pb-4 text-t15" style="--k: 0"><span class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-coral-500" aria-hidden="true"></span>Oficio destacado</span>{n > 1 && <span class="text-t13 text-white/60 tabular-nums">{i + 1} de {n}</span>}</p>
            <h3 class="v2-ofi-pieza mt-5 font-display text-d28 !text-white lg:text-d40" style="--k: 1">{o.c.data.title}</h3>
            <p class="v2-ofi-pieza mt-3 text-t17 text-white/80" style="--k: 2">{o.c.data.shortDescription}{o.nota && ` Tiene ${o.nota.cifra} de 5 en ${o.nota.texto}.`}</p>
            <div class="v2-ofi-pieza mt-auto flex items-center justify-between gap-4 pt-6" style="--k: 3">
              <a href={`${base}/${o.c.id}/`} class="v2-btn v2-btn-principal whitespace-nowrap" data-alto="52">Ver el curso <Ico nombre="arrow-right" tamano={18} class="v2-flecha" /></a>
              {n > 1 && (
                <span class="flex gap-2">
                  {auto && <button type="button" class="v2-ofi-flecha v2-ofi-pausa" data-ofi-pausa aria-pressed="false" aria-label="Pausar el cambio automático"><Ico nombre="pause" tamano={16} class="v2-ico-pausa" /><Ico nombre="play" tamano={16} class="v2-ico-seguir" /></button>}
                  <button type="button" class="v2-ofi-flecha" data-ofi-ir="-1" aria-label="Oficio anterior"><Ico nombre="arrow-left" tamano={18} /></button>
                  <button type="button" class="v2-ofi-flecha" data-ofi-ir="1" aria-label="Oficio siguiente"><Ico nombre="arrow-right" tamano={18} /></button>
                </span>
              )}
            </div>
          </article>
        ))}
        {n > 1 && <p class="sr-only" aria-live="polite" data-ofi-aviso></p>}
      </div>
    </div>
  </section>
)}

<style is:global>
  @layer components {
    /* Móvil: foto 4:3 arriba y la pila de tarjetas debajo, montada 64 px sobre la foto. */
    /* Sin overflow-clip-margin: lo que asoma fuera del recorte cuenta como ancho desplazable (la página se ensanchaba
       4 px en el celular). La sombra de abajo cabe en el relleno inferior. */
    .v2-ofi { position: relative; overflow: clip; padding-bottom: 24px; margin-bottom: -24px; touch-action: pan-y; }
    .v2-ofi-fotos { display: grid; overflow: hidden; border-radius: var(--radius-c-xl); aspect-ratio: 4 / 3; background: var(--color-navy-100); }
    .v2-ofi-foto { grid-area: 1 / 1; opacity: 0; }
    .v2-ofi-foto[data-activa] { opacity: 1; z-index: 2; }
    .v2-ofi-foto[data-saliente] { opacity: 1; z-index: 1; }
    .v2-ofi-foto picture { display: block; height: 100%; }
    .v2-ofi-pila { position: relative; z-index: 3; display: grid; margin: -64px 12px 0; }
    .v2-ofi-tar {
      grid-area: 1 / 1; display: flex; flex-direction: column; padding: 24px;
      border-radius: var(--radius-c-xl); background: var(--color-navy-950); color: #fff; box-shadow: var(--shadow-s3);
      transform-origin: 100% 0;
    }
    .v2-ofi-tar[data-estado='cayo'] { translate: 0 125%; rotate: 9deg; opacity: 0; visibility: hidden; }
    .v2-ofi-tar[data-estado='debajo'] { visibility: hidden; }
    .v2-ofi-flecha { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 999px; color: #fff; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .4); cursor: pointer; transition: box-shadow var(--t-rapido) var(--e-sale), background-color var(--t-rapido) var(--e-sale); }
    .v2-ofi-flecha:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
    .v2-ofi-pausa .v2-ico-seguir, .v2-ofi-pausa[aria-pressed='true'] .v2-ico-pausa { display: none; }
    .v2-ofi-pausa[aria-pressed='true'] .v2-ico-seguir { display: block; }
    @media (prefers-reduced-motion: reduce) { .v2-ofi-pausa { display: none; } }
    @media (hover: hover) { .v2-ofi-flecha:hover { box-shadow: inset 0 0 0 1px #fff; background: rgb(255 255 255 / .08); } }

    /* Escritorio: foto a todo el contenedor y la tarjeta dentro, abajo a la izquierda (como visitvalle). */
    @media (min-width: 1024px) {
      .v2-ofi { border-radius: var(--radius-c-xl); overflow: hidden; padding-bottom: 0; margin-bottom: 0; }
      .v2-ofi-fotos { aspect-ratio: 1200 / 660; }
      /* Cada tarjeta va del lado libre de su foto (FOTOS[…].tarjeta), para no tapar la cara ni las manos. */
      .v2-ofi-pila { position: absolute; inset: 40px; margin: 0; pointer-events: none; }
      .v2-ofi-tar { width: 448px; padding: 32px; justify-self: start; pointer-events: auto; }
      .v2-ofi-tar[data-lado='derecha'] { justify-self: end; transform-origin: 0 0; }
      .v2-ofi-tar[data-lado='derecha'][data-estado='cayo'] { rotate: -9deg; }
    }

    @media (prefers-reduced-motion: no-preference) {
      /* Caída: gira desde la esquina superior derecha y baja fuera del marco; al volver, sube por el mismo camino. */
      .v2-ofi-tar { transition: translate 720ms cubic-bezier(.55, 0, .7, .2), rotate 720ms cubic-bezier(.55, 0, .7, .2), opacity 300ms linear 420ms, visibility 0s linear 720ms; }
      .v2-ofi-tar[data-estado='activa'] { transition: translate 640ms cubic-bezier(.2, .8, .25, 1), rotate 640ms cubic-bezier(.2, .8, .25, 1), opacity 160ms linear, visibility 0s; }
      .v2-ofi-tar[data-estado='debajo'] { transition: visibility 0s linear 720ms; }
      /* Piezas de la tarjeta que queda arriba: entran en cascada, 75 ms entre una y otra. */
      .v2-ofi[data-cascada] .v2-ofi-tar[data-estado='activa'] .v2-ofi-pieza { animation: v2-ofi-pieza 520ms cubic-bezier(.2, .8, .25, 1) both; animation-delay: calc(160ms + var(--k) * 75ms); }
      @keyframes v2-ofi-pieza { from { opacity: 0; translate: 0 18px; } }
      .v2-ofi-foto { transition: opacity 700ms ease; }
      .v2-ofi-foto[data-saliente] { transition: none; }
    }
  }
</style>

<script>
  for (const raiz of document.querySelectorAll<HTMLElement>('[data-ofi]')) {
    const tarjetas = [...raiz.querySelectorAll<HTMLElement>('.v2-ofi-tar')];
    const fotos = [...raiz.querySelectorAll<HTMLElement>('.v2-ofi-foto')];
    const n = tarjetas.length;
    if (n < 2) continue;
    const aviso = raiz.querySelector<HTMLElement>('[data-ofi-aviso]');
    let actual = 0;
    tarjetas.forEach((t, i) => { if (i) t.inert = true; });

    /* La foto que viene ya está descargada y decodificada antes del fundido (máximo 700 ms de espera). */
    const img = (i: number) => fotos[i]?.querySelector('img') ?? null;
    const precarga = (i: number) => { const im = img((i + n) % n); if (im && im.loading !== 'eager') im.loading = 'eager'; };
    const lista = (i: number) => {
      const im = img(i);
      if (!im) return Promise.resolve();
      precarga(i);
      return Promise.race([im.decode().catch(() => undefined), new Promise(r => setTimeout(r, 700))]);
    };
    new IntersectionObserver((es, o) => {
      if (es.some(e => e.isIntersecting)) { precarga(1); precarga(n - 1); o.disconnect(); }
    }, { rootMargin: '600px 0px' }).observe(raiz);

    let espera: ReturnType<typeof setTimeout> | undefined;
    const ir = async (destino: number) => {
      const d = (destino + n) % n;
      if (d === actual) return;
      await lista(d);
      // Si el foco estaba en una flecha de la tarjeta que se va, pasa a la misma flecha de la que llega.
      const foco = document.activeElement as HTMLElement | null;
      const flecha = foco && tarjetas[actual]?.contains(foco) ? foco.dataset.ofiIr : undefined;
      raiz.toggleAttribute('data-cascada', d > actual);
      tarjetas.forEach((t, i) => {
        t.dataset.estado = i < d ? 'cayo' : i === d ? 'activa' : 'debajo';
        t.inert = i !== d;
      });
      // Fundido: la foto anterior queda debajo, opaca, hasta que la nueva termina de aparecer.
      fotos.forEach(f => f.removeAttribute('data-saliente'));
      fotos[actual]?.setAttribute('data-saliente', '');
      fotos[actual]?.removeAttribute('data-activa');
      fotos[actual]?.setAttribute('aria-hidden', 'true');
      fotos[d]?.setAttribute('data-activa', '');
      fotos[d]?.removeAttribute('aria-hidden');
      clearTimeout(espera);
      espera = setTimeout(() => fotos.forEach(f => f.removeAttribute('data-saliente')), 760);
      actual = d;
      if (flecha) tarjetas[d]?.querySelector<HTMLElement>(`[data-ofi-ir="${flecha}"]`)?.focus({ preventScroll: true });
      if (aviso) aviso.textContent = `${d + 1} de ${n}: ${tarjetas[d]?.querySelector('h3')?.textContent ?? ''}`;
      precarga(d + 1); precarga(d - 1);
    };

    /* Rotación automática (modo «Automático»): un temporizador que se rearma tras cada cambio y que no corre si el
       usuario pausó, si el cursor o el foco están dentro, si el bloque no se ve o si la pestaña está oculta. */
    const cada = Number(raiz.dataset.ofiAuto) || 0;
    const pausas = [...raiz.querySelectorAll<HTMLButtonElement>('[data-ofi-pausa]')];
    let pausado = false, encima = false, dentro = false, visible = false, reloj: ReturnType<typeof setTimeout> | undefined;
    const puede = () => cada > 0 && !pausado && !encima && !dentro && visible && !document.hidden && !matchMedia('(prefers-reduced-motion: reduce)').matches;
    const arma = () => { clearTimeout(reloj); if (puede()) reloj = setTimeout(() => { void ir(actual + 1).then(arma); }, cada); };
    if (cada) {
      pausas.forEach(b => b.addEventListener('click', () => {
        pausado = !pausado;
        pausas.forEach(x => { x.setAttribute('aria-pressed', String(pausado)); x.setAttribute('aria-label', pausado ? 'Seguir con el cambio automático' : 'Pausar el cambio automático'); });
        arma();
      }));
      raiz.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') { encima = true; arma(); } });
      raiz.addEventListener('pointerleave', e => { if (e.pointerType === 'mouse') { encima = false; arma(); } });
      raiz.addEventListener('focusin', () => { dentro = true; arma(); });
      raiz.addEventListener('focusout', e => { if (!raiz.contains(e.relatedTarget as Node | null)) { dentro = false; arma(); } });
      new IntersectionObserver(([e]) => { visible = !!e?.isIntersecting && e.intersectionRatio > 0.4; arma(); }, { threshold: [0, 0.4, 0.6] }).observe(raiz);
      document.addEventListener('visibilitychange', arma);
    }
    raiz.querySelectorAll<HTMLButtonElement>('[data-ofi-ir]').forEach(b => b.addEventListener('click', () => { void ir(actual + Number(b.dataset.ofiIr)).then(arma); }));
    raiz.addEventListener('keydown', e => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      void ir(actual + (e.key === 'ArrowRight' ? 1 : -1)).then(arma);
    });
    /* Deslizar con el dedo: a la izquierda, siguiente; a la derecha, anterior. */
    let toque: { x: number; y: number } | null = null;
    raiz.addEventListener('pointerdown', e => { if (e.pointerType !== 'mouse') toque = { x: e.clientX, y: e.clientY }; });
    raiz.addEventListener('pointerup', e => {
      if (!toque) return;
      const dx = e.clientX - toque.x, dy = e.clientY - toque.y;
      toque = null;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.4) void ir(actual + (dx < 0 ? 1 : -1)).then(arma);
    });
    raiz.addEventListener('pointercancel', () => { toque = null; });
  }
</script>
