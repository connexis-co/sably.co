---
/** Oficio destacado: foto grande con panel azul, con radios y sin JavaScript (bloque `oficio`). */
import Ico from '../Ico.astro';
import Foto from '../Foto.astro';
import type { Course } from '@/lib/emdash-content';
import type { NombreFoto } from '../../fotos';
interface Props { oficios: { c: Course; nota: { cifra: string; texto: string } | null; foto: NombreFoto }[]; base: string }
const { oficios, base } = Astro.props;
---
<!-- Oficio destacado: foto grande con panel azul (radios, sin JavaScript) -->
{oficios.length > 0 && (
  <section class="v2-contenedor pt-24 lg:pt-32" aria-labelledby="oficio-titulo">
    <h2 id="oficio-titulo" class="sr-only">Oficio destacado</h2>
    <div class="v2-oficios relative">
      {oficios.map((o, i) => <input type="radio" name="oficio" id={`oficio-${i}`} class="sr-only" checked={i === 0} aria-label={`Oficio destacado ${i + 1} de ${oficios.length}: ${o.c.data.title}`} />)}
      {oficios.map((o, i) => (
        <article class="v2-oficio relative" data-i={i}>
          <div class="overflow-hidden rounded-c-xl"><Foto nombre={o.foto!} sizes="(min-width: 1024px) 1200px, 100vw" class="aspect-[4/3] w-full object-cover lg:aspect-[1200/660]" /></div>
          <div class="relative -mt-16 mx-3 rounded-c-xl bg-navy-950 p-6 text-white shadow-s3 lg:absolute lg:right-10 lg:-bottom-10 lg:m-0 lg:w-[448px] lg:p-8">
            <p class="flex items-center justify-between border-b border-white/15 pb-4 text-t15"><span class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-coral-500" aria-hidden="true"></span>Oficio destacado</span><span class="text-t13 text-white/60">{i + 1} de {oficios.length}</span></p>
            <h3 class="mt-5 font-display text-d28 !text-white lg:text-d40">{o.c.data.title}</h3>
            <p class="mt-3 text-t17 text-white/80">{o.c.data.shortDescription}{o.nota && ` Tiene ${o.nota.cifra} de 5 en ${o.nota.texto}.`}</p>
            <div class="mt-6 flex items-center justify-between gap-4">
              <a href={`${base}/${o.c.id}/`} class="v2-btn v2-btn-principal" data-alto="52">Ver el curso <Ico nombre="arrow-right" tamano={18} class="v2-flecha" /></a>
              {oficios.length > 1 && (
                <span class="flex gap-2">
                  <label for={`oficio-${(i - 1 + oficios.length) % oficios.length}`} class="grid size-12 cursor-pointer place-items-center rounded-full ring-1 ring-white/40 hover:ring-white" title="Anterior"><Ico nombre="arrow-left" tamano={18} /><span class="sr-only">Oficio anterior</span></label>
                  <label for={`oficio-${(i + 1) % oficios.length}`} class="grid size-12 cursor-pointer place-items-center rounded-full ring-1 ring-white/40 hover:ring-white" title="Siguiente"><Ico nombre="arrow-right" tamano={18} /><span class="sr-only">Oficio siguiente</span></label>
                </span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<style is:global>
  @layer components {
    .v2-oficios .v2-oficio { display: none; }
    .v2-oficios:has(#oficio-0:checked) .v2-oficio[data-i='0'],
    .v2-oficios:has(#oficio-1:checked) .v2-oficio[data-i='1'],
    .v2-oficios:has(#oficio-2:checked) .v2-oficio[data-i='2'] { display: block; }
    /* Sin :has() se ven los tres seguidos: no se pierde nada. */
    @supports not selector(:has(*)) { .v2-oficios .v2-oficio { display: block; margin-bottom: 48px; } }
    .v2-oficios input:focus-visible ~ .v2-oficio label { outline: 2px solid #fff; outline-offset: 2px; }
    @media (prefers-reduced-motion: no-preference) { .v2-oficio { animation: v2-funde var(--t-base) var(--e-sale); } }
  }
</style>
