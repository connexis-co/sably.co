---
/** Áreas con foto y el resto como enlaces (bloque `categorias`). */
import { relDe } from '@/lib/enlaces-propios';
import Ico from '../Ico.astro';
import Foto from '../Foto.astro';
import { nombreArea, type DatosNavegacion } from '../../navegacion';
type Area = DatosNavegacion['areas'][number];
interface Props { copy: { eyebrow: string; title: string; description: string }; base: string; conFoto: Area[]; resto: Area[]; externas: { name: string; externalUrl?: string }[]; total: number }
const { copy: c, base, conFoto, resto, externas, total } = Astro.props;
const copy = { categories: c };
const nav = { areas: { length: total } };
---
<!-- Áreas -->
<section id="categorias" class="v2-contenedor scroll-mt-24 pt-24 lg:pt-32" aria-labelledby="categorias-titulo">
  <p class="v2-antetitulo text-navy-700">{copy.categories.eyebrow}</p>
  <h2 id="categorias-titulo" class="mt-3 font-display text-d28 lg:text-d40">{copy.categories.title}</h2>
  {copy.categories.description && <p class="mt-3 max-w-[640px] text-t17 text-navy-700">{copy.categories.description}</p>}
  <ul data-entra="grupo" class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 [scrollbar-width:none] lg:grid lg:grid-cols-6 lg:overflow-visible" role="list">
    {conFoto.map(a => (
      <li class="w-[44%] flex-none snap-start lg:w-auto">
        <a href={`${base}/cursos/${a.slug}/`} class="v2-cat group relative block overflow-hidden rounded-c-lg bg-navy-50 ring-1 ring-navy-100">
          <span class="block aspect-[4/5]">
            {a.foto ? <Foto nombre={a.foto} sizes="(min-width: 1024px) 180px, 44vw" decorativa class="v2-cat-foto h-full w-full object-cover" />
              : a.fotoCms && <img src={a.fotoCms} alt="" width="480" height="600" loading="lazy" decoding="async" class="v2-cat-foto h-full w-full object-cover" />}
          </span>
          <span class="v2-cat-cuenta absolute top-2.5 left-2.5 rounded-full bg-white/92 px-2.5 py-0.5 text-t13 font-semibold text-navy-950">{a.total === 1 ? '1 curso' : `${a.total} cursos`}</span>
          <span class="v2-cat-pie absolute inset-x-0 bottom-0 flex items-end justify-between gap-2 p-3 pt-12 text-white">
            <span class="text-t17 leading-5 font-semibold text-balance">{a.nombre}</span>
            <span class="v2-cat-flecha" aria-hidden="true"><Ico nombre="arrow-right" tamano={16} /></span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-navy-100 pt-6">
    <p class="text-t15 text-navy-500">También:</p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2" role="list">
      {resto.map(a => <li><a href={`${base}/cursos/${a.slug}/`} class="v2-subrayado inline-flex min-h-11 items-center text-t17 font-medium text-navy-950">{a.nombre}</a></li>)}
      {externas.map(c => <li><a href={c.externalUrl} target="_blank" rel={relDe(c.externalUrl, '_blank')} class="v2-subrayado inline-flex min-h-11 items-center gap-1 text-t17 font-medium text-navy-950">{nombreArea(c.name)} <span class="text-t13 font-normal text-navy-500">(Academia especializada)</span><Ico nombre="external-link" tamano={14} /></a></li>)}
    </ul>
    <a href={`${base}/cursos/`} class="v2-enlace ml-auto min-h-11">Ver las {nav.areas.length} áreas <Ico nombre="arrow-right" tamano={18} class="v2-flecha" /></a>
  </div>
</section>

<style is:global>
  /* Áreas con foto (E1, ronda 5): nombre y flecha sobre la foto con un degradado que asegura el contraste, recuento en
     una pastilla y la misma flecha en círculo de marca que las tarjetas de curso. Solo `scale` y colores al pasar. */
  .v2-cat-pie { background: linear-gradient(0deg, rgb(27 27 58 / .88) 0, rgb(27 27 58 / .55) 55%, rgb(27 27 58 / 0)); }
  .v2-cat-flecha { display: grid; flex: none; place-items: center; width: 32px; height: 32px; border-radius: 999px; background: var(--color-coral-600); color: #fff; }
  .v2-cat:focus-visible { outline: 3px solid var(--color-coral-600); outline-offset: 3px; }
  @media (prefers-reduced-motion: no-preference) {
    .v2-cat-foto { transition: scale var(--t-lento) var(--e-sale); }
    .v2-cat-flecha svg { transition: translate var(--t-rapido) var(--e-sale); }
    .v2-cat:is(:hover, :focus-visible) .v2-cat-foto { scale: 1.04; }
    .v2-cat:is(:hover, :focus-visible) .v2-cat-flecha svg { translate: 2px 0; }
  }
</style>
