---
/**
 * Categorías · «Filas» (prototipo 19). Dos filas de tarjetas de área que corren en sentidos contrarios (marquesina CSS:
 * pista duplicada, la copia con `aria-hidden` y `tabindex="-1"`), y debajo pastillas de acceso rápido. Cada tarjeta es
 * el enlace del área con su foto, su nombre y su número de cursos; no lleva pregunta ni precio porque `Categorias`
 * no recibe ni uno ni otro. Pausa con botón visible, con el cursor encima, con el foco dentro, con la pestaña oculta
 * y fuera de pantalla. Con «reducir movimiento» (o sin JS) las filas quedan quietas, con scroll horizontal y snap.
 * Mismas props, mismo `id` y mismo H2 que `Categorias.astro`. Las pastillas son «También:» (mismo texto y enlaces)
 * más «Ver las N áreas».
 */
import { relDe } from '@/lib/enlaces-propios';
import Ico from '../../Ico.astro';
import Foto from '../../Foto.astro';
import { nombreArea, type DatosNavegacion } from '../../../navegacion';
type Area = DatosNavegacion['areas'][number];
interface Props { copy: { eyebrow: string; title: string; description: string }; base: string; conFoto: Area[]; resto: Area[]; externas: { name: string; externalUrl?: string }[]; total: number }
const { copy: c, base, conFoto, resto, externas, total } = Astro.props;
const copy = { categories: c };
const nav = { areas: { length: total } };
const cuentaDe = (a: Area) => (a.total === 1 ? '1 curso' : `${a.total} cursos`);
/* Dos filas; cada una repite sus tarjetas hasta pasar de 6 para que la media pista cubra una pantalla ancha. */
const mitad = Math.ceil(conFoto.length / 2);
const filas = [conFoto.slice(0, mitad), conFoto.slice(mitad)].filter(f => f.length > 0).map(f => ({
  areas: f, reps: Math.max(1, Math.ceil(6 / f.length)),
}));
---
<!-- Áreas -->
<section id="categorias" class="v2-cf scroll-mt-24 pt-24 lg:pt-32" aria-labelledby="categorias-titulo" data-cat-filas>
  <div class="v2-contenedor">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
      <div>
        <p class="v2-antetitulo text-navy-700">{copy.categories.eyebrow}</p>
        <h2 id="categorias-titulo" class="mt-3 font-display text-d28 lg:text-d40">{copy.categories.title}</h2>
        {copy.categories.description && <p class="mt-3 max-w-[640px] text-t17 text-navy-700">{copy.categories.description}</p>}
      </div>
      <button type="button" class="v2-cf-pausa" data-cf-pausa aria-pressed="false" hidden>
        <Ico nombre="pause" tamano={16} class="v2-cf-ico-pausa" /><Ico nombre="play" tamano={16} class="v2-cf-ico-seguir" />
        <span data-cf-pausa-texto>Pausar el movimiento</span>
      </button>
    </div>
  </div>
  <div class="v2-cf-filas mt-8" role="group" aria-label="Áreas de cursos">
    {filas.map((fila, k) => (
      <div class:list={['v2-cf-carril', k % 2 === 1 && 'v2-cf-inversa']} style={`--n: ${fila.areas.length * fila.reps}`}>
        <ul class="v2-cf-pista" role="list">
          {[0, 1].map(copia => Array.from({ length: fila.reps }, (_, r) => fila.areas.map(a => {
            const oculta = copia === 1 || r > 0;
            return (
              <li class="v2-cf-tarjeta" aria-hidden={oculta ? 'true' : undefined}>
                <a href={`${base}/cursos/${a.slug}/`} class="v2-cf-enlace" tabindex={oculta ? -1 : undefined}>
                  <span class="v2-cf-foto">
                    {a.foto ? <Foto nombre={a.foto} sizes="(min-width: 1024px) 300px, 240px" decorativa class="h-full w-full object-cover" />
                      : a.fotoCms && <img src={a.fotoCms} alt="" width="480" height="600" loading="lazy" decoding="async" class="h-full w-full object-cover" />}
                  </span>
                  <span class="v2-cf-texto">
                    <span class="flex items-center justify-between gap-2 text-t17 font-semibold">{a.nombre}<Ico nombre="arrow-right" tamano={18} class="v2-cf-flecha" /></span>
                    <span class="text-t13">{cuentaDe(a)}</span>
                  </span>
                </a>
              </li>
            );
          })))}
        </ul>
      </div>
    ))}
  </div>
  <div class="v2-contenedor">
    <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-navy-100 pt-6">
      <p class="text-t15 text-navy-500">También:</p>
      <ul class="flex flex-wrap gap-3" role="list">
        {resto.map(a => <li><a href={`${base}/cursos/${a.slug}/`} class="v2-cf-pastilla">{a.nombre}</a></li>)}
        {externas.map(c => <li><a href={c.externalUrl} target="_blank" rel={relDe(c.externalUrl, '_blank')} class="v2-cf-pastilla">{nombreArea(c.name)} <span class="text-t13 font-normal text-navy-500">(Academia especializada)</span><Ico nombre="external-link" tamano={14} /></a></li>)}
      </ul>
      <a href={`${base}/cursos/`} class="v2-enlace ml-auto min-h-11">Ver las {nav.areas.length} áreas <Ico nombre="arrow-right" tamano={18} class="v2-flecha" /></a>
    </div>
  </div>
</section>

<style is:global>
  @layer components {
    .v2-cf { overflow-x: clip; }
    .v2-cf-filas { display: grid; gap: 16px; }
    /* Por defecto (reducir movimiento o sin JS): carril quieto con scroll horizontal y snap; las copias no se ven. */
    .v2-cf-carril { overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: thin; padding: 6px max(16px, calc((100vw - 1200px) / 2)); }
    .v2-cf-pista { display: flex; width: max-content; }
    .v2-cf-tarjeta { flex: none; margin-inline-end: 16px; scroll-snap-align: start; }
    .v2-cf-tarjeta[aria-hidden='true'] { display: none; }
    .v2-cf-enlace {
      position: relative; display: block; width: 240px; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius-c-lg);
      background: var(--color-navy-900); color: #fff; transition: scale var(--t-base) var(--e-sale);
    }
    @media (min-width: 1024px) { .v2-cf-enlace { width: 300px; } }
    .v2-cf-foto { position: absolute; inset: 0; }
    .v2-cf-foto picture { display: block; height: 100%; }
    .v2-cf-foto img { transition: scale var(--t-lento) var(--e-sale); }
    .v2-cf-texto { position: absolute; inset: auto 0 0 0; display: grid; gap: 2px; padding: 40px 16px 14px; background: linear-gradient(transparent, rgb(27 27 58 / .94) 60%); }
    .v2-cf-texto .text-t13 { color: rgb(255 255 255 / .85); }
    .v2-cf-enlace:focus-visible { outline: 3px solid var(--color-coral-600); outline-offset: 3px; }
    @media (hover: hover) and (pointer: fine) {
      .v2-cf-enlace:hover { scale: 1.03; }
      .v2-cf-enlace:hover .v2-cf-foto img { scale: 1.06; }
    }

    .v2-cf-pausa {
      display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: 999px;
      font-size: 14px; font-weight: 600; color: var(--color-navy-950); box-shadow: inset 0 0 0 1px var(--color-navy-100); background: #fff;
    }
    .v2-cf-pausa[hidden] { display: none; }
    .v2-cf-pausa:focus-visible { outline: 3px solid var(--color-coral-600); outline-offset: 3px; }
    .v2-cf-pausa .v2-cf-ico-seguir, .v2-cf-pausa[aria-pressed='true'] .v2-cf-ico-pausa { display: none; }
    .v2-cf-pausa[aria-pressed='true'] .v2-cf-ico-seguir { display: block; }

    .v2-cf-pastilla {
      display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 18px; border-radius: 999px; background: #fff;
      font-size: 16px; font-weight: 600; color: var(--color-navy-950); box-shadow: inset 0 0 0 1px var(--color-navy-100);
      transition: translate var(--t-rapido) var(--e-sale);
    }
    .v2-cf-pastilla:focus-visible { outline: 3px solid var(--color-coral-600); outline-offset: 2px; }
    @media (hover: hover) and (pointer: fine) { .v2-cf-pastilla:hover { translate: 0 -2px; } }

    /* Marquesina: solo con movimiento permitido y con JS (el botón de pausa existe). Solo translate. */
    @media (prefers-reduced-motion: no-preference) {
      .v2-cf[data-vivo] .v2-cf-carril { overflow: hidden; padding-inline: 0; scroll-snap-type: none; }
      .v2-cf[data-vivo] .v2-cf-tarjeta[aria-hidden='true'] { display: block; }
      .v2-cf[data-vivo] .v2-cf-pista { animation-name: v2-cf-pasa; animation-duration: calc(var(--n) * 7s); animation-timing-function: linear; animation-iteration-count: infinite; }
      .v2-cf[data-vivo] .v2-cf-inversa .v2-cf-pista { animation-direction: reverse; }
      .v2-cf[data-vivo] .v2-cf-filas:hover .v2-cf-pista, .v2-cf[data-vivo] .v2-cf-filas:focus-within .v2-cf-pista,
      .v2-cf[data-pausado] .v2-cf-pista, .v2-cf[data-fuera] .v2-cf-pista { animation-play-state: paused; }
      @keyframes v2-cf-pasa { to { translate: -50% 0; } }
    }
  }
</style>

<script>
  for (const raiz of document.querySelectorAll<HTMLElement>('[data-cat-filas]')) {
    if (!raiz.checkVisibility()) continue;
    const boton = raiz.querySelector<HTMLButtonElement>('[data-cf-pausa]');
    const texto = raiz.querySelector<HTMLElement>('[data-cf-pausa-texto]');
    if (!boton || matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    raiz.setAttribute('data-vivo', '');
    boton.hidden = false;
    boton.addEventListener('click', () => {
      const p = raiz.toggleAttribute('data-pausado');
      boton.setAttribute('aria-pressed', String(p));
      if (texto) texto.textContent = p ? 'Reanudar el movimiento' : 'Pausar el movimiento';
    });
    /* Pestaña oculta o fuera de pantalla: la marquesina se detiene sola (sin cambiar lo que eligió la persona). */
    const fuera = () => raiz.toggleAttribute('data-fuera', document.hidden || !visible);
    let visible = true;
    document.addEventListener('visibilitychange', fuera);
    if ('IntersectionObserver' in window) new IntersectionObserver(([e]) => { visible = !!e?.isIntersecting; fuera(); }).observe(raiz);
  }
</script>
