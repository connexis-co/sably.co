---
/**
 * «Los oficios convergen» (bloque `convergen`, HEROES-X.md §5, prototipo 08). Doce fotos de oficio empiezan
 * dispersas y, al bajar, se juntan en la rejilla del catálogo; al cerrarse aparece la cifra real de cursos, áreas y
 * países. CSS puro (0 B de JS): sección alta con escenario sticky y `view-timeline` con nombre. Solo translate,
 * rotate, scale y opacity. Sin soporte de animaciones ligadas al scroll o con «reducir movimiento»: la rejilla final
 * quieta y la cifra visible (el mismo HTML). Cada celda es un enlace a su curso.
 */
import Foto from '../Foto.astro';
import Ico from '../Ico.astro';
import NotaFuente from '@/components/v2/NotaFuente.astro';
import { corto } from './heroe/comun';
import type { OficioMosaico } from './Heroe.astro';
interface Props { oficios: OficioMosaico[]; base: string; cursos: number; areas: number; paises: number; hoy: string }
const { oficios, base, cursos, areas, paises, hoy } = Astro.props;
/* Punto de partida de cada foto (vw, vh, grados), el del prototipo. */
const DESDE: [number, number, number][] = [[-38, -30, -9], [-12, -42, 6], [14, -38, -5], [40, -26, 10], [-44, 2, 7], [-16, 8, -12], [18, 4, 8], [44, 6, -6], [-36, 34, -8], [-10, 44, 5], [16, 40, -10], [40, 32, 9]];
---
<section class="v2-converge mt-24 lg:mt-32" aria-labelledby="converge-titulo">
  <div class="v2-converge-escena v2-contenedor">
    <ul class="v2-converge-rejilla" role="list" aria-label="Algunos oficios de Sably">
      {oficios.slice(0, 12).map((o, i) => (
        <li style={`--x: ${DESDE[i]![0]}vw; --y: ${DESDE[i]![1]}vh; --r: ${DESDE[i]![2]}deg`}>
          <a href={`${base}/${o.id}/`}><Foto nombre={o.foto} sizes="(min-width: 1024px) 260px, 30vw" decorativa class="h-full w-full object-cover" /><span>{corto(o.titulo)}</span></a>
        </li>
      ))}
    </ul>
    <h2 id="converge-titulo" class="v2-converge-cifra font-display"><b>{cursos} cursos</b> de {areas} áreas, con el precio de {paises} países.</h2>
    <a href={`${base}/cursos/`} class="v2-btn v2-btn-principal v2-converge-cta" data-alto="52">Ver los {cursos} cursos <Ico nombre="arrow-right" tamano={18} class="v2-flecha" /></a>
    <NotaFuente class="v2-converge-fuente">Cursos, áreas y países contados el {hoy}.</NotaFuente>
  </div>
</section>

<style is:global>
  @layer components {
    .v2-converge { position: relative; overflow-x: clip; view-timeline-name: --converge; view-timeline-axis: block; }
    .v2-converge-escena { display: grid; gap: 28px; justify-items: center; padding-block: 48px; text-align: center; max-width: 1100px; }
    .v2-converge-rejilla { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; width: 100%; }
    @media (min-width: 700px) { .v2-converge-rejilla { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; } }
    .v2-converge-rejilla a { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius-c-lg); background: var(--color-navy-50); color: #fff; text-decoration: none; }
    .v2-converge-rejilla picture { display: contents; }
    .v2-converge-rejilla span { position: absolute; inset: auto 0 0 0; padding: 18px 8px 6px; background: linear-gradient(transparent, rgb(27 27 58 / .82)); font: 600 13px/17px var(--font-sans); text-align: left; }
    @media (min-width: 700px) { .v2-converge-rejilla span { font-size: 14px; padding: 22px 10px 8px; } }
    .v2-converge-cifra { margin: 0; color: var(--color-navy-950); font-size: clamp(28px, 4.4vw, 48px); line-height: 1.1; letter-spacing: -.02em; text-wrap: balance; }
    .v2-converge-cifra b { color: var(--color-coral-600); font-weight: inherit; }
    /* Mejora: solo con soporte y sin «reducir movimiento». Longhands: el minificador funde animation-timeline en la abreviada. */
    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) and (animation-range: contain 0% contain 100%) {
        .v2-converge { height: 260vh; }
        .v2-converge-escena { position: sticky; top: 0; min-height: 100vh; align-content: center; }
        @keyframes v2-junta { from { translate: var(--x) var(--y); rotate: var(--r); scale: .72; } }
        .v2-converge-rejilla li { animation-name: v2-junta; animation-duration: auto; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: --converge; animation-range: contain 0% contain 55%; }
        @keyframes v2-converge-aparece { from { opacity: 0; translate: 0 16px; } }
        .v2-converge-cifra, .v2-converge-cta, .v2-converge-fuente { animation-name: v2-converge-aparece; animation-duration: auto; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: --converge; animation-range: contain 50% contain 70%; }
      }
    }
  }
</style>
