---
/**
 * «Cómo funciona Sably» (bloque `como-funciona`, D2, estudio de movimiento F7). Cuatro pasos con un carril
 * coral que avanza y un número que se enciende cuando el paso cruza el 45 % de la ventana (estado, con un
 * IntersectionObserver: funciona sin animaciones ligadas al scroll). El texto de cada paso entra 12 px ligado
 * al scroll solo donde hay `animation-timeline` y sin «reducir movimiento».
 * Sin JavaScript, o con la animación apagada en el panel, todo se ve encendido y quieto.
 */
import Foto from '../Foto.astro';
interface Props { animado?: boolean }
const { animado = true } = Astro.props;
const COMO_FUNCIONA = [
  { titulo: 'Eliges el curso', texto: 'Cada ficha muestra qué aprenderás, el temario, la duración y el precio para tu país.' },
  { titulo: 'Te inscribes en Hotmart', texto: 'El pago se hace en Hotmart, la plataforma donde el creador publica su curso.' },
  { titulo: 'Estudias a tu ritmo', texto: 'Recibes el acceso por correo y ves las clases en video desde el celular o el computador.' },
  { titulo: 'Tienes 7 días de garantía', texto: 'Si no es lo que esperabas, pides el reembolso en Hotmart dentro de ese plazo.' },
];
---
<section id="como-funciona" class="v2-contenedor grid scroll-mt-24 gap-10 pt-28 lg:grid-cols-[minmax(0,1fr)_480px] lg:gap-16 lg:pt-40" aria-labelledby="como-funciona-title">
  <div>
    <p class="v2-antetitulo text-navy-700">Con transparencia</p>
    <h2 id="como-funciona-title" class="mt-3 font-display text-d28 lg:text-d40">Cómo funciona Sably</h2>
    <p class="mt-4 max-w-[600px] text-t17 text-navy-700">Sably es una plataforma de educación online para aprender oficios en español. Reúne cursos seleccionados de creadores independientes, guías y vídeos gratuitos, ordenados por oficio y por país.</p>
    <ol class="v2-pasos mt-8" role="list" data-pasos={animado ? '' : undefined} style={`--total: ${COMO_FUNCIONA.length}`}>
      {COMO_FUNCIONA.map((paso, i) => (
        <li class="v2-paso" data-paso={i}>
          <span class="v2-paso-num v2-num" aria-hidden="true">{i + 1}</span>
          <div class="v2-paso-texto"><h3 class="font-display text-t20 font-semibold">{paso.titulo}</h3><p class="mt-1 text-t17 text-navy-700">{paso.texto}</p></div>
        </li>
      ))}
    </ol>
    <p class="mt-6 text-t15 text-navy-700">Sably es un proyecto de Connexis, agencia colombiana de desarrollo web y marketing digital. <a href="/nosotros/" class="font-semibold text-navy-950 underline underline-offset-4">Conoce quién está detrás</a></p>
  </div>
  <figure>
    <div class="overflow-hidden rounded-c-xl"><Foto nombre="foto-portada-practica-vertical-1" sizes="(min-width: 1024px) 480px, 100vw" class="aspect-[4/5] w-full object-cover" /></div>
    <figcaption class="mt-3 text-t13 text-navy-500">Paso 3. Repites la técnica en casa, a tu ritmo.</figcaption>
  </figure>
</section>

<style is:global>
  @layer components {
    .v2-pasos { position: relative; --avance: 1; }
    /* Carril gris y, encima, el coral que se llena de arriba abajo (scaleY: solo transform). */
    .v2-pasos::before, .v2-pasos::after { content: ''; position: absolute; left: 19px; top: 40px; bottom: 40px; width: 2px; border-radius: 2px; }
    .v2-pasos::before { background: var(--color-navy-100); }
    .v2-pasos::after { background: var(--color-coral-500); transform-origin: top; scale: 1 var(--avance); transition: scale var(--t-lento) var(--e-sale); }
    .v2-paso { position: relative; display: grid; grid-template-columns: 40px 1fr; gap: 16px; padding: 20px 0; }
    .v2-paso-num {
      position: relative; z-index: 1; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 999px;
      font: 600 15px/1 var(--font-sans); background: var(--color-navy-950); color: #fff; box-shadow: 0 0 0 1px var(--color-navy-950);
      transition: background-color var(--t-base) var(--e-sale), color var(--t-base) var(--e-sale), box-shadow var(--t-base) var(--e-sale);
    }
    .v2-paso-texto { padding-top: 7px; }
    /* Con JavaScript: los pasos empiezan apagados y se encienden al cruzar el 45 % de la ventana. */
    .v2-pasos[data-vivo] { --avance: 0; }
    .v2-pasos[data-vivo] .v2-paso:not([data-encendido]) .v2-paso-num { background: #fff; color: var(--color-navy-500); box-shadow: 0 0 0 1px var(--color-navy-100); }
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        @keyframes v2-paso-entra { from { opacity: 0; translate: 0 12px; } }
        /* Longhands a propósito: el minificador funde animation-timeline en la abreviada y Chrome la descarta. */
        .v2-pasos[data-vivo] .v2-paso-texto { animation-name: v2-paso-entra; animation-duration: auto; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: view(); animation-range: entry 10% entry 60%; }
      }
    }
  }
</style>

<script>
  /* Enciende el número del paso que cruza el 45 % de la ventana (y los de antes) y avanza el carril hasta él. */
  for (const lista of document.querySelectorAll<HTMLElement>('[data-pasos]')) {
    if (!('IntersectionObserver' in window)) break;
    const pasos = [...lista.querySelectorAll<HTMLElement>('[data-paso]')];
    let ultimo = -1;
    const pintar = (n: number) => {
      ultimo = n;
      pasos.forEach((p, i) => p.toggleAttribute('data-encendido', i <= n));
      // El carril va del centro del primer número al del último: llega justo al número encendido.
      lista.style.setProperty('--avance', String(Math.max(0, n) / (pasos.length - 1)));
    };
    lista.setAttribute('data-vivo', '');
    const io = new IntersectionObserver(entradas => {
      for (const e of entradas) {
        const i = pasos.indexOf(e.target as HTMLElement);
        if (e.isIntersecting) { if (i > ultimo) pintar(i); }
        // Al subir por encima del paso, se apaga (solo si ya salió por abajo de la línea).
        else if (e.boundingClientRect.top > (e.rootBounds?.top ?? 0) && i <= ultimo) pintar(i - 1);
      }
    }, { rootMargin: '-45% 0px -55% 0px' });
    pasos.forEach(p => io.observe(p));
    // Si la página carga ya por debajo de la lista (ancla, vuelta atrás), todo encendido.
    if (lista.getBoundingClientRect().bottom < innerHeight * 0.45) pintar(pasos.length - 1);
  }
</script>
