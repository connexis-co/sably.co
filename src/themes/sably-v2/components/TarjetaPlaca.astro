---
/**
 * Tarjeta de curso con «placa que crece sobre la foto» (lámina `fEaNY` · widget 6, 312 × 416), para «Cursos
 * relacionados» de la ficha. En reposo, foto alta y una placa blanca abajo con el título y el oficio; con el cursor o
 * el foco la placa crece hacia arriba (`grid-template-rows: 0fr → 1fr`, 300 ms) con la promesa, los datos y «Ver el
 * curso», y la foto escala 1,03. Sin cursor (táctil) la placa sale abierta: ningún dato depende de un gesto que no
 * existe. Todo en el HTML (la parte plegada se recoge con grid, no con `display: none`, así el lector de pantalla la
 * lee). La tarjeta mide siempre lo mismo y la placa está anclada abajo: CLS 0. 0 KB de JavaScript.
 * No lleva precio a propósito (la lámina lo dice: el precio vive en la caja y en la tarjeta de listado); la otra
 * opción del panel (`relacionadosTarjeta`) vuelve a la tarjeta con precio.
 */
import { Image as OptimizedImage } from 'astro:assets';
import { cmsImageUrl } from '@/lib/cms-media';
import { courseCover } from '@/lib/categories';
import { getCategory, type Course } from '@/lib/emdash-content';
import type { Country } from '@/lib/countries';
import { resumenTarjeta } from '@/lib/presentacion-v2';
import Icono from '@/components/v2/Icono.astro';
interface Props { course: Course; country: Country }
const { course, country } = Astro.props;
const cat = (await getCategory(course.data.category))!;
const url = `/${country.code}/${course.id}/`;
const promesa = resumenTarjeta(course.data.shortDescription, 120);
const datos = [
  course.data.lessonsCount ? `${course.data.lessonsCount} lecciones` : null,
  course.data.durationHours ? `${course.data.durationHours} horas` : null,
  course.data.level || null,
].filter(Boolean).join(' · ');
---
<article class="v2-placa-tarjeta group" data-tarjeta-placa={course.id}>
  <OptimizedImage
    src={cmsImageUrl(course.cardImage) ?? cmsImageUrl(course.coverImage) ?? courseCover(course.id, cat.slug, 'card')}
    alt="" width={480} height={640} sizes="(min-width: 1024px) 312px, (min-width: 640px) 50vw, 100vw"
    loading="lazy" decoding="async" class="v2-placa-foto" />
  <div class="v2-placa">
    <h3 class="v2-placa-titulo"><a href={url} class="v2-placa-enlace">{course.data.title}</a></h3>
    <p class="v2-placa-oficio">{cat.name}</p>
    <div class="v2-placa-mas">
      <div>
        {promesa && <p class="v2-placa-promesa">{promesa}</p>}
        <p class="v2-placa-datos">{datos}</p>
        <p class="v2-placa-ver" aria-hidden="true">Ver el curso <Icono nombre="arrow-right" tamano={16} /></p>
      </div>
    </div>
  </div>
</article>
<style>
  .v2-placa-tarjeta {
    position: relative; isolation: isolate; display: flex; flex-direction: column; justify-content: flex-end;
    height: 416px; padding: 8px; overflow: hidden; border-radius: var(--radius-c-lg); background: var(--color-navy-100);
  }
  .v2-placa-foto { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; transition: scale 300ms var(--e-sale); }
  .v2-placa { padding: 16px; border-radius: 12px; background: #fff; box-shadow: 0 12px 32px -12px rgb(27 27 58 / 0.28); }
  .v2-placa-titulo { font: 600 20px/26px var(--font-display); color: var(--color-navy-950); text-wrap: balance; }
  .v2-placa-enlace { color: inherit; text-decoration: none; }
  /* Toda la tarjeta es el enlace (un solo destino de Tab). */
  .v2-placa-enlace::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .v2-placa-enlace:focus-visible { outline: none; }
  .v2-placa-tarjeta:has(.v2-placa-enlace:focus-visible) { outline: 3px solid var(--color-coral-600); outline-offset: 3px; }
  .v2-placa-oficio { margin-top: 2px; font-size: 13px; line-height: 20px; color: var(--color-navy-500); }
  .v2-placa-mas { display: grid; grid-template-rows: 1fr; }
  .v2-placa-mas > div { overflow: hidden; min-height: 0; }
  .v2-placa-promesa { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--color-navy-100); font-size: 15px; line-height: 22px; color: var(--color-navy-700); }
  .v2-placa-datos { margin-top: 10px; font-size: 13px; line-height: 20px; color: var(--color-navy-500); }
  .v2-placa-ver { display: inline-flex; align-items: center; gap: 6px; margin-top: 10px; font: 600 15px/22px var(--font-sans); color: var(--color-navy-950); }
  /* Con cursor: en reposo, plegada; crece con el cursor o el foco. Sin cursor (táctil), abierta de serie. */
  @media (hover: hover) and (pointer: fine) {
    .v2-placa-mas { grid-template-rows: 0fr; transition: grid-template-rows 300ms var(--e-sale); }
    .v2-placa-mas > div { opacity: 0; transition: opacity 150ms var(--e-sale); }
    .v2-placa-tarjeta:is(:hover, :focus-within) .v2-placa-mas { grid-template-rows: 1fr; }
    .v2-placa-tarjeta:is(:hover, :focus-within) .v2-placa-mas > div { opacity: 1; transition-delay: 100ms; }
    .v2-placa-tarjeta:is(:hover, :focus-within) .v2-placa-foto { scale: 1.03; }
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-placa-mas, .v2-placa-mas > div, .v2-placa-foto { transition: none !important; }
    .v2-placa-tarjeta:is(:hover, :focus-within) .v2-placa-foto { scale: none; }
  }
</style>
