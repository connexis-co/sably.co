---
/**
 * «Disponible online en {país}»: las ciudades del país en pastillas de texto, la
 * misma lista y la misma fuente (`country.cities` del CMS) que la ficha clásica
 * («Malla geo interna» en src/components/CourseLanding.astro). Era lo único que
 * la ficha V2 había perdido frente al clásico (docs/equipo/2026-11-25/seo/
 * ciudades.md, punto 4); JP la pidió de vuelta el 25-nov para ChatGPT, que lee el
 * HTML inicial y no ejecuta JavaScript.
 *
 * Límites (riesgo 10 de seo/riesgo-spam.md): rótulo y no encabezado, cada ciudad
 * una vez, sin enlaces, sin URL nuevas y sin texto distinto por ciudad ni
 * promesas locales (sedes, «academia en X»). Igual en todas las fichas del país.
 * Se apaga desde el panel (ajuste `mostrarCiudades`) sin dejar hueco.
 */
import type { Country } from '@/lib/countries';
interface Props { country: Country; mostrar: boolean; class?: string }
const { country, mostrar, class: clase } = Astro.props;
// [slug, nombre], cada ciudad una vez. El slug solo marca la ciudad que el visitante eligió (SelectorCiudad.astro).
const ciudades = [...new Map((country.cities ?? []).map(c => [c.name.trim().toLowerCase(), [c.slug, c.name.trim()] as const])).values()].filter(([, n]) => n);
---
{mostrar && ciudades.length > 0 && (
  <div class:list={['v2-ciudades', clase]} role="group" aria-labelledby="titulo-ciudades" data-ciudades={country.code}>
    <p id="titulo-ciudades" class="text-t15 font-semibold text-navy-950">Disponible online en {country.name}</p>
    <ul class="mt-3 flex flex-wrap gap-2" role="list">
      {ciudades.map(([slug, nombre]) => <li class="relative rounded-full bg-white px-3 py-1 text-t13 font-medium text-navy-700 ring-1 ring-navy-100" data-ciudad-slug={slug}>{nombre}</li>)}
    </ul>
  </div>
)}
