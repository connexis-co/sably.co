---
/**
 * Caja de compra V2 (lámina RGZQ7). Variante E «Cuenta clara» por defecto y B
 * «Cabecera oscura» desde el panel. Nombres de bloque según el módulo común con
 * la academia (contrato-ia-caja.md): titulo, subtitulo, promocion, precio,
 * cupon, boton, confianza (pago-seguro, garantia, constancia, medios),
 * acordeon, pais, whatsapp, nota_legal.
 *
 * Reutiliza lo ya verificado de PurchasePanel.astro: el servidor pinta el
 * enlace correcto; el script solo alterna el cupón (precio y enlace cambian a
 * la vez, la atribución se conserva) y, al vencer la campaña, vuelve al precio
 * normal. Los atributos data-* de la <section> los lee `npm run precio:test` y
 * la analítica: no se renombran.
 */
import Icono from '@/components/v2/Icono.astro';
import Estrellas from '@/components/v2/Estrellas.astro';
import Boton from '@/components/v2/Boton.astro';
import Contador from '@/components/v2/Contador.astro';
import Acordeon from '@/components/v2/Acordeon.astro';
import Bandera from '@/components/v2/Bandera.astro';
import LogosPago from '@/components/v2/LogosPago.astro';
import LogoHotmart from '@/components/v2/LogoHotmart.astro';
import Precio from '@/components/v2/Precio.astro';
import { buildWhatsAppUrl } from '@/lib/hotmart';
import { fechaCorta } from '@/lib/cuenta-atras';
import { nombresCreadores } from '@/lib/creadores';
import { importe, fotoPropia, iniciales } from '@/lib/presentacion-v2';
import { rellenarPlantilla, type AjustesV2 } from '@/lib/ajustes-tema';
import { docConAjustes } from '@/lib/caja/sably';
import { resolverZona } from '@/lib/caja/resolver';
import type { Bloque, Condicion } from '@/lib/caja/model';
import { notaHotmart } from '@/lib/opiniones';
import type { Ficha } from '@/lib/ficha';
import type { Country } from '@/lib/countries';

interface Props { f: Ficha; country: Country; ajustes: AjustesV2 }
const { f, country, ajustes } = Astro.props;
const { offer, quote, real, baseAmount, currency, localCheckout, marketLinks, promoRow, promoSiguiente, creadoresVisibles, course, proveedor, nombreEnFrase, valoracion } = f;

/* Qué bloques lleva la caja, en qué variante y con qué textos: el núcleo común con la
   academia (src/lib/caja/, copia exacta de la suya) sobre el documento de Sably. */
const zona = resolverZona({ doc: docConAjustes(ajustes.caja), curso: { courseId: course.id, escuela: proveedor, cajaElementos: null }, zona: 'caja' });
const cumple = (si?: Condicion) => !si
  || ((!si.campana || (si.campana === 'sin' ? !offer : si.campana === 'con-fechas' ? Boolean(offer?.end) : Boolean(offer)))
    && (!si.cupon || (si.cupon === 'aplicado') === Boolean(offer))
    && (!si.paises?.length || si.paises.map(p => p.toLowerCase()).includes(country.code)));
const bloque = (tipo: Bloque['tipo']) => zona.bloques.find(b => b.tipo === tipo && b.visible && cumple(b.si)) ?? null;
const hijos = (tipo: Bloque['tipo']) => (bloque(tipo)?.hijos ?? []).filter(h => h.visible && cumple(h.si));
const hijo = (tipo: Bloque['tipo'], item: Bloque['tipo']) => hijos(tipo).some(h => h.tipo === item);

/* Un solo formato de precio (símbolo + cifra del país + código): src/lib/presentacion-v2.ts. */
const precio = (valor: number) => importe(valor, currency, country.hreflang);
const conMoneda = (valor: number) => precio(valor).texto;
const loc = country.hreflang;
const conPrecio = Boolean(quote || real);
const estado = offer ? 'campana' : conPrecio ? 'normal' : 'sin-precio';
const reducido = offer && quote?.reduced ? quote.reduced : null;
const descuento = reducido ? baseAmount - reducido : null;
const discounted = new URL(localCheckout.href);
if (offer) discounted.searchParams.set('offDiscount', offer.coupon);
const enlaceInicial = offer ? discounted.href : localCheckout.href;
const campana = promoRow?.etiqueta || promoRow?.nombre || null;
const fin = offer?.end ? `${fechaCorta(offer.end)}, hora de Colombia` : null;
const variante = zona.preajuste === 'cabecera-oscura' && offer && bloque('promocion') ? 'cabecera-oscura' : 'cuenta-clara';
const leida = quote?.at ? new Intl.DateTimeFormat('es-CO', { timeZone: 'America/Bogota', day: 'numeric', month: 'short', year: 'numeric' }).format(quote.at).replace(/ de /g, ' ') : null;
const whatsapp = buildWhatsAppUrl(country.whatsapp, `Hola, tengo una duda antes de inscribirme en «${course.data.title}»`);
const creador = ajustes.mostrarCreador && creadoresVisibles.length ? nombresCreadores(creadoresVisibles.map(c => c.nombre)) : null;
const foto = ajustes.mostrarCreador ? creadoresVisibles.map(c => c.foto).find(fotoPropia) ?? null : null;
const siglas = creador ? iniciales(creadoresVisibles[0]!.nombre) : '';
/* Si a la misma hora empieza otra campaña con descuento (Black Friday → Cyber Monday),
   no se promete la vuelta al precio normal: solo cuándo termina esta. */
const despues = descuento && !promoSiguiente ? `Después vuelve a ${conMoneda(baseAmount)}.` : null;
const variables = { curso: nombreEnFrase, escuela: creadoresVisibles.length ? nombresCreadores(creadoresVisibles.map(c => c.nombre)) : '' };
const texto = (tipo: Bloque['tipo']) => { const b = bloque(tipo); return b?.textos?.texto ? rellenarPlantilla(b.textos.texto, variables) : ''; };
const titulo = texto('titulo');
const subtitulo = texto('subtitulo');
const reloj = bloque('promocion') && bloque('promocion')!.opciones?.reloj !== 'no';
const whatsappBloque = bloque('whatsapp');
const nota = bloque('calificacion') ? notaHotmart(valoracion) : null;
const preguntas = hijos('acordeon');
const tituloId = 'titulo-compra';
---
<section id="compra" tabindex="-1" aria-labelledby={tituloId}
  class:list={['v2-caja scroll-mt-28 overflow-hidden rounded-c-lg bg-white shadow-s2 outline-none', variante === 'cabecera-oscura' && 'v2-caja-oscura']}
  data-purchase-panel data-base={conPrecio ? conMoneda(baseAmount) : undefined} data-reduced={reducido ? conMoneda(reducido) : undefined}
  data-base-hablado={conPrecio ? precio(baseAmount).hablado : undefined} data-reduced-hablado={reducido ? precio(reducido).hablado : undefined} data-original-url={localCheckout.href}
  data-discount-url={offer ? discounted.href : undefined} data-until={offer?.end} data-precio-hasta={offer ? (offer.hastaPrecio ?? 'nunca') : undefined}
  data-currency={currency} data-base-amount={conPrecio ? baseAmount : undefined} data-reduced-amount={reducido ?? undefined}
  data-quote-source={quote?.fuente ?? 'respaldo'} data-quote-at={quote?.at ?? undefined}
  data-estado={estado} data-cupon={offer ? 'aplicado' : undefined} data-variante={variante} data-resaltada={ajustes.caja.resaltada ? '' : undefined}
  data-precio-normal={ajustes.caja.precioNormal}
  data-codigo={offer?.coupon} data-pct={offer?.saving} data-campana={campana ?? undefined} data-preajuste={zona.preajuste}>

  {variante === 'cabecera-oscura' && offer ? (
    <div class="bg-navy-950 px-6 pt-6 pb-5 text-white" data-bloque="promocion">
      {titulo && <h2 id={tituloId} class="text-t20 font-semibold !text-white">{titulo}</h2>}
      {!titulo && <h2 id={tituloId} class="sr-only">Inscripción al curso</h2>}
      {subtitulo && <p class="mt-1 text-t15 text-white/75">{subtitulo}</p>}
      <div class="mt-5 flex items-end justify-between gap-4 border-t border-white/15 pt-5">
        <div>
          {campana && <p class="text-t13 font-semibold text-coral-500">{campana}</p>}
          <p class="v2-num font-display text-d40 font-semibold">{offer.saving} % <span class="text-t15 font-normal text-white/75">menos</span></p>
        </div>
        {offer.end && reloj && <Contador hasta={offer.end} desde={promoRow?.desde} estilo="casillas" oscuro vivo={ajustes.caja.movimiento} class="[&_p]:hidden" />}
      </div>
      {bloque('cupon') && <p class="mt-3 flex items-center gap-2 text-t13 font-semibold" data-bloque="cupon"><Icono nombre="circle-check" tamano={16} class="text-whatsapp" /><span data-cupon-texto>Cupón {offer.coupon} aplicado</span>
        <button type="button" data-toggle class="ml-auto min-h-9 font-medium text-white underline underline-offset-4">Quitar</button></p>}
      {fin && <p class="text-t13 text-white/70">Termina el {fin}</p>}
    </div>
  ) : (
    (titulo || subtitulo) ? (
      <div class:list={['v2-caja-titulo px-6 pt-6', ajustes.caja.tituloCentrado && 'v2-caja-titulo-centro text-center']} data-bloque="titulo">
        {titulo ? <h2 id={tituloId} class="text-t20 font-semibold text-balance">{titulo}</h2> : <h2 id={tituloId} class="sr-only">Inscripción al curso</h2>}
        {subtitulo && <p class="mt-1 text-t15 text-navy-700 max-lg:hidden">{subtitulo}</p>}
        {/* C8 (añadido de JP a la ronda 2): línea corta y centrada bajo el subtítulo, del 45 % del ancho. */}
        {ajustes.caja.tituloCentrado && (titulo || subtitulo) && <span class="v2-caja-filete mx-auto mt-4 block h-0.5 w-[45%] rounded-full bg-navy-100" aria-hidden="true"></span>}
      </div>
    ) : <h2 id={tituloId} class="sr-only">Inscripción al curso</h2>
  )}

  <div class="v2-caja-cuerpo px-6 pt-5 pb-6">
    {/* C10: la fila del país, de fábrica oculta (el país y la moneda siguen en «País y moneda» y en la cabecera). */}
    {ajustes.caja.pais && <p class="flex items-center gap-2 text-t13 text-navy-700" data-bloque="pais"><Bandera codigo={country.code} />Precio para {country.name}</p>}

    {estado === 'campana' && variante === 'cuenta-clara' && descuento && (
      <dl class="mt-4 space-y-2 border-b border-navy-100 pb-4 text-t15" data-bloque="precio">
        <div class="flex items-baseline justify-between gap-3">
          <dt class="text-navy-700">Precio normal</dt>
          <dd class="text-navy-500" data-tachado><Precio valor={baseAmount} moneda={currency} locale={loc} class="v2-tachado" codigoClass="text-t13" /></dd>
        </div>
        {bloque('cupon') && <div class="flex items-baseline justify-between gap-3" data-bloque="cupon">
          <dt class="flex min-w-0 flex-wrap items-center gap-x-2 text-navy-950">
            <span data-cupon-icono class="inline-flex flex-none"><Icono nombre="circle-check" tamano={16} class="text-v2-ok" /></span>
            <span data-cupon-texto class="whitespace-nowrap">Cupón {offer!.coupon} · {offer!.saving} %</span>
            <button type="button" data-toggle class="min-h-9 text-t13 font-medium whitespace-nowrap text-navy-950 underline underline-offset-4 hover:text-coral-700">Quitar</button>
          </dt>
          <dd class="flex-none font-semibold whitespace-nowrap text-coral-700" data-cupon-cifra>{descuento ? <span data-con-cupon><Precio valor={-descuento} moneda={currency} locale={loc} codigoClass="text-t13" /></span> : null}<span data-sin-cupon class="v2-num">−{offer!.saving} %</span></dd>
        </div>}
      </dl>
    )}

    <div class="mt-4" aria-live="polite" aria-atomic="true" data-bloque="importe">
      <p class="text-t13 text-navy-500" data-precio-rotulo>{estado === 'campana' ? (variante === 'cuenta-clara' ? 'Hoy pagas' : 'Precio con cupón') : estado === 'sin-precio' ? 'Precio' : 'Precio'}</p>
      {estado === 'sin-precio'
        ? <p class="mt-1 text-t17 text-navy-700">El precio en {currency} lo ves en Hotmart antes de pagar.</p>
        : <p class="font-display text-d40 font-semibold text-navy-950"><Precio valor={reducido ?? baseAmount} moneda={currency} locale={loc} marca="amount-cifra" codigoClass="text-t20 font-medium" /></p>}
      {estado === 'campana' && variante === 'cabecera-oscura' && (
        <p class="mt-1 flex flex-wrap items-center gap-2 text-t15 text-navy-500" data-savings>antes <Precio valor={baseAmount} moneda={currency} locale={loc} class="v2-tachado" codigoClass="text-t13" /><span class="rounded-c-sm bg-coral-50 px-2 py-0.5 text-t13 font-semibold text-coral-700">Ahorras {offer!.saving} %</span></p>
      )}
    </div>

    {estado === 'campana' && variante === 'cuenta-clara' && reloj && offer?.end && (
      <Contador hasta={offer.end} desde={promoRow?.desde} estilo={ajustes.caja.contador === 'tique' ? 'linea' : ajustes.caja.contador} campana={campana} despues={despues} sigueOtra={Boolean(promoSiguiente)} cupon={offer.coupon} vivo={ajustes.caja.movimiento} class="mt-4" />
    )}
    {offer && (
      <p class="mt-4 hidden rounded-c-md bg-navy-50 p-3 text-t13 text-navy-700" data-aviso-fin>
        <Icono nombre="calendar-off" tamano={16} class="mr-1 inline align-[-3px]" />{campana ?? 'La promoción'} terminó{fin ? ` el ${fin}` : ''}. Este es el precio normal; recarga la página para ver si hay otra promoción vigente.
      </p>
    )}

    <div class="mt-5" data-bloque="boton">
      {estado === 'campana'
        ? <Boton variante="principal" completo href={enlaceInicial} target="_blank" rel="noopener nofollow sponsored" data-cta-hotmart data-cta-position="panel" data-pago data-btn-con={`Inscribirme con ${offer!.saving} %`} data-btn-sin={`Inscribirme · ${conMoneda(baseAmount)}`} data-btn-sin-hablado={`Inscribirme, ${precio(baseAmount).hablado}`}>Inscribirme con {offer!.saving} %</Boton>
        : estado === 'normal'
          ? <Boton variante="precio" completo href={localCheckout.href} target="_blank" rel="noopener nofollow sponsored" data-cta-hotmart data-cta-position="panel" data-pago aria-label={`Inscribirme, ${precio(baseAmount).hablado}`} precio={{ cifra: precio(baseAmount).visible, moneda: currency }}>Inscribirme</Boton>
          : <Boton variante="principal" completo href={localCheckout.href} target="_blank" rel="noopener nofollow sponsored" data-cta-hotmart data-cta-position="panel" data-pago>Ver precio en Hotmart</Boton>}
      <p class="mt-3 text-t13 text-navy-700" data-bloque="pago-seguro">Pagas en <LogoHotmart alto={15} class="mx-0.5" /> en {currency} · sin crear cuenta en Sably</p>
      {hijo('confianza', 'acceso') && <p class="text-t13 text-navy-500">El acceso te llega por correo al instante.</p>}
    </div>

    {creador && (
      <div class="mt-5 flex items-center gap-3 border-t border-navy-100 pt-5" data-bloque="docente">
        {foto ? <img src={foto} alt="" width="40" height="40" loading="lazy" class="size-10 rounded-full object-cover ring-1 ring-navy-100" />
              : <span class="grid size-10 flex-none place-items-center rounded-full bg-navy-950 text-t13 font-semibold text-white" aria-hidden="true">{siglas}</span>}
        <p class="text-t15 font-semibold text-navy-950">Lo dicta {creador}<span class="block text-t13 font-normal text-navy-500">Es el nombre que verás en Hotmart al pagar.</span></p>
      </div>
    )}

    {nota && <p class="mt-5 flex items-center gap-1.5 text-t13 text-navy-700" data-bloque="calificacion"><Estrellas nota={valoracion!.rating} /><strong class="v2-num ml-1 font-semibold text-navy-950">{nota.cifra}</strong> · {nota.numero} calificaciones en Hotmart</p>}

    <ul class="mt-5 space-y-3 border-t border-navy-100 pt-5 text-t15 text-navy-950" data-bloque="confianza">
      {hijo('confianza', 'garantia') && <li class="flex items-center gap-3" data-item="garantia"><span class="grid size-8 place-items-center rounded-c-sm bg-navy-50"><Icono nombre="shield-check" tamano={18} /></span>7 días para pedir reembolso</li>}
      <li class="flex items-center gap-3" data-item="constancia"><span class="grid size-8 place-items-center rounded-c-sm bg-navy-50"><Icono nombre="award" tamano={18} /></span>Constancia de finalización</li>
      {hijo('confianza', 'medios') && <li class="flex items-center gap-3" data-item="medios"><span class="grid size-8 place-items-center rounded-c-sm bg-navy-50"><Icono nombre="credit-card" tamano={18} /></span>Tarjeta o PayPal</li>}
    </ul>
    {hijo('confianza', 'medios') && <LogosPago pais={country.code} locales={false} class="mt-3 pl-11" />}

    <div class="mt-5 border-t border-navy-100" data-bloque="acordeon">
      {preguntas.map(p => p.tipo === 'clic' ? (
        <Acordeon titulo="Qué pasa al pulsar" grupo="caja" class="border-b border-navy-100" tituloClass="min-h-12 py-3 text-t15 font-medium text-navy-950">
          <ol class="list-decimal space-y-1.5 pb-4 pl-5 text-t13 text-navy-700">
            <li>Se abre Hotmart en otra pestaña, con el curso y el precio en {currency}{offer ? ` y el cupón ${offer.coupon} ya puesto` : ''}.</li>
            <li>Pagas ahí; Sably no ve ni guarda tus datos de pago.</li>
            <li>Hotmart te manda por correo el acceso a las lecciones.</li>
            <li>Tienes 7 días para pedir el reembolso desde Hotmart.</li>
            <li>Al terminar el 100 % de las lecciones, Hotmart emite tu constancia de finalización.</li>
          </ol>
        </Acordeon>
      ) : p.tipo === 'medios' ? (
        <Acordeon titulo="Medios de pago" grupo="caja" class="border-b border-navy-100" tituloClass="min-h-12 py-3 text-t15 font-medium text-navy-950">
          <div class="pb-4 text-t13 text-navy-700">
            <p>{f.FAQ_PAGO.a}</p>
            <LogosPago pais={country.code} class="mt-3" alto={18} />
          </div>
        </Acordeon>
      ) : p.tipo === 'calcula' ? (
        <Acordeon titulo="¿Cómo se calcula el precio?" grupo="caja" class="border-b border-navy-100" tituloClass="min-h-12 py-3 text-t15 font-medium text-navy-950">
          <p class="pb-4 text-t13 text-navy-700">Es el total con tarjeta que muestra Hotmart para {country.name}{leida ? `, leído el ${leida}` : ''}. Hotmart lo convierte a {currency} con su propia tasa{offer ? ` y le aplica el cupón ${offer.coupon}` : ''}; el importe final lo ves antes de pagar.</p>
        </Acordeon>
      ) : p.tipo === 'garantia' ? (
        <Acordeon titulo="Garantía de 7 días" grupo="caja" class="border-b border-navy-100" tituloClass="min-h-12 py-3 text-t15 font-medium text-navy-950">
          <p class="pb-4 text-t13 text-navy-700">Si el curso no cumple tus expectativas, pides el reembolso del 100 % en Hotmart dentro de los 7 días.</p>
        </Acordeon>
      ) : p.tipo === 'propia' && p.textos?.pregunta && p.textos?.respuesta ? (
        <Acordeon titulo={p.textos.pregunta} grupo="caja" class="border-b border-navy-100" tituloClass="min-h-12 py-3 text-t15 font-medium text-navy-950">
          <p class="pb-4 text-t13 text-navy-700">{rellenarPlantilla(p.textos.respuesta, variables)}</p>
        </Acordeon>
      ) : null)}
      <Acordeon titulo="País y moneda" grupo="caja" class="border-b border-navy-100" tituloClass="min-h-12 py-3 text-t15 font-medium text-navy-950">
        <p class="text-t13 text-navy-700">Ahora: {country.name} · {currency}. Cambiar a:</p>
        <ul class="grid grid-cols-2 gap-x-3 pb-3">{marketLinks.map(m => <li><a class="inline-block py-2 text-t13 text-navy-950 underline underline-offset-4" href={m.href}>{m.label}</a></li>)}</ul>
      </Acordeon>
    </div>
  </div>

  <div class="bg-navy-50 px-6 py-5" data-bloque="whatsapp">
    {whatsappBloque && (whatsappBloque.variante === 'enlace'
      ? <p class="text-t15 text-navy-950">¿Dudas antes de pagar? <a href={whatsapp} target="_blank" rel="noopener nofollow" class="font-semibold underline underline-offset-4">{whatsappBloque.textos?.etiqueta || 'Escríbenos por WhatsApp'}</a></p>
      : <><p class="text-t15 font-semibold text-navy-950">¿Dudas antes de pagar?</p>
        <Boton variante="whatsapp" completo href={whatsapp} target="_blank" rel="noopener nofollow" class="mt-3">{whatsappBloque.textos?.etiqueta || 'Escríbenos por WhatsApp'}</Boton></>)}
    <p class:list={['text-t13 text-navy-500', whatsappBloque && 'mt-3']} data-bloque="nota_legal">Sably recibe una comisión cuando te inscribes desde aquí, sin costo extra para ti.{leida && ` Precio leído en Hotmart el ${leida}.`}</p>
  </div>
</section>

<style>
  /* C9: «Precio normal» tachado con campaña. La clase va al componente Precio, que está en otro ámbito de estilos:
     por eso `:global` (antes la regla no lo alcanzaba y el precio de antes salía sin tachar). */
  .v2-caja :global(.v2-tachado) { text-decoration: line-through; text-decoration-thickness: 1.5px; text-decoration-color: var(--color-coral-600); }
  .v2-caja[data-precio-normal='sin-tachar'] [data-tachado] :global(.v2-tachado) { text-decoration: none; }
  /* C4 (ronda 2 de JP): en móvil la caja blanca se fundía con el fondo. Resaltada (ajuste `cajaResaltada`, de
     fábrica): contorno navy, sombra más honda y un filete coral arriba que la ata al botón. Vale para las dos
     variantes: en «cabecera oscura» el filete queda sobre la cabecera. */
  .v2-caja[data-resaltada] {
    border-top: 4px solid var(--color-coral-600);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--color-navy-300) 70%, transparent), 0 24px 48px -20px rgb(27 27 58 / 0.32), 0 4px 10px -2px rgb(27 27 58 / 0.08);
  }
  .v2-caja[data-cupon='retirado'] [data-cupon-icono] { opacity: 0.4; }
  .v2-caja[data-cupon='retirado'] [data-cupon-cifra] { color: var(--color-navy-500); font-weight: 400; }
  .v2-caja:not([data-cupon='retirado']) [data-sin-cupon], .v2-caja[data-cupon='retirado'] [data-con-cupon] { display: none; }
  .v2-caja[data-cupon='retirado'] :global(.v2-tachado) { text-decoration: none; }
  .v2-caja[data-cupon='retirado'] :global([data-contador-despues]) { display: none; }
  .v2-caja[data-cupon='retirado'] :global([data-contador-sigue]) { display: inline; }
  .v2-caja[data-estado='vencida'] :global(:is([data-bloque='cupon'], [data-contador], [data-savings])) { display: none; }
  .v2-caja[data-estado='vencida'] :global([data-aviso-fin]) { display: block; }
  /* Móvil: precio y botón primero (dentro de los primeros 844 px); la cuenta y el contador, después. */
  @media (width < 1024px) {
    .v2-caja-cuerpo { display: flex; flex-direction: column; }
    .v2-caja-cuerpo > :global(*) { order: 5; }
    .v2-caja-cuerpo > :global([data-bloque='pais']) { order: 0; }
    .v2-caja-cuerpo > :global([data-bloque='importe']) { order: 1; }
    .v2-caja-cuerpo > :global([data-bloque='boton']) { order: 2; }
    .v2-caja-cuerpo > :global([data-bloque='precio']) { order: 3; margin-top: 20px; border-top: 1px solid var(--color-navy-100); padding-top: 16px; }
    .v2-caja-cuerpo > :global(:is([data-contador], [data-aviso-fin])) { order: 4; }
    /* El H1 ya está encima: en móvil el título de la caja solo lo leen los lectores de pantalla. */
    .v2-caja-titulo { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .v2-caja-titulo + .v2-caja-cuerpo { padding-top: 24px; }
  }
  [data-amount-cifra].cambia { animation: v2-cambia var(--t-base) var(--e-sale); }
  @keyframes v2-cambia { from { opacity: 0.2; translate: 0 0.25em; } }
</style>

<script>
  import { trackEvent } from '@/lib/analytics';
  const caja = document.querySelector<HTMLElement>('section[data-purchase-panel][data-variante]');
  if (caja && caja.dataset.discountUrl) {
    const d = caja.dataset;
    const enlaces = document.querySelectorAll<HTMLAnchorElement>('a[data-pago]');
    const toggles = caja.querySelectorAll<HTMLButtonElement>('[data-toggle]');
    // Fin del precio rebajado: el del tramo con el mismo cupón (ver ficha.ts), no el de la campaña.
    const fin = d.precioHasta === 'nunca' ? 0 : Number(d.precioHasta ?? d.until);
    const vencida = () => fin > 0 && Date.now() >= fin;
    let aplicado = true;
    // «$ 95.506 COP» → «$ 95.506»: el código va aparte, más pequeño.
    const cifra = (texto: string) => texto.replace(/\s+[A-Z]{3}$/, '');
    function pintar() {
      const activo = aplicado && !vencida();
      const importe = activo ? d.reduced! : d.base!;
      if (vencida()) caja!.dataset.estado = 'vencida';
      caja!.dataset.cupon = activo ? 'aplicado' : 'retirado';
      const nodo = caja!.querySelector<HTMLElement>('[data-amount-cifra]');
      if (nodo && nodo.textContent !== cifra(importe)) { nodo.textContent = cifra(importe); nodo.classList.remove('cambia'); void nodo.offsetWidth; nodo.classList.add('cambia'); }
      const hablado = (activo ? d.reducedHablado : d.baseHablado) ?? '';
      document.querySelectorAll('[data-amount-cifra-hablado], [data-precio-fijo-hablado]').forEach(n => { n.textContent = hablado; });
      const rotulo = caja!.querySelector('[data-precio-rotulo]');
      if (rotulo) rotulo.textContent = activo ? (d.variante === 'cuenta-clara' ? 'Hoy pagas' : 'Precio con cupón') : vencida() ? 'Precio' : 'Pagas sin cupón';
      caja!.querySelectorAll('[data-cupon-texto]').forEach(t => { t.textContent = activo ? `Cupón ${d.codigo}${d.variante === 'cuenta-clara' ? ` · ${d.pct} %` : ' aplicado'}` : `Cupón ${d.codigo} retirado`; });
      toggles.forEach(b => { b.textContent = activo ? 'Quitar' : 'Volver a aplicar'; b.setAttribute('aria-label', activo ? `Quitar el cupón ${d.codigo}` : `Volver a aplicar el cupón ${d.codigo}`); });
      // El botón de la caja, la barra fija y el cierre cambian precio y enlace a la vez.
      enlaces.forEach(a => {
        a.href = activo ? d.discountUrl! : d.originalUrl!;
        const texto = a.querySelector('[data-btn-texto]');
        if (texto && a.dataset.btnCon) texto.textContent = activo ? a.dataset.btnCon : a.dataset.btnSin!;
        if (a.dataset.btnSinHablado) { if (activo) a.removeAttribute('aria-label'); else a.setAttribute('aria-label', a.dataset.btnSinHablado); }
      });
      document.querySelectorAll<HTMLElement>('[data-precio-fijo]').forEach(p => { p.textContent = cifra(importe); });
      document.querySelectorAll<HTMLElement>('[data-precio-fijo-nota]').forEach(p => { p.textContent = activo ? `con cupón ${d.codigo}` : 'precio normal'; });
      document.querySelectorAll<HTMLElement>('[data-cierre-promo]').forEach(p => { p.hidden = !activo; });
    }
    toggles.forEach(b => b.addEventListener('click', () => { aplicado = !aplicado; pintar(); trackEvent('coupon_toggle', { page: location.pathname, applied: String(aplicado) }); }));
    // Si la campaña vence con la página abierta, el clic ya lleva al precio normal.
    enlaces.forEach(a => a.addEventListener('click', () => { if (vencida()) pintar(); }));
    if (fin > 0) { if (vencida()) pintar(); else setTimeout(pintar, Math.min(fin - Date.now() + 500, 2_147_000_000)); }
  }
</script>
