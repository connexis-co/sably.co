---
/** Elige la plantilla «homologaciones-index» del tema de la petición (src/lib/ajustes-tema.ts). */
import Clasica from '../sably-classic/pages/homologaciones-index.astro';
import V2 from '../sably-v2/pages/homologaciones-index.astro';
import { temaDeLaPeticion } from '@/lib/ajustes-tema';
type Props = Parameters<typeof Clasica>[0];
const v2 = (await temaDeLaPeticion(Astro)).tema === 'v2';
---
{v2 ? <V2 {...Astro.props as Props} /> : <Clasica {...Astro.props as Props} />}
