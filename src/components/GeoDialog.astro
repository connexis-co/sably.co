---
import { getCountries } from '@/lib/emdash-content';
const COUNTRIES = await getCountries();

/**
 * Selector de país. Se abre desde el header, persiste la preferencia
 * (localStorage) y navega a la portada del país. Ya no hay paso de ciudad: las
 * páginas de ciudad se consolidaron con un 301 en las de país (city-redirect).
 */
interface Props {
  /** Ruta después del código de país, ej. "/cursos/oficios/". */
  pathAfterCountry: string;
}
const { pathAfterCountry } = Astro.props;
---

<dialog
  id="geo-dialog"
  data-path={pathAfterCountry}
  class="m-auto w-[min(92vw,480px)] rounded-lg p-0 shadow-2xl backdrop:bg-ink/50 backdrop:backdrop-blur-sm"
>
  <div class="p-6">
    <div class="flex items-center justify-between gap-4">
      <h2 class="text-lg font-bold" id="geo-title">¿Desde dónde nos visitas?</h2>
      <button
        type="button"
        class="rounded-full p-2 text-muted hover:bg-surface-100"
        data-geo-close
        aria-label="Cerrar"
      >
        ✕
      </button>
    </div>

    <div data-geo-step="country" class="mt-4 grid grid-cols-2 gap-2">
      {
        COUNTRIES.map((c) => (
          <a
            href={`/${c.code}/`}
            data-geo-country={c.code}
            class="flex items-center gap-3 rounded-md border border-surface-200 px-4 py-3 text-left text-sm font-medium text-heading transition hover:border-accent hover:bg-accent-soft"
          >
            <span class="text-xl" aria-hidden="true">
              {c.flag}
            </span>
            {c.name}
          </a>
        ))
      }
    </div>
  </div>
</dialog>

<script>
  import { $country } from '@/stores/geo';

  const dialog = document.getElementById('geo-dialog') as HTMLDialogElement | null;

  if (dialog) {
    document.querySelectorAll('[data-geo-open]').forEach((btn) =>
      btn.addEventListener('click', () => dialog.showModal()),
    );

    dialog.querySelector('[data-geo-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    /* Cada país es un <a> y navega por sí solo; antes de salir se guarda la
       preferencia y se avisa a GTM con el mismo evento de siempre. */
    dialog.querySelectorAll<HTMLElement>('[data-geo-country]').forEach((el) =>
      el.addEventListener('click', () => {
        const country = el.dataset.geoCountry ?? 'co';
        $country.set(country);
        window.dataLayer ??= [];
        window.dataLayer.push({ event: 'select_country', country_code: country, city: 'all' });
      }),
    );
  }
</script>
