---
/**
 * Estrellas del hero del curso: el visitante deja su valoración con un toque.
 *
 * Empiezan vacías. No se pinta la nota de compradores de Hotmart: es de un
 * tercero y los términos de Hotmart (cláusula 5.2) no permiten usar su nombre
 * para promocionar. El voto va a `visitor_rating` en D1 (uno por visitante y
 * curso, hash de IP): señal de interés, no calidad verificada, y por eso
 * tampoco va al aggregateRating del schema.
 */
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<div data-valorar data-slug={slug} class="flex flex-wrap items-center gap-x-2 gap-y-1">
  <span class="flex" role="group" aria-label="Valora este curso de 1 a 5 estrellas">
    {
      [1, 2, 3, 4, 5].map((n) => (
        <button
          type="button"
          data-estrella={n}
          class="px-0.5 text-xl leading-none text-white/30 transition-transform hover:scale-125 focus-visible:scale-125"
          aria-label={`Valorar con ${n} estrella${n > 1 ? 's' : ''}`}
          title={`Valorar con ${n}`}
        >
          ★
        </button>
      ))
    }
  </span>
  <span class="text-sm text-white/70">Valora este curso</span>
  <span data-valorar-gracias hidden class="text-sm font-semibold text-warning"></span>
</div>

<script>
  const caja = document.querySelector<HTMLElement>('[data-valorar]');
  if (caja) {
    const slug = caja.dataset.slug!;
    const marca = `sably:voto:${slug}`;
    const gracias = caja.querySelector<HTMLElement>('[data-valorar-gracias]')!;
    const estrellas = [...caja.querySelectorAll<HTMLButtonElement>('[data-estrella]')];

    const pintar = (n: number, clase = 'text-warning') =>
      estrellas.forEach((e) => {
        e.classList.toggle(clase, Number(e.dataset.estrella) <= n);
        e.classList.toggle('text-white/30', Number(e.dataset.estrella) > n);
      });

    // Quien ya votó en esta sesión ve su voto, no las estrellas vacías.
    const votado = Number(sessionStorage.getItem(marca));
    if (votado) {
      pintar(votado);
      gracias.textContent = `Tu valoración: ${votado}★`;
      gracias.hidden = false;
    }

    /** Lo que había pintado antes de este intento, para poder revertir. */
    const previo = () => Number(sessionStorage.getItem(marca)) || 0;

    for (const e of estrellas) {
      e.addEventListener('click', async () => {
        const n = Number(e.dataset.estrella);
        const antes = previo();

        // Optimista: se pinta ya, pero NO se dice «gracias» hasta que el
        // servidor confirme. `fetch` no lanza con un 404 o un 400, así que un
        // try/catch por sí solo daba por bueno un voto que se perdía.
        pintar(n);
        gracias.textContent = 'Guardando…';
        gracias.hidden = false;

        try {
          const r = await fetch('/api/v1/valorar', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ slug, rating: n }),
            signal: AbortSignal.timeout(8000),
          });
          const d = (await r.json().catch(() => ({}))) as {
            error?: string; votos?: number; media?: number;
          };
          if (!r.ok) throw new Error(d.error || 'no se pudo guardar');

          sessionStorage.setItem(marca, String(n));
          // Se enseña el acumulado que devuelve el servidor: es el dato real,
          // no una promesa.
          gracias.textContent = d.votos && d.media
            ? `Tu ${n}★ · ${String(d.media).replace('.', ',')} de ${d.votos} visitantes`
            : `Tu valoración: ${n}★`;
        } catch (err) {
          // Se revierte: dejar las estrellas encendidas afirmaría que se guardó
          // algo que no se guardó.
          pintar(antes);
          gracias.textContent =
            err instanceof DOMException && err.name === 'TimeoutError'
              ? 'No hubo conexión. Inténtalo otra vez.'
              : 'No pudimos guardar tu valoración.';
        }
      });
    }
  }
</script>
