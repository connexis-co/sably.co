---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, subtitle, align = 'left' } = Astro.props;
---

<div class={align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl'}>
  {eyebrow && <p class="mb-2 text-sm font-bold tracking-wide text-accent uppercase">{eyebrow}</p>}
  <h2 class="text-2xl font-bold sm:text-3xl">{title}</h2>
  {subtitle && <p class="mt-3 text-base text-body">{subtitle}</p>}
</div>
