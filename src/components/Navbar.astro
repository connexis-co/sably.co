---
const links = [
  { href: '/cursos', label: 'Cursos' },
  { href: '/black-university', label: 'Black University' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/contacto', label: 'Contacto' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-ink/85 backdrop-blur-lg">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2 text-xl font-extrabold tracking-tight text-white" aria-label="Sably — inicio">
      <span class="grid size-8 place-items-center rounded-lg bg-brand text-sm font-black text-ink">S</span>
      sably<span class="text-brand">.</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Navegación principal">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
            isActive(l.href) ? 'text-brand' : 'text-slate-300 hover:bg-white/5 hover:text-white',
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/cursos"
        class="hidden rounded-lg bg-brand px-4 py-2 text-sm font-bold text-ink transition hover:bg-brand-strong sm:inline-block"
      >
        Empieza ahora
      </a>
      <button
        id="menu-btn"
        type="button"
        class="grid size-10 place-items-center rounded-lg text-slate-200 hover:bg-white/5 md:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-white/5 md:hidden">
    <nav class="mx-auto max-w-7xl space-y-1 px-4 py-3" aria-label="Menú móvil">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'block rounded-lg px-3 py-2.5 text-sm font-medium',
            isActive(l.href) ? 'bg-white/5 text-brand' : 'text-slate-200 hover:bg-white/5',
          ]}
        >
          {l.label}
        </a>
      ))}
      <a href="/cursos" class="mt-2 block rounded-lg bg-brand px-3 py-2.5 text-center text-sm font-bold text-ink">
        Empieza ahora
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
