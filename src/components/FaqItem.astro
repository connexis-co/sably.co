---
interface Props {
  question: string;
}
const { question } = Astro.props;
---

<details class="group rounded-xl border border-white/10 bg-panel px-5 transition hover:border-white/20">
  <summary class="flex items-center justify-between gap-4 py-4 text-left text-sm font-semibold text-white sm:text-base">
    {question}
    <span class="faq-icon grid size-6 shrink-0 place-items-center rounded-full border border-white/15 text-brand" aria-hidden="true">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
    </span>
  </summary>
  <div class="pb-5 text-sm leading-relaxed text-slate-400">
    <slot />
  </div>
</details>
