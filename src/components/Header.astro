---
import { getCollection } from 'astro:content';
import { CATEGORIES, INTERNAL_CATEGORIES, categoryCover } from '@/lib/categories';
import type { Country, City } from '@/lib/countries';
import { formatPrice } from '@/lib/countries';
import Logo from './Logo.astro';
import { buildWhatsAppUrl } from '@/lib/hotmart';

interface Props {
  country: Country;
  city?: City;
  /** Ruta después del código de país (para el switcher de país). */
  pathAfterCountry: string;
}
const { country, city, pathAfterCountry } = Astro.props;

const allCourses = await getCollection('courses');
const featuredByCategory = new Map(
  INTERNAL_CATEGORIES.map((cat) => {
    const inCat = allCourses.filter((c) => c.data.category === cat.slug);
    const pick = inCat.find((c) => c.data.featured) ?? inCat[0];
    return [cat.slug, pick] as const;
  }),
);

const base = `/${country.code}`;
const geoLabel = city ? `${country.flag} ${city.name}` : `${country.flag} ${country.name}`;
const waUrl = buildWhatsAppUrl(country.whatsapp, 'Hola, estoy interesado(a) y quiero más información sobre los cursos de Sably');
---

<header class="sticky top-0 z-50 border-b border-surface-200 bg-white/95 backdrop-blur">
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <Logo href={`${base}/`} />

    <!-- Nav desktop -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
      <div class="relative" data-mega-root>
        <button
          type="button"
          data-mega-trigger
          aria-expanded="false"
          aria-controls="mega-panel"
          class="flex items-center gap-1.5 rounded-md px-4 py-2 text-sm font-semibold text-heading transition hover:bg-surface-100 hover:text-primary"
        >
          Categorías
          <svg class="size-4 transition-transform" data-mega-chevron viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>

        <div
          id="mega-panel"
          data-mega-panel
          class="invisible absolute left-1/2 top-full mt-2 w-[880px] -translate-x-1/2 rounded-lg border border-surface-200 bg-white opacity-0 shadow-2xl transition-all duration-200"
        >
          <div class="grid grid-cols-[240px_1fr_280px]">
            <!-- Col 1: categorías -->
            <ul class="border-r border-surface-100 p-3" role="list">
              {
                CATEGORIES.map((cat, i) =>
                  cat.externalUrl ? (
                    <li>
                      <a
                        href={cat.externalUrl}
                        target="_blank"
                        rel="noopener"
                        class="flex items-center justify-between gap-2 rounded-md px-3 py-2.5 text-sm font-medium text-heading hover:bg-accent-soft"
                      >
                        <span>{cat.emoji} {cat.name}</span>
                        <span class="rounded-full bg-accent px-2 py-0.5 text-[10px] font-bold text-white">Academia</span>
                      </a>
                    </li>
                  ) : (
                    <li>
                      <button
                        type="button"
                        data-mega-cat={cat.slug}
                        data-active={i === 1 ? 'true' : undefined}
                        class="flex w-full items-center justify-between gap-2 rounded-md px-3 py-2.5 text-left text-sm font-medium text-heading transition hover:bg-surface-100 data-[active]:bg-surface-100 data-[active]:text-primary"
                      >
                        <span>{cat.emoji} {cat.name}</span>
                        <span aria-hidden="true" class="text-muted">›</span>
                      </button>
                    </li>
                  ),
                )
              }
            </ul>

            <!-- Col 2 + 3 por categoría -->
            {
              INTERNAL_CATEGORIES.map((cat, i) => {
                const featured = featuredByCategory.get(cat.slug);
                return (
                  <div
                    data-mega-content={cat.slug}
                    class:list={['col-span-2 grid grid-cols-[1fr_280px]', { hidden: i !== 0 }]}
                  >
                    <div class="p-5">
                      <p class="mb-3 text-xs font-bold tracking-wide text-muted uppercase">{cat.name}</p>
                      <ul class="grid grid-cols-2 gap-1" role="list">
                        {cat.subcategories.map((sub) => (
                          <li>
                            <a
                              href={`${base}/cursos/${cat.slug}/#${sub.slug}`}
                              class="block rounded-md px-3 py-2 text-sm text-body hover:bg-surface-100 hover:text-primary"
                            >
                              {sub.name}
                            </a>
                          </li>
                        ))}
                      </ul>
                      <a
                        href={`${base}/cursos/${cat.slug}/`}
                        class="mt-3 inline-block text-sm font-semibold text-accent hover:text-accent-hover"
                      >
                        Ver todos los cursos de {cat.name} →
                      </a>
                    </div>
                    <div class="flex flex-col justify-between rounded-r-lg bg-off-white p-5">
                      {featured ? (
                        <>
                          <div>
                            <span class="rounded-full bg-accent px-2.5 py-1 text-[11px] font-bold text-white">Destacado</span>
                            <div
                              class="mt-3 h-24 overflow-hidden rounded-md"
                              style={`background-image: linear-gradient(135deg, ${cat.gradient[0]}, ${cat.gradient[1]})`}
                            >
                              <img
                                src={categoryCover(cat.slug, 'card')}
                                alt=""
                                width="480"
                                height="320"
                                loading="lazy"
                                class="h-full w-full object-cover"
                              />
                            </div>
                            <p class="mt-3 line-clamp-2 text-sm font-bold text-primary">{featured.data.title}</p>
                            <p class="mt-1 text-sm font-semibold text-accent">
                              {formatPrice(featured.data.priceUSD, country)}
                            </p>
                          </div>
                          <a
                            href={`${base}/${featured.id}/`}
                            class="mt-3 rounded-md bg-primary px-4 py-2 text-center text-sm font-semibold text-white transition hover:bg-primary-soft"
                          >
                            Ver curso
                          </a>
                        </>
                      ) : (
                        <p class="text-sm text-muted">Muy pronto nuevos cursos aquí.</p>
                      )}
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>

      <a href={`${base}/cursos/`} class="rounded-md px-4 py-2 text-sm font-semibold text-heading transition hover:bg-surface-100 hover:text-primary">Cursos</a>
      <a href="/homologaciones/" class="rounded-md px-4 py-2 text-sm font-semibold text-heading transition hover:bg-surface-100 hover:text-primary">Homologaciones</a>
      <a href="/blog/" class="rounded-md px-4 py-2 text-sm font-semibold text-heading transition hover:bg-surface-100 hover:text-primary">Blog</a>
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-geo-open
        class="flex max-w-[46vw] items-center gap-1.5 truncate rounded-md border border-surface-200 px-2.5 py-2 text-sm font-medium text-heading transition hover:border-accent sm:max-w-none sm:gap-2 sm:px-3"
      >
        {geoLabel}
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <a
        href={`${base}/cursos/`}
        class="hidden rounded-md bg-accent px-4 py-2 text-sm font-bold text-white transition hover:bg-accent-hover lg:block"
      >
        Empezar ahora
      </a>
      <!-- Hamburger -->
      <button
        type="button"
        data-drawer-open
        class="rounded-md p-2 text-heading hover:bg-surface-100 lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <svg data-icon-burger class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg data-icon-close class="hidden size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Drawer mobile: FUERA del header — el backdrop-blur del header crea un
     containing block que rompería position:fixed de sus descendientes.
     Navegación multi-nivel con paneles deslizantes (patrón aprende.com). -->
<div id="mobile-drawer" data-drawer class="pointer-events-none fixed inset-0 z-[60] lg:hidden" aria-hidden="true">
  <div
    data-drawer-backdrop
    class="absolute inset-0 bg-ink/50 opacity-0 backdrop-blur-sm transition-opacity duration-300"
  >
  </div>
  <div
    data-drawer-panel
    class="absolute inset-y-0 right-0 flex w-[min(92vw,400px)] translate-x-full flex-col bg-white shadow-2xl transition-transform duration-300 ease-out"
  >
    <div class="flex items-center justify-between border-b border-surface-100 p-4">
      <Logo href={`${base}/`} />
      <div class="flex items-center gap-2">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener nofollow"
          class="flex size-9 items-center justify-center rounded-full bg-[#00e676] text-white"
          aria-label="Escríbenos por WhatsApp"
        >
          <svg viewBox="0 0 24 24" class="size-5 fill-current" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.7 14.1c-.2.7-1.4 1.3-1.9 1.3-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-2.9-1.3-4.8-4.2-5-4.4-.1-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4-.1.7.5.2.6.8 2 .9 2.1.1.2.1.3 0 .5-.1.2-.2.4-.3.5l-.5.6c-.2.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.2 1.4 2.5 1.5.3.2.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.3 0 .2 0 .7-.2 1.3Z"/></svg>
        </a>
        <button type="button" data-drawer-close class="rounded-full p-2 text-muted hover:bg-surface-100" aria-label="Cerrar menú">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
    </div>

    <div class="relative flex-1 overflow-hidden">
      <!-- Nivel 1: principal -->
      <div data-mnav-panel="main" class="absolute inset-0 overflow-y-auto p-4 transition-transform duration-300 ease-out">
        <button
          type="button"
          data-geo-open
          class="mb-4 flex w-full items-center justify-between rounded-md border border-surface-200 px-4 py-3 text-sm font-medium text-heading"
        >
          <span>{geoLabel}</span>
          <span class="text-accent">Cambiar</span>
        </button>
        <nav aria-label="Menú principal">
          <button
            type="button"
            data-mnav-go="programas"
            class="flex w-full items-center justify-between border-b border-surface-100 py-4 text-[15px] font-semibold text-heading"
          >
            Programas
            <span class="text-muted" aria-hidden="true">›</span>
          </button>
          <a href={`${base}/cursos/`} class="flex items-center justify-between border-b border-surface-100 py-4 text-[15px] font-semibold text-heading">
            Todos los cursos
            <span class="text-muted" aria-hidden="true">›</span>
          </a>
          <a href="/homologaciones/" class="flex items-center justify-between border-b border-surface-100 py-4 text-[15px] font-semibold text-heading">
            Homologaciones
            <span class="text-muted" aria-hidden="true">›</span>
          </a>
          <a href="/blog/" class="flex items-center justify-between border-b border-surface-100 py-4 text-[15px] font-semibold text-heading">
            Blog
            <span class="text-muted" aria-hidden="true">›</span>
          </a>
          <a href="/nosotros/" class="flex items-center justify-between border-b border-surface-100 py-4 text-[15px] font-semibold text-heading">
            Sobre nosotros
            <span class="text-muted" aria-hidden="true">›</span>
          </a>
        </nav>
        <a href={`${base}/cursos/`} class="mt-6 block rounded-md bg-accent px-4 py-3.5 text-center text-sm font-bold text-white">
          Ver todos los cursos
        </a>
      </div>

      <!-- Nivel 2: programas -->
      <div data-mnav-panel="programas" class="absolute inset-0 translate-x-full overflow-y-auto p-4 transition-transform duration-300 ease-out">
        <button type="button" data-mnav-back="main" class="mb-3 flex items-center gap-1.5 text-sm font-semibold text-accent">
          ‹ Volver
        </button>
        <h2 class="text-lg font-bold text-primary">Programas de estudio</h2>
        <p class="mt-1 mb-4 text-sm text-body">Potencia tus habilidades, transforma tu futuro y obtén tu certificado.</p>
        {
          CATEGORIES.map((cat) =>
            cat.externalUrl ? (
              <a
                href={cat.externalUrl}
                target="_blank"
                rel="noopener"
                class="mb-2 flex w-full items-center justify-between rounded-md bg-off-white px-4 py-3.5 text-sm font-semibold text-heading"
              >
                <span>{cat.emoji} {cat.name}</span>
                <span class="rounded-full bg-accent px-2 py-0.5 text-[10px] font-bold text-white">Academia</span>
              </a>
            ) : (
              <button
                type="button"
                data-mnav-go={`cat-${cat.slug}`}
                class="mb-2 flex w-full items-center justify-between rounded-md bg-off-white px-4 py-3.5 text-sm font-semibold text-heading transition hover:bg-accent-soft"
              >
                <span>{cat.emoji} {cat.name}</span>
                <span class="text-muted" aria-hidden="true">›</span>
              </button>
            ),
          )
        }
        <a href={`${base}/cursos/`} class="mt-3 block rounded-md border border-surface-300 px-4 py-3 text-center text-sm font-semibold text-heading">
          Explorar todos
        </a>
      </div>

      <!-- Nivel 3: una por categoría -->
      {
        INTERNAL_CATEGORIES.map((cat) => (
          <div
            data-mnav-panel={`cat-${cat.slug}`}
            class="absolute inset-0 translate-x-full overflow-y-auto p-4 transition-transform duration-300 ease-out"
          >
            <button type="button" data-mnav-back="programas" class="mb-3 flex items-center gap-1.5 text-sm font-semibold text-accent">
              ‹ Volver
            </button>
            <h2 class="text-lg font-bold text-primary">
              {cat.emoji} {cat.name}
            </h2>
            <p class="mt-1 mb-4 text-sm text-body">{cat.description}</p>
            <nav aria-label={`Subcategorías de ${cat.name}`}>
              {cat.subcategories.map((sub) => (
                <a
                  href={`${base}/cursos/${cat.slug}/#${sub.slug}`}
                  class="flex items-center justify-between border-b border-surface-100 py-3 text-sm text-heading"
                >
                  {sub.name}
                  <span class="text-muted" aria-hidden="true">›</span>
                </a>
              ))}
            </nav>
            <a href={`${base}/cursos/${cat.slug}/`} class="mt-4 block rounded-md bg-accent px-4 py-3 text-center text-sm font-bold text-white">
              Ver todos los cursos de {cat.name}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  // ── Mega menú desktop ──────────────────────────────────────────────
  const root = document.querySelector<HTMLElement>('[data-mega-root]');
  if (root) {
    const trigger = root.querySelector<HTMLButtonElement>('[data-mega-trigger]')!;
    const panel = root.querySelector<HTMLElement>('[data-mega-panel]')!;
    const chevron = root.querySelector<HTMLElement>('[data-mega-chevron]');
    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    const setOpen = (open: boolean) => {
      panel.classList.toggle('invisible', !open);
      panel.classList.toggle('opacity-0', !open);
      trigger.setAttribute('aria-expanded', String(open));
      chevron?.classList.toggle('rotate-180', open);
    };
    const scheduleClose = () => {
      closeTimer = setTimeout(() => setOpen(false), 150);
    };
    const cancelClose = () => clearTimeout(closeTimer);

    trigger.addEventListener('click', () => setOpen(panel.classList.contains('invisible')));
    root.addEventListener('mouseenter', () => {
      cancelClose();
      setOpen(true);
    });
    root.addEventListener('mouseleave', scheduleClose);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) setOpen(false);
    });

    const catButtons = root.querySelectorAll<HTMLButtonElement>('[data-mega-cat]');
    const contents = root.querySelectorAll<HTMLElement>('[data-mega-content]');
    const activate = (slug: string) => {
      catButtons.forEach((b) => {
        if (b.dataset.megaCat === slug) b.dataset.active = 'true';
        else delete b.dataset.active;
      });
      contents.forEach((c) => c.classList.toggle('hidden', c.dataset.megaContent !== slug));
      window.dataLayer ??= [];
      window.dataLayer.push({ event: 'mega_menu_interact', category_clicked: slug });
    };
    catButtons.forEach((b) => {
      b.addEventListener('mouseenter', () => activate(b.dataset.megaCat!));
      b.addEventListener('focus', () => activate(b.dataset.megaCat!));
      b.addEventListener('click', () => activate(b.dataset.megaCat!));
    });
    if (catButtons[0]) activate(catButtons[0].dataset.megaCat!);
  }

  // ── Drawer mobile ──────────────────────────────────────────────────
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  if (drawer) {
    const openBtn = document.querySelector<HTMLButtonElement>('[data-drawer-open]');
    const backdrop = drawer.querySelector<HTMLElement>('[data-drawer-backdrop]');
    const panel = drawer.querySelector<HTMLElement>('[data-drawer-panel]');
    const burger = openBtn?.querySelector('[data-icon-burger]');
    const close = openBtn?.querySelector('[data-icon-close]');

    const toggle = (open: boolean) => {
      drawer.classList.toggle('pointer-events-none', !open);
      drawer.setAttribute('aria-hidden', String(!open));
      backdrop?.classList.toggle('opacity-0', !open);
      panel?.classList.toggle('translate-x-full', !open);
      document.body.classList.toggle('no-scroll', open);
      openBtn?.setAttribute('aria-expanded', String(open));
      openBtn?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      burger?.classList.toggle('hidden', open);
      close?.classList.toggle('hidden', !open);
      if (!open) {
        drawer.querySelectorAll<HTMLElement>('[data-mnav-panel]').forEach((pn) => {
          const main = pn.dataset.mnavPanel === 'main';
          pn.classList.toggle('translate-x-full', !main);
          pn.classList.remove('-translate-x-full');
        });
      }
    };
    const isOpen = () => !drawer.classList.contains('pointer-events-none');

    openBtn?.addEventListener('click', () => toggle(!isOpen()));
    drawer.querySelector('[data-drawer-close]')?.addEventListener('click', () => toggle(false));
    backdrop?.addEventListener('click', () => toggle(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) toggle(false);
    });

    // Paneles deslizantes multi-nivel (aprende.com style)
    const panels = drawer.querySelectorAll<HTMLElement>('[data-mnav-panel]');
    const showPanel = (id: string, direction: 'forward' | 'back') => {
      panels.forEach((pn) => {
        const isTarget = pn.dataset.mnavPanel === id;
        pn.classList.toggle('translate-x-full', !isTarget && direction === 'back');
        pn.classList.toggle('-translate-x-full', !isTarget && direction === 'forward');
        if (isTarget) {
          pn.classList.remove('translate-x-full', '-translate-x-full');
          pn.scrollTop = 0;
        }
      });
    };
    drawer.querySelectorAll<HTMLButtonElement>('[data-mnav-go]').forEach((b) =>
      b.addEventListener('click', () => showPanel(b.dataset.mnavGo!, 'forward')),
    );
    drawer.querySelectorAll<HTMLButtonElement>('[data-mnav-back]').forEach((b) =>
      b.addEventListener('click', () => showPanel(b.dataset.mnavBack!, 'back')),
    );
  }
</script>
