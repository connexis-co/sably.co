---
/**
 * Reseñas REALES del curso, deslizables.
 *
 * Sustituye a los testimonios de la colección local, que eran personas
 * inventadas con ciudades inventadas («Marcela H., Cartagena»). Aquí cada
 * tarjeta es una reseña pública del producto en Hotmart: el nombre que su
 * autor publicó, su nota y su texto — verificable en la página del producto.
 *
 * En móvil es un carrusel con scroll-snap (deslizable con el pulgar); en
 * escritorio, rejilla de tres. Si el curso no tiene reseñas propias se
 * completan con reseñas reales de otros cursos de la misma categoría, cada
 * una nombrando su curso: rellenar sin decirlo sería atribuirle al curso
 * opiniones que no son suyas.
 */
import { env } from 'cloudflare:workers';
import { getCourses } from '@/lib/emdash-content';
import { readPublicReviews, type PublicReview } from '@/plugins/sably-operations/public';

interface Props {
  slug: string;
  /** Slugs de cursos de la misma categoría, para completar si faltan. */
  relacionados?: string[];
}
const { slug, relacionados = [] } = Astro.props;

interface Tarjeta extends PublicReview {
  /** Título del curso al que pertenece, solo cuando NO es el de esta página. */
  deCurso?: string;
}

const db = (env as unknown as {SABLY_DB:D1Database}).SABLY_DB;
const [reviews,courses] = await Promise.all([readPublicReviews(db).catch(()=>[]),getCourses()]);
const titles = new Map(courses.map(c=>[c.id,c.data.title]));
const propias: Tarjeta[] = reviews.filter(r=>r.slug===slug&&r.texto).slice(0,6);
const tarjetas: Tarjeta[] = [...propias];
for (const rel of relacionados) {
  if (tarjetas.length >= 6) break;
  const titulo = titles.get(rel);
  if (!titulo) continue;
  for (const r of reviews.filter((x) => x.slug===rel&&x.texto).slice(0, 2)) {
    if (tarjetas.length >= 6) break;
    tarjetas.push({ ...r, deCurso: titulo });
  }
}
const estrellas = (n: number): string => '★'.repeat(Math.max(1, Math.min(5, Math.round(n))));
---

{
  tarjetas.length > 0 && (
    <section aria-labelledby="resenas-title">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="resenas-title" class="text-2xl font-bold">
          Lo que dicen los compradores
        </h2>
        <p class="text-xs text-muted">Reseñas de compradores publicadas tras revisión</p>
      </div>
      <div
        class="scrollbar-fina -mx-4 mt-5 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-px-4 px-4 pb-3 md:mx-0 md:grid md:snap-none md:grid-cols-3 md:overflow-visible md:px-0"
      >
        {tarjetas.map((t) => (
          <article class="flex min-w-[82%] snap-start flex-col rounded-lg border border-surface-200 bg-white p-5 sm:min-w-[320px] md:min-w-0">
            <p class="text-warning" aria-label={`${Math.round(t.rating)} de 5 estrellas`}>
              {estrellas(t.rating)}
            </p>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-body">"{t.texto}…"</p>
            <footer class="mt-4 flex items-center gap-3 border-t border-surface-100 pt-3">
              <span
                class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary/10 font-bold text-primary"
                aria-hidden="true"
              >
                {t.nombre.charAt(0).toUpperCase()}
              </span>
              <div class="min-w-0">
                <p class="truncate text-sm font-bold text-primary">{t.nombre}</p>
                <p class="truncate text-xs text-muted">
                  {t.deCurso ? `Sobre ${t.deCurso}` : t.source==='hotmart-public' ? 'Reseña pública · Hotmart' : 'Compra verificada'}
                </p>
              </div>
            </footer>
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  /* Scrollbar discreta para el carrusel en móvil/trackpad. */
  .scrollbar-fina {
    scrollbar-width: thin;
    scrollbar-color: var(--color-surface-300) transparent;
  }
  .scrollbar-fina::-webkit-scrollbar {
    height: 6px;
  }
  .scrollbar-fina::-webkit-scrollbar-thumb {
    border-radius: 3px;
    background: var(--color-surface-300);
  }
</style>
