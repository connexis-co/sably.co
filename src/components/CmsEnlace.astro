---
/**
 * Marca `link` del texto rico del CMS. Delega en la de EmDash salvo cuando el enlace va a una web del mismo
 * dueño (src/lib/enlaces-propios.ts): esa sale con `nofollow`. En /nosotros/ el texto del panel enlazaba
 * follow a academiadebelleza.edu.co y cursodeglobosonline.com (seo-test, regla `red-propia-follow`, 25-nov).
 * `esWebPropia` solo acepta URL absolutas que se dejan analizar y cuyo dominio está en la lista: el `href`
 * no necesita más saneado.
 */
import { Link } from 'emdash/ui';
import { esWebPropia } from '@/lib/enlaces-propios';
interface Props { node: { markDef: { _type: 'link'; _key: string; href: string; blank?: boolean } } }
const { node } = Astro.props;
const href = node?.markDef?.href;
const blank = Boolean(node?.markDef?.blank);
---
{esWebPropia(href)
  ? <a href={href} target={blank ? '_blank' : undefined} rel={blank ? 'noopener noreferrer nofollow' : 'nofollow'}><slot /></a>
  : <Link node={node}><slot /></Link>}
