---
import { CATEGORIES } from '@/lib/categories';
import { COUNTRIES, type Country } from '@/lib/countries';
import { SITE } from '@/lib/site';
import Logo from './Logo.astro';
import SocialIcon from './SocialIcon.astro';

interface Props {
  country: Country;
}
const { country } = Astro.props;
const base = `/${country.code}`;
const year = new Date().getFullYear();

/* Solo las redes con perfil real: una URL vacía en SITE.social significa que
   la cuenta no existe todavía y no se pinta un enlace muerto. */
const REDES = [
  { network: 'instagram', url: SITE.social.instagram, label: 'Instagram' },
  { network: 'tiktok', url: SITE.social.tiktok, label: 'TikTok' },
  { network: 'facebook', url: SITE.social.facebook, label: 'Facebook' },
  { network: 'youtube', url: SITE.social.youtube, label: 'YouTube' },
].filter((r) => r.url);

const SABLY_LINKS = [
  { href: '/nosotros/', label: 'Sobre nosotros' },
  { href: '/homologaciones/', label: 'Homologaciones' },
  { href: '/blog/', label: 'Blog' },
  { href: '/contacto/', label: 'Contacto' },
  { href: '/sitemap/', label: 'Mapa del sitio' },
  { href: '/legal/terminos/', label: 'Términos y condiciones' },
  { href: '/legal/privacidad/', label: 'Política de privacidad' },
];
---

<footer class="bg-primary text-white">
  <div class="container-site py-12 sm:py-14">
    <!-- Marca: full width en móvil, columna propia desde lg -->
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.4fr)_repeat(3,minmax(0,1fr))] lg:gap-8">
      <div>
        <Logo href={`${base}/`} inverted />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/70">{SITE.tagline}</p>

        <p class="mt-5 text-xs font-bold tracking-wide text-white/50 uppercase">Ecosistema Sably</p>
        <ul class="mt-2 space-y-1.5" role="list">
          {
            SITE.filiales.map((f) => (
              <li>
                <a
                  href={f.url}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-1.5 text-sm font-semibold text-white transition hover:text-accent"
                >
                  {f.name}
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>

        <div class="mt-6 flex gap-2.5">
          {
            REDES.map((r) => (
              <a
                href={r.url}
                target="_blank"
                rel="noopener"
                aria-label={r.label}
                class="flex size-10 items-center justify-center rounded-full bg-white/10 text-white/80 transition hover:bg-accent hover:text-white"
              >
                <SocialIcon network={r.network} class="size-[18px]" />
              </a>
            ))
          }
        </div>
      </div>

      <!-- En móvil las 3 listas van en 2 columnas para no hacer un footer kilométrico -->
      <nav aria-label="Categorías" class="min-w-0">
        <h2 class="font-display text-sm font-bold tracking-wide text-white uppercase">Categorías</h2>
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-3 lg:grid-cols-1" role="list">
          {
            CATEGORIES.map((cat) => (
              <li>
                <a
                  href={cat.externalUrl ?? `${base}/cursos/${cat.slug}/`}
                  class="text-sm text-white/70 transition hover:text-white"
                  {...(cat.externalUrl ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {cat.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Países" class="min-w-0">
        <h2 class="font-display text-sm font-bold tracking-wide text-white uppercase">Por país</h2>
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-3 lg:grid-cols-1" role="list">
          {
            COUNTRIES.map((c) => (
              <li>
                <a href={`/${c.code}/`} class="text-sm text-white/70 transition hover:text-white">
                  <span aria-hidden="true">{c.flag}</span> {c.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Sably" class="min-w-0">
        <h2 class="font-display text-sm font-bold tracking-wide text-white uppercase">Sably</h2>
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-3 lg:grid-cols-1" role="list">
          {
            SABLY_LINKS.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-white/70 transition hover:text-white">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-site flex flex-col items-center gap-2 py-5 text-center text-xs text-white/50 sm:flex-row sm:justify-between sm:text-left">
      <p>© {year} Sably — Todos los derechos reservados.</p>
      <p>Los cursos se imparten a través de Hotmart. Certificado incluido.</p>
    </div>
  </div>
</footer>
