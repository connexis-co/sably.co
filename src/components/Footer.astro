---
import { getCategories, getCountries } from '@/lib/emdash-content';
import { getMenu } from 'emdash';
import { getLiveSiteSettings } from '@/lib/live-site-settings';
import { safeEditorialUrl, marketMenuUrl } from '@/lib/sably-theme';
import { type Country } from '@/lib/countries';
import { SITE } from '@/lib/site';
import Logo from './Logo.astro';
import SocialIcon from './SocialIcon.astro';

interface Props {
  country: Country;
}
const { country } = Astro.props;
const base = `/${country.code}`;
const year = new Date().getFullYear();

const [CATEGORIES, COUNTRIES, settings, footer, social, ecosystem] = await Promise.all([
  getCategories(), getCountries(), getLiveSiteSettings(), getMenu('footer',{locale:'es'}), getMenu('social',{locale:'es'}), getMenu('ecosystem',{locale:'es'}),
]);
type Network = 'instagram'|'tiktok'|'facebook'|'youtube';
function socialNetwork(href:string):Network|null {
  // Editors can rename a menu label without changing the icon's identity.
  let host:string;try{host=new URL(href).hostname.toLowerCase();}catch{return null;}
  for(const [domain,network] of [['instagram.com','instagram'],['tiktok.com','tiktok'],['facebook.com','facebook'],['youtube.com','youtube'],['youtu.be','youtube']] as const){
    if(host===domain||host.endsWith(`.${domain}`))return network;
  }
  return null;
}
const REDES = (social?.items ?? []).flatMap(item => {
  const url=safeEditorialUrl(item.url);
  return url ? [{network:socialNetwork(url),url,label:item.label}] : [];
});
const SABLY_LINKS = (footer?.items ?? []).flatMap(item=>{
  const href=marketMenuUrl(item.url,country.code);
  return href?[{href,label:item.label,target:item.target}]:[];
});
const ECOSYSTEM = (ecosystem?.items ?? []).flatMap(item=>{
  const href=safeEditorialUrl(item.url);
  return href?[{href,label:item.label,target:item.target}]:[];
});
---

<footer class="bg-primary text-white">
  <div class="container-site py-12 sm:py-14">
    <!-- Marca: full width en móvil, columna propia desde lg -->
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.4fr)_repeat(3,minmax(0,1fr))] lg:gap-8">
      <div>
        <Logo href={`${base}/`} inverted />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/70">{settings.tagline ?? SITE.tagline}</p>

        <p class="mt-5 text-xs font-bold tracking-wide text-white/50 uppercase">Ecosistema Sably</p>
        <ul class="mt-2 space-y-1.5" role="list">
          {
            ECOSYSTEM.map((f) => (
              <li>
                <a
                  href={f.href}
                  target={f.target}
                  rel={f.target==='_blank'?'noopener':undefined}
                  class="inline-flex items-center gap-1.5 text-sm font-semibold text-white transition hover:text-accent"
                >
                  {f.label}
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>

        <div class="mt-6 flex gap-2.5">
          {
            REDES.map((r) => (
              <a
                href={r.url}
                target="_blank"
                rel="noopener"
                aria-label={r.label}
                class:list={['flex h-10 items-center justify-center bg-white/10 text-white/80 transition hover:bg-accent hover:text-white',r.network?'w-10 rounded-full':'rounded-md px-3']}
              >
                {r.network?<SocialIcon network={r.network} class="size-[18px]" />:<span class="text-xs font-semibold">{r.label}</span>}
              </a>
            ))
          }
        </div>
      </div>

      <!-- En móvil las 3 listas van en 2 columnas para no hacer un footer kilométrico -->
      <nav aria-label="Categorías" class="min-w-0">
        <h2 class="font-display text-sm font-bold tracking-wide text-white uppercase">Categorías</h2>
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-3 lg:grid-cols-1" role="list">
          {
            CATEGORIES.map((cat) => (
              <li>
                <a
                  href={cat.externalUrl ?? `${base}/cursos/${cat.slug}/`}
                  class="text-sm text-white/70 transition hover:text-white"
                  {...(cat.externalUrl ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {cat.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Países" class="min-w-0">
        <h2 class="font-display text-sm font-bold tracking-wide text-white uppercase">Por país</h2>
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-3 lg:grid-cols-1" role="list">
          {
            COUNTRIES.map((c) => (
              <li>
                <a href={`/${c.code}/`} class="text-sm text-white/70 transition hover:text-white">
                  <span aria-hidden="true">{c.flag}</span> {c.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Sably" class="min-w-0">
        <h2 class="font-display text-sm font-bold tracking-wide text-white uppercase">Sably</h2>
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-3 lg:grid-cols-1" role="list">
          {
            SABLY_LINKS.map((l) => (
              <li>
                <a href={l.href} target={l.target} rel={l.target==='_blank'?'noopener':undefined} class="text-sm text-white/70 transition hover:text-white">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-site flex flex-col items-center gap-2 py-5 text-center text-xs text-white/50 sm:flex-row sm:flex-wrap sm:justify-between sm:text-left">
      <p>© {year} Sably — Todos los derechos reservados.</p>
      <p>Los cursos se imparten a través de Hotmart. Certificado incluido.</p>
      {/* Aviso de afiliado en todo el sitio (FTC, SIC, LSSI y la política de
          tergiversación de Google Ads piden declarar la comisión). Dice
          «como afiliado» y no «afiliado de Hotmart»: los Términos de Hotmart
          (6.4) prohíben sugerir un vínculo con Hotmart; la afiliación es a los
          cursos de cada creador. sm:basis-full lo baja a su propia línea. */}
      <p class="sm:basis-full">
        Sably recomienda cursos como afiliado: si compras a través de nuestros enlaces recibimos una comisión, sin
        costo extra para ti. Pagos y acceso gestionados por Hotmart.{' '}
        <a
          href="/legal/terminos/#afiliacion"
          class="underline decoration-white/30 underline-offset-2 transition hover:text-white">Más información</a
        >
      </p>
    </div>
  </div>
</footer>
