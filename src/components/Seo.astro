---
import { EmDashHead } from 'emdash/ui';
import { safeJsonLdSerialize } from 'emdash/page';
import type { PublicPageContext } from 'emdash';
import type { HreflangAlternate } from '@/lib/seo';
interface Props {
  title: string; page: PublicPageContext; alternates?: HreflangAlternate[];
  schemas?: object[]; noindexGoogle?: boolean; ogLocale?: string;
}
const { title, page, alternates = [], schemas = [], noindexGoogle = false, ogLocale = 'es_CO' } = Astro.props;
---
<title>{title}</title>
<EmDashHead {page} />
<meta property="og:locale" content={ogLocale} />
{noindexGoogle && <meta name="googlebot" content="noindex, follow" />}
{alternates.map(alt => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
{schemas.map(schema => <script type="application/ld+json" set:html={safeJsonLdSerialize(schema)} />)}
