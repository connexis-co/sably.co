---
import { env } from 'cloudflare:workers';
import { cmsImageUrl } from '@/lib/cms-media';
import type { Course } from '@/lib/emdash-content';
import { courseCover } from '@/lib/categories';
import { getCategory } from '@/lib/emdash-content';
import { formatPrice, type Country } from '@/lib/countries';
import { formatMonto } from '@/lib/moneda';
import { readOperationalPrice, readOperationalRating } from '@/plugins/sably-operations/public';
import Rating from './Rating.astro';

interface Props {
  course: Course;
  country: Country;
  /** En contexto de ciudad, la card enlaza a la landing hiperlocal del curso. */
  citySlug?: string;
  /** Prioridad de carga para cards above-the-fold. */
  eager?: boolean;
}
const { course, country, citySlug } = Astro.props;
const cat = (await getCategory(course.data.category))!;

/* Precio y valoración reales de Hotmart; sin dato real no se inventa nada:
   precio de catálogo como respaldo, sin estrellas y sin badge de descuento. */
const operationalDb = (env as unknown as {SABLY_DB:D1Database}).SABLY_DB;
const real = await readOperationalPrice(operationalDb, course.id, country, Astro.locals).catch(() => null);
const valoracion = await readOperationalRating(operationalDb, course.id, Astro.locals).catch(() => null);
const url = citySlug
  ? `/${country.code}/${citySlug}/${course.id}/`
  : `/${country.code}/${course.id}/`;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-lg border border-surface-200 bg-white transition duration-300 hover:-translate-y-1 hover:shadow-xl"
>
  <a href={url} class="flex h-full flex-col" aria-label={course.data.title}>
    <div
      class="relative h-40 overflow-hidden"
      style={`background-image: linear-gradient(135deg, ${cat.gradient[0]}, ${cat.gradient[1]})`}
    >
      <img
        src={cmsImageUrl(course.cardImage) ?? cmsImageUrl(course.coverImage) ?? courseCover(course.id, cat.slug, 'card')}
        alt=""
        width="480"
        height="320"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
      <span class="absolute top-3 left-3 rounded-full bg-white/90 px-2.5 py-1 text-[11px] font-bold text-heading">
        {cat.emoji} {cat.name}
      </span>
    </div>
    <div class="flex flex-1 flex-col p-4">
      <h3 class="line-clamp-2 font-display text-base font-bold text-primary group-hover:text-accent">
        {course.data.title}
      </h3>
      <p class="mt-1.5 line-clamp-2 text-sm text-body">{course.data.shortDescription}</p>
      {
        valoracion && (
          <div class="mt-2">
            <Rating rating={valoracion.rating} count={valoracion.total} fuente="Hotmart" />
          </div>
        )
      }
      <p class="mt-1 text-xs text-muted">{course.data.durationHours} h · {course.data.level}</p>
      <div class="mt-auto flex items-baseline gap-2 pt-3">
        <span class="text-lg font-extrabold whitespace-nowrap text-primary">
          {real ? formatMonto(real.monto, real.moneda) : formatPrice(course.data.priceUSD, country)}
        </span>
      </div>
    </div>
  </a>
</article>
