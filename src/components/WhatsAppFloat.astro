---
import type { Country } from '@/lib/countries';
import { buildWhatsAppUrl } from '@/lib/hotmart';

/**
 * Botón flotante de WhatsApp estilo "whatsbuilder" (plugin de JP usado en
 * academiadebelleza.edu.co): círculo verde oficial con ondas expansivas y
 * mensaje pre-llenado contextual por página/curso.
 *
 * Número y posición se pueden cambiar desde /admin/widgets sin desplegar: el
 * HTML hornea los valores por defecto y un fetch a /api/v1/config aplica lo
 * guardado en D1. Si la llamada falla, el botón se queda como está — la
 * personalización es opcional, el botón no.
 *
 * En móvil, cuando la página lleva la barra fija de compra abajo, el botón se
 * eleva por encima de ella (`--wa-carril`): tres flotantes sin coordinar era
 * justo lo que tenía rota la vista móvil.
 */
interface Props {
  country: Country;
  /** Contexto para el mensaje pre-llenado, ej. nombre del curso o página. */
  context?: string;
}
const { country, context } = Astro.props;
const message = context
  ? `Hola, estoy interesado(a) y quiero más información sobre "${context}"`
  : 'Hola, estoy interesado(a) y quiero más información sobre los cursos de Sably';
const url = buildWhatsAppUrl(country.whatsapp, message);
---

<a
  href={url}
  target="_blank"
  rel="noopener nofollow"
  data-wa-float
  data-numero-pais={country.whatsapp}
  data-mensaje={message}
  class="wa-float"
  aria-label={`Escríbenos por WhatsApp (${country.name})`}
>
  <span class="wa-wave" style="animation-delay: 1s" aria-hidden="true"></span>
  <span class="wa-wave" style="animation-delay: 1.3s" aria-hidden="true"></span>
  <span class="wa-wave" style="animation-delay: 1.5s" aria-hidden="true"></span>
  <span class="wa-circle">
    <svg viewBox="0 0 24 24" class="size-8 fill-white" aria-hidden="true">
      <path
        d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.7 14.1c-.2.7-1.4 1.3-1.9 1.3-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-2.9-1.3-4.8-4.2-5-4.4-.1-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4-.1.7.5.2.6.8 2 .9 2.1.1.2.1.3 0 .5-.1.2-.2.4-.3.5l-.5.6c-.2.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.2 1.4 2.5 1.5.3.2.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.3 0 .2 0 .7-.2 1.3Z"
      ></path>
    </svg>
  </span>
</a>

<style>
  .wa-float {
    /* Los offsets viven en variables para que /admin/widgets pueda moverlos. */
    --wa-x: 21px;
    --wa-y: 58px;
    --wa-carril: 0px;
    position: fixed;
    right: var(--wa-x);
    bottom: calc(var(--wa-y) + var(--wa-carril) + env(safe-area-inset-bottom, 0px));
    z-index: 50;
    display: inline-block;
    width: 56px;
    height: 56px;
  }
  /* La barra fija de compra ocupa el borde inferior en todas las anchuras,
     así que el botón sube su carril siempre, no solo en móvil. */
  :global(body[data-has-sticky]) .wa-float {
    --wa-carril: calc(var(--barra-alto, 57px) + 0.75rem);
  }
  .wa-circle {
    position: relative;
    z-index: 10;
    display: flex;
    width: 56px;
    height: 56px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #00e676;
    box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.4);
    transition: transform 0.2s ease;
  }
  .wa-float:hover .wa-circle {
    transform: scale(1.07);
  }
  .wa-wave {
    position: absolute;
    inset: 5px;
    z-index: 1;
    border-radius: 50%;
    background: #00e676;
    opacity: 0;
    animation: wa-wave 1.7s infinite;
  }
  @keyframes wa-wave {
    0% {
      transform: scale(1);
    }
    15% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: scale(2.5);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-wave {
      animation: none;
    }
  }
</style>

<script>
  import { trackEvent } from '@/lib/analytics';

  const boton = document.querySelector<HTMLAnchorElement>('[data-wa-float]');

  boton?.addEventListener('click', () => {
    trackEvent('click_whatsapp', { page_type: document.body.dataset.pageType ?? 'unknown' });
  });

  /* Configuración del panel: número global y posición. Falla en silencio. */
  if (boton) {
    interface Config {
      whatsapp?: {
        activo: boolean;
        numero: string;
        x: number;
        y: number;
        paginasOcultas?: string[];
      };
    }

    /* Coincidencia de ruta para ocultar por página: exacta (con o sin barra
       final) o con comodín `*`. Se configura en /admin/widgets. */
    const rutaOculta = (patrones: string[]): boolean => {
      const ruta = location.pathname;
      return patrones.some((patron) => {
        if (!patron) return false;
        if (patron.includes('*')) {
          const rx = new RegExp(
            '^' +
              patron
                .split('*')
                .map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
                .join('.*') +
              '$',
          );
          return rx.test(ruta);
        }
        return ruta === patron || ruta === `${patron}/` || `${ruta}/` === patron;
      });
    };
    fetch('/api/v1/config')
      .then((r): Promise<Config | null> => (r.ok ? (r.json() as Promise<Config>) : Promise.resolve(null)))
      .then((cfg) => {
        const wa = cfg?.whatsapp;
        if (!wa) return;
        // Apagado global (activo) o por página (lista de rutas del panel).
        if (!wa.activo || rutaOculta(wa.paginasOcultas ?? [])) {
          boton.remove();
          return;
        }
        if (Number.isFinite(wa.x)) boton.style.setProperty('--wa-x', `${wa.x}px`);
        if (Number.isFinite(wa.y)) boton.style.setProperty('--wa-y', `${wa.y}px`);
        // Número global del panel: reescribe el enlace conservando el mensaje.
        if (wa.numero && wa.numero !== boton.dataset.numeroPais) {
          boton.href = `https://wa.me/${wa.numero}?text=${encodeURIComponent(boton.dataset.mensaje ?? '')}`;
        }
      })
      .catch(() => {});
  }
</script>
