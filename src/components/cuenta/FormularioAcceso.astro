---
/**
 * Formulario de acceso (contrato §9, `AccountEntryForm`; diseño «Cuenta / Tarjeta de acceso» y «Tarjeta de
 * código»): el mismo en la página /ingresar/ y en la ventana emergente (`DialogoCuenta.astro`), que lo pide a
 * /ingresar/ con la cabecera `X-Account-Form: 1` y envía los formularios `[data-cuenta-paso]` sin salir de ella.
 * Paso 1: Google y/o correo. Paso 2: el código de 6 dígitos que llegó al correo. La primera vez crea la cuenta.
 */
import BotonGoogle from './BotonGoogle.astro';
import Boton from '@/components/v2/Boton.astro';
import Campo from '@/components/v2/Campo.astro';
import { CONSENTIMIENTO, RUTAS, enlaceIngresar, type ModoAcceso } from '@/lib/cuenta/nucleo';
import { CLAVE_MIN, CLAVE_MAX } from '@/lib/cuenta/clave';
interface Props {
  csrf: string; volver: string; aviso?: string | null; tono?: 'alerta' | 'info';
  google: boolean; correo: boolean;
  /** Correo y contraseña disponibles (necesita el correo: el alta y el olvido van por código). */
  clave?: boolean;
  /** Paso 1: código por correo, contraseña, o crear/cambiar la contraseña. */
  modo?: ModoAcceso;
  /** Paso 2: correo al que se envió el código, segundos para poder pedir otro y si espera una contraseña nueva. */
  codigo?: { email: string; reenviarEn: number; clave?: boolean } | null;
  /** Página: h1. Ventana: párrafo con el id que nombra el diálogo. */
  titulo: 'pagina' | 'ventana';
}
const { csrf, volver, aviso, tono = 'alerta', google, correo, clave = false, codigo, titulo } = Astro.props;
const modo: ModoAcceso = clave ? (Astro.props.modo ?? 'codigo') : 'codigo';
const titulos: Record<ModoAcceso, string> = { codigo: 'Ingresa o crea tu cuenta', clave: 'Ingresa con tu contraseña', nueva: 'Crea o cambia tu contraseña' };
const enlace = (m: ModoAcceso) => enlaceIngresar(volver, undefined, m);
const Titulo = titulo === 'pagina' ? 'h1' : 'p';
const idTitulo = titulo === 'ventana' ? 'v2-cuenta-dialogo-titulo' : undefined;
// En la ventana, el título deja sitio a la X de cerrar.
const claseTitulo = `font-display text-[28px]/[34px] font-semibold text-navy-950 lg:text-[32px]/[38px]${titulo === 'ventana' ? ' pr-10' : ''}`;
---
<div data-cuenta-formulario>
  <style is:inline>
    .v2-cuenta-separador { display: flex; align-items: center; gap: 12px; margin-top: 20px; font: 500 13px/18px var(--font-sans); color: var(--color-navy-500); }
    .v2-cuenta-separador::before, .v2-cuenta-separador::after { content: ''; flex: 1; height: 1px; background: var(--color-navy-100); }
    .v2-cuenta-codigo {
      display: block; width: 100%; height: 64px; border-radius: var(--radius-c-md); border: 1.5px solid var(--color-navy-300); background: #fff;
      text-align: center; font: 600 30px/1 var(--font-display); letter-spacing: 0.35em; padding-left: 0.35em; color: var(--color-navy-950);
      font-variant-numeric: tabular-nums;
    }
    .v2-cuenta-codigo:focus { outline: none; border-color: var(--color-coral-600); box-shadow: 0 0 0 4px var(--color-coral-100, #FBD9E2); }
  </style>
  {codigo ? (
    <>
      <a href={enlaceIngresar(volver)} rel="nofollow" class="mb-3 inline-flex min-h-11 items-center gap-2 text-t15 font-medium text-navy-700" data-cuenta-paso-atras>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        Paso 2 de 2
      </a>
      <Titulo id={idTitulo} class={claseTitulo}>Revisa tu correo</Titulo>
      <p class="mt-2 text-t15 text-navy-700">Escribe el código de 6 dígitos que enviamos a</p>
      <p class="mt-1 flex flex-wrap items-baseline gap-x-3 text-t15"><strong class="break-all text-navy-950">{codigo.email}</strong><a href={enlaceIngresar(volver)} rel="nofollow" class="font-semibold text-navy-950 underline underline-offset-4" data-cuenta-paso-atras>Cambiar</a></p>
      {aviso && <p role={tono === 'alerta' ? 'alert' : 'status'} class:list={['mt-5 rounded-c-md px-4 py-3 text-t15', tono === 'alerta' ? 'bg-coral-50 text-coral-700' : 'bg-navy-50 text-navy-900']}>{aviso}</p>}
      <form method="post" action={RUTAS.correoVerificar} class="mt-5" data-cuenta-paso>
        <input type="hidden" name="csrf" value={csrf} />
        <input type="hidden" name="volver" value={volver} />
        <label for="cuenta-codigo" class="sr-only">Código de 6 dígitos</label>
        <input id="cuenta-codigo" name="codigo" class="v2-cuenta-codigo" inputmode="numeric" autocomplete="one-time-code" pattern="\s*\d{3}\s?\d{3}\s*" maxlength="7" required aria-describedby="cuenta-codigo-ayuda" />
        <p id="cuenta-codigo-ayuda" class="mt-2 text-t13 text-navy-500">Vence en 10 minutos. Si no lo ves, busca en spam o promociones.{codigo.clave && ' Al confirmarlo guardamos tu contraseña y cerramos la sesión en tus otros dispositivos.'}</p>
        <Boton tipo="submit" alto={52} completo flecha={false} class="mt-5">Verificar y entrar</Boton>
      </form>
      <form method="post" action={RUTAS.correoEnviar} class="mt-4 flex flex-wrap items-center gap-x-2 text-t15 text-navy-700" data-cuenta-paso>
        <input type="hidden" name="csrf" value={csrf} />
        <input type="hidden" name="volver" value={volver} />
        <input type="hidden" name="email" value={codigo.email} />
        <input type="hidden" name="reenviar" value="1" />
        <input type="hidden" name="pais" value="" data-cuenta-pais />
        ¿No llegó? <button type="submit" class="min-h-11 font-semibold text-navy-950 underline underline-offset-4">Reenviar código</button>
        {codigo.reenviarEn > 0 && <span class="w-full text-t13 text-navy-500">Puedes pedir otro dentro de un minuto.</span>}
      </form>
    </>
  ) : (
    <>
      <Titulo id={idTitulo} class={claseTitulo}>{titulos[modo]}</Titulo>
      <p class="mt-2 text-t15 text-navy-700">{modo === 'nueva'
        ? 'Escribe tu correo y la contraseña que quieres usar. Te enviamos un código para confirmar que el correo es tuyo; si ya tienes cuenta, la nueva reemplaza a la anterior.'
        : correo ? 'Con Google, con un código que te enviamos al correo o con tu contraseña.' : 'Con tu cuenta de Google. Si es la primera vez, se crea tu cuenta en el momento.'}</p>
      {aviso && <p role={tono === 'alerta' ? 'alert' : 'status'} class:list={['mt-5 rounded-c-md px-4 py-3 text-t15', tono === 'alerta' ? 'bg-coral-50 text-coral-700' : 'bg-navy-50 text-navy-900']}>{aviso}</p>}
      {google && modo !== 'nueva' && (
        <form method="post" action={RUTAS.googleInicio} class="mt-6" data-cuenta-ingresar>
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="volver" value={volver} />
          <input type="hidden" name="pais" value="" data-cuenta-pais />
          <BotonGoogle />
        </form>
      )}
      {correo && modo === 'codigo' && (
        <>
          {google && <p class="v2-cuenta-separador" role="presentation"><span>o con tu correo</span></p>}
          <form method="post" action={RUTAS.correoEnviar} class:list={[google ? 'mt-4' : 'mt-6']} data-cuenta-paso>
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="volver" value={volver} />
            <input type="hidden" name="pais" value="" data-cuenta-pais />
            <Campo id="cuenta-correo" nombre="email" etiqueta="Correo electrónico" tipo="email" requerido autocompletar="email" maximo={254} />
            <Boton tipo="submit" alto={52} completo flecha={false} class="mt-4">Enviarme un código</Boton>
          </form>
          <p class="mt-3 text-t13 text-navy-500">¿Primera vez? Tu cuenta se crea al confirmar el código.</p>
          {clave && <p class="mt-2 text-t15"><a href={enlace('clave')} rel="nofollow" class="font-semibold text-navy-950 underline underline-offset-4" data-cuenta-paso-atras>Entrar con contraseña</a></p>}
        </>
      )}
      {modo === 'clave' && (
        <>
          {google && <p class="v2-cuenta-separador" role="presentation"><span>o con tu correo y contraseña</span></p>}
          <form method="post" action={RUTAS.claveEntrar} class:list={[google ? 'mt-4' : 'mt-6']} data-cuenta-paso>
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="volver" value={volver} />
            <Campo id="cuenta-correo" nombre="email" etiqueta="Correo electrónico" tipo="email" requerido autocompletar="username" maximo={254} />
            <div class="v2-campo mt-4">
              <input id="cuenta-clave" name="clave" type="password" placeholder=" " required autocomplete="current-password" minlength={1} maxlength={CLAVE_MAX} />
              <label for="cuenta-clave">Contraseña</label>
              
            </div>
            <Boton tipo="submit" alto={52} completo flecha={false} class="mt-4">Entrar</Boton>
          </form>
          <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-t15">
            <a href={enlace('nueva')} rel="nofollow" class="font-semibold text-navy-950 underline underline-offset-4" data-cuenta-paso-atras>¿Olvidaste tu contraseña?</a>
            <a href={enlace('codigo')} rel="nofollow" class="font-semibold text-navy-950 underline underline-offset-4" data-cuenta-paso-atras>Entrar con un código</a>
          </p>
          <p class="mt-2 text-t13 text-navy-500">¿Primera vez? <a href={enlace('nueva')} rel="nofollow" class="underline underline-offset-2" data-cuenta-paso-atras>Crea tu cuenta con contraseña</a>.</p>
        </>
      )}
      {modo === 'nueva' && (
        <>
          <form method="post" action={RUTAS.claveNueva} class="mt-6" data-cuenta-paso>
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="volver" value={volver} />
            <input type="hidden" name="pais" value="" data-cuenta-pais />
            <Campo id="cuenta-correo" nombre="email" etiqueta="Correo electrónico" tipo="email" requerido autocompletar="username" maximo={254} />
            <div class="v2-campo mt-4">
              <input id="cuenta-clave-nueva" name="clave" type="password" placeholder=" " required autocomplete="new-password" minlength={CLAVE_MIN} maxlength={CLAVE_MAX} aria-describedby="cuenta-clave-nueva-ayuda" />
              <label for="cuenta-clave-nueva">Contraseña nueva</label>
              <span id="cuenta-clave-nueva-ayuda" class="v2-campo-ayuda">Al menos 10 caracteres. Mejor una frase que no uses en otros sitios.</span>
            </div>
            <Boton tipo="submit" alto={52} completo flecha={false} class="mt-4">Enviarme el código</Boton>
          </form>
          <p class="mt-3 text-t15"><a href={enlace('clave')} rel="nofollow" class="font-semibold text-navy-950 underline underline-offset-4" data-cuenta-paso-atras>Volver a entrar con contraseña</a></p>
        </>
      )}
      <p class="mt-4 text-t13 text-navy-500">{CONSENTIMIENTO.texto} Más detalles en la <a href="/legal/privacidad/" class="underline underline-offset-2">política de privacidad</a>.</p>
      <p class="mt-5 flex gap-3 rounded-c-md bg-navy-50 px-4 py-3 text-t13 text-navy-700">
        <svg class="mt-0.5 flex-none" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        Para comprar un curso no necesitas cuenta. El pago se hace en Hotmart.
      </p>
    </>
  )}
</div>
