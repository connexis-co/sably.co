---
/**
 * Ventana emergente de acceso (contrato §9, `AccountDialog`): `<dialog>` modal, centrado en escritorio y hoja
 * inferior en móvil. Al pulsar un enlace `[data-cuenta-abrir]` («Entrar» de la cabecera o del menú) pide el
 * formulario a /ingresar/ con `X-Account-Form: 1` y lo pinta dentro; el envío va a Google como desde la página.
 * Sin JavaScript, o si la petición falla, el enlace abre la página /ingresar/. Está en la capa superior: no
 * mueve nada de la página.
 */
---
<dialog id="v2-cuenta-dialogo" class="v2-cuenta-dialogo" aria-labelledby="v2-cuenta-dialogo-titulo">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p id="v2-cuenta-dialogo-titulo" class="font-display text-[26px]/[32px] font-semibold text-navy-950">Entra en Sably</p>
      <p class="mt-2 text-t15 text-navy-700">Con tu cuenta de Google. Si es la primera vez, se crea tu cuenta en el momento.</p>
    </div>
    <button type="button" class="v2-icono-boton v2-sin-borde -mt-1 -mr-2 flex-none" data-cuenta-cerrar aria-label="Cerrar">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>
  <div class="mt-6 min-h-[204px]" data-cuenta-dialogo-cuerpo aria-live="polite">
    <div class="h-[52px] animate-pulse rounded-full bg-navy-50" aria-hidden="true"></div>
  </div>
</dialog>

<style is:global>
  .v2-cuenta-dialogo {
    margin: auto; padding: 28px; border: 0; border-radius: var(--radius-c-xl); background: #fff; color: var(--color-navy-950);
    width: min(460px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); box-shadow: var(--shadow-s3); overflow: auto; overscroll-behavior: contain;
  }
  .v2-cuenta-dialogo::backdrop { background: rgb(27 27 58 / 0.45); }
  @media (width < 640px) {
    .v2-cuenta-dialogo {
      margin: auto 0 0; width: 100%; max-width: none; border-radius: var(--radius-c-xl) var(--radius-c-xl) 0 0;
      padding: 24px 20px max(24px, env(safe-area-inset-bottom));
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .v2-cuenta-dialogo { transition: opacity var(--t-base) var(--e-sale), translate var(--t-base) var(--e-sale), overlay var(--t-base) allow-discrete, display var(--t-base) allow-discrete; opacity: 0; translate: 0 12px; }
    .v2-cuenta-dialogo[open] { opacity: 1; translate: 0 0; }
    @starting-style { .v2-cuenta-dialogo[open] { opacity: 0; translate: 0 12px; } }
  }
</style>

<script>
  import { prepararDialogo } from './dialogo-cliente';
  prepararDialogo();
</script>
