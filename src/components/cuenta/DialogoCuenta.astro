---
/**
 * Ventana emergente de acceso (contrato §9, `AccountDialog`): un dialog modal, centrado en escritorio y hoja
 * inferior en móvil. Al pulsar un enlace `[data-cuenta-abrir]` («Ingresar» de la cabecera o del menú) pide el
 * formulario a /ingresar/ con `X-Account-Form: 1` y lo pinta dentro; el correo y el código se envían sin salir
 * de ella (dialogo-cliente.ts) y Google va a su página como desde /ingresar/. Sin JavaScript, o si la petición
 * falla, el enlace abre la página /ingresar/. Está en la capa superior: no mueve nada de la página.
 */
---
<dialog id="v2-cuenta-dialogo" class="v2-cuenta-dialogo" aria-labelledby="v2-cuenta-dialogo-titulo">
  <button type="button" class="v2-icono-boton v2-sin-borde v2-cuenta-dialogo-cerrar" data-cuenta-cerrar aria-label="Cerrar">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
  </button>
  <div class="min-h-[300px]" data-cuenta-dialogo-cuerpo aria-live="polite">
    <p id="v2-cuenta-dialogo-titulo" class="font-display text-[28px]/[34px] font-semibold text-navy-950">Ingresa o crea tu cuenta</p>
    <div class="mt-6 h-[52px] animate-pulse rounded-full bg-navy-50" aria-hidden="true"></div>
  </div>
</dialog>

<style is:inline>
  .v2-cuenta-dialogo {
    margin: auto; padding: 28px; position: fixed; border: 0; border-radius: var(--radius-c-xl); background: #fff; color: var(--color-navy-950);
    width: min(460px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); box-shadow: var(--shadow-s3); overflow: auto; overscroll-behavior: contain;
  }
  .v2-cuenta-dialogo-cerrar { position: absolute; top: 14px; right: 14px; }
  .v2-cuenta-dialogo::backdrop { background: rgb(27 27 58 / 0.45); }
  @media (width < 640px) {
    .v2-cuenta-dialogo {
      margin: auto 0 0; width: 100%; max-width: none; border-radius: var(--radius-c-xl) var(--radius-c-xl) 0 0;
      padding: 24px 20px max(24px, env(safe-area-inset-bottom));
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .v2-cuenta-dialogo { transition: opacity var(--t-base) var(--e-sale), translate var(--t-base) var(--e-sale), overlay var(--t-base) allow-discrete, display var(--t-base) allow-discrete; opacity: 0; translate: 0 12px; }
    .v2-cuenta-dialogo[open] { opacity: 1; translate: 0 0; }
    @starting-style { .v2-cuenta-dialogo[open] { opacity: 0; translate: 0 12px; } }
  }
</style>

<script>
  import { prepararDialogo } from './dialogo-cliente';
  prepararDialogo();
</script>
