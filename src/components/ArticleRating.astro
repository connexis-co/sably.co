---
/**
 * Valoración del artículo con estrellas, contra D1.
 *
 * El promedio que se enseña sale de `/api/v1/pulso` y solo cuando el backend
 * lo declara publicable: hacen falta al menos 5 votos de 5 IPs distintas. Por
 * debajo de eso no se enseña número — un «5,0 de 1 voto» es ruido que parece
 * dato, y ya se retiró de este sitio un agregado inventado por ese motivo.
 *
 * El voto no alimenta ningún Schema.org: lo que lee Google se hornea en el
 * build desde el snapshot, para que sea auditable en dist/.
 */
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<section
  data-rating-widget
  data-slug={slug}
  class="mt-10 rounded-lg border border-surface-200 bg-off-white p-6 text-center"
  aria-labelledby="rating-title"
>
  <h2 id="rating-title" class="font-display text-lg font-bold text-primary">¿Te sirvió este artículo?</h2>
  <p class="mt-1 text-sm text-body">Tu valoración nos ayuda a mejorar el contenido.</p>

  <div class="mt-4 flex items-center justify-center gap-1" role="group" aria-label="Calificar de 1 a 5 estrellas">
    {
      [1, 2, 3, 4, 5].map((n) => (
        <button
          type="button"
          data-star={n}
          aria-label={`${n} ${n === 1 ? 'estrella' : 'estrellas'}`}
          class="rounded p-1 text-2xl leading-none transition-transform duration-150 hover:scale-110"
        >
          <span data-star-icon class="text-surface-300">★</span>
        </button>
      ))
    }
  </div>

  <p data-rating-thanks class="mt-2 hidden text-sm font-semibold text-success">¡Gracias por tu valoración! 🎉</p>
  <p data-rating-error class="mt-2 hidden text-sm font-semibold text-error"></p>
  <p data-rating-avg class="mt-2 hidden text-sm text-muted"></p>
</section>

<script>
  import { trackEvent } from '@/lib/analytics';
  import { visitanteId, permanencia } from '@/lib/visitante';

  const widget = document.querySelector<HTMLElement>('[data-rating-widget]');
  if (widget) {
    const slug = widget.dataset.slug ?? '';
    const subject = `blog:${slug}`;
    const key = `sably:rating:${slug}`;
    const stars = [...widget.querySelectorAll<HTMLButtonElement>('[data-star]')];
    const thanks = widget.querySelector<HTMLElement>('[data-rating-thanks]');
    const fallo = widget.querySelector<HTMLElement>('[data-rating-error]');
    const media = widget.querySelector<HTMLElement>('[data-rating-avg]');

    const paint = (value: number) => {
      stars.forEach((btn, i) => {
        const icon = btn.querySelector('[data-star-icon]');
        icon?.classList.toggle('text-warning', i < value);
        icon?.classList.toggle('text-surface-300', i >= value);
      });
    };

    /** Solo se enseña el promedio cuando el backend dice que es publicable. */
    type Pulso = { votes: number; avg: number | null; publicable: boolean };
    const pintarMedia = (d: Pulso) => {
      if (!media) return;
      if (!d.publicable || d.avg === null) {
        media.classList.add('hidden');
        return;
      }
      media.textContent = `${d.avg.toFixed(1)} de 5 · ${d.votes} valoraciones`;
      media.classList.remove('hidden');
    };

    const previo = Number(localStorage.getItem(key) || 0);
    if (previo) {
      paint(previo);
      thanks?.classList.remove('hidden');
    }

    // El promedio se pide una vez al cargar, sin bloquear nada.
    void fetch(`/api/v1/pulso?subject=${encodeURIComponent(subject)}`, {
      signal: AbortSignal.timeout(6000),
    })
      .then((r) => (r.ok ? (r.json() as Promise<Pulso>) : null))
      .then((d) => d && pintarMedia(d))
      .catch(() => {
        /* sin promedio no pasa nada: el widget sigue sirviendo para votar */
      });

    stars.forEach((btn) =>
      btn.addEventListener('click', async () => {
        const value = Number(btn.dataset.star);
        paint(value);
        fallo?.classList.add('hidden');

        try {
          const r = await fetch('/api/v1/votos', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              subject,
              value,
              visitor_id: visitanteId(),
              // La base exige un mínimo de permanencia con un CHECK: votar a
              // los 400 ms no se puede insertar ni aunque el cliente insista.
              dwell_ms: permanencia(),
            }),
            signal: AbortSignal.timeout(8000),
          });
          const d = (await r.json().catch(() => ({}))) as {
            error?: string; votes?: number; avg?: number | null;
          };
          if (!r.ok) throw new Error(d.error || 'no se pudo guardar');

          localStorage.setItem(key, String(value));
          thanks?.classList.remove('hidden');
          trackEvent('rate_article', { article: slug, rating: value });
          // El POST devuelve el agregado, pero el umbral lo decide /pulso.
          void fetch(`/api/v1/pulso?subject=${encodeURIComponent(subject)}`)
            .then((x) => (x.ok ? (x.json() as Promise<Pulso>) : null))
            .then((x) => x && pintarMedia(x))
            .catch(() => {});
        } catch (e) {
          // Se revierte al voto anterior: dejar la estrella encendida diría que
          // se guardó algo que no se guardó.
          paint(Number(localStorage.getItem(key) || 0));
          thanks?.classList.add('hidden');
          if (fallo) {
            const msg = (e as Error).message;
            fallo.textContent = /demasiado rápido/.test(msg)
              ? 'Lee un poco el artículo antes de valorarlo.'
              : 'No pudimos guardar tu valoración. Inténtalo de nuevo.';
            fallo.classList.remove('hidden');
          }
        }
      }),
    );
    stars.forEach((btn, i) => {
      btn.addEventListener('mouseenter', () => paint(i + 1));
    });
    widget.addEventListener('mouseleave', () => paint(Number(localStorage.getItem(key) || 0)));
  }
</script>
