---
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry, render } from 'astro:content';
import { renderMarkdown } from '@/lib/markdown';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Rating from '@/components/Rating.astro';
import CourseCard from '@/components/CourseCard.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import StickyCta from '@/components/StickyCta.astro';
import ExitIntent from '@/components/ExitIntent.astro';
import LeadModal from '@/components/LeadModal.astro';
import { COUNTRIES, formatPrice, localPrice, type Country, type City } from '@/lib/countries';
import { formatMonto, precioReal, valoracionReal } from '@/lib/hotmartLive';
import { getCategory, courseCover } from '@/lib/categories';
import { buildHotmartUrl } from '@/lib/hotmart';
import { countryAlternates, breadcrumbSchema, faqSchema, courseSchema } from '@/lib/seo';
import { SITE } from '@/lib/site';

/**
 * Landing de conversión de curso, hiperlocal cuando recibe `city`:
 * H1/meta/breadcrumb/FAQ/testimonios/UTM cambian según la ciudad.
 */
interface Props {
  course: CollectionEntry<'courses'>;
  country: Country;
  city?: City;
}

const { course, country, city } = Astro.props;
const category = getCategory(course.data.category);
const base = `/${country.code}`;
const coursePath = city ? `${base}/${city.slug}/${course.id}/` : `${base}/${course.id}/`;
const { Content } = await render(course);

/* Variante por país generada y validada (scripts/generar-catalogo.py). Si
   existe, la página usa su meta, descripción, FAQs y listas; si no, cae al
   contenido genérico del MDX. Opcional por diseño: el build nunca depende
   del lote completo. */
const locale = (await getEntry('courseLocales', `${course.id}--${country.code}`)) ?? null;
/* renderMarkdown baja los encabezados un nivel para que cuelguen del h2 de la
   sección, de ahí que el tamaño de prosa se defina sobre h3 y h4. Las listas
   numeradas llevan su propio marcador porque el list-disc de los elementos
   alcanzaba también a los de las listas ordenadas. */
const localeHtml = locale ? renderMarkdown(locale.data.descripcion) : null;
const learnings = locale?.data.beneficios ?? course.data.learnings;
const audience = locale?.data.para_quien ?? course.data.audience;

/* El título de país colisiona por dos vías: sin variante todos los países
   comparten el metaTitle del MDX, y con variante el modelo a veces repite el
   mismo título en varios mercados. Se añade el país solo cuando hay colisión
   real: la mediana ya está en 55 caracteres y añadirlo siempre pasaría de 60. */
const localesDelCurso = (await getCollection('courseLocales')).filter(
  (l) => l.data.course === course.id,
);
const tituloColisiona = locale
  ? localesDelCurso.filter((l) => l.data.meta_title === locale.data.meta_title).length > 1
  : localesDelCurso.length < COUNTRIES.length - 1;

/* El `ref` es lo que acredita la comisión: sin él la venta se le atribuye al
   productor. El descuento NO se añade aquí (sería una promesa horneada en el
   HTML estático): lo inyecta el script de promo si hay campaña vigente. */
const ctaUrl = buildHotmartUrl({
  baseUrl: course.data.hotmartUrl,
  ref: course.data.hotmartRef,
  courseSlug: course.id,
  countryCode: country.code,
  citySlug: city?.slug,
});

/* Sin producto Hotmart asignado, `hotmartUrl` es el placeholder PENDIENTE y el
   checkout responde `pay.hotmart.com/error?errorMessage=008`. Mandar ahí al
   usuario quema la visita, así que el CTA captura el lead en su lugar. Esto
   aplica igual a las variantes de país y ciudad, que comparten este componente. */
const hayCheckout = !course.data.hotmartUrl.includes('PENDIENTE');
const ctaHref = hayCheckout ? ctaUrl : '#lead-modal';

const allCourses = await getCollection('courses');

/* Jerarquía pilar/satélite: el pilar es el único que apunta al head term.
   El satélite enlaza hacia arriba y el pilar lista sus especializaciones, de
   modo que la señal se concentra en una sola página en vez de repartirse. */
const pillar = course.data.pillar
  ? (allCourses.find((c) => c.id === course.data.pillar) ?? null)
  : null;
const satellites = allCourses.filter((c) => c.data.pillar === course.id);

const related = allCourses
  .filter(
    (c) =>
      c.data.category === course.data.category &&
      c.id !== course.id &&
      c.id !== pillar?.id &&
      !satellites.some((s) => s.id === c.id),
  )
  .slice(0, 4);

const allTestimonials = (await getCollection('testimonials')).filter(
  (t) => t.data.courseSlug === course.id || t.data.category === course.data.category,
);
const cityFirst = city
  ? [...allTestimonials].sort(
      (a, b) =>
        Number(b.data.citySlug === city.slug && b.data.countryCode === country.code) -
        Number(a.data.citySlug === city.slug && a.data.countryCode === country.code),
    )
  : allTestimonials;
const testimonials = cityFirst.slice(0, 3);

/**
 * Precio y valoración REALES de Hotmart (src/data/hotmart-live.json).
 *
 * Cuando existen, mandan sobre el frontmatter: el precio de catálogo salía de
 * `priceUSD × tasa estática` y enseñaba $140.000 COP mientras el checkout
 * cobraba $165.450 — el visitante veía un precio y pagaba otro. Sin dato real
 * no se inventa nada: precio de catálogo como respaldo y cero estrellas.
 */
const real = precioReal(course.id, country);
const valoracion = valoracionReal(course.id);
const precioTexto = real
  ? formatMonto(real.monto, real.moneda)
  : formatPrice(course.data.priceUSD, country);

/* FAQs: las del curso + banco estándar (garantiza ≥8 por página, con FAQPage schema). */
const STANDARD_FAQS = [
  {
    q: '¿Cómo se realiza el pago?',
    a: `El pago se procesa de forma 100% segura a través de Hotmart, con tarjetas y métodos de pago locales de ${country.name}. Pagas una sola vez, en ${country.currency} o su equivalente.`,
  },
  {
    q: '¿Puedo estudiar desde el celular?',
    a: 'Sí. La plataforma funciona en celular, tablet y computador, con las clases disponibles 24/7 para que avances donde estés.',
  },
  {
    q: '¿Cuándo empiezo el curso?',
    a: 'El acceso es inmediato: al confirmarse el pago recibes un correo con tu ingreso a la plataforma y puedes empezar en minutos.',
  },
  {
    q: '¿Qué pasa si tengo dudas durante el curso?',
    a: 'Cuentas con soporte por WhatsApp de nuestro equipo y el área de preguntas del curso para resolver lo que se te atasque.',
  },
];

/* Con variante país, sus 8 FAQs (que ya cubren pagos locales) sustituyen al
   banco genérico: mezclar ambos duplicaría la pregunta de pago. */
const baseFaqs = locale ? locale.data.faqs : [...course.data.faqs, ...STANDARD_FAQS];
const faqs = city
  ? [
      {
        q: `¿Puedo tomar este curso desde ${city.name}?`,
        a: `Sí. El curso es 100% online: estudia desde ${city.name} a tu ritmo, con acceso de por vida y precios en ${country.currency}. Solo necesitas internet.`,
      },
      ...baseFaqs,
      {
        q: `¿El certificado sirve en ${city.name}?`,
        a: `El certificado digital respalda tus habilidades ante clientes y empleadores en ${city.name} y toda Latinoamérica.`,
      },
    ]
  : baseFaqs;

const pageUrl = `${SITE.url}${coursePath}`;
const h1 = city ? `${course.data.title} en ${city.name}` : (locale?.data.h1 ?? course.data.title);
const tituloPais =
  locale?.data.meta_title ??
  course.data.metaTitle ??
  `${course.data.title} | Curso Online con Certificado | Sably`;
const title = city
  ? `${course.data.title} en ${city.name}, ${country.name} | Online + Certificado | Sably`
  : tituloColisiona
    ? `${tituloPais.replace(/\s*\|\s*Sably\s*$/, '')} | ${country.name}`
    : tituloPais;
const descPais = locale?.data.meta_description ?? course.data.shortDescription;
const descColisiona = locale
  ? localesDelCurso.filter((l) => l.data.meta_description === locale.data.meta_description).length > 1
  : localesDelCurso.length < COUNTRIES.length - 1;
const description = city
  ? `Estudia desde ${city.name}: ${course.data.shortDescription}`.slice(0, 158)
  : descColisiona
    ? `Desde ${country.name}: ${descPais}`.slice(0, 158)
    : descPais;

const breadcrumb = city
  ? [
      { name: 'Inicio', url: `${SITE.url}${base}/` },
      { name: city.name, url: `${SITE.url}${base}/${city.slug}/` },
      { name: category.name, url: `${SITE.url}${base}/${city.slug}/cursos/${category.slug}/` },
      { name: course.data.title, url: pageUrl },
    ]
  : [
      { name: 'Inicio', url: `${SITE.url}${base}/` },
      { name: category.name, url: `${SITE.url}${base}/cursos/${category.slug}/` },
      { name: course.data.title, url: pageUrl },
    ];

const schemas = [
  breadcrumbSchema(breadcrumb),
  courseSchema({
    title: course.data.title,
    description: course.data.shortDescription,
    url: pageUrl,
    image: new URL(courseCover(course.id, category.slug), SITE.url).href,
    // El precio marcado es el mismo que se enseña: Google exige que coincidan.
    price: real ? real.monto : localPrice(course.data.priceUSD, country),
    priceCurrency: real ? real.moneda : country.currency,
    instructorName: course.data.instructor.name,
    category: category.name,
    workloadHours: course.data.durationHours,
    teaches: course.data.learnings,
    level: course.data.level,
    syllabus: course.data.modules.map((m) => m.title),
    datePublished: course.data.publishedAt.toISOString(),
    // La valoración pública real del producto en Hotmart, dejada por
    // compradores. La misma que pintan las estrellas visibles: sin dato real
    // no se emite nada, que inventar reseñas para Google es acción manual.
    ...(valoracion ? { rating: { value: valoracion.rating, count: valoracion.total } } : {}),
  }),
  faqSchema(faqs),
];
---

<BaseLayout
  {title}
  {description}
  {country}
  {city}
  pathAfterCountry={`/${course.id}/`}
  alternates={city ? [] : countryAlternates(`/${course.id}/`)}
  image={courseCover(course.id, category.slug)}
  {schemas}
  pageType={city ? 'course_city' : 'course'}
  whatsappContext={city ? `${course.data.title} (${city.name})` : course.data.title}
>
  <StickyCta title={course.data.title} precio={precioTexto} ctaUrl={ctaHref} />

  <!-- Hero -->
  <section class="bg-primary">
    <div class="container-site grid gap-10 py-14 lg:grid-cols-[1fr_420px] lg:py-20">
      <div>
        <nav aria-label="Breadcrumb" class="text-sm text-white/60">
          <a href={`${base}/`} class="hover:text-white">Inicio</a> <span aria-hidden="true">›</span>
          {
            city && (
              <>
                <a href={`${base}/${city.slug}/`} class="hover:text-white">
                  {city.name}
                </a>
                <span aria-hidden="true">›</span>
              </>
            )
          }
          <a
            href={city ? `${base}/${city.slug}/cursos/${category.slug}/` : `${base}/cursos/${category.slug}/`}
            class="hover:text-white">{category.name}</a
          >
          <span aria-hidden="true">›</span>
          <span class="text-white">{course.data.title}</span>
        </nav>
        <h1 class="mt-4 text-3xl leading-tight font-extrabold text-white sm:text-4xl">{h1}</h1>
        <p class="mt-4 max-w-xl text-lg text-white/80">{locale?.data.subtitulo ?? course.data.shortDescription}</p>
        {/* Solo métricas reales: las estrellas son la valoración pública del
            producto en Hotmart (dejada por compradores) y solo se pintan si
            existen. El «N estudiantes» del frontmatter y el «N lo están
            tomando en tu ciudad» eran números inventados y se retiraron. */}
        <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-white/80">
          {valoracion && (
            <Rating rating={valoracion.rating} count={valoracion.total} class="[&_*]:!text-white/90" />
          )}
          <span>🕐 {course.data.durationHours} horas</span>
          <span>📚 {course.data.lessonsCount} lecciones</span>
          <span>📈 {course.data.level}</span>
        </div>
      </div>

      <!-- Card de compra -->
      <div class="h-fit rounded-lg bg-white p-6 shadow-2xl">
        <div
          class="relative h-40 overflow-hidden rounded-md"
          style={`background-image: linear-gradient(135deg, ${category.gradient[0]}, ${category.gradient[1]})`}
        >
          <img
            src={courseCover(course.id, category.slug)}
            alt={`${category.name}: ${course.data.title}`}
            width="800"
            height="533"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        </div>
        {/* `whitespace-nowrap` en cada importe: sin él, monedas largas como
            "$165.450 COP" parten el valor y la moneda en dos renglones.

            Con precio real NO hay tachado ni badge de descuento fijos: el
            «antes $156.000» salía de un originalPriceUSD de catálogo que el
            checkout jamás cobró. El badge existe oculto y lo enseña el script
            de promo cuando hay campaña vigente — descuento anunciado solo si
            el cupón lo aplica de verdad. */}
        <div class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span
            data-precio-real
            data-slug={course.id}
            data-moneda={real?.moneda}
            class="text-3xl font-extrabold whitespace-nowrap text-primary">{precioTexto}</span
          >
          {
            !real && (
              <span class="text-lg whitespace-nowrap text-muted line-through">
                {formatPrice(course.data.originalPriceUSD, country)}
              </span>
            )
          }
          <span
            data-promo-badge
            hidden
            class="rounded-full bg-accent px-2.5 py-1 text-xs font-bold whitespace-nowrap text-white"
          ></span>
        </div>
        {
          real && !real.esLocal && (
            <p class="mt-1 text-xs text-muted">
              Precio en dólares; al pagar, Hotmart lo muestra en tu moneda local.
            </p>
          )
        }
        {/* Oculto por defecto: solo se muestra si hay campaña vigente (ver promo.ts). */}
        <p
          data-promo-nota
          hidden
          data-country={country.code}
          data-slug={course.id}
          class="mt-1 text-xs font-semibold text-error"
        >
          🔥 <span data-promo-nota-texto></span> — se aplica automáticamente al pagar
        </p>
        <a
          href={ctaHref}
          target={hayCheckout ? '_blank' : undefined}
          rel="noopener nofollow sponsored"
          {...(hayCheckout ? { 'data-cta-hotmart': true } : { 'data-lead-open': true })}
          data-cta-position="hero"
          class="animate-pulse-soft mt-5 block rounded-md bg-accent px-6 py-4 text-center font-bold text-white transition hover:bg-accent-hover"
        >
          {hayCheckout ? '🔥 Inscribirme ahora' : '📩 Avísame cuando abra'}
        </a>
        {
          /* Sin cupo abierto el CTA no puede prometer inscripción. Se avisa en corto
             y el botón pasa a captar el lead, que es lo único accionable ahora. */
          !hayCheckout && (
            <p class="mt-2 text-center text-xs text-muted">
              Las inscripciones a este curso están cerradas por el momento. Déjanos tus datos y te
              avisamos apenas se abran.
            </p>
          )
        }
        <button
          type="button"
          data-lead-open
          class="mt-3 block w-full rounded-md border border-surface-300 px-6 py-3 text-center text-sm font-semibold text-heading transition hover:border-accent hover:text-accent"
        >
          Recibir más información
        </button>
        <ul class="mt-5 space-y-2 text-sm text-body" role="list">
          <li>✅ Acceso de por vida, 24/7</li>
          <li>✅ Certificado digital incluido</li>
          <li>✅ Garantía de 7 días</li>
          <li>✅ Pago seguro vía Hotmart</li>
        </ul>
      </div>
    </div>
    <div id="hero-sentinel" aria-hidden="true"></div>
  </section>

  <div class="container-site grid gap-12 py-14 lg:grid-cols-[1fr_380px]">
    <div class="min-w-0 space-y-12">
      {
        city && (
          <p class="rounded-lg bg-accent-soft p-5 text-sm leading-relaxed text-heading">
            <strong>¿Vives en {city.name}?</strong> Este curso es 100% online: estúdialo a tu ritmo desde cualquier
            barrio de {city.name} y aplica lo aprendido para emprender o mejorar tus ingresos en tu ciudad, con precios
            en {country.currency} y acompañamiento por WhatsApp en {country.name}.
          </p>
        )
      }

      <!-- Qué aprenderás -->
      <section aria-labelledby="learnings-title">
        <h2 id="learnings-title" class="text-2xl font-bold">Qué aprenderás</h2>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2" role="list">
          {
            learnings.map((item) => (
              <li class="flex items-start gap-2.5 rounded-md bg-off-white p-3.5 text-sm text-heading">
                <span class="text-success" aria-hidden="true">
                  ✅
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Programa -->
      <section aria-labelledby="program-title">
        <h2 id="program-title" class="text-2xl font-bold">Programa del curso</h2>
        <div class="mt-5 divide-y divide-surface-200 rounded-lg border border-surface-200">
          {
            course.data.modules.map((mod, i) => (
              <details class="group p-5" open={i === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-heading">
                  <span>
                    <span class="mr-2 text-accent">Módulo {i + 1}.</span>
                    {mod.title}
                  </span>
                  <span class="text-accent transition-transform group-open:rotate-45" aria-hidden="true">
                    +
                  </span>
                </summary>
                <ul class="mt-3 space-y-2 pl-2" role="list">
                  {mod.lessons.map((lesson) => (
                    <li class="flex items-center gap-2.5 text-sm text-body">
                      <span aria-hidden="true">▶️</span>
                      {lesson}
                    </li>
                  ))}
                </ul>
              </details>
            ))
          }
        </div>
      </section>

      <!-- Certificado -->
      <section aria-labelledby="cert-title" class="rounded-lg bg-off-white p-6 sm:p-8">
        <div class="grid items-center gap-6 sm:grid-cols-[1fr_260px]">
          <div>
            <h2 id="cert-title" class="text-2xl font-bold">Tu certificado al completar el curso</h2>
            <p class="mt-3 text-sm leading-relaxed text-body">
              Al terminar el 100% de las lecciones recibes un <strong class="text-heading">certificado digital de
              finalización emitido a través de Hotmart</strong>, con tu nombre y el del curso. Puedes descargarlo,
              imprimirlo y compartirlo en tu hoja de vida o redes profesionales.
            </p>
            <ul class="mt-4 space-y-1.5 text-sm text-body" role="list">
              <li>✅ Digital y verificable</li>
              <li>✅ Con tu nombre completo</li>
              <li>✅ Sin costo adicional</li>
            </ul>
          </div>
          <img
            src="/certificado-sably.jpg"
            alt="Ejemplo del certificado digital de finalización que recibirás"
            width="800"
            height="533"
            loading="lazy"
            class="w-full rounded-md border border-surface-200 object-cover shadow-md"
          />
        </div>
      </section>

      <!-- Sobre el curso: variante país generada, o el MDX genérico si no hay -->
      <section aria-label="Sobre este curso">
        <h2 class="text-2xl font-bold">Sobre este curso</h2>
        <div class="mt-4 space-y-4 text-[15px] leading-relaxed text-body [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-primary [&_h4]:mt-6 [&_h4]:text-lg [&_h4]:font-bold [&_h4]:text-primary [&_li]:ml-5 [&_ol>li]:list-decimal [&_ol]:space-y-1.5 [&_strong]:text-heading [&_ul>li]:list-disc [&_ul]:space-y-1.5">
          {localeHtml ? <Fragment set:html={localeHtml} /> : <Content />}
        </div>
      </section>

      <!-- Para quién es -->
      <section aria-labelledby="audience-title">
        <h2 id="audience-title" class="text-2xl font-bold">¿Para quién es este curso?</h2>
        <ul class="mt-5 space-y-3" role="list">
          {
            audience.map((item) => (
              <li class="flex items-start gap-3 rounded-md border border-surface-200 p-4 text-sm text-heading">
                <span aria-hidden="true">🎯</span>
                {item}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Testimonios -->
      {
        testimonials.length > 0 && (
          <section aria-labelledby="testimonials-title">
            <h2 id="testimonials-title" class="text-2xl font-bold">
              Lo que dicen los estudiantes
            </h2>
            <div class="mt-5 grid gap-5 md:grid-cols-3">
              {testimonials.map((t) => (
                <TestimonialCard
                  name={t.data.name}
                  citySlug={t.data.citySlug}
                  countryCode={t.data.countryCode}
                  text={t.data.text}
                  rating={t.data.rating}
                />
              ))}
            </div>
          </section>
        )
      }

      <!-- FAQ -->
      <section aria-labelledby="faq-title">
        <h2 id="faq-title" class="text-2xl font-bold">Preguntas frecuentes</h2>
        <div class="mt-5">
          <FaqAccordion {faqs} />
        </div>
      </section>

      <!-- Malla geo interna -->
      <section aria-labelledby="cities-title">
        <h2 id="cities-title" class="text-lg font-bold">
          {city ? `Este curso también se estudia en otras ciudades de ${country.name}` : `Estudia este curso desde tu ciudad en ${country.name}`}
        </h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            country.cities
              .filter((c) => c.slug !== city?.slug)
              .map((c) => (
                <a
                  href={`${base}/${c.slug}/${course.id}/`}
                  class="rounded-full border border-surface-200 px-4 py-2 text-sm font-medium text-heading transition hover:border-accent hover:text-accent"
                >
                  📍 {c.name}
                </a>
              ))
          }
          {
            city && (
              <a
                href={`${base}/${course.id}/`}
                class="rounded-full border border-surface-200 px-4 py-2 text-sm font-medium text-heading transition hover:border-accent hover:text-accent"
              >
                🌎 Todo {country.name}
              </a>
            )
          }
        </div>
      </section>
    </div>

    <!-- Sidebar instructor + garantía -->
    <aside class="space-y-6 lg:sticky lg:top-24 lg:h-fit">
      <div class="rounded-lg border border-surface-200 p-6">
        <h2 class="text-sm font-bold tracking-wide text-muted uppercase">Tu instructor</h2>
        <div class="mt-4 flex items-center gap-4">
          <span class="flex size-14 items-center justify-center rounded-full bg-primary font-display text-xl font-bold text-white" aria-hidden="true">
            {course.data.instructor.name.charAt(0)}
          </span>
          <div>
            <p class="font-bold text-primary">{course.data.instructor.name}</p>
            <p class="text-sm text-muted">{course.data.instructor.title}</p>
          </div>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-body">{course.data.instructor.bio}</p>
      </div>
      <div class="rounded-lg border border-surface-200 p-6">
        <h2 class="text-sm font-bold tracking-wide text-muted uppercase">Requisitos previos</h2>
        <ul class="mt-3 space-y-2 text-sm text-body" role="list">
          <li>✅ No necesitas experiencia previa</li>
          <li>✅ Conexión a internet (celular o computador)</li>
          <li>✅ Ganas de aprender y practicar</li>
        </ul>
      </div>
      <div class="rounded-lg bg-success/10 p-6 text-center">
        <p class="text-3xl" aria-hidden="true">🛡️</p>
        <h2 class="mt-2 font-bold text-primary">Garantía de 7 días</h2>
        <p class="mt-2 text-sm text-body">
          Si el curso no cumple tus expectativas, te devolvemos el 100% de tu dinero. Sin preguntas.
        </p>
      </div>
    </aside>
  </div>

  <!-- Especializaciones (si este curso es el pilar del clúster) -->
  {
    satellites.length > 0 && (
      <section class="container-site py-14">
        <h2 class="text-2xl font-bold">Especialízate después de este curso</h2>
        <p class="mt-2 max-w-2xl text-body">
          Este es el curso general. Cuando domines la base, estas especializaciones te dejan cobrar
          más por servicio.
        </p>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {satellites.slice(0, 8).map((c) => (
            <CourseCard course={c} {country} citySlug={city?.slug} />
          ))}
        </div>
      </section>
    )
  }

  <!-- Enlace al pilar (si este curso es una especialización) -->
  {
    pillar && (
      <section class="container-site py-10">
        <a
          href={city ? `${base}/${city.slug}/${pillar.id}/` : `${base}/${pillar.id}/`}
          class="group flex flex-wrap items-center gap-x-4 gap-y-2 rounded-lg border border-surface-200 bg-off-white p-6 transition hover:border-accent hover:shadow-lg"
        >
          <span class="text-3xl" aria-hidden="true">
            {category.emoji}
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-xs font-bold tracking-wide text-accent uppercase">
              ¿Prefieres empezar por lo general?
            </span>
            <span class="mt-1 block font-display text-lg font-bold text-primary group-hover:text-accent">
              {pillar.data.title}
            </span>
            <span class="mt-1 block text-sm text-body">{pillar.data.shortDescription}</span>
          </span>
          <span class="font-semibold text-accent">Ver curso →</span>
        </a>
      </section>
    )
  }

  <!-- Cursos relacionados -->
  {
    related.length > 0 && (
      <section class="bg-off-white py-14">
        <div class="container-site">
          <h2 class="text-2xl font-bold">Cursos relacionados</h2>
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {related.map((c) => (
              <CourseCard course={c} {country} citySlug={city?.slug} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- CTA final -->
  <section class="bg-primary py-16 text-center">
    <div class="container-site">
      <h2 class="text-3xl font-extrabold text-white">
        {city ? `¿Listo para empezar desde ${city.name}?` : '¿Listo para empezar?'}
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-white/80">
        {
          valoracion
            ? `Los compradores lo valoran con ${valoracion.rating.toFixed(1).replace('.', ',')} de 5 (${valoracion.total} valoraciones reales en Hotmart).`
            : 'Acceso de por vida, certificado incluido y garantía de 7 días.'
        }
      </p>
      <a
        href={ctaHref}
        target={hayCheckout ? '_blank' : undefined}
        rel="noopener nofollow sponsored"
        {...(hayCheckout ? { 'data-cta-hotmart': true } : { 'data-lead-open': true })}
        data-cta-position="footer"
        class="animate-pulse-soft mt-7 inline-block rounded-md bg-accent px-8 py-4 font-bold text-white transition hover:bg-accent-hover"
      >
        {hayCheckout ? '🔥 Inscribirme ahora' : '📩 Avísame cuando abra'}
      </a>
      <p class="mt-4 text-sm text-white/60">
        {
          hayCheckout
            ? 'Garantía de 7 días · Acceso de por vida · Certificado incluido'
            : 'Te escribimos en cuanto haya cupos, sin compromiso.'
        }
      </p>
    </div>
  </section>

  <LeadModal {country} courseTitle={course.data.title} courseSlug={course.id} />
  <ExitIntent ctaUrl={ctaHref} />
</BaseLayout>

<script>
  import { trackEvent } from '@/lib/analytics';

  const body = document.body;
  trackEvent('view_course', { page: location.pathname });
  document.querySelectorAll<HTMLAnchorElement>('[data-cta-hotmart]').forEach((cta) =>
    cta.addEventListener('click', () => {
      trackEvent('click_cta_hotmart', {
        page: location.pathname,
        cta_position: cta.dataset.ctaPosition ?? 'unknown',
      });
    }),
  );

  const marks = [25, 50, 75, 100];
  const fired = new Set<number>();
  addEventListener(
    'scroll',
    () => {
      const depth = ((scrollY + innerHeight) / body.scrollHeight) * 100;
      marks.forEach((m) => {
        if (depth >= m && !fired.has(m)) {
          fired.add(m);
          trackEvent('scroll_depth', { page_type: body.dataset.pageType ?? 'course', depth: `${m}%` });
        }
      });
    },
    { passive: true },
  );
</script>

<script>
  /* Promoción: nada se promete en el HTML estático. Si hay campaña vigente para
     el país del visitante, se muestran la nota y el badge de la ficha.

     Del cupón en los enlaces de pago se encarga PromoBanner, que vive en
     BaseLayout y por tanto cubre también las páginas sin ficha de curso. Aquí
     solo va lo propio de la ficha.

     Las dos fuentes son las mismas que las del banner y en el mismo orden: el
     override manual de `/admin/promociones` gana al calendario horneado. */
  import { campaignDeOverride, leerOverride, resolvePromo, type PromoCampaign } from '@/lib/promo';

  type Aplicable = Pick<PromoCampaign, 'label' | 'discountPct'>;

  const nota = document.querySelector<HTMLElement>('[data-promo-nota]');
  if (nota) {
    const pais = nota.dataset.country ?? 'co';
    const slug = nota.dataset.slug;

    const aplicar = (promo: Aplicable): void => {
      nota.hidden = false;
      nota.querySelector('[data-promo-nota-texto]')!.textContent =
        `${promo.label}: ${promo.discountPct}% de descuento`;

      /* El badge nace oculto y solo lo enseña una campaña vigente: un "-50%"
         fijo junto al precio real sería otro descuento perpetuo de mentira. */
      const badge = document.querySelector<HTMLElement>('[data-promo-badge]');
      if (badge) {
        badge.textContent = `-${promo.discountPct}%`;
        badge.hidden = false;
      }
    };

    // El calendario se aplica ya, sin esperar a la red.
    const delCalendario = resolvePromo({
      countryCode: pais,
      now: new Date(),
      urlKey: new URLSearchParams(location.search).get('promo'),
    });
    if (delCalendario) aplicar(delCalendario);

    leerOverride().then((o) => {
      const manual = o && campaignDeOverride(o, { countryCode: pais, courseSlug: slug });
      if (manual) aplicar(manual);
    });
  }

  /* Refresco del precio desde la colo del visitante. Dos efectos en uno: si
     Hotmart movió el precio desde el último build, la ficha lo corrige al
     vuelo; y la consulta se hace desde la colo más cercana al visitante, así
     que cada país mantiene fresca SU moneda en D1 (Hotmart la fija por IP).
     Throttle por sesión: una vez por curso basta. */
  {
    const nodo = document.querySelector<HTMLElement>('[data-precio-real][data-slug]');
    const slug = nodo?.dataset.slug;
    const moneda = nodo?.dataset.moneda;
    const marca = `sably:precio:${slug}`;
    if (nodo && slug && moneda && !sessionStorage.getItem(marca)) {
      sessionStorage.setItem(marca, '1');
      fetch('/api/v1/precios/refresca', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ slug }),
      })
        .then((r): Promise<{ precios?: Record<string, number> } | null> =>
          r.ok ? (r.json() as Promise<{ precios?: Record<string, number> }>) : Promise.resolve(null),
        )
        .then((d) => {
          const monto = d?.precios?.[moneda];
          if (!monto || monto <= 0) return;
          const dec = Number.isInteger(monto) ? 0 : 2;
          const n = new Intl.NumberFormat('es-CO', {
            minimumFractionDigits: dec,
            maximumFractionDigits: dec,
          }).format(monto);
          const texto = moneda === 'USD' ? `US$${n}` : `$${n} ${moneda}`;
          document.querySelectorAll<HTMLElement>('[data-precio-real]').forEach((el) => {
            if (el.textContent !== texto) el.textContent = texto;
          });
        })
        .catch(() => {});
    }
  }
</script>
