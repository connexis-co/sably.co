---
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry, render } from 'astro:content';
import { renderMarkdown } from '@/lib/markdown';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Rating from '@/components/Rating.astro';
import RatingInteractivo from '@/components/RatingInteractivo.astro';
import CourseCard from '@/components/CourseCard.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import StickyCta from '@/components/StickyCta.astro';
import CoursePlayer from '@/components/CoursePlayer.astro';
import ExitIntent from '@/components/ExitIntent.astro';
import LeadModal from '@/components/LeadModal.astro';
import {
  COUNTRIES,
  formatPrice,
  formatPriceCorto,
  localPrice,
  type Country,
  type City,
} from '@/lib/countries';
import { getCategory, courseCover } from '@/lib/categories';
import { formatMonto, precioReal } from '@/lib/hotmartLive';
import { buildHotmartUrl } from '@/lib/hotmart';
import { aceptaCupon, proveedorDe } from '@/lib/proveedores';
import { resolvePromo } from '@/lib/promo';
import { countryAlternates, breadcrumbSchema, faqSchema, courseSchema, videoSchema } from '@/lib/seo';
import { COURSE_VIDEOS, duracionIso } from '@/lib/course-videos';
import { SITE, CDN_URL } from '@/lib/site';

/**
 * Landing de conversión de curso, hiperlocal cuando recibe `city`:
 * H1/meta/breadcrumb/FAQ/testimonios/UTM cambian según la ciudad.
 */
interface Props {
  course: CollectionEntry<'courses'>;
  country: Country;
  city?: City;
}

const { course, country, city } = Astro.props;
const category = getCategory(course.data.category);
const base = `/${country.code}`;
const coursePath = city ? `${base}/${city.slug}/${course.id}/` : `${base}/${course.id}/`;
const { Content } = await render(course);

/* Variante por país generada y validada (scripts/generar-catalogo.py). Si
   existe, la página usa su meta, descripción, FAQs y listas; si no, cae al
   contenido genérico del MDX. Opcional por diseño: el build nunca depende
   del lote completo. */
const locale = (await getEntry('courseLocales', `${course.id}--${country.code}`)) ?? null;
/* renderMarkdown baja los encabezados un nivel para que cuelguen del h2 de la
   sección, de ahí que el tamaño de prosa se defina sobre h3 y h4. Las listas
   numeradas llevan su propio marcador porque el list-disc de los elementos
   alcanzaba también a los de las listas ordenadas. */
const localeHtml = locale ? renderMarkdown(locale.data.descripcion) : null;
const learnings = locale?.data.beneficios ?? course.data.learnings;
const audience = locale?.data.para_quien ?? course.data.audience;

/* El título de país colisiona por dos vías: sin variante todos los países
   comparten el metaTitle del MDX, y con variante el modelo a veces repite el
   mismo título en varios mercados. Se añade el país solo cuando hay colisión
   real: la mediana ya está en 55 caracteres y añadirlo siempre pasaría de 60. */
const localesDelCurso = (await getCollection('courseLocales')).filter(
  (l) => l.data.course === course.id,
);
const tituloColisiona = locale
  ? localesDelCurso.filter((l) => l.data.meta_title === locale.data.meta_title).length > 1
  : localesDelCurso.length < COUNTRIES.length - 1;

/* Política del creador: hay quien no acepta el cupón del sitio porque su
   acortador ya trae dentro la oferta elegida. Ver src/lib/proveedores.ts. */
const conCupon = aceptaCupon(course.data.proveedor);

/* Id del proveedor (normalizado al defecto si falta). Va al <body> para que el
   banner y el repintado de precio apliquen solo las promociones dirigidas a él. */
const proveedor = proveedorDe(course.data.proveedor);

const ctaUrl = buildHotmartUrl({
  baseUrl: course.data.hotmartUrl,
  aceptaCupon: conCupon,
  courseSlug: course.id,
  countryCode: country.code,
  citySlug: city?.slug,
});

const allCourses = await getCollection('courses');

/* Jerarquía pilar/satélite: el pilar es el único que apunta al head term.
   El satélite enlaza hacia arriba y el pilar lista sus especializaciones, de
   modo que la señal se concentra en una sola página en vez de repartirse. */
const pillar = course.data.pillar
  ? (allCourses.find((c) => c.id === course.data.pillar) ?? null)
  : null;
const satellites = allCourses.filter((c) => c.data.pillar === course.id);

const related = allCourses
  .filter(
    (c) =>
      c.data.category === course.data.category &&
      c.id !== course.id &&
      c.id !== pillar?.id &&
      !satellites.some((s) => s.id === c.id),
  )
  .slice(0, 4);

const allTestimonials = (await getCollection('testimonials')).filter(
  (t) => t.data.courseSlug === course.id || t.data.category === course.data.category,
);
const cityFirst = city
  ? [...allTestimonials].sort(
      (a, b) =>
        Number(b.data.citySlug === city.slug && b.data.countryCode === country.code) -
        Number(a.data.citySlug === city.slug && a.data.countryCode === country.code),
    )
  : allTestimonials;
const testimonials = cityFirst.slice(0, 3);

/* Aquí vivía `cityStudents`, que pintaba «N estudiantes lo están tomando en
   <ciudad>» a partir de `40 + ((city.slug.length * 31 + course.id.length * 7)
   % 180)`. Era aritmética sobre la longitud del slug presentada como alumnos
   reales: no había fuente de datos detrás, y su propio comentario lo admitía
   («Fase 2: datos reales de Hotmart»).

   No es un dato optimista, es una afirmación de hecho falsa, y salía en las
   landings de ciudad de TODOS los cursos, tuvieran producto o no. Se retira
   hasta que haya matrículas reales por ciudad que contar. */

const discountPct = Math.round((1 - course.data.priceUSD / course.data.originalPriceUSD) * 100);

/**
 * ¿Este curso existe como producto de verdad?
 *
 * Los que siguen con `PENDIENTE` no tienen checkout: nadie los ha comprado
 * nunca. Publicar en ellos «4,9 · 183 valoraciones · 1.043 estudiantes» es
 * inventar prueba social de un producto inexistente, y son reseñas fabricadas
 * a ojos de la SIC en Colombia. El dato del frontmatter es de catálogo, no de
 * compradores, así que en estas fichas no se pinta ninguno.
 *
 * La ficha sigue publicándose: conserva el SEO y capta el lead. Lo que se cae
 * es la cifra que afirma algo falso.
 */
const sinProducto = /PENDIENTE/i.test(course.data.hotmartUrl);

/* Precio real de Hotmart, igual que en CourseCard. Hasta ahora la ficha usaba
   el de catálogo mientras las tarjetas de cursos relacionados ya usaban el real:
   en la misma página podían convivir dos importes distintos para el mismo curso.
   Se resuelve una vez aquí y de aquí beben la tarjeta de compra y la barra fija. */
const real = precioReal(course.id, country);
const precioTexto = real
  ? formatMonto(real.monto, real.moneda)
  : formatPrice(course.data.priceUSD, country);

/* Importe base sobre el que se aplica el cupón. Va al DOM en crudo para que el
   controlador de promoción pueda recalcular en cliente sin volver a pedirlo. */
const montoBase = real ? real.monto : localPrice(course.data.priceUSD, country);
const monedaBase = real ? real.moneda : country.currency;

/* El precio que se enseña es el que cobra el checkout. La campaña vive en D1 y
   cambia sin desplegar, así que el build pinta el precio de tabla y el script
   de abajo aplica el cupón vigente en cuanto responde /api/v1/promo. El tachado
   y la píldora nacen ocultos: sin campaña confirmada no se anuncia descuento. */
const precioTachadoTexto = undefined;
const descuentoVisible = undefined;

/* Campaña del calendario vigente en el build. Solo se usa para rotular la
   píldora de la barra fija ("Black Friday −40%" en vez de un "−40%" pelado).
   `null` es el caso normal la mayor parte del año. */
const promoVigente = resolvePromo({ countryCode: country.code, now: new Date() });

/* Video de presentación: vive en R2 (cdn.sably.co). Sin CDN configurado no se
   pinta el reproductor, así el entorno local no queda con un <video> roto. */
const videoSrc = course.data.videoKey && CDN_URL ? `${CDN_URL}/videos/${course.data.videoKey}` : null;

/* FAQs: las del curso + banco estándar (garantiza ≥8 por página, con FAQPage schema). */
const STANDARD_FAQS = [
  {
    q: '¿Cómo se realiza el pago?',
    a: `El pago se procesa de forma 100% segura a través de Hotmart, con tarjetas y métodos de pago locales de ${country.name}. Pagas una sola vez, en ${country.currency} o su equivalente.`,
  },
  {
    q: '¿Puedo estudiar desde el celular?',
    a: 'Sí. La plataforma funciona en celular, tablet y computador, con las clases disponibles 24/7 para que avances donde estés.',
  },
  {
    q: '¿Cuándo empiezo el curso?',
    a: 'El acceso es inmediato: al confirmarse el pago recibes un correo con tu ingreso a la plataforma y puedes empezar en minutos.',
  },
  {
    q: '¿Qué pasa si tengo dudas durante el curso?',
    a: 'Cuentas con soporte por WhatsApp de nuestro equipo y el área de preguntas del curso para resolver lo que se te atasque.',
  },
];

/* Con variante país, sus 8 FAQs (que ya cubren pagos locales) sustituyen al
   banco genérico: mezclar ambos duplicaría la pregunta de pago. */
const baseFaqsRaw = locale ? locale.data.faqs : [...course.data.faqs, ...STANDARD_FAQS];
/* En cursos sin checkout (PENDIENTE) las FAQ que prometen pago, garantía o
   acceso inmediato describen algo que todavía no existe. Se filtran y se
   sustituyen por una honesta de disponibilidad, igual que ya se ocultan la
   oferta y el instructor: el FAQPage no debe afirmar lo que la ficha no cumple. */
const baseFaqs = sinProducto
  ? [
      ...baseFaqsRaw.filter(
        (f) => !/(pago|hotmart|garant|reembolso|inscrib|inscríb|se procesa|confirmarse|precio)/i.test(`${f.q} ${f.a}`),
      ),
      {
        q: '¿Cuándo puedo inscribirme?',
        a: 'Estamos habilitando las inscripciones de este curso. Déjanos tus datos y te avisamos apenas esté disponible, sin compromiso.',
      },
    ]
  : baseFaqsRaw;
const faqs = city
  ? [
      {
        q: `¿Puedo tomar este curso desde ${city.name}?`,
        a: `Sí. El curso es 100% online: estudia desde ${city.name} a tu ritmo, con acceso de por vida y precios en ${country.currency}. Solo necesitas internet.`,
      },
      ...baseFaqs,
      {
        q: `¿El certificado sirve en ${city.name}?`,
        a: `El certificado digital respalda tus habilidades ante clientes y empleadores en ${city.name} y toda Latinoamérica.`,
      },
    ]
  : baseFaqs;

const pageUrl = `${SITE.url}${coursePath}`;
const h1 = city ? `${course.data.title} en ${city.name}` : (locale?.data.h1 ?? course.data.title);
const tituloPais =
  locale?.data.meta_title ??
  course.data.metaTitle ??
  `${course.data.title} | Curso Online con Certificado | Sably`;
const title = city
  ? `${course.data.title} en ${city.name}, ${country.name} | Online | Sably`
  : tituloColisiona
    ? `${tituloPais.replace(/\s*\|\s*Sably\s*$/, '')} | ${country.name}`
    : tituloPais;

/* Recorta a un límite de palabra con elipsis. Antes se hacía `.slice(0, 158)`
   crudo, que cortaba a media palabra («…cobra más por cad») porque el texto
   compuesto casi siempre pasa de 158. Corta en el último espacio si el recorte
   no deja la frase demasiado mocha. */
const recortarDesc = (s: string, max = 158): string => {
  if (s.length <= max) return s;
  const corte = s.slice(0, max - 1);
  const sp = corte.lastIndexOf(' ');
  return `${(sp > max * 0.6 ? corte.slice(0, sp) : corte).trimEnd()}…`;
};

const descPais = locale?.data.meta_description ?? course.data.shortDescription;
const descColisiona = locale
  ? localesDelCurso.filter((l) => l.data.meta_description === locale.data.meta_description).length > 1
  : localesDelCurso.length < COUNTRIES.length - 1;
const description = city
  ? recortarDesc(`Estudia desde ${city.name}: ${course.data.shortDescription}`)
  : descColisiona
    ? recortarDesc(`Desde ${country.name}: ${descPais}`)
    : descPais;

const breadcrumb = city
  ? [
      { name: 'Inicio', url: `${SITE.url}${base}/` },
      { name: city.name, url: `${SITE.url}${base}/${city.slug}/` },
      { name: category.name, url: `${SITE.url}${base}/${city.slug}/cursos/${category.slug}/` },
      { name: course.data.title, url: pageUrl },
    ]
  : [
      { name: 'Inicio', url: `${SITE.url}${base}/` },
      { name: category.name, url: `${SITE.url}${base}/cursos/${category.slug}/` },
      { name: course.data.title, url: pageUrl },
    ];

const schemas = [
  breadcrumbSchema(breadcrumb),
  courseSchema({
    title: course.data.title,
    description: course.data.shortDescription,
    url: pageUrl,
    image: new URL(courseCover(course.id, category.slug), SITE.url).href,
    /* El mismo importe que ve el visitante. Si el schema declarase el precio de
       catálogo mientras la página enseña el real de Hotmart, el snippet de
       Google anunciaría una cifra que no se cobra. Número crudo, nunca el texto
       ya formateado. */
    price: real ? real.monto : localPrice(course.data.priceUSD, country),
    priceCurrency: real ? real.moneda : country.currency,
    /* Sin producto no hay instructor verificado: el del frontmatter es de
       relleno y declararlo como `Person` mete en el índice de Google a alguien
       que no existe, con credenciales de un oficio de riesgo. */
    instructorName: sinProducto ? undefined : course.data.instructor?.name,
    comprable: !sinProducto,
    category: category.name,
    workloadHours: course.data.durationHours,
    teaches: course.data.learnings,
    level: course.data.level,
    syllabus: course.data.modules.map((m) => m.title),
    datePublished: course.data.publishedAt.toISOString(),
    // `rating` se omite a propósito: la nota del frontmatter es de catálogo,
    // no de compradores. Se conectará al agregado real de D1 (vista
    // v_course_rating) cuando haya reseñas verificadas por compra.
  }),
  faqSchema(faqs),
  // VideoObject solo donde el vídeo existe y se reproduce en la propia página.
  // La duración y la fecha salen del archivo real, no del frontmatter.
  // Solo en la página de país, nunca en las 37 de ciudad: es el mismo archivo,
  // y repetirlo en 45 URLs hace que Google elija una y descarte el resto. El
  // sitemap lo declara con el mismo criterio.
  ...(!city && videoSrc && COURSE_VIDEOS[course.id]
    ? [
        videoSchema({
          name: `${course.data.title} — presentación en vídeo`,
          description: course.data.shortDescription,
          thumbnailUrl: new URL(courseCover(course.id, category.slug), SITE.url).href,
          uploadDate: COURSE_VIDEOS[course.id]!.subido,
          duration: duracionIso(COURSE_VIDEOS[course.id]!.segundos),
          contentUrl: videoSrc,
          pageUrl,
        }),
      ]
    : []),
];
---

<BaseLayout
  {title}
  {description}
  {country}
  {city}
  pathAfterCountry={`/${course.id}/`}
  alternates={city ? [] : countryAlternates(`/${course.id}/`)}
  {schemas}
  pageType={city ? 'course_city' : 'course'}
  sinCupon={!conCupon}
  {proveedor}
  whatsappContext={city ? `${course.data.title} (${city.name})` : course.data.title}
>
  {/* La barra fija anuncia precio y lleva al checkout. Sin producto no hay ni
      uno ni otro: su enlace acabaría en la página de error de Hotmart y el
      precio sería el de catálogo, que nadie va a cobrar. */}
  {!sinProducto && (
    <StickyCta
      title={course.data.title}
      precio={precioTexto}
      precioTachado={precioTachadoTexto}
      descuentoPct={descuentoVisible}
      promoLabel={promoVigente?.label}
      monto={montoBase}
      moneda={monedaBase}
      pais={country.code}
      slug={course.id}
      {ctaUrl}
    />
  )}

  {/* Precio con el cupón vigente aplicado, en la tarjeta y en la barra a la vez.
      Vive aquí y no en cada componente porque el importe debe ser el mismo en
      los dos sitios: una sola petición, un solo cálculo, dos pintados. */}
  <script>
    import { formatMonto, precioConDescuento } from '@/lib/moneda';
    import { leerPromos, mejorPromocion } from '@/lib/promo';

    const cajas = document.querySelectorAll<HTMLElement>('[data-precio-caja]');

    // Sin cupón no hay porcentaje que aplicar: el precio que se muestra ya es
    // el que cobra el checkout. Repintarlo con el pct de una promoción enseñaría
    // la mitad y el comprador pagaría el doble. Esta guarda es la última línea:
    // aunque una promoción apuntara por error a un curso sin cupón, aquí no se
    // repinta.
    if (cajas.length && !document.body.hasAttribute('data-sin-cupon')) {
      const proveedor = document.body.dataset.proveedor ?? 'masterclasses';

      leerPromos()
        .then((promos) => {
          if (!promos.length) return;

          for (const caja of cajas) {
            const monto = Number(caja.dataset.monto);
            const moneda = caja.dataset.moneda;
            const pais = caja.dataset.pais ?? '';
            const slug = caja.dataset.slug ?? '';
            if (!Number.isFinite(monto) || monto <= 0 || !moneda) continue;

            // La promoción que de verdad cubre este curso, país y proveedor. Si
            // ninguna aplica, el precio de tabla se queda como está: nunca se
            // anuncia un descuento que este curso no recibe en el checkout.
            const promo = mejorPromocion(promos, { countryCode: pais, proveedor, courseSlug: slug });
            if (!promo) continue;

            const real = caja.querySelector<HTMLElement>('[data-precio-real]');
            const tachado = caja.querySelector<HTMLElement>('[data-precio-tachado]');
            const badge = caja.querySelector<HTMLElement>('[data-promo-badge]');
            if (!real) continue;

            const final = precioConDescuento(monto, moneda, promo.pct);
            if (final >= monto) continue; // descuento nulo: no se toca nada

            real.textContent = formatMonto(final, moneda);
            if (tachado) {
              // Sin el código de moneda: ya lo dice la cifra principal y en
              // móvil esos caracteres de más cortaban la píldora.
              tachado.textContent = formatMonto(monto, moneda).replace(/\s[A-Z]{3}$/, '');
              tachado.hidden = false;
            }
            if (badge) {
              badge.textContent = `−${promo.pct}%`;
              badge.hidden = false;
            }
          }
        })
        .catch(() => {
          /* Sin respuesta se queda el precio de tabla: nunca se anuncia un
             descuento que no se ha podido confirmar. */
        });
    }
  </script>

  <!-- Hero -->
  <section class="bg-primary">
    <div class="container-site grid gap-10 py-14 lg:grid-cols-[1fr_420px] lg:py-20">
      <div>
        <nav aria-label="Breadcrumb" class="text-sm text-white/60">
          <a href={`${base}/`} class="hover:text-white">Inicio</a> <span aria-hidden="true">›</span>
          {
            city && (
              <>
                <a href={`${base}/${city.slug}/`} class="hover:text-white">
                  {city.name}
                </a>
                <span aria-hidden="true">›</span>
              </>
            )
          }
          <a
            href={city ? `${base}/${city.slug}/cursos/${category.slug}/` : `${base}/cursos/${category.slug}/`}
            class="hover:text-white">{category.name}</a
          >
          <span aria-hidden="true">›</span>
          <span class="text-white">{course.data.title}</span>
        </nav>
        <h1 class="mt-4 text-3xl leading-tight font-extrabold text-white sm:text-4xl">{h1}</h1>
        <p class="mt-4 max-w-xl text-lg text-white/80">{locale?.data.subtitulo ?? course.data.shortDescription}</p>
        <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-white/80">
          {/* Interactivo en el hero: las estrellas muestran la nota de compradores
              y además se pueden pulsar para dejar la propia. El componente ya
              existía desde el PR #67 pero no estaba montado en ninguna página,
              así que la ficha seguía con las estrellas de solo lectura. */}
          {/* Un curso puede venderse y no tener todavia ninguna resena en
              Hotmart. Antes estos campos eran obligatorios y por eso siempre
              habia algo que pintar; ahora que son opcionales hay que
              comprobarlos, o la ficha revienta el build. */}
          {!sinProducto && course.data.rating != null && course.data.ratingCount != null && (
            <RatingInteractivo
              slug={course.id}
              rating={course.data.rating}
              count={course.data.ratingCount}
            />
          )}
          {!sinProducto && course.data.students != null && (
            <span>👥 {course.data.students.toLocaleString('es-CO')} estudiantes</span>
          )}
          <span>🕐 {course.data.durationHours} horas</span>
          <span>📚 {course.data.lessonsCount} lecciones</span>
          <span>📈 {course.data.level}</span>
        </div>
      </div>

      <!-- Card de compra -->
      <div class="h-fit rounded-lg bg-white p-6 shadow-2xl">
        {
          videoSrc ? (
            <CoursePlayer
              src={videoSrc}
              poster={courseCover(course.id, category.slug)}
              title={course.data.title}
              courseId={course.id}
            />
          ) : (
            /* Sin video, la portada manda la misma relación de aspecto que el
               reproductor, así la tarjeta no cambia de alto entre cursos. */
            <div
              class="relative aspect-video overflow-hidden rounded-md"
              style={`background-image: linear-gradient(135deg, ${category.gradient[0]}, ${category.gradient[1]})`}
            >
              <img
                src={courseCover(course.id, category.slug)}
                alt={`${category.name}: ${course.data.title}`}
                width="800"
                height="450"
                fetchpriority="high"
                class="h-full w-full object-cover"
              />
            </div>
          )
        }
        {/* Jerarquía de precio: la cifra que se paga manda y el precio anterior la
            acompaña en la misma línea a un cuerpo mucho menor. Antes el tachado
            iba a `text-lg` con una píldora al lado: sumaban 410 px en una columna
            de 372 y el conjunto saltaba de línea partiendo "$196.000 COP" por el
            espacio previo a la moneda. `whitespace-nowrap` impide ese corte. */}
        {
          /* Sin producto el importe sería el de catálogo, y nadie lo va a
             cobrar porque no hay checkout. Anunciar una cifra concreta que no
             corresponde a ninguna transacción posible es lo mismo que hacía el
             `Offer` del marcado, solo que a la vista. */
          sinProducto ? (
            <p class="mt-5 text-lg font-bold text-primary">Próximamente</p>
          ) : (
            <div
              class="mt-5 flex flex-wrap items-baseline gap-x-2.5 gap-y-0.5"
              data-precio-caja
              data-monto={montoBase}
              data-moneda={monedaBase}
              data-pais={country.code}
              data-slug={course.id}
            >
              <span data-precio-real class="text-3xl font-extrabold whitespace-nowrap text-primary">
                {precioTexto}
              </span>
              <span
                data-precio-tachado
                hidden
                class="text-sm whitespace-nowrap text-muted line-through"
              />
