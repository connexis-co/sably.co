---
import { Image as OptimizedImage } from 'astro:assets';
import {RelatedGuides,VerifiedReviews} from '@/themes';
import {readVerifiedCourseReviews} from '@/lib/verified-course-reviews';
import {courseWatch} from '@/lib/course-watch';
import {clusterDeCurso,relatedGuides} from '@/lib/related-guides';
import {nombresCreadores,urlCreador} from '@/lib/creadores';
import {courseSeo,indexableAtPath} from '@/lib/cms-indexability';
import { cmsImageUrl } from '@/lib/cms-media';
import { getContentRepository } from '@/lib/emdash-content';
import ResenasCurso from '@/components/ResenasCurso.astro';
import CmsRichBody from '@/components/CmsRichBody.astro';
import { renderMarkdown } from '@/lib/markdown';
import type { ResolvedCourseContent } from '@/lib/emdash-content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Rating from '@/components/Rating.astro';
import RatingInteractivo from '@/components/RatingInteractivo.astro';
import CourseCard from '@/components/CourseCard.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import PurchasePanel from '@/components/PurchasePanel.astro';
import { checkoutPrice, quotable, quoteFreshUntil } from '@/lib/checkout-price';
import CoursePlayer from '@/components/CoursePlayer.astro';
import LeadModal from '@/components/LeadModal.astro';
import {
  localPrice,
  type Country,
  type City,
} from '@/lib/countries';
import { courseCover } from '@/lib/categories';
import { readOperationalPrice, readOperationalRating } from '@/plugins/sably-operations/public';
import { faqsHonestas } from '@/lib/faq-honestas';
import { faqPagoPais } from '@/lib/medios-de-pago';
import { buildHotmartUrl } from '@/lib/hotmart';
import { aceptaCupon, proveedorDe } from '@/lib/proveedores';
import { mejorPromocion } from '@/lib/promo';
import { readActivePromosForRequest } from '@/plugins/sably-operations/public';
import { env } from 'virtual:sably-runtime';
import { countryAlternates, breadcrumbSchema, conMarca, faqSchema, courseSchema } from '@/lib/seo';
import { SITE, CDN_URL } from '@/lib/site';
import { conciseTitle } from '@/lib/seo-title';

/**
 * Landing de conversión de curso, hiperlocal cuando recibe `city`:
 * H1/meta/breadcrumb/FAQ/testimonios/UTM cambian según la ciudad.
 */
interface Props {
  content: ResolvedCourseContent;
  country: Country;
  city?: City;
}

const { country, city, content } = Astro.props;
const cms = await getContentRepository();
const COUNTRIES = await cms.getCountries();
const { course, locale } = content;
Astro.response.headers.set('X-Sably-Content-Source', content.source);
Astro.response.headers.set('X-Sably-Locale-Source', content.localeSource);
const category = (await cms.getCategory(course.data.category))!;
const base = `/${country.code}`;
const coursePath = city ? `${base}/${city.slug}/${course.id}/` : `${base}/${course.id}/`;


/* Variante por país generada y validada (scripts/generar-catalogo.py). Si
   existe, la página usa su meta, descripción, FAQs y listas; si no, cae al
   contenido genérico del MDX. Opcional por diseño: el build nunca depende
   del lote completo. */
/* renderMarkdown baja los encabezados un nivel para que cuelguen del h2 de la
   sección, de ahí que el tamaño de prosa se defina sobre h3 y h4. Las listas
   numeradas llevan su propio marcador porque el list-disc de los elementos
   alcanzaba también a los de las listas ordenadas. */
const localeHtml = locale ? renderMarkdown(locale.data.descripcion) : null;
// CMS source_body stays plain Markdown: it never enters Astro's MDX compiler.
const courseHtml = content.sourceBody === null ? null : renderMarkdown(content.sourceBody);
const learnings = locale?.data.beneficios ?? course.data.learnings;
const audience = locale?.data.para_quien ?? course.data.audience;

/* El título de país colisiona por dos vías: sin variante todos los países
   comparten el metaTitle del MDX, y con variante el modelo a veces repite el
   mismo título en varios mercados. Se añade el país solo cuando hay colisión
   real: la mediana ya está en 55 caracteres y añadirlo siempre pasaría de 60. */
const localesDelCurso = (await cms.getCourseLocales(course.id)).filter(
  (l) => l.data.course === course.id,
);
const tituloColisiona = locale
  ? localesDelCurso.filter((l) => l.data.meta_title === locale.data.meta_title).length > 1
  : localesDelCurso.length < COUNTRIES.length - 1;

/* Política del creador: hay quien no acepta el cupón del sitio porque su
   acortador ya trae dentro la oferta elegida. Ver src/lib/proveedores.ts. */
const conCupon = aceptaCupon(course.data.proveedor);

/* Id del proveedor (normalizado al defecto si falta). Va al <body> para que el
   banner y el repintado de precio apliquen solo las promociones dirigidas a él. */
const proveedor = proveedorDe(course.data.proveedor);

const ctaUrl = buildHotmartUrl({
  baseUrl: course.data.hotmartUrl,
  aceptaCupon: conCupon,
  courseSlug: course.id,
  countryCode: country.code,
  citySlug: city?.slug,
});

const allCourses = await cms.getCourses();
const creators = (await cms.getCreators()).filter(creator => creator.cursos.includes(course.id));

/* Jerarquía pilar/satélite: el pilar es el único que apunta al head term.
   El satélite enlaza hacia arriba y el pilar lista sus especializaciones, de
   modo que la señal se concentra en una sola página en vez de repartirse. */
const pillar = course.data.pillar
  ? (allCourses.find((c) => c.id === course.data.pillar) ?? null)
  : null;
const satellites = allCourses.filter((c) => c.data.pillar === course.id);

/* Guías del blog: primero las que enlazan a este curso; si no llegan a tres,
   las que enlazan a su clúster (pilar y especializaciones), que el editor
   definió con `pillar`. Nunca por palabra clave ni por categoría. */
const guides = relatedGuides(await cms.getBlogPosts(), course.id, SITE.url, clusterDeCurso(course, allCourses));

const related = allCourses
  .filter(
    (c) =>
      c.data.category === course.data.category &&
      c.id !== course.id &&
      c.id !== pillar?.id &&
      !satellites.some((s) => s.id === c.id),
  )
  .slice(0, 4);

/* Aquí vivía «Lo que dicen los estudiantes» con la colección editorial de
   testimonios: 40 personas y ciudades inventadas por un workflow multiagente
   (docs/CHANGELOG_FRONTEND.md). El 11 de agosto (#67) se retiraron, el 13 una
   sobrescritura de esta plantilla las devolvió y la migración las llevó a
   EmDash. La única prueba social pública es VerifiedReviews: compras reales. */

/* Aquí vivía `cityStudents`, que pintaba «N estudiantes lo están tomando en
   <ciudad>» a partir de `40 + ((city.slug.length * 31 + course.id.length * 7)
   % 180)`. Era aritmética sobre la longitud del slug presentada como alumnos
   reales: no había fuente de datos detrás, y su propio comentario lo admitía
   («Fase 2: datos reales de Hotmart»).

   No es un dato optimista, es una afirmación de hecho falsa, y salía en las
   landings de ciudad de TODOS los cursos, tuvieran producto o no. Se retira
   hasta que haya matrículas reales por ciudad que contar. */

const discountPct = Math.round((1 - course.data.priceUSD / course.data.originalPriceUSD) * 100);

/**
 * ¿Este curso existe como producto de verdad?
 *
 * Los que siguen con `PENDIENTE` no tienen checkout: nadie los ha comprado
 * nunca. Publicar en ellos «4,9 · 183 valoraciones · 1.043 estudiantes» es
 * inventar prueba social de un producto inexistente, y son reseñas fabricadas
 * a ojos de la SIC en Colombia. El dato del frontmatter es de catálogo, no de
 * compradores, así que en estas fichas no se pinta ninguno.
 *
 * La ficha sigue publicándose: conserva el SEO y capta el lead. Lo que se cae
 * es la cifra que afirma algo falso.
 */
const sinProducto = /PENDIENTE/i.test(course.data.hotmartUrl);

/* Creador real del curso: la relación del CMS o, si falta, el autor que Hotmart
   publica en la página del producto (src/lib/creadores.ts). Sin creador no se
   pinta nada. Sin producto tampoco: al afiliarse al producto real el creador
   puede ser otro, y la ficha contradiría al checkout. */
const creadoresVisibles = sinProducto ? [] : creators;

/* EmDash actualiza priceUSD como precio base editorial. La captura comercial
   de Hotmart conserva prioridad mientras exista, igual que en CourseCard.
   Precio real de Hotmart, igual que en CourseCard. Hasta ahora la ficha usaba
   el de catálogo mientras las tarjetas de cursos relacionados ya usaban el real:
   en la misma página podían convivir dos importes distintos para el mismo curso.
   Se resuelve una vez aquí y de aquí beben la tarjeta de compra y la barra fija. */
const operationalDb = (env as unknown as {SABLY_DB:D1Database}).SABLY_DB;
const verifiedReviews = await readVerifiedCourseReviews(operationalDb,course.id).catch(()=>({reviews:[]}));
const real = await readOperationalPrice(operationalDb, course.id, country, Astro.locals).catch(() => null);
/* Valoración PÚBLICA REAL de Hotmart (o null). Solo se pinta en el hero; no va
   al aggregateRating del schema porque es de un tercero (ver courseSchema más
   abajo). Nunca la del frontmatter, que era de catálogo/inventada. */
const valoracion = await readOperationalRating(operationalDb, course.id, Astro.locals).catch(() => null);
/* Importe base sobre el que se aplica el cupón. Va al DOM en crudo para que el
   controlador de promoción pueda recalcular en cliente sin volver a pedirlo. */
const montoBase = real ? real.monto : localPrice(course.data.priceUSD, country);
const monedaBase = real ? real.moneda : country.currency;

const activePromos = await readActivePromosForRequest((env as unknown as {SABLY_DB:D1Database}).SABLY_DB, Astro.locals).catch(() => []);
const promoRow = mejorPromocion(activePromos, { countryCode: country.code, proveedor, courseSlug: course.id, urlKey: Astro.url.searchParams.get('promo') });
const coupon = conCupon && promoRow ? promoRow.cupon : null;
const quote = sinProducto ? null : await checkoutPrice(course.id, course.data.hotmartUrl, country.code, coupon);
/* La ficha no puede vivir en caché más que la cotización que pinta: Hotmart
   cambia la tasa de cambio sin aviso y la página guardada seguía un día entero
   con el importe viejo (24-nov: 93.067 en la ficha, 95.506 en el pago). */
const freshUntil = sinProducto ? null : quoteFreshUntil(quote, quotable(course.id, course.data.hotmartUrl, country.code));
const currency = quote?.currency ?? monedaBase;
const displayMoney = (value: number) => new Intl.NumberFormat(country.hreflang, {style:'currency', currency, currencyDisplay:'narrowSymbol', minimumFractionDigits:Number.isInteger(value) ? 0 : 2, maximumFractionDigits:2}).format(value) + ' ' + currency;
const baseAmount = quote?.base ?? montoBase;
const saving = quote?.reduced ? Math.round(100 * (1 - quote.reduced / quote.base)) : 0;
const offer = coupon && quote?.reduced && promoRow && saving === promoRow.pct
  ? {price:displayMoney(quote.reduced), saving, coupon, name:promoRow.nombre, end:promoRow.hasta}
  : null;
/* Precio de lista para la pregunta «¿Cuánto cuesta?»: siempre el importe sin
   cupón. El rebajado va aparte, con su cupón y su fecha (ver faq-honestas). */
const precioTexto = displayMoney(baseAmount);
const marketQuery = new URLSearchParams(Astro.url.search);
const marketLinks = COUNTRIES.filter(item => item.code !== country.code).map(item => ({
  label: item.name,
  href: '/' + item.code + '/' + course.id + '/' + (marketQuery.size ? '?' + marketQuery : '') + '#compra'
}));
const localCheckout = new URL(ctaUrl);
if (quote) localCheckout.searchParams.set('countrycode', country.code.toUpperCase());

/* Video de presentación: vive en R2 (cdn.sably.co). Sin CDN configurado no se
   pinta el reproductor, así el entorno local no queda con un <video> roto. */
const videoSrc = course.data.videoKey && CDN_URL ? `${CDN_URL}/videos/${course.data.videoKey}` : null;
const watch = courseWatch(course,SITE.url,CDN_URL);

/* FAQs: las del curso + banco estándar (garantiza ≥8 por página, con FAQPage schema). */
const FAQ_PAGO = faqPagoPais(country);
const STANDARD_FAQS = [
  FAQ_PAGO,
  {
    q: '¿Puedo estudiar desde el celular?',
    a: 'Sí. La plataforma funciona en celular, tablet y computador, con las clases disponibles 24/7 para que avances donde estés.',
  },
  {
    q: '¿Cuándo empiezo el curso?',
    a: 'El acceso es inmediato: al confirmarse el pago recibes un correo con tu ingreso a la plataforma y puedes empezar en minutos.',
  },
  {
    q: '¿Qué pasa si tengo dudas durante el curso?',
    a: 'Cuentas con soporte por WhatsApp de nuestro equipo y el área de preguntas del curso para resolver lo que se te atasque.',
  },
];

/* Con variante país, sus 8 FAQs (que ya cubren pagos locales) sustituyen al
   banco genérico: mezclar ambos duplicaría la pregunta de pago. */
const baseFaqsRaw = locale ? locale.data.faqs : [...course.data.faqs, ...STANDARD_FAQS];
/* En cursos sin checkout (PENDIENTE) las FAQ que prometen pago, garantía o
   acceso inmediato describen algo que todavía no existe. Se filtran y se
   sustituyen por una honesta de disponibilidad, igual que ya se ocultan la
   oferta y el instructor: el FAQPage no debe afirmar lo que la ficha no cumple. */
const baseFaqs = sinProducto
  ? [
      ...baseFaqsRaw.filter(
        (f) => !/(pago|hotmart|garant|reembolso|inscrib|inscríb|se procesa|confirmarse|precio)/i.test(`${f.q} ${f.a}`),
      ),
      {
        q: '¿Cuándo puedo inscribirme?',
        a: 'Estamos habilitando las inscripciones de este curso. Déjanos tus datos y te avisamos apenas esté disponible, sin compromiso.',
      },
    ]
  : /* Las variantes de país traen precios, descuentos y medios de pago que no
       coinciden con el checkout: se quitan, el precio sale de esta ficha y los
       medios de pago de la lista verificada del país. */
    faqsHonestas(baseFaqsRaw, { precioTexto, oferta: offer && { precio: offer.price, cupon: offer.coupon, hasta: offer.end }, faqPago: FAQ_PAGO });
const faqs = city
  ? [
      {
        q: `¿Puedo tomar este curso desde ${city.name}?`,
        a: `Sí. El curso es 100% online: estudia desde ${city.name} a tu ritmo, con acceso de por vida y precios en ${country.currency}. Solo necesitas internet.`,
      },
      ...baseFaqs,
      {
        q: `¿El certificado sirve en ${city.name}?`,
        a: `El certificado digital respalda tus habilidades ante clientes y empleadores en ${city.name} y toda Latinoamérica.`,
      },
    ]
  : baseFaqs;

const pageUrl = `${SITE.url}${coursePath}`;
/* La URL de la ficha de país, que es el canonical también de las de ciudad. El
   nodo Product/Course se construye con ella en las dos variantes: si la de
   ciudad declarase su propia URL, Google vería 37 entidades distintas para un
   solo curso, cada una en una página que él mismo descarta por duplicada. */
const canonicalUrl = `${SITE.url}${base}/${course.id}/`;
const h1 = city ? `${course.data.title} en ${city.name}` : (locale?.data.h1 ?? course.data.title);
/* Los H2 de plantilla («Qué aprenderás», «Programa del curso», «Preguntas
   frecuentes») eran idénticos en todas las fichas. Con el nombre del curso
   cada ficha describe su propio contenido. «Curso de X» pide artículo. */
const esCurso = /^curso\b/i.test(course.data.title);
const nombreEnFrase = esCurso ? `el ${course.data.title}` : course.data.title;
const deNombre = esCurso ? `del ${course.data.title}` : `de ${course.data.title}`;
const tituloPais =
  locale?.data.meta_title ??
  course.data.metaTitle ??
  `${course.data.title} | Curso Online con Certificado | Sably`;
/* Ficha de país: la regla de colisión no cambia; después se asegura la marca
   cuando cabe en 60 caracteres (ver conMarca) y la mayúscula inicial, porque
   diez meta_title generados empiezan en minúscula («curso de barbería…»). */
const mayusculaInicial = (s: string): string => s.charAt(0).toUpperCase() + s.slice(1);
const generatedTitle = city
  ? `${course.data.title} en ${city.name}, ${country.name} | Online | Sably`
  : conMarca(
      mayusculaInicial(
        tituloColisiona
          ? `${tituloPais.replace(/\s*\|\s*Sably\s*$/, '')} | ${country.name}`
          : tituloPais,
      ),
    );
const title = conciseTitle(generatedTitle, [
  `${course.data.title} en ${city?.name ?? country.name}`,
  `${course.data.title.replace(/^Curso de /i, '')} | ${city?.name ?? country.name}`,
]);

/* Recorta a un límite de palabra con elipsis. Antes se hacía `.slice(0, 158)`
   crudo, que cortaba a media palabra («…cobra más por cad») porque el texto
   compuesto casi siempre pasa de 158. Corta en el último espacio si el recorte
   no deja la frase demasiado mocha. */
const recortarDesc = (s: string, max = 158): string => {
  if (s.length <= max) return s;
  const corte = s.slice(0, max - 1);
  const sp = corte.lastIndexOf(' ');
  return `${(sp > max * 0.6 ? corte.slice(0, sp) : corte).trimEnd()}…`;
};

const descPais = locale?.data.meta_description ?? course.data.shortDescription;
const descColisiona = locale
  ? localesDelCurso.filter((l) => l.data.meta_description === locale.data.meta_description).length > 1
  : localesDelCurso.length < COUNTRIES.length - 1;
const description = city
  ? recortarDesc(`Estudia desde ${city.name}: ${course.data.shortDescription}`)
  : descColisiona
    ? recortarDesc(`Desde ${country.name}: ${descPais}`)
    : recortarDesc(descPais);

const breadcrumb = [
      { name: 'Inicio', url: `${SITE.url}${base}/` },
      { name: category.name, url: `${SITE.url}${base}/cursos/${category.slug}/` },
      { name: course.data.title, url: canonicalUrl },
    ];

const schemas = [
  breadcrumbSchema(breadcrumb),
  courseSchema({
    title: course.data.title,
    description: course.data.shortDescription,
    url: canonicalUrl,
    image: new URL(cmsImageUrl(course.coverImage) ?? courseCover(course.id, category.slug), SITE.url).href,
    /* El mismo importe que ve el visitante. Si el schema declarase el precio de
       catálogo mientras la página enseña el real de Hotmart, el snippet de
       Google anunciaría una cifra que no se cobra. Número crudo, nunca el texto
       ya formateado. */
    price: offer && quote?.reduced ? quote.reduced : baseAmount,
    priceCurrency: currency,
    /* El precio rebajado tiene fecha: sin ella el Offer anuncia el importe con
       cupón como si fuera el precio permanente del curso. */
    priceValidUntil: offer?.end ?? null,
    creators: creadoresVisibles.map((c) => ({ slug: c.slug, nombre: c.nombre, bio: c.bio, url: urlCreador(SITE.url, country.code, c.slug) })),
    comprable: !sinProducto,
    category: category.name,
    workloadHours: course.data.durationHours,
    teaches: course.data.learnings,
    level: course.data.level,
    syllabus: course.data.modules.map((m) => m.title),
    datePublished: course.data.publishedAt.toISOString(),
    // Same first-party data as the visible VerifiedReviews section below.
    verifiedReviews,
  }),
  faqSchema(faqs),
  // Video discovery belongs to the dedicated watch page, not a sales page.
];
---

<BaseLayout
  {title}
  {description}
  {country}
  {city}
  pathAfterCountry={`/${course.id}/`}
  alternates={city || sinProducto ? [] : (await countryAlternates(`/${course.id}/`)).filter(alt=>{
    const code=new URL(alt.href).pathname.split('/')[1];
    const variant=localesDelCurso.find(locale=>locale.data.country===code);
    return indexableAtPath(courseSeo(course.seo,variant?.seo),alt.href,SITE.url);
  })}
  {schemas}
  pageType={city ? 'course_city' : 'course'}
  image={cmsImageUrl(course.coverImage) ?? courseCover(course.id, category.slug)}
  noindex={sinProducto}
  {freshUntil}
  sinCupon={true}
  {proveedor}
  whatsappContext={city ? `${course.data.title} (${city.name})` : course.data.title}
  canonical={city ? `${SITE.url}${base}/${course.id}/` : undefined}
>
  <!-- Hero -->
  <section class="bg-primary" data-content-source={content.source} data-content-locale-source={content.localeSource}>
    <div class="container-site grid gap-3 py-4 lg:gap-10 lg:grid-cols-[1fr_420px] lg:py-20">
      <div class="contents lg:block">
        <div class="order-1">
        <nav aria-label="Breadcrumb" class="text-sm text-white/60">
          <a href={`${base}/`} class="hover:text-white">Inicio</a> <span aria-hidden="true">›</span>
          {
            city && (
              <>
                <a href={`${base}/${city.slug}/`} class="hover:text-white">
                  {city.name}
                </a>
                <span aria-hidden="true">›</span>
              </>
            )
          }
          <a
            href={city ? `${base}/${city.slug}/cursos/${category.slug}/` : `${base}/cursos/${category.slug}/`}
            class="hover:text-white">{category.name}</a
          >
          <span aria-hidden="true">›</span>
          <span class="text-white">{course.data.title}</span>
        </nav>
        <h1 {...(locale?.edit.h1 ?? course.edit.title)} class="mt-2 text-2xl leading-tight font-extrabold text-white sm:text-3xl lg:mt-4 lg:text-4xl">{h1}</h1>
        </div>
        <div class="order-4">
        <p class="mt-4 max-w-xl text-lg text-white/80">{locale?.data.subtitulo ?? course.data.shortDescription}</p>
        {/* Solo el nombre, sin enlace (decisión de JP, 4-nov-2026): nombrar al
            creador es la señal de autoría; sacar al visitante de la ficha antes
            del botón de compra no aporta nada a la venta. */}
        {creadoresVisibles.length > 0 && (
          <p data-creado-por class="mt-3 text-sm text-white/80">
            Creado por <span class="font-semibold text-white">{nombresCreadores(creadoresVisibles.map((c) => c.nombre))}</span>
          </p>
        )}
        <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-white/80">
          {/* Interactivo en el hero: las estrellas muestran la nota de compradores
              y además se pueden pulsar para dejar la propia. El componente ya
              existía desde el PR #67 pero no estaba montado en ninguna página,
              así que la ficha seguía con las estrellas de solo lectura. */}
          {/* Un curso puede venderse y no tener todavia ninguna resena en
              Hotmart. Antes estos campos eran obligatorios y por eso siempre
              habia algo que pintar; ahora que son opcionales hay que
              comprobarlos, o la ficha revienta el build. */}
          {!sinProducto && valoracion && (
            <RatingInteractivo
              slug={course.id}
              rating={valoracion.rating}
              count={valoracion.total}
            />
          )}
          <span>🕐 {course.data.durationHours} horas</span>
          <span>📚 {course.data.lessonsCount} lecciones</span>
          <span>📈 {course.data.level}</span>
        </div>
        </div>
        {!sinProducto && <a href="#compra" class="order-2 flex flex-wrap justify-between gap-2 rounded-md bg-white p-3 font-bold text-primary lg:hidden"><span>Opciones de compra ↓</span><span data-purchase-summary>{offer?.price ?? displayMoney(baseAmount)}</span></a>}
      </div>

      <!-- Card de compra -->
      <div class="contents lg:block lg:h-fit lg:rounded-lg lg:bg-white lg:p-6 lg:shadow-2xl">
        <div data-course-media class="order-3 min-w-0">
        {
          videoSrc ? (
            <Fragment><CoursePlayer
              src={videoSrc}
              poster={cmsImageUrl(course.coverImage) ?? courseCover(course.id, category.slug)}
              title={course.data.title}
              courseId={course.id}
            />{watch&&<a href={watch.path} class="mt-3 block text-sm font-semibold text-white underline lg:text-accent">Ver la presentación en su página de vídeo →</a>}</Fragment>
          ) : (
            /* Sin video, la portada manda la misma relación de aspecto que el
               reproductor, así la tarjeta no cambia de alto entre cursos. */
            <div
              class="relative aspect-video overflow-hidden rounded-md"
              style={`background-image: linear-gradient(135deg, ${category.gradient[0]}, ${category.gradient[1]})`}
            >
              <OptimizedImage
                src={cmsImageUrl(course.coverImage) ?? courseCover(course.id, category.slug)}
                alt={`${category.name}: ${course.data.title}`}
                width={800}
                height={450}
                sizes="(min-width: 1024px) 384px, (min-width: 768px) 50vw, 100vw"
                fetchpriority="high"
                class="h-full w-full object-cover"
              />
            </div>
          )
        }
        </div>
        <div class="order-5 rounded-lg bg-white p-4 lg:p-0">
        {sinProducto ? <p class="mt-5 font-bold">Próximamente</p> : <PurchasePanel markets={marketLinks} country={country.name} price={displayMoney(baseAmount)} checkout={localCheckout.href} {offer}
          evidence={{currency, base:baseAmount, reduced:offer && quote?.reduced ? quote.reduced : null, source:quote ? 'hotmart' : 'respaldo', at:quote?.at ?? null}} />}
        {
          /* Sin producto no hay checkout al que mandar a nadie: `hotmartUrl`
             sigue siendo el marcador `PENDIENTE` y ese enlace acaba en la
             página de error de Hotmart (errorMessage=008). Quien pulsaba
             «Inscribirme» se estrellaba. Aquí el botón principal es el de
             dejar los datos, que es lo que la ficha puede cumplir hoy. */
          sinProducto ? (
            <button
              type="button"
              data-lead-open
              class="mt-5 block w-full rounded-md bg-accent px-6 py-4 text-center font-bold text-white transition hover:bg-accent-hover"
            >
              Avísame cuando abra
            </button>
          ) : (
            <>
              <button
                type="button"
                data-lead-open
                class="mt-3 block w-full rounded-md border border-surface-300 px-6 py-3 text-center text-sm font-semibold text-heading transition hover:border-accent hover:text-accent"
              >
                Recibir más información
              </button>
              {/* Aviso de comisión junto al primer CTA: la FTC pide que vaya
                  cerca de la recomendación, no solo en el footer. Solo aquí,
                  en la rama con checkout; sin producto no hay enlace que
                  declarar. text-body/80 da 4,5:1 sobre blanco (text-muted no
                  llega al AA a 11 px). */}
              <p class="mt-2 text-center text-[11px] leading-snug text-body/80">
                Si te inscribes desde este enlace, Sably recibe una comisión sin costo extra para ti.
              </p>
            </>
          )
        }
        <ul class="mt-5 space-y-2 text-sm text-body" role="list">
          <li>✅ Acceso de por vida, 24/7</li>
          <li>✅ Certificado digital incluido</li>
          {/* Garantía y pago solo existen si hay checkout: en «Próximamente»
              prometerían algo que todavía no se puede comprar. */}
          {!sinProducto && <li>✅ Garantía de 7 días</li>}
          {!sinProducto && <li>✅ Pago seguro vía Hotmart</li>}
        </ul>
        </div>
      </div>
    </div>
    <div id="hero-sentinel" aria-hidden="true"></div>
  </section>

  <div class="container-site grid gap-12 py-14 lg:grid-cols-[1fr_380px]">
    <div class="min-w-0 space-y-12">
      {
        city && (
          <p class="rounded-lg bg-accent-soft p-5 text-sm leading-relaxed text-heading">
            <strong>¿Vives en {city.name}?</strong> Este curso es 100% online: estúdialo a tu ritmo desde cualquier
            barrio de {city.name} y aplica lo aprendido para emprender o mejorar tus ingresos en tu ciudad, con precios
            en {country.currency} y acompañamiento por WhatsApp en {country.name}.
          </p>
        )
      }

      <!-- Qué aprenderás -->
      <section aria-labelledby="learnings-title">
        <h2 id="learnings-title" class="text-2xl font-bold">{`Qué aprenderás en ${nombreEnFrase}`}</h2>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2" role="list">
          {
            learnings.map((item) => (
              <li class="flex items-start gap-2.5 rounded-md bg-off-white p-3.5 text-sm text-heading">
                <span class="text-success" aria-hidden="true">
                  ✅
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Programa -->
      <section aria-labelledby="program-title">
        <h2 id="program-title" class="text-2xl font-bold">{`Temario ${deNombre}`}</h2>
        <div class="mt-5 divide-y divide-surface-200 rounded-lg border border-surface-200">
          {
            course.data.modules.map((mod, i) => (
              <details class="group p-5" open={i === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-heading">
                  <span>
                    <span class="mr-2 text-accent">Módulo {i + 1}.</span>
                    {mod.title}
                  </span>
                  <span class="text-accent transition-transform group-open:rotate-45" aria-hidden="true">
                    +
                  </span>
                </summary>
                <ul class="mt-3 space-y-2 pl-2" role="list">
                  {mod.lessons.map((lesson) => (
                    <li class="flex items-center gap-2.5 text-sm text-body">
                      <span aria-hidden="true">▶️</span>
                      {lesson}
                    </li>
                  ))}
                </ul>
              </details>
            ))
          }
        </div>
      </section>

      {/* Constancia: una línea de texto. Aquí había una sección entera con la
          imagen /certificado-sably.jpg, un «diploma» generado («Nivel Avanzado ·
          120 horas», sello dorado y dos firmas) presentado como «ejemplo del
          certificado digital que recibirás». No era el documento que emite
          Hotmart. Sin producto no hay constancia que anunciar. */}
      {!sinProducto && (
        <p data-constancia class="rounded-lg bg-off-white p-5 text-sm leading-relaxed text-body">
          <strong class="text-heading">Constancia de finalización.</strong> Al completar el 100 % de las lecciones,
          Hotmart emite una constancia digital de finalización con tu nombre y el del curso.
        </p>
      )}

      <!-- Sobre el curso: variante país generada, o el MDX genérico si no hay -->
      <section aria-label="Sobre este curso">
        <h2 class="text-2xl font-bold">Sobre este curso</h2>
        <div class="mt-4 space-y-4 text-[15px] leading-relaxed text-body [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-primary [&_h4]:mt-6 [&_h4]:text-lg [&_h4]:font-bold [&_h4]:text-primary [&_li]:ml-5 [&_ol>li]:list-decimal [&_ol]:space-y-1.5 [&_strong]:text-heading [&_ul>li]:list-disc [&_ul]:space-y-1.5">
          {content.richBody
            ? <CmsRichBody value={content.richBody} />
            : <Fragment set:html={localeHtml ?? courseHtml ?? ''} />}
        </div>
      </section>

      <VerifiedReviews data={verifiedReviews}/>
      {/* Sin producto no hay compradores: ni reseñas propias ni ajenas. */}
      {!sinProducto && <ResenasCurso slug={course.id} />}

      <!-- Para quién es -->
      <section aria-labelledby="audience-title">
        <h2 id="audience-title" class="text-2xl font-bold">¿Para quién es este curso?</h2>
        <ul class="mt-5 space-y-3" role="list">
          {
            audience.map((item) => (
              <li class="flex items-start gap-3 rounded-md border border-surface-200 p-4 text-sm text-heading">
                <span aria-hidden="true">🎯</span>
                {item}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- FAQ -->
      <section aria-labelledby="faq-title">
        <h2 id="faq-title" class="text-2xl font-bold">{`Preguntas frecuentes sobre ${nombreEnFrase}`}</h2>
        <div class="mt-5">
          <FaqAccordion {faqs} />
        </div>
      </section>

      <RelatedGuides posts={guides} />

      <!-- Malla geo interna -->
      <section aria-labelledby="cities-title">
        {/* Rótulo, no encabezado: la lista de ciudades no es una sección de
            contenido del curso y como H2 repetía el país en las 896 fichas. */}
        <p id="cities-title" class="text-lg font-bold text-heading">
          {`Disponible online en ${country.name}`}
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            country.cities
              .filter((c) => c.slug !== city?.slug)
              .map((c) => (
                <span
                  class="rounded-full border border-surface-200 px-4 py-2 text-sm font-medium text-heading"
                >
                  📍 {c.name}
                </span>
              ))
          }
          {
            city && (
              <a
                href={`${base}/${course.id}/`}
                class="rounded-full border border-surface-200 px-4 py-2 text-sm font-medium text-heading transition hover:border-accent hover:text-accent"
              >
                🌎 Todo {country.name}
              </a>
            )
          }
        </div>
      </section>
    </div>

    <!-- Sidebar: creador + requisitos + garantía -->
    <aside class="space-y-6 lg:sticky lg:top-24 lg:h-fit">
      {creadoresVisibles.map(creator => (
        <div class="rounded-lg border border-surface-200 p-6">
          <h2 class="text-sm font-bold tracking-wide text-muted uppercase">Creador del curso</h2>
          <p class="mt-3 font-bold text-primary">{creator.nombre}</p>
          {creator.bio && <p class="mt-2 line-clamp-4 text-sm text-body">{creator.bio}</p>}
        </div>
      ))}
      {/* El instructor del contenido del curso no se pinta ni se marca como
          `Person`: los datos cargados eran de relleno (nombre, cargo y
          biografía de alguien que no existe) y no coincidían con el checkout.
          Cuando el curso tiene un creador cargado y verificable, es el bloque
          «Creador del curso» de arriba. */}
      <div class="rounded-lg border border-surface-200 p-6">
        <h2 class="text-sm font-bold tracking-wide text-muted uppercase">Requisitos previos</h2>
        <ul class="mt-3 space-y-2 text-sm text-body" role="list">
          <li>✅ No necesitas experiencia previa</li>
          <li>✅ Conexión a internet (celular o computador)</li>
          <li>✅ Ganas de aprender y practicar</li>
        </ul>
      </div>
      {
        /* Sin checkout no hay compra que reembolsar: la caja de garantía solo
           se pinta en cursos comprables. */
        !sinProducto && (
          <div class="rounded-lg bg-success/10 p-6 text-center">
            <p class="text-3xl" aria-hidden="true">🛡️</p>
            <h2 class="mt-2 font-bold text-primary">Garantía de 7 días</h2>
            {/* El reembolso lo hace Hotmart, no Sably: «te devolvemos» prometía
                algo que no podemos cumplir y contradecía /legal/terminos/. */}
            <p class="mt-2 text-sm text-body">
              Si el curso no cumple tus expectativas, pides el reembolso del 100 % en Hotmart dentro de los 7 días.
            </p>
          </div>
        )
      }
    </aside>
  </div>

  <!-- Especializaciones (si este curso es el pilar del clúster) -->
  {
    satellites.length > 0 && (
      <section class="container-site py-14">
        <h2 class="text-2xl font-bold">Especialízate después de este curso</h2>
        <p class="mt-2 max-w-2xl text-body">
          Este es el curso general. Cuando domines la base, estas especializaciones te dejan cobrar
          más por servicio.
        </p>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {satellites.slice(0, 8).map((c) => (
            <CourseCard course={c} {country} citySlug={city?.slug} />
          ))}
        </div>
      </section>
    )
  }

  <!-- Enlace al pilar (si este curso es una especialización) -->
  {
    pillar && (
      <section class="container-site py-10">
        <a
          href={city ? `${base}/${city.slug}/${pillar.id}/` : `${base}/${pillar.id}/`}
          class="group flex flex-wrap items-center gap-x-4 gap-y-2 rounded-lg border border-surface-200 bg-off-white p-6 transition hover:border-accent hover:shadow-lg"
        >
          <span class="text-3xl" aria-hidden="true">
            {category.emoji}
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-xs font-bold tracking-wide text-accent uppercase">
              ¿Prefieres empezar por lo general?
            </span>
            <span class="mt-1 block font-display text-lg font-bold text-primary group-hover:text-accent">
              {pillar.data.title}
            </span>
            <span class="mt-1 block text-sm text-body">{pillar.data.shortDescription}</span>
          </span>
          <span class="font-semibold text-accent">Ver curso →</span>
        </a>
      </section>
    )
  }

  <!-- Cursos relacionados -->
  {
    related.length > 0 && (
      <section class="bg-off-white py-14">
        <div class="container-site">
          <h2 class="text-2xl font-bold">Cursos relacionados</h2>
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {related.map((c) => (
              <CourseCard course={c} {country} citySlug={city?.slug} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- CTA final -->
  <section class="bg-primary py-16 text-center">
    <div class="container-site">
      <h2 class="text-3xl font-extrabold text-white">
        {city ? `¿Listo para empezar desde ${city.name}?` : '¿Listo para empezar?'}
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-white/80">
        {
          sinProducto
            ? 'Déjanos tus datos y te avisamos en cuanto abramos las inscripciones.'
            : 'Empieza hoy y aprende a tu ritmo, con acceso de por vida.'
        }
      </p>
      {
        sinProducto ? (
          <button
            type="button"
            data-lead-open
            class="mt-7 inline-block rounded-md bg-accent px-8 py-4 font-bold text-white transition hover:bg-accent-hover"
          >
            Avísame cuando abra
          </button>
        ) : (
          <a
            href="#compra"
            class="animate-pulse-soft mt-7 inline-block rounded-md bg-accent px-8 py-4 font-bold text-white transition hover:bg-accent-hover"
          >
            Opciones de compra
          </a>
        )
      }
      {
        !sinProducto && (
          <p class="mt-4 text-sm text-white/60">
            Garantía de 7 días · Acceso de por vida · Certificado incluido
          </p>
        )
      }
      {
        /* El mismo aviso de comisión del hero, junto al CTA final. text-white/50
           es el tono atenuado del footer, que pasa el AA sobre bg-primary. */
        !sinProducto && (
          <p class="mt-1.5 text-[11px] leading-snug text-white/50">
            Si te inscribes desde este enlace, Sably recibe una comisión sin costo extra para ti.
          </p>
        )
      }
    </div>
  </section>

  <LeadModal {country} courseTitle={course.data.title} courseSlug={course.id} />
  {/* El popup de salida ofrece comprar. Sin producto no hay nada que comprar y
      su CTA acabaría en la misma página de error, así que no se monta. */}

</BaseLayout>

<script>
  import { trackEvent } from '@/lib/analytics';

  const body = document.body;
  trackEvent('view_course', { page: location.pathname });
  document.querySelectorAll<HTMLAnchorElement>('[data-cta-hotmart]').forEach((cta) =>
    cta.addEventListener('click', () => {
      trackEvent('click_cta_hotmart', {
        page: location.pathname,
        cta_position: cta.dataset.ctaPosition ?? 'unknown',
      });
    }),
  );

  const marks = [25, 50, 75, 100];
  const fired = new Set<number>();
  addEventListener(
    'scroll',
    () => {
      const depth = ((scrollY + innerHeight) / body.scrollHeight) * 100;
      marks.forEach((m) => {
        if (depth >= m && !fired.has(m)) {
          fired.add(m);
          trackEvent('scroll_depth', { page_type: body.dataset.pageType ?? 'course', depth: `${m}%` });
        }
      });
    },
    { passive: true },
  );
</script>
