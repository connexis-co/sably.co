---
import { publicStats } from '@/lib/public-stats';
const stats = await publicStats();

/* Solo afirmaciones respaldadas. La media de valoraciones de Hotmart ya no
   se enseña: es una nota de un tercero. */
const items = [
  { icon: '🎓', label: `Disponible en ${stats.countries} países` },
  { icon: '📜', label: 'Certificado incluido' },
  { icon: '🔥', label: 'Cursos vía Hotmart — acceso de por vida' },
];
---

<div class="border-y border-surface-200 bg-off-white">
  <div class="container-site flex flex-wrap items-center justify-center gap-x-10 gap-y-3 py-5">
    {
      items.map((item) => (
        <p class="flex items-center gap-2 text-sm font-semibold text-heading">
          <span aria-hidden="true">{item.icon}</span>
          {item.label}
        </p>
      ))
    }
  </div>
</div>
