---
import { SITE } from '@/lib/site';

/* Solo afirmaciones respaldadas: la media y el total salen de las
   valoraciones públicas reales de los productos en Hotmart, y el texto lo dice:
   sin la fuente, el lector (y el LLM que lo cite) la toma por nota de Sably. */
const items = [
  { icon: '🎓', label: `Estudiantes en ${SITE.stats.countries} países` },
  { icon: '⭐', label: `${SITE.stats.rating} de media en ${SITE.stats.reviews.toLocaleString('es-CO')} valoraciones reales en Hotmart` },
  { icon: '📜', label: 'Certificado incluido' },
  { icon: '🔥', label: 'Cursos vía Hotmart — acceso de por vida' },
];
---

<div class="border-y border-surface-200 bg-off-white">
  <div class="container-site flex flex-wrap items-center justify-center gap-x-10 gap-y-3 py-5">
    {
      items.map((item) => (
        <p class="flex items-center gap-2 text-sm font-semibold text-heading">
          <span aria-hidden="true">{item.icon}</span>
          {item.label}
        </p>
      ))
    }
  </div>
</div>
