---
/**
 * Cinco estrellas en ámbar con relleno parcial (4,3 → cuatro llenas y un tercio). Decorativas:
 * la nota siempre va escrita al lado («4,3 de 5»).
 */
interface Props { nota: number; tamano?: number; class?: string }
const { nota, tamano = 16, class: clase } = Astro.props;
const llena = (i: number) => Math.max(0, Math.min(1, nota - i));
const d = 'M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z';
const id = `e${Math.round(nota * 10)}`;
---
<span class:list={['inline-flex gap-0.5 text-ambar', clase]} aria-hidden="true">
  {[0, 1, 2, 3, 4].map(i => (
    <svg width={tamano} height={tamano} viewBox="0 0 24 24">
      <defs><linearGradient id={`${id}-${i}`}><stop offset={llena(i)} stop-color="currentColor" /><stop offset={llena(i)} stop-color="#e6e6f0" /></linearGradient></defs>
      <path d={d} fill={`url(#${id}-${i})`} />
    </svg>
  ))}
</span>
