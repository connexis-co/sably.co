---
/**
 * Reproductor de la narración de un artículo (V2). Solo se pinta si hay narración vigente: el texto del artículo
 * sigue entero en el HTML y el audio es un añadido. Alto reservado (sin CLS), `preload="none"` (no compite con el
 * LCP), controles propios con el controlador común de `medios/` y, sin JS, el reproductor del navegador.
 */
// El CSS va en línea y solo con el reproductor: importado como hoja, entraría en el CSS empaquetado de todas las
// páginas (y cambiaría su HTML) aunque ninguna tuviera narración.
import cssMedios from './medios/medios.css?raw';
interface Props { src: string; segundos: number; titulo: string; caratula?: string; id?: string; medioId?: string; proveedor?: string }
const { src, segundos, titulo, caratula, id = 'narracion', medioId, proveedor } = Astro.props;
const reloj = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
const minutos = Math.max(1, Math.round(segundos / 60));
const estilos = cssMedios.replace(/\/\*[\s\S]*?\*\//g, '').replace(/\s+/g, ' ').trim();
---
<style is:inline set:html={estilos}></style>
<section class="v2-medio v2-medio-audio" data-medio data-medio-tipo="audio" data-medio-id={medioId} data-medio-proveedor={proveedor} data-medio-titulo={titulo} data-medio-artista="Sably" data-medio-caratula={caratula} aria-labelledby={`${id}-titulo`}>
  <div class="v2-medio-cabeza">
    <span class="v2-medio-ondas" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <p class="v2-medio-titulo" id={`${id}-titulo`}>Escucha este artículo · {minutos} min</p>
  </div>
  <audio data-medio-elemento controls preload="none" src={src} aria-labelledby={`${id}-titulo`}></audio>
  <div class="v2-medio-controles" data-medio-controles role="group" aria-label="Controles de la narración" hidden>
    <button type="button" class="v2-medio-boton v2-medio-principal" data-medio-alternar aria-label="Reproducir la narración">
      <svg class="v2-medio-play" width="22" height="22" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M6.5 3.8c0-.8.9-1.3 1.6-.9l8.4 5.3c.6.4.6 1.3 0 1.7l-8.4 5.3c-.7.4-1.6-.1-1.6-.9z" /></svg>
      <svg class="v2-medio-pausa" width="22" height="22" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><rect x="4.5" y="3.5" width="4" height="13" rx="1.2" /><rect x="11.5" y="3.5" width="4" height="13" rx="1.2" /></svg>
      <span class="v2-medio-estado" data-medio-etiqueta>Escuchar</span>
    </button>
    <button type="button" class="v2-medio-boton v2-medio-salto v2-medio-atras" data-medio-saltar="-15" aria-label="Retroceder 15 segundos">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12a8 8 0 1 0 2.4-5.7" /><path d="M4 3.5v3.8h3.8" /></svg>
      <span aria-hidden="true">15</span>
    </button>
    <div class="v2-medio-linea">
      <span class="v2-medio-tiempo" data-medio-actual aria-hidden="true">0:00</span>
      <input type="range" class="v2-medio-barra" data-medio-barra min="0" max={Math.ceil(segundos)} step="1" value="0" aria-label="Posición de la narración" />
      <span class="v2-medio-tiempo v2-medio-total" data-medio-total aria-hidden="true">{reloj(segundos)}</span>
    </div>
    <button type="button" class="v2-medio-boton v2-medio-salto v2-medio-adelante" data-medio-saltar="15" aria-label="Avanzar 15 segundos">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 12a8 8 0 1 1-2.4-5.7" /><path d="M20 3.5v3.8h-3.8" /></svg>
      <span aria-hidden="true">15</span>
    </button>
    <div class="v2-medio-ritmo">
      <button type="button" class="v2-medio-velocidad" data-medio-velocidad aria-haspopup="menu" aria-expanded="false" aria-controls={`${id}-velocidades`} aria-label="Velocidad: normal">
        <span data-medio-velocidad-valor>1×</span>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m3 7.5 3-3 3 3" /></svg>
      </button>
      <div class="v2-medio-menu" id={`${id}-velocidades`} role="menu" aria-label="Velocidad de reproducción" data-medio-menu hidden>
        {[['0.75', '0,75×', '0,75 veces'], ['1', '1×', 'Normal'], ['1.25', '1,25×', '1,25 veces'], ['1.5', '1,5×', '1,5 veces'], ['2', '2×', '2 veces']].map(([v, t, l]) => (
          <button type="button" role="menuitemradio" aria-checked={v === '1' ? 'true' : 'false'} aria-label={l} tabindex="-1" data-medio-velocidad-opcion={v}>
            <span>{t}</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m3 7.5 2.5 2.5L11 4.5" /></svg>
          </button>
        ))}
      </div>
    </div>
    <div class="v2-medio-sonido">
      <button type="button" class="v2-medio-boton v2-medio-silenciar" data-medio-silenciar aria-pressed="false" aria-label="Silenciar">
        <svg class="v2-medio-altavoz" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 7.5h3L10.5 4v12L6 12.5H3z" fill="currentColor" /><path d="M13.5 7a4 4 0 0 1 0 6M15.5 4.5a7.5 7.5 0 0 1 0 11" /></svg>
        <svg class="v2-medio-mudo" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 7.5h3L10.5 4v12L6 12.5H3z" fill="currentColor" /><path d="m13.5 8 4 4m0-4-4 4" /></svg>
      </button>
      <input type="range" class="v2-medio-barra v2-medio-volumen" data-medio-volumen min="0" max="100" step="5" value="100" aria-label="Volumen de la narración" />
    </div>
  </div>
  <p class="v2-medio-estado" data-medio-estado role="status" aria-live="polite"></p>
</section>
<script>
  import { prepararMedios } from './medios/controlador';
  prepararMedios();
</script>
