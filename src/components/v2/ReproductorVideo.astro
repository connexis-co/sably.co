---
/**
 * Reproductor de vídeo V2 sobre el controlador común de `medios/` (el mismo del audio de las narraciones).
 *
 * Fachada: hasta que la persona pulsa solo hay un <img> (el póster, que en la ficha es el LCP) y un enlace al MP4.
 * Al pulsar se descarga el controlador (import diferido) y se monta el <video> con los controles propios desde un
 * <template>, en la misma caja 16:9: nada cambia de alto (CLS 0). Sin JS el enlace abre el MP4 en el navegador.
 * La medición (`video_start`, `video_progress`…) es la de `medios/medicion.ts`, solo con la medición aceptada.
 */
import { getImage } from 'astro:assets';
import Icono from '@/components/v2/Icono.astro';
import cssFachada from './medios/video-fachada.css?raw';
interface Props {
  /** MP4 que siempre funciona (R2, o el 720p del proveedor). */
  src: string;
  /** HLS adaptativo (Mux). Se usa solo si el navegador lo reproduce de forma nativa (Safari, Chrome ≥ 142…). */
  hls?: string;
  /** Subtítulos WebVTT del proveedor; solo se cargan junto con el HLS (mismo origen con CORS). */
  subtitulos?: string;
  poster: string;
  titulo: string;
  /** Texto alternativo del póster cuando no hay vídeo; con vídeo el póster es decorativo. */
  alt?: string;
  segundos?: number;
  /** Identificador estable para la medición, p. ej. `curso:curso-de-barberia`. */
  medioId: string;
  proveedor?: string;
  /** El póster es el LCP de la página (ficha): fetchpriority alta. */
  prioritario?: boolean;
  rotulo?: string;
  class?: string;
}
const { src, hls, subtitulos, poster, titulo, segundos = 0, medioId, proveedor = 'r2', prioritario = false, rotulo = 'Presentación', class: clase } = Astro.props;
const anchos = [480, 780, 1200];
const imagenes = await Promise.all(anchos.map(width => getImage({ src: poster, width, height: Math.round(width * 9 / 16) }).catch(() => null)));
const principal = imagenes[1] ?? imagenes[0];
const srcset = imagenes.map((img, i) => img && `${img.src} ${anchos[i]}w`).filter(Boolean).join(', ');
/* Solo la fachada, en línea y solo donde hay vídeo; los controles llegan con el controlador (estilos-video.ts). */
const estilos = cssFachada.replace(/\/\*[\s\S]*?\*\//g, '').replace(/\s+/g, ' ').trim();
const reloj = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
---
<style is:inline set:html={estilos}></style>
<div class:list={['v2-medio v2-medio-video', clase]} data-medio-fachada data-medio-tipo="video" data-medio-id={medioId}
  data-medio-proveedor={proveedor} data-medio-titulo={titulo} data-medio-artista="Sably" data-medio-album="Presentaciones de cursos"
  data-medio-caratula={principal?.src ?? poster} data-medio-verbo="Ver" data-medio-nombre="el vídeo" data-medio-fin="Vídeo terminado.">
  <img src={principal?.src ?? poster} srcset={srcset || undefined} sizes="(min-width: 1024px) 780px, 100vw" alt=""
    width="780" height="439" fetchpriority={prioritario ? 'high' : 'auto'} loading={prioritario ? 'eager' : 'lazy'} decoding="async" class="v2-medio-poster" />
  <a href={src} class="v2-medio-portada" data-medio-abrir aria-label={`Reproducir el vídeo: ${titulo}`}>
    <span class="v2-medio-gran-play" aria-hidden="true"><Icono nombre="play" tamano={28} class="translate-x-0.5" /></span>
    <span class="v2-medio-rotulo"><Icono nombre="circle-play" tamano={16} />{rotulo}{segundos > 0 && <span class="v2-num"> · {reloj(segundos)}</span>}</span>
  </a>
  <template data-medio-plantilla>
    <video data-medio-elemento playsinline preload="metadata" src={src} data-hls={hls} aria-label={titulo}>
      {hls && subtitulos && <track kind="subtitles" srclang="es" label="Español" src={subtitulos} data-medio-pista />}
    </video>
    <div class="v2-medio-controles" data-medio-controles role="group" aria-label="Controles del vídeo" hidden>
      <button type="button" class="v2-medio-boton v2-medio-principal" data-medio-alternar aria-label="Reproducir el vídeo">
        <svg class="v2-medio-play" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M6 3.5 16.5 10 6 16.5z" /></svg>
        <svg class="v2-medio-pausa" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M5 3.5h3.5v13H5zm6.5 0H15v13h-3.5z" /></svg>
        <span class="v2-medio-estado" data-medio-etiqueta>Ver</span>
      </button>
      <div class="v2-medio-linea">
        <span class="v2-medio-tiempo" data-medio-actual aria-hidden="true">0:00</span>
        <input type="range" class="v2-medio-barra" data-medio-barra min="0" max={Math.max(1, Math.ceil(segundos))} step="1" value="0" aria-label="Posición del vídeo" />
        <span class="v2-medio-tiempo" data-medio-total aria-hidden="true">{reloj(segundos)}</span>
      </div>
      <button type="button" class="v2-medio-boton" data-medio-pantalla aria-label="Pantalla completa">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M3 7V3h4M13 3h4v4M17 13v4h-4M7 17H3v-4" /></svg>
      </button>
    </div>
    <p class="v2-medio-estado" data-medio-estado role="status" aria-live="polite"></p>
  </template>
</div>
<script>
  for (const raiz of document.querySelectorAll<HTMLElement>('[data-medio-fachada]')) {
    const abrir = raiz.querySelector<HTMLAnchorElement>('[data-medio-abrir]');
    const plantilla = raiz.querySelector<HTMLTemplateElement>('[data-medio-plantilla]');
    if (!abrir || !plantilla) continue;
    // Precarga al acercarse: así el play() sigue dentro del gesto de la persona (Safari lo exige).
    const cargar = () => Promise.all([import('./medios/controlador'), import('./medios/estilos-video').then((m) => m.ponerEstilosVideo())]);
    const precargar = () => void cargar();
    for (const ev of ['pointerenter', 'focus', 'touchstart']) abrir.addEventListener(ev, precargar, { once: true, passive: true });
    abrir.addEventListener('click', async (e) => {
      e.preventDefault();
      if (raiz.dataset.medio !== undefined) return;
      raiz.dataset.medio = '';
      const [{ prepararMedio }] = await cargar();
      raiz.appendChild(plantilla.content.cloneNode(true));
      // HLS solo donde el navegador lo reproduce solo (sin motor en JS); si no, el MP4. Los subtítulos van con el HLS.
      const video = raiz.querySelector<HTMLVideoElement>('video');
      if (video?.dataset.hls && video.canPlayType('application/vnd.apple.mpegurl')) {
        const mp4 = video.src;
        video.crossOrigin = 'anonymous';
        video.src = video.dataset.hls;
        // Si el HLS falla (copia borrada, proveedor caído), una vez al MP4 antes de que el controlador lo dé por perdido.
        video.addEventListener('error', (ev) => {
          ev.stopImmediatePropagation();
          raiz.dataset.medioRespaldo = 'pendiente';
          const fin = () => { delete raiz.dataset.medioRespaldo; };
          video.addEventListener('playing', fin, { once: true });
          setTimeout(fin, 5000);
          video.querySelector('[data-medio-pista]')?.remove();
          video.removeAttribute('crossorigin');
          raiz.dataset.medioProveedor = 'r2';
          video.src = mp4;
          void video.play().catch(() => {});
        }, { once: true });
      } else {
        video?.querySelector('[data-medio-pista]')?.remove();
        if (video && new URL(video.src).hostname === 'cdn.sably.co') raiz.dataset.medioProveedor = 'r2';
      }
      prepararMedio(raiz);
      abrir.hidden = true;
      raiz.querySelector<HTMLButtonElement>('[data-medio-alternar]')?.click();
      raiz.querySelector<HTMLButtonElement>('[data-medio-alternar]')?.focus();
    });
  }
</script>
