---
/**
 * Constancia de muestra, tratamiento E «Con talón de verificación» (lámina
 * constancia-secciones/kmJmq). Es un documento ilustrativo de Sably: no lleva
 * firmas, sellos, horas ni avales, y el código y el QR son de ejemplo (el QR es
 * un dibujo decorativo, no codifica nada). La constancia real la emite Hotmart.
 * Para un lector de pantalla es una sola imagen con una frase; el contenido
 * visual interno no se lee.
 * Escritorio: panel azul noche, centro blanco y talón perforado a la derecha.
 * Móvil (< 640 px): se apila y el talón pasa debajo, en horizontal.
 */
interface Props { curso: string; creador?: string | null; class?: string }
const { curso, creador = null, class: clase } = Astro.props;

// QR decorativo de 21 × 21 módulos: tres marcas de esquina y relleno pseudoaleatorio fijo.
const N = 21;
const esquina = (x: number, y: number): boolean | null => {
  const arriba = y < 7, abajo = y >= N - 7, izq = x < 7, der = x >= N - 7;
  if (!((arriba && izq) || (arriba && der) || (abajo && izq))) return null;
  const dx = izq ? x : x - (N - 7);
  const dy = arriba ? y : y - (N - 7);
  if (dx === 0 || dx === 6 || dy === 0 || dy === 6) return true;
  return dx >= 2 && dx <= 4 && dy >= 2 && dy <= 4;
};
const separador = (x: number, y: number) =>
  (x === 7 && y <= 7) || (y === 7 && x <= 7) || (x === N - 8 && y <= 7) || (y === 7 && x >= N - 8) || (x === 7 && y >= N - 8) || (y === N - 8 && x <= 7);
let semilla = 20261125;
const azar = () => (semilla = (Math.imul(semilla, 1664525) + 1013904223) >>> 0) / 4294967296;
let qr = '';
for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) {
  const e = esquina(x, y);
  const lleno = e !== null ? e : separador(x, y) ? false : azar() > 0.52;
  if (lleno) qr += `M${x} ${y}h1v1h-1z`;
}
const etiqueta = `Ejemplo ilustrativo de la constancia de finalización del curso ${curso}. Lleva un nombre de muestra, un código de verificación de ejemplo y un código QR de ejemplo. La constancia real la emite Hotmart.`;
---
<figure role="img" aria-label={etiqueta} class:list={['v2-const', clase]} data-constancia-ejemplo>
  <div class="v2-const-panel" aria-hidden="true">
    <svg class="v2-const-emblema" viewBox="110 110 467 520" width="26" height="28" focusable="false"><g transform="translate(80 610) scale(1 -1)"><path d="M456 305H346Q346 341 317 363Q288 385 240 385Q201 385 175.5 368.5Q150 352 150 327Q150 302 175 283.5Q200 265 237.5 247Q275 229 318.5 209Q362 189 399.5 161Q437 133 462 94Q487 55 487 0H377Q377 37 352 61.5Q327 86 289.5 106Q252 126 208.5 144.5Q165 163 127.5 187Q90 211 65 244.5Q40 278 40 327Q40 362 55.5 392Q71 422 98.5 444Q126 466 163.5 478Q201 490 246 490Q293 490 331.5 476.5Q370 463 397.5 438.5Q425 414 440.5 380Q456 346 456 305Z" fill="#fff"/><path d="M110 130Q140 130 160 110Q180 90 180 60Q180 30 160 10Q140 -10 110 -10Q80 -10 60 10Q40 30 40 60Q40 90 60 110Q80 130 110 130Z" fill="#e8456b"/></g></svg>
    <svg class="v2-const-trama" viewBox="-100 -100 200 200" focusable="false"><g fill="none" stroke="currentColor" stroke-width="0.6">{Array.from({ length: 18 }, (_, i) => <ellipse rx="92" ry="34" transform={`rotate(${i * 10})`} />)}</g></svg>
    <p class="v2-const-titulo"><span class="v2-const-filete"></span>Constancia de finalización</p>
  </div>
  <div class="v2-const-centro" aria-hidden="true">
    <p class="v2-const-rotulo">Ejemplo ilustrativo</p>
    <div>
      <p class="text-t13 text-navy-500">Se hace constar que</p>
      <p class="v2-const-nombre">Tu nombre aquí</p>
      <p class="mt-4 text-t13 text-navy-500">completó el curso</p>
      <p class="v2-const-curso">{curso}</p>
    </div>
    <dl class="v2-const-filas">
      <div><dt>Fecha</dt><dd>El día que terminas</dd></div>
      {creador && <div><dt>Lo dicta</dt><dd>{creador}</dd></div>}
    </dl>
  </div>
  <div class="v2-const-talon" aria-hidden="true">
    <p class="v2-const-verif">Verificación</p>
    <svg class="v2-const-qr" viewBox="-1 -1 23 23" width="96" height="96" shape-rendering="crispEdges" focusable="false"><rect x="-1" y="-1" width="23" height="23" fill="#fff"/><path d={qr} fill="#1b1b3a"/></svg>
    <p class="v2-const-codigo"><span class="v2-num">SBL-0000-0000</span><span>Código de ejemplo</span></p>
    <p class="v2-const-emite"><span>Se emite en</span><strong>Hotmart</strong></p>
  </div>
</figure>
<style>
  .v2-const {
    --fondo-muesca: var(--constancia-fondo, #fff);
    position: relative; display: grid; grid-template-columns: 170px minmax(0, 1fr) 150px; width: 100%; max-width: 620px; min-height: 420px; margin: 0;
    overflow: hidden; border-radius: var(--radius-c-lg); background: #fff; box-shadow: var(--shadow-s2);
  }
  .v2-const-panel { position: relative; display: flex; flex-direction: column; justify-content: space-between; padding: 28px 22px; overflow: hidden; background: var(--color-navy-950); border-left: 4px solid var(--color-coral-600); color: #fff; }
  .v2-const-emblema { position: relative; z-index: 1; }
  .v2-const-trama { position: absolute; left: -40px; bottom: -30px; width: 240px; color: rgb(255 255 255 / 0.1); pointer-events: none; }
  .v2-const-titulo { position: relative; z-index: 1; font: 600 20px/24px var(--font-display); }
  .v2-const-filete { display: block; width: 28px; height: 2px; margin-bottom: 14px; background: var(--color-coral-600); }
  .v2-const-centro { display: flex; flex-direction: column; justify-content: space-between; gap: 24px; padding: 24px; min-width: 0; }
  .v2-const-rotulo { align-self: flex-start; padding: 3px 10px; border-radius: 999px; background: var(--color-coral-50); box-shadow: inset 0 0 0 1px var(--color-coral-100); font-size: 12px; line-height: 18px; font-weight: 600; color: var(--color-coral-700); }
  .v2-const-nombre { margin-top: 2px; padding-bottom: 10px; border-bottom: 1px solid var(--color-navy-100); font: 600 32px/38px var(--font-display); letter-spacing: -0.01em; color: var(--color-navy-950); overflow-wrap: anywhere; }
  .v2-const-curso { margin-top: 2px; font: 600 20px/26px var(--font-display); color: var(--color-navy-950); text-wrap: balance; }
  .v2-const-filas { margin: 0; }
  .v2-const-filas > div { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-bottom: 1px solid var(--color-navy-100); font-size: 13px; line-height: 18px; }
  .v2-const-filas dt { color: var(--color-navy-500); }
  .v2-const-filas dd { margin: 0; text-align: right; font-weight: 600; color: var(--color-navy-950); }
  .v2-const-talon {
    position: relative; display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 14px; padding: 24px 14px; text-align: center;
    background: var(--color-coral-50); border-left: 2px dotted var(--color-coral-500);
  }
  .v2-const-talon::before, .v2-const-talon::after { content: ''; position: absolute; left: -9px; width: 16px; height: 16px; border-radius: 50%; background: var(--fondo-muesca); }
  .v2-const-talon::before { top: -8px; }
  .v2-const-talon::after { bottom: -8px; }
  .v2-const-verif { font-size: 13px; line-height: 18px; font-weight: 600; color: var(--color-coral-600); }
  .v2-const-qr { padding: 6px; border-radius: var(--radius-c-sm); background: #fff; box-shadow: inset 0 0 0 1px var(--color-coral-100); box-sizing: content-box; }
  .v2-const-codigo { display: flex; flex-direction: column; gap: 2px; font-size: 12px; line-height: 16px; color: var(--color-navy-500); }
  .v2-const-codigo .v2-num { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-weight: 500; color: var(--color-navy-950); }
  .v2-const-emite { display: flex; flex-direction: column; font-size: 12px; line-height: 16px; color: var(--color-navy-500); }
  .v2-const-emite strong { font: 600 15px/20px var(--font-display); color: var(--color-navy-950); }
  @media (width < 640px) {
    .v2-const { grid-template-columns: 1fr; min-height: 0; }
    .v2-const-panel { flex-direction: row; align-items: center; justify-content: flex-start; gap: 14px; padding: 18px 20px; border-left: 0; border-top: 4px solid var(--color-coral-600); }
    .v2-const-trama { left: auto; right: -50px; bottom: -70px; }
    .v2-const-titulo { font-size: 17px; line-height: 22px; }
    .v2-const-filete { display: none; }
    .v2-const-centro { padding: 20px; gap: 18px; }
    .v2-const-nombre { font-size: 28px; line-height: 34px; }
    .v2-const-talon { display: grid; grid-template-columns: auto 1fr auto; grid-template-areas: 'verif verif verif' 'qr codigo emite'; align-items: center; justify-items: start; gap: 10px 14px; padding: 20px; text-align: left; border-left: 0; border-top: 2px dotted var(--color-coral-500); }
    .v2-const-talon::before, .v2-const-talon::after { top: -9px; bottom: auto; }
    .v2-const-talon::before { left: -8px; }
    .v2-const-talon::after { left: auto; right: -8px; }
    .v2-const-verif { grid-area: verif; }
    .v2-const-qr { grid-area: qr; width: 72px; height: 72px; }
    .v2-const-codigo { grid-area: codigo; }
    .v2-const-emite { grid-area: emite; text-align: right; justify-self: end; }
  }
  @media print { .v2-const { box-shadow: none; outline: 1px solid var(--color-navy-100); } }
</style>
