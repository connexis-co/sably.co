---
/**
 * «Seguir escuchando» (blog DISENO §12.6). Un <audio> no sobrevive a una navegación normal: cuando alguien deja una
 * narración a medias y pasa a otra página, aquí aparece una píldora abajo a la izquierda (el WhatsApp está a la
 * derecha) con el artículo y el minuto, que la reproduce allí mismo o abre el artículo.
 *  - Qué narración: `sably:seguir` (lo escribe el artículo, articulo.ts, solo con «blogNarracionSeguir» encendido).
 *  - En qué punto: `sably:medio:<ruta del audio>`, la misma clave del controlador de medios (controlador.ts), que la
 *    borra al terminar el audio. Este reproductor la sigue actualizando, así que al volver al artículo retoma igual.
 *  - Sale durante la visita (2 horas desde la última escucha), nunca en el propio artículo, y se descarta con su cierre
 *    o al terminar. Sin datos guardados no añade nada a la página: ni HTML ni CSS (los crea el script al hacer falta).
 * No tapa: sube sobre lo fijo abajo (--fijo-inferior: barra de compra de la ficha en móvil, narración del blog) y
 * deja sitio a la cookie; la píldora del índice y los avisos de compras recientes suben por encima de ella.
 */
---
<script is:inline>
(() => {
  let r, pos;
  try {
    r = JSON.parse(localStorage.getItem('sably:seguir') || 'null');
    if (!r || typeof r.u !== 'string' || typeof r.a !== 'string' || Date.now() - r.h > 72e5 || location.pathname === r.u) return;
    pos = Number(localStorage.getItem('sably:medio:' + r.s)) || 0;
  } catch { return; }
  if (pos <= 5 || (r.d && pos >= r.d - 10)) return;
  const clave = 'sably:medio:' + r.s;
  const reloj = (s) => { const t = Math.max(0, Math.floor(s)); return Math.floor(t / 60) + ':' + String(t % 60).padStart(2, '0'); };
  const guardar = (v) => { try { v === null ? localStorage.removeItem(clave) : localStorage.setItem(clave, String(Math.floor(v))); } catch {} };
  const css = '.v2-seguir{position:fixed;z-index:42;left:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));translate:0 calc(-1 * var(--fijo-inferior,0px));display:flex;align-items:center;gap:2px;width:max-content;max-width:min(420px,calc(100vw - 112px));min-height:52px;padding:4px;border-radius:99px;background:#1b1b3a;color:#fff;box-shadow:0 12px 32px -8px rgb(27 27 58/.35);font:500 13px/18px var(--font-sans,system-ui);animation:v2-seguir-entra .24s cubic-bezier(.16,1,.3,1)}'
    + '@keyframes v2-seguir-entra{from{opacity:0;translate:0 8px}}@media (prefers-reduced-motion:reduce){.v2-seguir{animation:none}}'
    + '.v2-seguir button{display:grid;place-items:center;flex:none;width:44px;height:44px;padding:0;border:0;border-radius:99px;background:none;color:inherit;cursor:pointer}'
    + '.v2-seguir [data-seguir-alternar]{background:#e11d48;background:var(--color-coral-600,#e11d48)}'
    + '.v2-seguir button:focus-visible,.v2-seguir a:focus-visible{outline:3px solid var(--color-coral-500,#f43f5e);outline-offset:2px}'
    + '.v2-seguir a{display:flex;flex-direction:column;min-width:0;padding:4px 8px 4px 10px;color:inherit;text-decoration:none}'
    + '.v2-seguir a span{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#c7c7e0;font-variant-numeric:tabular-nums}.v2-seguir a b{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-weight:600;font-size:14px;line-height:20px}'
    + '.v2-seguir .v2-seguir-pausa,.v2-seguir[data-sonando] .v2-seguir-play{display:none}.v2-seguir[data-sonando] .v2-seguir-pausa{display:block}'
    + 'body:has(#sbc-ico:not([hidden])) .v2-seguir{left:64px;max-width:min(420px,calc(100vw - 148px))}'
    + 'body:has(.v2-seguir) .v2-indice-pildora{bottom:calc(80px + var(--fijo-inferior,0px))}body:has(.v2-seguir) .ps-toast{--ps-carril:64px!important}';
  const estilo = document.createElement('style');
  estilo.textContent = css;
  const caja = document.createElement('div');
  caja.className = 'v2-seguir';
  caja.setAttribute('role', 'region');
  caja.setAttribute('aria-label', 'Seguir escuchando');
  const svg = (d, cls) => '<svg class="' + cls + '" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="' + d + '"/></svg>';
  caja.innerHTML = '<button type="button" data-seguir-alternar>' + svg('M6 3.5 16.5 10 6 16.5z', 'v2-seguir-play') + svg('M5 3.5h3.5v13H5zm6.5 0H15v13h-3.5z', 'v2-seguir-pausa') + '</button>'
    + '<a data-seguir-enlace><span data-seguir-tiempo></span><b data-seguir-titulo></b></a>'
    + '<button type="button" data-seguir-cerrar aria-label="Cerrar «Seguir escuchando»">' + svg('M5.3 4.2 10 8.9l4.7-4.7 1.1 1.1L11.1 10l4.7 4.7-1.1 1.1L10 11.1l-4.7 4.7-1.1-1.1L8.9 10 4.2 5.3z', '') + '</button>';
  const boton = caja.querySelector('[data-seguir-alternar]');
  const enlace = caja.querySelector('[data-seguir-enlace]');
  const tiempo = caja.querySelector('[data-seguir-tiempo]');
  caja.querySelector('[data-seguir-titulo]').textContent = String(r.t || 'Narración del artículo');
  enlace.href = r.u + '#narracion';
  const pintar = (s, sonando) => {
    tiempo.textContent = reloj(s) + (sonando ? ' · Escuchando' : ' · Seguir escuchando');
    caja.toggleAttribute('data-sonando', sonando);
    boton.setAttribute('aria-label', (sonando ? 'Pausar' : 'Seguir escuchando') + ' «' + (r.t || 'la narración') + '» ' + (sonando ? '' : 'desde ' + reloj(s)));
  };
  pintar(pos, false);
  let audio = null, ultimo = 0;
  const quitar = () => { caja.remove(); estilo.remove(); try { localStorage.removeItem('sably:seguir'); } catch {} };
  boton.addEventListener('click', () => {
    if (!audio) {
      audio = new Audio(r.a);
      audio.preload = 'metadata';
      audio.addEventListener('loadedmetadata', () => { if (audio.currentTime < 1) audio.currentTime = Math.min(pos, audio.duration || pos); }, { once: true });
      audio.addEventListener('timeupdate', () => { pintar(audio.currentTime, !audio.paused); if (Date.now() - ultimo > 5000) { ultimo = Date.now(); guardar(audio.currentTime); } });
      audio.addEventListener('play', () => { pintar(audio.currentTime || pos, true); try { r.h = Date.now(); localStorage.setItem('sably:seguir', JSON.stringify(r)); } catch {} });
      audio.addEventListener('pause', () => { if (audio.currentTime > 0) guardar(audio.currentTime); pintar(audio.currentTime || pos, false); });
      audio.addEventListener('ended', () => { guardar(null); quitar(); });
      audio.addEventListener('error', () => { location.href = enlace.href; });
      if ('mediaSession' in navigator) navigator.mediaSession.metadata = new MediaMetadata({ title: String(r.t || ''), artist: 'Sably', album: 'Artículos narrados' });
      // Si suena otro medio de la página (el reproductor del artículo, un vídeo), este se calla.
      document.addEventListener('play', (e) => { if (e.target !== audio) audio.pause(); }, true);
    }
    if (audio.paused) audio.play().catch(() => { location.href = enlace.href; }); else audio.pause();
  });
  caja.querySelector('[data-seguir-cerrar]').addEventListener('click', () => { if (audio) audio.pause(); quitar(); });
  document.head.append(estilo);
  document.body.append(caja);
})();
</script>
