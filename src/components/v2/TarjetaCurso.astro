---
/**
 * Tarjeta de curso V2: foto 4:3 con radio 16, categoría en placa, y debajo, con
 * jerarquía y alturas fijas para que toda la fila quede alineada (ronda 2 de JP, B):
 * título (dos líneas), descripción (dos líneas, sin cortar palabras: `resumenTarjeta`),
 * duración y nivel, nota corta de Hotmart («★★★★☆ 4,4 · 27»; sin nota, la fila queda
 * reservada y vacía) y precio de hoy con el normal tachado en la misma línea. La fuente
 * y la fecha de la nota van en el texto accesible y en la ayuda al pasar el cursor; el
 * listado las declara una vez al pie (`fuenteDeNotas`). Al pasar el cursor la foto escala 1,03 y la tarjeta gana s2;
 * la tarjeta no se mueve.
 * El precio llega hecho (`precio`, de `preciosDeTarjetas` en src/lib/precio-hoy.ts):
 * es el que la ficha da como precio a pagar hoy, con el normal tachado al lado
 * cuando la campaña aplica a ese curso. `null` = sin precio de Hotmart para ese
 * país: la tarjeta no enseña cifra (nunca una de relleno).
 * Con `filaEnMovil`, por debajo de 640 px pasa a fila de listado: miniatura 4:3
 * de 112 px a la izquierda, sin placa ni descripción y sin marco (el separador
 * lo pone la lista).
 */
import { Image as OptimizedImage } from 'astro:assets';
import { env } from 'virtual:sably-runtime';
import { cmsImageUrl } from '@/lib/cms-media';
import type { Course } from '@/lib/emdash-content';
import { courseCover } from '@/lib/categories';
import { getCategory } from '@/lib/emdash-content';
import type { Country } from '@/lib/countries';
import type { PrecioTarjeta } from '@/lib/precio-tarjeta';
import Precio from './Precio.astro';
import { readOperationalRating } from '@/plugins/sably-operations/public';
import Icono from './Icono.astro';
import Estrellas from './Estrellas.astro';
import { notaHotmart } from '@/lib/opiniones';
import { resumenTarjeta } from '@/lib/presentacion-v2';
interface Props { course: Course; country: Country; precio: PrecioTarjeta | null; eager?: boolean; filaEnMovil?: boolean }
const { course, country, precio, eager = false, filaEnMovil = false } = Astro.props;
const cat = (await getCategory(course.data.category))!;
const operationalDb = (env as unknown as { SABLY_DB: D1Database }).SABLY_DB;
const valoracion = await readOperationalRating(operationalDb, course.id, Astro.locals).catch(() => null);
const url = `/${country.code}/${course.id}/`;
const nota = notaHotmart(valoracion);
const resumen = resumenTarjeta(course.data.shortDescription);
/* Para las tarjetas más estrechas (cuatro columnas a 1024–1279 en la portada): dos líneas de ~18 a 24 caracteres (contenido de 178 a 250 px). */
const resumenCorto = resumenTarjeta(course.data.shortDescription, 34);
---
<article data-fila-movil={filaEnMovil || undefined} data-tarjeta-curso={course.id} class="v2-tc group relative flex h-full flex-col rounded-c-lg bg-white ring-1 ring-navy-100">
  <div class="v2-tc-foto relative aspect-[4/3] overflow-hidden bg-navy-50">
    <OptimizedImage
      src={cmsImageUrl(course.cardImage) ?? cmsImageUrl(course.coverImage) ?? courseCover(course.id, cat.slug, 'card')}
      alt={course.data.title} width={480} height={360}
      sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
      loading={eager ? 'eager' : 'lazy'} decoding="async"
      class="h-full w-full object-cover transition-transform duration-(--t-base) ease-(--e-sale) group-hover:scale-[1.03]" />
    <span class="v2-tc-placa absolute top-3 left-3 rounded-full bg-navy-950/85 px-3 py-1 text-t13 font-medium text-white">{cat.name}</span>
  </div>
  <div class="v2-tc-cuerpo @container flex flex-1 flex-col p-5">
    <h3 class="v2-tc-titulo line-clamp-2 min-h-[2lh] text-t17 leading-6 font-semibold text-balance text-navy-950 transition-colors duration-(--t-rapido) group-hover:text-coral-700"><a href={url} class="after:absolute after:inset-0 focus-visible:outline-none">{course.data.title}</a></h3>
    <hr class="v2-tc-raya mt-3 border-0 border-t border-navy-100" aria-hidden="true" />
    <p class="v2-tc-desc mt-3 line-clamp-2 min-h-[2lh] text-t15 leading-[22px] text-navy-700">{resumenCorto === resumen ? resumen : <><span class="v2-tc-r-largo">{resumen}</span><span class="v2-tc-r-corto hidden">{resumenCorto}</span></>}</p>
    <p class="v2-tc-meta mt-3 truncate text-t13 leading-5 text-navy-500">{course.data.durationHours} h · {course.data.level}</p>
    {nota
      ? <p class="v2-tc-nota mt-1 flex h-5 items-center gap-1.5 text-t13 text-navy-500" title={nota.accesible}><Estrellas nota={valoracion!.rating} tamano={13} class="flex-none" /><span aria-hidden="true"><span class="font-semibold text-navy-950">{nota.cifra}</span> · {nota.numero}</span><span class="sr-only">{nota.accesible}</span></p>
      : <p class="v2-tc-nota mt-1 h-5" aria-hidden="true" data-sin-nota></p>}
    <p class="v2-tc-precio mt-auto flex min-h-11 items-center justify-between gap-3 pt-4 text-t17 font-semibold text-navy-950">
      {precio ? (
        <span class="flex min-w-0 flex-nowrap items-baseline gap-x-2 whitespace-nowrap" data-tc-precio data-moneda={precio.moneda} data-hoy={precio.hoy} data-normal={precio.normal ?? undefined}>
          <Precio valor={precio.hoy} moneda={precio.moneda} locale={country.hreflang} codigoClass="text-t13 font-medium" />
          {precio.normal !== null && <span class="v2-tc-normal text-t13 font-normal text-navy-500"><span class="sr-only">Precio normal: </span><Precio valor={precio.normal} moneda={precio.moneda} locale={country.hreflang} class="line-through decoration-[1.5px]" codigoClass="text-t13" /></span>}
        </span>
      ) : <span />}
      <span class="v2-tc-flecha" aria-hidden="true"><Icono nombre="arrow-right" tamano={18} /></span>
    </p>
  </div>
</article>
<style is:global>
  /* Sin ámbito de Astro: los selectores cuelgan de `.v2-tc`, de clases v2-tc-* o de data-fila-movil, que solo existen aquí; así la
     hoja común no repite el atributo data-astro-cid en cada regla. */
  .v2-tc:has(a:focus-visible) { outline: 3px solid var(--color-coral-600); outline-offset: 3px; }
  /* Cursor (C9, juez pieza 31): la sombra s2 vive en un ::after y solo cambia su opacidad (composición, 240 ms),
     en vez de animar `box-shadow` 380 ms en la tarjeta. La foto recorta con su propio radio superior, así que la
     tarjeta ya no necesita `overflow: hidden`, que habría cortado la sombra. */
  .v2-tc-foto { border-radius: var(--radius-c-lg) var(--radius-c-lg) 0 0; }
  .v2-tc::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    box-shadow: var(--shadow-s2); opacity: 0; transition: opacity var(--t-base) var(--e-sale);
  }
  /* Al pasar el cursor y con el foco de teclado. Sin @media (hover): en el celular tocar la tarjeta ya navega. */
  .v2-tc:is(:hover, :has(a:focus-visible))::after { opacity: 1; }
  /* Ojo: el contenedor (`@container` en .v2-tc-cuerpo) mide la caja de contenido, sin los 20 px de relleno de cada lado. */
  /* Botón de ir (D3, ronda 5): círculo de 40 px en el color de marca; al pasar el cursor o con el foco se llena y la
     flecha avanza. Decorativo: el enlace es toda la tarjeta. Solo color de fondo y `translate` (sin reflujo). */
  .v2-tc-flecha { display: grid; flex: none; place-items: center; width: 40px; height: 40px; border-radius: 999px; background: var(--color-coral-50); color: var(--color-coral-700); transition: background-color var(--t-rapido) var(--e-sale), color var(--t-rapido) var(--e-sale); }
  .v2-tc-flecha svg { transition: translate var(--t-rapido) var(--e-sale); }
  .v2-tc:is(:hover, :has(a:focus-visible)) .v2-tc-flecha { background: var(--color-coral-600); color: #fff; }
  @media (prefers-reduced-motion: no-preference) { .v2-tc:is(:hover, :has(a:focus-visible)) .v2-tc-flecha svg { translate: 3px 0; } }
  /* El resumen corto llega oculto (`hidden`) y esta regla, fuera de capas, le gana a la utilidad. */
  @container (width < 252px) { .v2-tc-r-largo { display: none; } .v2-tc-r-corto { display: inline; } }
  /* Ronda 5: desde 275 px y no 220, para que la flecha (ahora un botón de 40 px) quepa siempre junto al precio. */
  @container (width < 275px) {
    /* Cuatro columnas a 1024–1279 (opción «4» del panel) o un carril estrecho: «$ 600.30 MXN $ 1,200.60 MXN» no cabe
       en una línea legible. El tachado pasa a una línea pequeña encima, con su hueco reservado en todas las tarjetas,
       para que el precio de hoy quede a la misma altura en toda la fila. */
    .v2-tc-precio { min-height: 62px; align-items: flex-end; }
    .v2-tc-precio [data-tc-precio] { flex-wrap: wrap; }
    .v2-tc-normal { order: -1; flex-basis: 100%; line-height: 18px; }
  }
  @media (width < 640px) {
    [data-fila-movil] { display: grid; grid-template-columns: 112px minmax(0, 1fr); align-items: start; gap: 0 14px; padding: 14px 0; border-radius: 0; background: transparent; box-shadow: none; }
    /* (box-shadow: none quita el anillo ring-1, que es una sombra.) Sin sombra al pasar, placa, descripción, hueco de la nota ni flecha (toda la fila es el enlace; el precio de hoy y el
       tachado caben juntos sin la flecha). */
    [data-fila-movil]::after, [data-fila-movil] :is(.v2-tc-placa, .v2-tc-raya, .v2-tc-desc, .v2-tc-nota[data-sin-nota], .v2-tc-flecha) { display: none; }
    [data-fila-movil] .v2-tc-foto { border-radius: 12px; }
    [data-fila-movil] .v2-tc-cuerpo { padding: 0; }
    [data-fila-movil] .v2-tc-titulo { min-height: 0; }
    [data-fila-movil] .v2-tc-meta { margin-top: 4px; }
    [data-fila-movil] .v2-tc-precio { padding-top: 6px; min-height: 0; }
    /* MXN y CLP son más anchos («$1,191.32 MXN»): en la fila, hoy a 14 px y el normal a 12 px (ARS lleva decimales: «$ 96.862,00 ARS»), siempre juntos. */
    [data-fila-movil] [data-tc-precio] { font-size: 14px; column-gap: 4px; }
    [data-fila-movil] :is(.v2-tc-normal, .v2-tc-normal *) { font-size: 12px; }
  }
</style>
