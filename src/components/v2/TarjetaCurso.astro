---
/**
 * Tarjeta de curso V2: foto 4:3 con radio 16, categoría en placa, y debajo
 * título, descripción, nota real de Hotmart (si existe), duración y nivel, y
 * precio real. Al pasar el cursor la foto escala 1,03 y la tarjeta gana s2;
 * la tarjeta no se mueve.
 * Con `filaEnMovil`, por debajo de 640 px pasa a fila de listado: miniatura 4:3
 * de 112 px a la izquierda, sin placa ni descripción y sin marco (el separador
 * lo pone la lista).
 */
import { Image as OptimizedImage } from 'astro:assets';
import { env } from 'virtual:sably-runtime';
import { cmsImageUrl } from '@/lib/cms-media';
import type { Course } from '@/lib/emdash-content';
import { courseCover } from '@/lib/categories';
import { getCategory } from '@/lib/emdash-content';
import { localPrice, type Country } from '@/lib/countries';
import Precio from './Precio.astro';
import { readOperationalPrice, readOperationalRating } from '@/plugins/sably-operations/public';
import Icono from './Icono.astro';
import Estrellas from './Estrellas.astro';
import { notaHotmart } from '@/lib/opiniones';
interface Props { course: Course; country: Country; eager?: boolean; filaEnMovil?: boolean }
const { course, country, eager = false, filaEnMovil = false } = Astro.props;
const cat = (await getCategory(course.data.category))!;
const operationalDb = (env as unknown as { SABLY_DB: D1Database }).SABLY_DB;
const real = await readOperationalPrice(operationalDb, course.id, country, Astro.locals).catch(() => null);
const valoracion = await readOperationalRating(operationalDb, course.id, Astro.locals).catch(() => null);
const url = `/${country.code}/${course.id}/`;
const nota = notaHotmart(valoracion);
---
<article data-fila-movil={filaEnMovil || undefined} class="group relative flex h-full flex-col overflow-hidden rounded-c-lg bg-white ring-1 ring-navy-100 transition-shadow duration-(--t-lento) ease-(--e-sale) hover:shadow-s2 hover:ring-transparent">
  <div class="v2-tc-foto relative aspect-[4/3] overflow-hidden bg-navy-50">
    <OptimizedImage
      src={cmsImageUrl(course.cardImage) ?? cmsImageUrl(course.coverImage) ?? courseCover(course.id, cat.slug, 'card')}
      alt={course.data.title} width={480} height={360}
      sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
      loading={eager ? 'eager' : 'lazy'} decoding="async"
      class="h-full w-full object-cover transition-transform duration-(--t-lento) ease-(--e-sale) group-hover:scale-[1.03]" />
    <span class="v2-tc-placa absolute top-3 left-3 rounded-full bg-navy-950/85 px-3 py-1 text-t13 font-medium text-white">{cat.name}</span>
  </div>
  <div class="v2-tc-cuerpo flex flex-1 flex-col gap-2 p-5">
    <h3 class="text-t17 font-semibold text-navy-950"><a href={url} class="after:absolute after:inset-0 focus-visible:outline-none">{course.data.title}</a></h3>
    <p class="v2-tc-desc line-clamp-2 text-t15 text-navy-700">{course.data.shortDescription}</p>
    {nota && <p class="flex items-start gap-1 text-t13 text-navy-500"><Estrellas nota={valoracion!.rating} tamano={13} class="mt-0.5 flex-none" /><span><span class="font-semibold text-navy-950">{nota.cifra}</span> · {nota.texto}</span></p>}
    <p class="text-t13 text-navy-500">{course.data.durationHours} h · {course.data.level}</p>
    <p class="v2-tc-precio mt-auto flex items-center justify-between pt-3 text-t17 font-semibold text-navy-950">
      {real ? <Precio valor={real.monto} moneda={real.moneda} locale={country.hreflang} codigoClass="text-t13 font-medium" />
        : <Precio valor={localPrice(course.data.priceUSD, country)} moneda={country.currency} locale={country.hreflang} codigoClass="text-t13 font-medium" />}
      <Icono nombre="arrow-right" class="text-navy-950 transition-transform duration-(--t-rapido) group-hover:translate-x-[3px]" />
    </p>
  </div>
</article>
<style>
  article:has(a:focus-visible) { outline: 3px solid var(--color-coral-600); outline-offset: 3px; }
  @media (width < 640px) {
    article[data-fila-movil] { display: grid; grid-template-columns: 112px minmax(0, 1fr); align-items: start; gap: 0 14px; padding: 14px 0; overflow: visible; border-radius: 0; background: transparent; box-shadow: none; }
    article[data-fila-movil]:hover { box-shadow: none; }
    article[data-fila-movil] .v2-tc-foto { border-radius: 12px; }
    article[data-fila-movil] :is(.v2-tc-placa, .v2-tc-desc) { display: none; }
    article[data-fila-movil] .v2-tc-cuerpo { padding: 0; gap: 4px; }
    article[data-fila-movil] .v2-tc-precio { padding-top: 4px; }
  }
</style>
