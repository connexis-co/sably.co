---
import { getCountry } from '@/lib/countries';

interface Props {
  name: string;
  citySlug: string;
  countryCode: string;
  text: string;
  rating: number;
  courseTitle?: string;
}
const { name, citySlug, countryCode, text, rating, courseTitle } = Astro.props;
const country = getCountry(countryCode);
const city = country.cities.find((c) => c.slug === citySlug);
const initial = name.charAt(0).toUpperCase();
---

<figure class="flex h-full flex-col rounded-lg border border-surface-200 bg-white p-6">
  <span class="text-warning" aria-hidden="true">{'★'.repeat(Math.round(rating))}</span>
  <blockquote class="mt-3 flex-1 text-sm leading-relaxed text-body">"{text}"</blockquote>
  <figcaption class="mt-4 flex items-center gap-3">
    <span
      class="flex size-10 items-center justify-center rounded-full bg-primary font-display font-bold text-white"
      aria-hidden="true"
    >
      {initial}
    </span>
    <div>
      <p class="text-sm font-bold text-heading">{name}</p>
      <p class="text-xs text-muted">
        {city?.name ?? country.name}, {country.name} {country.flag}
        {courseTitle && <span class="block">{courseTitle}</span>}
      </p>
    </div>
  </figcaption>
</figure>
