---
/** Barra de progreso de lectura fija bajo el header. */
---

<div
  data-reading-progress
  class="fixed inset-x-0 top-16 z-40 h-1 origin-left scale-x-0 bg-accent transition-transform duration-75 ease-out"
  role="progressbar"
  aria-label="Progreso de lectura"
  aria-valuemin="0"
  aria-valuemax="100"
>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
  const article = document.querySelector('article');
  if (bar && article) {
    const update = () => {
      const start = article.offsetTop;
      const total = article.offsetHeight - window.innerHeight;
      const done = Math.min(1, Math.max(0, (window.scrollY - start) / Math.max(total, 1)));
      bar.style.transform = `scaleX(${done})`;
      bar.setAttribute('aria-valuenow', String(Math.round(done * 100)));
    };
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update, { passive: true });
  }
</script>
