---
interface Props {
  faqs: { q: string; a: string }[];
}
const { faqs } = Astro.props;
---

<div class="divide-y divide-surface-200 rounded-lg border border-surface-200">
  {
    faqs.map((faq) => (
      <details class="group p-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-heading">
          {faq.q}
          <span class="text-accent transition-transform group-open:rotate-45" aria-hidden="true">
            +
          </span>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-body">{faq.a}</p>
      </details>
    ))
  }
</div>
