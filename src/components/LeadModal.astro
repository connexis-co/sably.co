---
import { COUNTRIES, type Country } from '@/lib/countries';
import { CONSENTIMIENTO, POLITICA_URL } from '@/lib/consentimiento';

/**
 * Captura de lead.
 *
 * El dato se guarda SIEMPRE en D1 antes de cualquier bifurcación: perderlo por
 * abrir WhatsApp sería perder justo lo que se quería capturar. Solo después se
 * ramifica según el dispositivo — en un escritorio, mandar a WhatsApp obliga a
 * escanear un QR o a instalar la aplicación, así que ahí se confirma por
 * correo y se acabó.
 *
 * El texto de confirmación lo elige el servidor, que es el único que sabe si
 * de verdad salió un correo.
 */
interface Props {
  country: Country;
  courseTitle?: string;
  courseSlug?: string;
}
const { country, courseTitle = '', courseSlug = '' } = Astro.props;
---

<dialog
  id="lead-modal"
  class="m-auto w-[min(92vw,440px)] rounded-lg p-0 shadow-2xl backdrop:bg-ink/50 backdrop:backdrop-blur-sm"
>
  <form
    method="dialog"
    data-lead-form
    data-whatsapp={country.whatsapp}
    data-course={courseSlug}
    class="p-6"
  >
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-lg font-bold">Recibe más información</h2>
        <p class="mt-1 text-sm text-body">
          {courseTitle ? `Sobre "${courseTitle}"` : 'Sobre nuestros cursos'} — sin compromiso.
        </p>
      </div>
      <button type="button" data-lead-close class="rounded-full p-2 text-muted hover:bg-surface-100" aria-label="Cerrar">✕</button>
    </div>

    <div aria-hidden="true" style="position:absolute;left:-9999px;height:0;overflow:hidden">
      <label>Deja este campo vacío <input type="text" name="trampa" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="mt-5 space-y-3">
      <label class="block">
        <span class="mb-1 block text-xs font-semibold text-heading">Nombre</span>
        <input name="name" required autocomplete="name" class="w-full rounded-md border border-surface-300 px-3 py-2.5 text-sm" />
      </label>
      <label class="block">
        <span class="mb-1 block text-xs font-semibold text-heading">Email</span>
        <input name="email" type="email" required autocomplete="email" class="w-full rounded-md border border-surface-300 px-3 py-2.5 text-sm" />
      </label>
      <label class="block">
        <span class="mb-1 block text-xs font-semibold text-heading">WhatsApp (opcional)</span>
        <input name="whatsapp" type="tel" autocomplete="tel" class="w-full rounded-md border border-surface-300 px-3 py-2.5 text-sm" />
      </label>
      <label class="block">
        <span class="mb-1 block text-xs font-semibold text-heading">País</span>
        <select name="country" class="w-full rounded-md border border-surface-300 px-3 py-2.5 text-sm" data-lead-country>
          {COUNTRIES.map((c) => <option value={c.code} selected={c.code === country.code}>{c.flag} {c.name}</option>)}
        </select>
      </label>
    </div>

    <button
      type="submit"
      class="mt-5 w-full rounded-md bg-accent px-4 py-3 text-sm font-bold text-white transition hover:bg-accent-hover"
    >
      Quiero recibir información
    </button>
    <label class="mt-3 flex items-start gap-2 text-[11px] text-muted">
      <input type="checkbox" name="consent" required class="mt-0.5 shrink-0" />
      <span>
        <span data-consent-text>{CONSENTIMIENTO.lead}</span>{' '}
        <a href={POLITICA_URL} class="underline">Leer la política de privacidad</a>.
      </span>
    </label>
    <p data-lead-success class="mt-3 hidden rounded-md bg-success/10 p-3 text-center text-sm font-semibold text-success"></p>
    <p data-lead-error class="mt-3 hidden rounded-md bg-error/10 p-3 text-center text-sm font-semibold text-error"></p>
  </form>
</dialog>

<script>
  import { buildWhatsAppUrl } from '@/lib/hotmart';
  import { trackEvent } from '@/lib/analytics';

  const modal = document.getElementById('lead-modal') as HTMLDialogElement | null;
  const form = modal?.querySelector<HTMLFormElement>('[data-lead-form]');

  /**
   * Decide si continuar por WhatsApp.
   *
   * `pointer: coarse` sin `pointer: fine` es un dispositivo que solo se maneja
   * con el dedo: móvil o tableta, donde el enlace `wa.me` abre la aplicación.
   * Un portátil táctil declara ambos y cae del lado del escritorio, que es lo
   * correcto: ahí WhatsApp Web pide escanear un QR.
   */
  const esTactil = (): boolean =>
    matchMedia('(pointer: coarse)').matches && !matchMedia('(pointer: fine)').matches;

  if (modal && form) {
    const abiertoEn = { t: Date.now() };
    const exito = form.querySelector<HTMLElement>('[data-lead-success]');
    const fallo = form.querySelector<HTMLElement>('[data-lead-error]');
    const enviar = form.querySelector<HTMLButtonElement>('[type="submit"]');

    document.querySelectorAll('[data-lead-open]').forEach((btn) =>
      btn.addEventListener('click', () => {
        abiertoEn.t = Date.now();
        modal.showModal();
      }),
    );
    form.querySelector('[data-lead-close]')?.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      exito?.classList.add('hidden');
      fallo?.classList.add('hidden');

      const datos = new FormData(form);
      if (!datos.get('consent')) {
        if (fallo) {
          fallo.textContent = 'Necesitamos tu autorización para poder contactarte.';
          fallo.classList.remove('hidden');
        }
        return;
      }

      const nombre = String(datos.get('name') ?? '').trim();
      const correo = String(datos.get('email') ?? '').trim();
      const curso = form.dataset.course ?? '';
      const movil = esTactil();

      if (enviar) enviar.disabled = true;

      type Respuesta = { mensaje?: string; correo?: boolean };
      let respuesta: Respuesta | null = null;
      let guardado = false;
      try {
        const r = await fetch('/api/v1/leads', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            name: nombre,
            email: correo,
            phone: String(datos.get('whatsapp') ?? '') || undefined,
            course_interest: curso || undefined,
            source: `${location.pathname} · ${movil ? 'whatsapp' : 'correo'}`,
            consent_text: form.querySelector('[data-consent-text]')?.textContent?.trim(),
            trampa: String(datos.get('trampa') ?? ''),
            abierto_ms: Date.now() - abiertoEn.t,
          }),
          signal: AbortSignal.timeout(10000),
        });
        respuesta = (await r.json().catch(() => null)) as Respuesta | null;
        guardado = r.ok;
      } catch {
        /* se resuelve abajo: en móvil la conversación sigue igual */
      } finally {
        if (enviar) enviar.disabled = false;
      }

      trackEvent('submit_lead_form', {
        course_interest: curso,
        country: String(datos.get('country') ?? ''),
        source: location.pathname,
        canal: movil ? 'whatsapp' : 'correo',
      });

      const wa = form.dataset.whatsapp;
      if (movil && wa) {
        // En móvil la conversación es el objetivo, así que se abre aunque el
        // POST haya fallado: mejor un lead solo en WhatsApp que ninguno.
        const msg = `Hola Sably 👋 Soy ${nombre}. Quiero información${curso ? ` sobre "${curso}"` : ' sobre sus cursos'}. Mi correo: ${correo}`;
        window.open(buildWhatsAppUrl(wa, msg), '_blank', 'noopener');
        if (exito) {
          exito.textContent = 'Te abrimos WhatsApp para seguir por ahí.';
          exito.classList.remove('hidden');
        }
        setTimeout(() => modal.close(), 1800);
        return;
      }

      // Escritorio: nada de WhatsApp. El texto lo decide el servidor porque es
      // el único que sabe si salió un correo de verdad.
      if (guardado && exito) {
        exito.textContent = respuesta?.mensaje ?? 'Recibimos tus datos. Te contactamos por correo.';
        exito.classList.remove('hidden');
        form.querySelectorAll('input, select').forEach((el) => {
          if (el instanceof HTMLInputElement && el.type !== 'checkbox') el.value = '';
        });
        setTimeout(() => modal.close(), 3500);
      } else if (fallo) {
        fallo.textContent =
          'No pudimos enviar tu solicitud. Revisa tu conexión e inténtalo otra vez.';
        fallo.classList.remove('hidden');
      }
    });
  }
</script>
