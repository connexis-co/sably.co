---
import Base from '../layouts/Base.astro';
import FaqItem from '../components/FaqItem.astro';
import { SITE, GUARANTEE_DAYS } from '../data/site';
---

<Base
  title={`Contacto | ${SITE.name}`}
  description={`¿Tienes dudas sobre un curso o tu compra? Escríbenos a ${SITE.email} y el equipo de ${SITE.name} te ayudará lo antes posible.`}
>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Contacto</h1>
    <p class="mt-3 max-w-2xl text-slate-400">
      ¿Tienes preguntas sobre un curso, tu acceso o tu compra? Estamos para ayudarte.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-white/10 bg-panel p-7">
        <span class="text-3xl" aria-hidden="true">✉️</span>
        <h2 class="mt-3 text-lg font-bold text-white">Escríbenos</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-400">
          Respondemos consultas sobre cursos, accesos, certificados y el beneficio Black
          University®.
        </p>
        <a
          id="mail-cta"
          href={`mailto:${SITE.email}?subject=Consulta%20desde%20sably.co`}
          class="mt-5 inline-block rounded-xl bg-brand px-6 py-3 text-sm font-bold text-ink transition hover:bg-brand-strong"
        >
          {SITE.email}
        </a>
      </div>

      <div class="rounded-2xl border border-white/10 bg-panel p-7">
        <span class="text-3xl" aria-hidden="true">🛒</span>
        <h2 class="mt-3 text-lg font-bold text-white">Soporte de tu compra</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-400">
          Los pagos y accesos son gestionados por Hotmart. Si ya compraste, también puedes usar su
          centro de ayuda con el correo de tu compra para reenviar accesos o gestionar tu garantía
          de {GUARANTEE_DAYS} días.
        </p>
        <a
          href="https://hotmart.com/es/support"
          rel="noopener nofollow"
          target="_blank"
          class="mt-5 inline-block rounded-xl border border-white/15 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/5"
        >
          Centro de ayuda de Hotmart ↗
        </a>
      </div>
    </div>

    <div class="mt-12">
      <h2 class="text-xl font-extrabold text-white">Antes de escribir, quizá esto te sirva</h2>
      <div class="mt-4 space-y-3">
        <FaqItem question="No me llegó el correo con mis accesos">
          Revisa la carpeta de spam o promociones del correo con el que compraste. El remitente es
          Hotmart. Si no aparece, escríbenos indicando tu nombre y correo de compra y lo
          verificamos.
        </FaqItem>
        <FaqItem question="Quiero pedir un reembolso">
          Tienes {GUARANTEE_DAYS} días de garantía desde la compra. Puedes solicitarlo directamente
          desde el correo de compra de Hotmart o escribirnos para guiarte en el proceso. Consulta
          la <a href="/legal/reembolsos" class="text-brand underline-offset-4 hover:underline">política de reembolsos</a>.
        </FaqItem>
        <FaqItem question="Tengo dudas sobre qué curso elegir">
          Cuéntanos qué te gustaría aprender y cuál es tu experiencia actual, y te recomendamos el
          curso ideal para empezar.
        </FaqItem>
      </div>
    </div>
  </section>
</Base>

<script>
  // Si llegan desde el botón de un curso (?curso=slug), prellenamos el asunto del correo.
  const curso = new URLSearchParams(location.search).get('curso');
  const cta = document.getElementById('mail-cta') as HTMLAnchorElement | null;
  if (curso && cta) {
    const subject = encodeURIComponent(`Quiero inscribirme: ${curso.replaceAll('-', ' ')}`);
    cta.href = cta.href.split('?')[0] + `?subject=${subject}`;
  }
</script>
