---
import { getPage, getCountry } from '@/lib/emdash-content';
import { normalizePagePath } from '@/lib/page-path';
import { PageTemplate } from '@/themes';
export const prerender = false;
const [page,country]=await Promise.all([getPage('terminos'),getCountry('co')]);
if (!page || !country) return new Response('Página no encontrada',{status:404});
const canonicalPath=normalizePagePath(page.path);
if (!canonicalPath) return new Response('Ruta editorial inválida',{status:404});
if (canonicalPath!==normalizePagePath(Astro.url.pathname)) return Astro.redirect(canonicalPath,301);
Astro.locals.sablyContent=page.contentRef;
Astro.locals.sablySeo=page.seo;
---
<PageTemplate {page} {country} />
