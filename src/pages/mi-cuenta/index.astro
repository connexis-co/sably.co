---
/**
 * Mi cuenta · Inicio (diseño «B1», marco fhG4J): acceso a las compras en Hotmart, cursos guardados (si hay),
 * resumen de preferencias y ayuda. Sin datos de compras, avance ni opiniones: Sably no los enlaza a la cuenta.
 * Privada: `no-store`, `noindex`, sin marcos, fuera de los sitemaps.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { COUNTRIES, getCountry } from '@/lib/countries';
import { getCourses } from '@/lib/emdash-content';
import { buildWhatsAppUrl } from '@/lib/hotmart';
import { aplicarCabecerasPrivadas, cuentaActual, cuentaServidor, redirigir } from '@/lib/cuenta/http';
import { RUTAS, enlaceIngresar } from '@/lib/cuenta/nucleo';
import AreaPersonal from '@/components/cuenta/AreaPersonal.astro';
import Bandera from '@/components/v2/Bandera.astro';
import Ico from '@/themes/sably-v2/components/Ico.astro';
import '@/themes/sably-v2/estilos.css';

export const prerender = false;
aplicarCabecerasPrivadas(Astro.response.headers);
const servidor = await cuentaServidor(Astro);
if (!servidor) return new Response('Not found', { status: 404 }); // igual que hoy sin cuenta
const cuenta = await cuentaActual(Astro, servidor.almacen);
if (!cuenta) return redirigir(enlaceIngresar(RUTAS.cuenta));
const [prefs, guardados, formas] = await Promise.all([
  servidor.almacen.preferencias(cuenta.id), servidor.almacen.guardados(cuenta.id), servidor.almacen.formasDeAcceso(cuenta.id),
]);
const pais = prefs.pais && COUNTRIES.some(c => c.code === prefs.pais) ? getCountry(prefs.pais) : null;
const country = pais ?? getCountry('co');
const titulos = guardados.length ? new Map((await getCourses().catch(() => [])).map(c => [c.id, c.data.title])) : new Map<string, string>();
const cursos = guardados.map(item => item.slice('curso:'.length)).filter(slug => titulos.has(slug));
const accesos = [formas.google && 'Google', servidor.estado.correo && 'código por correo', formas.clave && 'contraseña'].filter(Boolean).join(', ').replace(/^./, c => c.toUpperCase());
const primerNombre = cuenta.nombre.trim().split(/\s+/)[0];
const ayuda = buildWhatsAppUrl(country.whatsapp, 'Hola, necesito ayuda con mi cuenta de Sably.');
---
<BaseLayout title="Mi cuenta | Sably" description="Tu cuenta de Sably: tus cursos, preferencias y sesión." {country} pathAfterCountry="/" pageType="cuenta" noindex temaV2>
  <AreaPersonal nombre={cuenta.nombre} email={cuenta.email} foto={cuenta.foto} activa="inicio">
    <div class="v2-contenedor cu-cuerpo cu-dos">
      <div class="cu-principal">
        <header>
          <h1 class="cu-h1">{primerNombre ? `Hola, ${primerNombre}` : 'Hola'}</h1>
          <p class="cu-bajada">Desde aquí llegas a tus compras y cambias tus ajustes.</p>
        </header>

        <section class="cu-seccion" aria-labelledby="cuenta-compras">
          <h2 id="cuenta-compras" class="cu-h2">Tus cursos</h2>
          <div class="cu-tarjeta cu-compras">
            <span class="cu-marca"><Ico nombre="graduation-cap" tamano={26} /></span>
            <div>
              <h3 class="cu-h3">Tus cursos comprados están en Hotmart</h3>
              <p class="cu-texto">Se pagan y se ven allí, con el correo que usaste al comprar.</p>
            </div>
            <a href="https://consumer.hotmart.com/" target="_blank" rel="noopener nofollow" class="v2-btn cu-btn-noche" data-alto="48">Ir a mis compras en Hotmart<Ico nombre="external-link" tamano={18} /><span class="sr-only"> (se abre en una pestaña nueva)</span></a>
          </div>
        </section>

        {cursos.length > 0 && (
          <section class="cu-seccion" aria-labelledby="cuenta-guardados">
            <h2 id="cuenta-guardados" class="cu-h2">Guardados</h2>
            <ul class="cu-guardados" role="list">
              {cursos.map(slug => <li><a href={`/${country.code}/${slug}/`}>{titulos.get(slug)}<Ico nombre="arrow-right" tamano={18} /></a></li>)}
            </ul>
          </section>
        )}

        <section class="cu-suave cu-explorar" aria-labelledby="cuenta-explorar">
          <div>
            <h2 id="cuenta-explorar" class="cu-h3">¿Qué quieres aprender ahora?</h2>
            <p class="cu-texto">Cursos y precios para {country.name}, en {country.currency}.</p>
          </div>
          <a href={`/${country.code}/cursos/`} class="v2-btn v2-btn-secundario" data-alto="48"><Bandera codigo={country.code} />Ver cursos en {country.name}</a>
        </section>
      </div>

      <div class="cu-lateral">
        <section class="cu-tarjeta" aria-labelledby="cuenta-resumen">
          <h2 id="cuenta-resumen" class="cu-h3">Tus preferencias</h2>
          <dl class="cu-filas">
            <div><dt>País y moneda</dt><dd>{pais ? <><Bandera codigo={pais.code} />{pais.name} · {pais.currency}</> : 'Automático'}</dd></div>
            <div><dt>Formas de acceso</dt><dd>{accesos || '—'}</dd></div>
          </dl>
          <a href={RUTAS.cuentaPreferencias} rel="nofollow" class="cu-enlace" data-no-prefetch>Cambiar preferencias</a>
        </section>
        <div class="cu-ayuda">
          <p>¿Necesitas ayuda con tu cuenta?</p>
          <a href={ayuda} target="_blank" rel="noopener nofollow" class="v2-btn v2-btn-secundario" data-alto="48"><img src="/v2/logos/whatsapp.svg" alt="" width="18" height="18" />Escríbenos por WhatsApp</a>
        </div>
      </div>
    </div>
  </AreaPersonal>
</BaseLayout>
