---
import Base from '../../layouts/Base.astro';
import FaqItem from '../../components/FaqItem.astro';
import CourseCard from '../../components/CourseCard.astro';
import { COURSES, formatCOP, buyUrl } from '../../data/courses';
import { SITE, BLACK_UNIVERSITY, GUARANTEE_DAYS } from '../../data/site';

export function getStaticPaths() {
  return COURSES.map((course) => ({ params: { slug: course.slug }, props: { course } }));
}

const { course } = Astro.props;
const discount = Math.round((1 - course.price / course.fullPrice) * 100);
const totalLessons = course.curriculum.reduce((acc, m) => acc + m.lessons, 0);
const related = COURSES.filter((c) => c.slug !== course.slug).slice(0, 4);
const checkout = buyUrl(course);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: course.title,
    description: course.excerpt,
    url: new URL(`/cursos/${course.slug}`, SITE.url).href,
    inLanguage: 'es',
    provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    offers: {
      '@type': 'Offer',
      price: course.price,
      priceCurrency: 'COP',
      availability: 'https://schema.org/InStock',
      url: new URL(`/cursos/${course.slug}`, SITE.url).href,
    },
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'online',
      courseWorkload: `PT${course.hours}H`,
    },
  },
];

const includes = [
  `${course.hours} horas de video bajo demanda`,
  `${course.curriculum.length} módulos · ${totalLessons} clases paso a paso`,
  'Acceso de por vida y actualizaciones',
  'Certificado digital al finalizar',
  `Membresía ${BLACK_UNIVERSITY.name} (+${BLACK_UNIVERSITY.coursesCount} cursos)`,
  `Garantía de reembolso de ${GUARANTEE_DAYS} días`,
];
---

<Base
  title={`${course.title} | ${SITE.name}`}
  description={course.excerpt}
  jsonLd={jsonLd}
>
  <!-- HERO DEL CURSO -->
  <section class="relative overflow-hidden border-b border-white/5">
    <div
      class="pointer-events-none absolute inset-0 opacity-30"
      style={`background: radial-gradient(60% 50% at 30% 0%, ${course.glow}22 0%, transparent 70%)`}
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <nav class="text-xs text-slate-500" aria-label="Ruta de navegación">
        <a href="/" class="hover:text-brand">Inicio</a>
        <span class="mx-1.5">/</span>
        <a href="/cursos" class="hover:text-brand">Cursos</a>
        <span class="mx-1.5">/</span>
        <span class="text-slate-300">{course.cardTitle}</span>
      </nav>

      <div class="mt-6 grid gap-10 lg:grid-cols-[1fr_24rem]">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-semibold text-slate-200">
            {course.emoji} {course.category}
          </span>
          <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-[2.6rem] lg:leading-[1.15]">
            {course.title}
          </h1>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-400 sm:text-lg">
            {course.excerpt}
          </p>

          <div class="mt-6 flex flex-wrap gap-2 text-xs font-semibold text-slate-300">
            {[
              `📶 ${course.level}`,
              `⏱️ ${course.hours} horas`,
              `📚 ${course.curriculum.length} módulos`,
              `🎬 ${totalLessons} clases`,
              '🎓 Certificado digital',
              '♾️ Acceso de por vida',
            ].map((chip) => (
              <span class="rounded-full border border-white/10 bg-panel px-3 py-1.5">{chip}</span>
            ))}
          </div>

          <div class="mt-10">
            <h2 class="text-xl font-extrabold text-white">Sobre este curso</h2>
            <p class="mt-3 max-w-2xl leading-relaxed text-slate-400">{course.description}</p>
          </div>

          <div class="mt-10">
            <h2 class="text-xl font-extrabold text-white">¿Qué vas a aprender?</h2>
            <ul class="mt-4 grid gap-3 sm:grid-cols-2">
              {course.learn.map((item) => (
                <li class="flex items-start gap-3 rounded-xl border border-white/10 bg-panel px-4 py-3 text-sm text-slate-300">
                  <svg class="mt-0.5 shrink-0 text-brand" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-10">
            <h2 class="text-xl font-extrabold text-white">Temario del curso</h2>
            <p class="mt-1 text-sm text-slate-500">
              {course.curriculum.length} módulos · {totalLessons} clases · {course.hours} horas
            </p>
            <div class="mt-4 space-y-2.5">
              {course.curriculum.map((mod, i) => (
                <div class="flex items-center justify-between gap-4 rounded-xl border border-white/10 bg-panel px-4 py-3.5">
                  <div class="flex items-center gap-3">
                    <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-white/5 text-xs font-bold text-brand">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <h3 class="text-sm font-semibold text-white">{mod.title}</h3>
                  </div>
                  <span class="shrink-0 text-xs text-slate-500">{mod.lessons} clases</span>
                </div>
              ))}
            </div>
          </div>

          <div class="mt-10">
            <h2 class="text-xl font-extrabold text-white">¿Para quién es este curso?</h2>
            <ul class="mt-4 space-y-3">
              {course.audience.map((item) => (
                <li class="flex items-start gap-3 text-sm text-slate-400">
                  <span class="mt-1 size-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-10 rounded-2xl border border-gold/25 bg-gradient-to-br from-[#141414] to-[#1a1503] p-6">
            <h2 class="flex items-center gap-2 text-lg font-extrabold text-white">
              🖤 Incluye la membresía {BLACK_UNIVERSITY.name}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">
              Al comprar este curso activas el acceso a {BLACK_UNIVERSITY.name} (antes {BLACK_UNIVERSITY.formerName}):
              más de {BLACK_UNIVERSITY.coursesCount} cursos, talleres y seminarios para seguir formándote en lo que
              quieras. <a href="/black-university" class="font-semibold text-gold-soft underline-offset-4 hover:underline">Conoce el beneficio →</a>
            </p>
          </div>
        </div>

        <!-- TARJETA DE COMPRA -->
        <aside class="lg:-mt-2">
          <div class="lg:sticky lg:top-24 rounded-2xl border border-white/10 bg-panel p-6 shadow-2xl shadow-black/40">
            <div class:list={['relative grid aspect-[16/9] place-items-center overflow-hidden rounded-xl bg-gradient-to-br', course.gradient]}>
              <div
                class="absolute inset-0 opacity-50"
                style={`background: radial-gradient(circle at 50% 60%, ${course.glow}33 0%, transparent 65%)`}
                aria-hidden="true"
              >
              </div>
              <span class="relative text-6xl drop-shadow-lg" aria-hidden="true">{course.emoji}</span>
            </div>

            <div class="mt-5 flex items-baseline gap-3">
              <span class="text-3xl font-extrabold text-white">{formatCOP(course.price)}</span>
              <span class="text-slate-500 line-through">{formatCOP(course.fullPrice)}</span>
            </div>
            <p class="mt-1 inline-block rounded-full bg-brand/15 px-2.5 py-1 text-xs font-bold text-brand">
              {discount}% de descuento hoy
            </p>

            <a
              href={checkout}
              {...(course.hotmartUrl ? { rel: 'nofollow sponsored' } : {})}
              class="mt-5 block rounded-xl bg-brand px-6 py-4 text-center text-base font-bold text-ink shadow-lg shadow-brand/20 transition hover:bg-brand-strong"
            >
              Inscribirme ahora
            </a>
            <p class="mt-3 text-center text-xs text-slate-500">
              Pago seguro procesado por Hotmart · Garantía de {GUARANTEE_DAYS} días
            </p>

            <ul class="mt-6 space-y-3 border-t border-white/10 pt-5 text-sm text-slate-300">
              {includes.map((item) => (
                <li class="flex items-start gap-3">
                  <svg class="mt-0.5 shrink-0 text-brand" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- FAQ DE COMPRA -->
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
    <h2 class="text-center text-2xl font-extrabold tracking-tight text-white">
      Preguntas sobre tu compra
    </h2>
    <div class="mt-6 space-y-3">
      <FaqItem question="¿Cuándo empiezo?">
        De inmediato. Al confirmarse el pago en Hotmart recibes tus accesos por correo y puedes
        empezar a ver las clases al instante, a tu ritmo.
      </FaqItem>
      <FaqItem question="¿Necesito experiencia previa?">
        No. Este programa está diseñado {course.level.toLowerCase() === 'desde cero' ? 'desde cero' : 'para tu nivel'}:
        empieza por los fundamentos y avanza módulo a módulo hasta las técnicas profesionales.
      </FaqItem>
      <FaqItem question="¿Qué pasa si no me gusta el curso?">
        Tienes {GUARANTEE_DAYS} días de garantía. Solicita el reembolso directamente en Hotmart y te
        devuelven el 100% del pago, sin preguntas. Más detalles en
        la <a href="/legal/reembolsos" class="text-brand underline-offset-4 hover:underline">política de reembolsos</a>.
      </FaqItem>
    </div>
  </section>

  <!-- RELACIONADOS -->
  <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-extrabold tracking-tight text-white">También te puede interesar</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {related.map((c) => <CourseCard course={c} />)}
    </div>
  </section>
</Base>
