---
/**
 * /ingresar/: entrar o crear la cuenta con Google (un solo botón; la primera vez crea la cuenta).
 * Privada: `no-store`, `noindex`, sin marcos y fuera de los sitemaps. `?volver=` vuelve a la página
 * de origen (lista blanca de `destinoSeguro`); `?aviso=` explica lo que pasó.
 * Con la cabecera `X-Account-Form: 1` devuelve solo el formulario, para la ventana emergente
 * (`DialogoCuenta.astro`); sin ella, la página completa. Las dos formas de entrar usan el mismo formulario.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCountry } from '@/lib/countries';
import { aplicarCabecerasPrivadas, cookieFlujo, cuentaActual, cuentaServidor, tokenCsrf, redirigir } from '@/lib/cuenta/http';
import { AVISOS, RUTAS, ahora, destinoSeguro, modoValido } from '@/lib/cuenta/nucleo';
import FormularioAcceso from '@/components/cuenta/FormularioAcceso.astro';
import Ico from '@/themes/sably-v2/components/Ico.astro';
import { FOTOS, srcsetFoto } from '@/themes/sably-v2/fotos';
import css from '@/components/cuenta/acceso.css?raw';
import '@/themes/sably-v2/estilos.css';

export const prerender = false;
aplicarCabecerasPrivadas(Astro.response.headers);
Astro.response.headers.set('Vary', 'X-Account-Form');
const servidor = await cuentaServidor(Astro);
if (!servidor) return new Response('Not found', { status: 404 }); // igual que hoy sin cuenta
const volver = destinoSeguro(Astro.url.searchParams.get('volver'));
if (await cuentaActual(Astro, servidor.almacen)) {
  // Código mal escrito al crear la contraseña desde Preferencias (ya con sesión): vuelve a su casilla con el aviso.
  const fallo = Astro.url.searchParams.get('aviso');
  return redirigir(volver === RUTAS.cuentaPreferencias && fallo?.startsWith('codigo-') ? `${volver}?paso=codigo&aviso=${encodeURIComponent(fallo)}#cuenta-clave` : volver);
}
const csrf = tokenCsrf(Astro, servidor.secreto);
// El correo se ofrece solo si el proveedor está listo (Ajustes → Correo con su clave).
const correo = !!(await servidor.correo());
let codigoAviso = Astro.url.searchParams.get('aviso') ?? '';
const codigo = Astro.url.searchParams.get('paso') === 'codigo' && servidor.estado.correo
  ? await servidor.almacen.codigoPendiente(cookieFlujo(Astro), ahora()) : null;
if (Astro.url.searchParams.get('paso') === 'codigo' && !codigo && !codigoAviso) codigoAviso = 'codigo-caducado';
const google = !!servidor.google;
// Contraseña: solo con el correo listo (el alta y «olvidé mi contraseña» van por código).
const clave = servidor.estado.clave && correo;
const modo = modoValido(Astro.url.searchParams.get('modo'));
if (!google && !correo && !codigo && !codigoAviso) codigoAviso = 'sin-acceso';
const aviso = Object.hasOwn(AVISOS, codigoAviso) ? AVISOS[codigoAviso] : null;
const tono = ['salida', 'borrada', 'guardado', 'reenviado', 'clave-cambiada'].includes(codigoAviso) ? 'info' : 'alerta';
const fragmento = Astro.request.headers.get('x-account-form') === '1';
const country = getCountry('co');
// Solo lo que la cuenta hace hoy (el diseño A2 lista además guardar, compras y opiniones, que aún no existen).
const entradas = [google && 'con Google', correo && 'con un código a tu correo', clave && 'con contraseña'].filter(Boolean) as string[];
const ventajas = [
  entradas.length && `Entras ${new Intl.ListFormat('es', { type: 'disjunction' }).format(entradas)}`,
  'Tu país y tu moneda quedan guardados en tu cuenta',
  'Cierras la sesión en todos tus dispositivos cuando quieras',
  'Eliminas la cuenta y sus datos cuando quieras',
].filter(Boolean);
const foto = 'foto-estudiar-celular-2';
const dimensiones = FOTOS[foto];
---
{fragmento ? <FormularioAcceso {csrf} {volver} {aviso} {tono} {google} {correo} {clave} {modo} {codigo} titulo="ventana" /> : (
  <BaseLayout title="Entrar | Sably" description="Entra en tu cuenta de Sably o créala con Google o con un código en tu correo." {country} pathAfterCountry="/" pageType="cuenta" noindex temaV2>
    <style is:inline set:html={css}></style>
    <section class="v2-contenedor ac-pagina">
      <div class="ac-formulario">
        {volver !== RUTAS.cuenta && <a href={volver} class="ac-volver"><Ico nombre="arrow-left" tamano={18} />Volver a la página anterior</a>}
        <FormularioAcceso {csrf} {volver} {aviso} {tono} {google} {correo} {clave} {modo} {codigo} titulo="pagina" />
      </div>
      <div class="ac-lado">
        {/* Solo escritorio: en móvil las fuentes no aplican y no se descarga nada. */}
        <picture>
          <source media="(width >= 1024px)" type="image/avif" srcset={srcsetFoto(foto, 'avif')} sizes="(width >= 1280px) 624px, 50vw" />
          <source media="(width >= 1024px)" type="image/webp" srcset={srcsetFoto(foto, 'webp')} sizes="(width >= 1280px) 624px, 50vw" />
          <img src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" alt="" width={dimensiones.ancho} height={dimensiones.alto} fetchpriority="high" />
        </picture>
        <section class="ac-panel" aria-labelledby="cuenta-ventajas">
          <h2 id="cuenta-ventajas">Con tu cuenta</h2>
          <ul role="list">
            {ventajas.map(v => <li><Ico nombre="check" tamano={16} /><span>{v}</span></li>)}
          </ul>
        </section>
      </div>
    </section>
    <script is:inline>
      // El país que eligió en el selector de la cabecera siembra las preferencias de una cuenta nueva.
      try { const p = localStorage.getItem('sably:country'); if (p && /^[a-z]{2}$/.test(p)) document.querySelectorAll('[data-cuenta-pais]').forEach(c => { c.value = p; }); } catch {}
      document.querySelector('#cuenta-codigo, #cuenta-correo')?.focus();
    </script>
  </BaseLayout>
)}
