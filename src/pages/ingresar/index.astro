---
/**
 * /ingresar/: entrar o crear la cuenta con Google (un solo botón; la primera vez crea la cuenta).
 * Privada: `no-store`, `noindex`, sin marcos y fuera de los sitemaps. `?volver=` vuelve a la página
 * de origen (lista blanca de `destinoSeguro`); `?aviso=` explica lo que pasó.
 * Con la cabecera `X-Account-Form: 1` devuelve solo el formulario, para la ventana emergente
 * (`DialogoCuenta.astro`); sin ella, la página completa. Las dos formas de entrar usan el mismo formulario.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCountry } from '@/lib/countries';
import { aplicarCabecerasPrivadas, cookieFlujo, cuentaActual, cuentaServidor, tokenCsrf, redirigir } from '@/lib/cuenta/http';
import { AVISOS, ahora, destinoSeguro } from '@/lib/cuenta/nucleo';
import FormularioAcceso from '@/components/cuenta/FormularioAcceso.astro';
import '@/themes/sably-v2/estilos.css';

export const prerender = false;
aplicarCabecerasPrivadas(Astro.response.headers);
Astro.response.headers.set('Vary', 'X-Account-Form');
const servidor = await cuentaServidor(Astro);
if (!servidor) return new Response('Not found', { status: 404 }); // igual que hoy sin cuenta
const volver = destinoSeguro(Astro.url.searchParams.get('volver'));
if (await cuentaActual(Astro, servidor.almacen)) return redirigir(volver);
const csrf = tokenCsrf(Astro, servidor.secreto);
// El correo se ofrece solo si el proveedor está listo (Ajustes → Correo con su clave).
const correo = !!(await servidor.correo());
let codigoAviso = Astro.url.searchParams.get('aviso') ?? '';
const codigo = Astro.url.searchParams.get('paso') === 'codigo' && servidor.estado.correo
  ? await servidor.almacen.codigoPendiente(cookieFlujo(Astro), ahora()) : null;
if (Astro.url.searchParams.get('paso') === 'codigo' && !codigo && !codigoAviso) codigoAviso = 'codigo-caducado';
const google = !!servidor.google;
if (!google && !correo && !codigo && !codigoAviso) codigoAviso = 'sin-acceso';
const aviso = Object.hasOwn(AVISOS, codigoAviso) ? AVISOS[codigoAviso] : null;
const tono = ['salida', 'borrada', 'guardado', 'reenviado'].includes(codigoAviso) ? 'info' : 'alerta';
const fragmento = Astro.request.headers.get('x-account-form') === '1';
const country = getCountry('co');
---
{fragmento ? <FormularioAcceso {csrf} {volver} {aviso} {tono} {google} {correo} {codigo} titulo="ventana" /> : (
  <BaseLayout title="Entrar | Sably" description="Entra en tu cuenta de Sably o créala con Google o con un código en tu correo." {country} pathAfterCountry="/" pageType="cuenta" noindex temaV2>
    <section class="v2-contenedor flex justify-center py-10 lg:py-20">
      <div class="w-full max-w-[440px] lg:rounded-c-xl lg:bg-white lg:p-10 lg:shadow-s2">
        <FormularioAcceso {csrf} {volver} {aviso} {tono} {google} {correo} {codigo} titulo="pagina" />
      </div>
    </section>
    <script is:inline>
      // El país que eligió en el selector de la cabecera siembra las preferencias de una cuenta nueva.
      try { const p = localStorage.getItem('sably:country'); if (p && /^[a-z]{2}$/.test(p)) document.querySelectorAll('[data-cuenta-pais]').forEach(c => { c.value = p; }); } catch {}
      document.querySelector('#cuenta-codigo, #cuenta-correo')?.focus();
    </script>
  </BaseLayout>
)}
