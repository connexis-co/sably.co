---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCountry, DEFAULT_COUNTRY } from '@/lib/countries';
import { blogCover, readingTime, blogFacets } from '@/lib/blog';
import { breadcrumbSchema } from '@/lib/seo';
import { SITE } from '@/lib/site';

const country = getCountry(DEFAULT_COUNTRY);
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const facets = blogFacets(posts);
const [featured, ...rest] = posts;

const title = 'Blog de Sably | Guías para aprender oficios y emprender';
const description =
  'Guías prácticas, tendencias y consejos para aprender un oficio rentable y emprender en Latinoamérica.';

const schemas = [
  breadcrumbSchema([
    { name: 'Inicio', url: `${SITE.url}/co/` },
    { name: 'Blog', url: `${SITE.url}/blog/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${SITE.url}/blog/#blog`,
    name: title,
    description,
    url: `${SITE.url}/blog/`,
    inLanguage: 'es',
    publisher: { '@id': `${SITE.url}/#organization` },
    // Los artículos van como referencias, no como copias del Article completo:
    // la ficha entera vive en cada post y duplicarla aquí solo crea dos
    // entidades para la misma URL.
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      url: `${SITE.url}/blog/${post.id}/`,
      datePublished: post.data.publishedAt.toISOString(),
      image: `${SITE.url}${blogCover(post.data.category, 'card')}`,
      author: { '@id': `${SITE.url}/#organization` },
    })),
  },
];
---

<BaseLayout {title} {description} {country} pathAfterCountry="/" {schemas} pageType="blog">
  <section class="bg-primary py-12 sm:py-14">
    <div class="container-site">
      <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Blog de Sably</h1>
      <p class="mt-3 max-w-2xl text-white/80">{description}</p>
    </div>
  </section>

  <!-- Buscador + filtros -->
  <section class="sticky top-16 z-30 border-b border-surface-200 bg-white/95 backdrop-blur" aria-label="Buscar y filtrar artículos">
    <div class="container-site flex flex-col gap-3 py-4 lg:flex-row lg:items-center lg:justify-between">
      <label class="flex w-full items-center gap-2.5 rounded-lg border border-surface-200 px-3.5 py-2.5 focus-within:border-accent lg:max-w-sm">
        <svg class="size-4 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="sr-only">Buscar artículos</span>
        <input
          type="search"
          data-blog-search
          placeholder="Buscar en el blog…"
          autocomplete="off"
          class="w-full bg-transparent text-sm outline-none placeholder:text-muted"
        />
      </label>

      <div class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 lg:mx-0 lg:flex-wrap lg:px-0 lg:pb-0" role="group" aria-label="Filtrar por categoría">
        <button
          type="button"
          data-blog-filter="all"
          data-active="true"
          class="shrink-0 rounded-full border border-surface-200 px-4 py-1.5 text-sm font-medium text-heading transition data-[active]:border-accent data-[active]:bg-accent data-[active]:text-white"
        >
          Todos ({posts.length})
        </button>
        {
          facets.map((f) => (
            <button
              type="button"
              data-blog-filter={f.name}
              class="shrink-0 rounded-full border border-surface-200 px-4 py-1.5 text-sm font-medium text-heading transition hover:border-accent data-[active]:border-accent data-[active]:bg-accent data-[active]:text-white"
            >
              {f.name} ({f.count})
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-site py-10 sm:py-14">
    {
      posts.length === 0 ? (
        <p class="text-center text-lg text-body">Muy pronto publicaremos nuestras primeras guías.</p>
      ) : (
        <>
          {featured && (
            <a
              href={`/blog/${featured.id}/`}
              data-blog-card
              data-category={featured.data.category ?? 'Guía'}
              data-search={`${featured.data.title} ${featured.data.description} ${(featured.data.keywords ?? []).join(' ')}`.toLowerCase()}
              class="group mb-10 grid overflow-hidden rounded-xl border border-surface-200 transition hover:shadow-xl lg:grid-cols-2"
            >
              <div class="h-56 overflow-hidden sm:h-64 lg:h-auto">
                <img
                  src={blogCover(featured.data.category, 'hero')}
                  alt=""
                  width="800"
                  height="533"
                  fetchpriority="high"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <div class="flex flex-col justify-center p-6 sm:p-8">
                <p class="text-xs font-bold tracking-wide text-accent uppercase">
                  {featured.data.category ?? 'Guía'} · Destacado
                </p>
                <h2 class="mt-3 font-display text-2xl font-bold text-primary group-hover:text-accent sm:text-3xl">
                  {featured.data.title}
                </h2>
                <p class="mt-3 line-clamp-3 text-body">{featured.data.description}</p>
                <p class="mt-4 text-sm text-muted">
                  {featured.data.publishedAt.toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' })}
                  · {readingTime(featured.body ?? '')} min de lectura
                </p>
              </div>
            </a>
          )}

          <div data-blog-grid class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {rest.map((post) => (
              <a
                href={`/blog/${post.id}/`}
                data-blog-card
                data-category={post.data.category ?? 'Guía'}
                data-search={`${post.data.title} ${post.data.description} ${(post.data.keywords ?? []).join(' ')}`.toLowerCase()}
                class="group flex flex-col overflow-hidden rounded-xl border border-surface-200 transition hover:-translate-y-0.5 hover:shadow-lg"
              >
                <div class="h-44 overflow-hidden">
                  <img
                    src={blogCover(post.data.category, 'card')}
                    alt=""
                    width="480"
                    height="320"
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                <div class="flex flex-1 flex-col p-5 sm:p-6">
                  <p class="text-xs font-bold tracking-wide text-accent uppercase">{post.data.category ?? 'Guía'}</p>
                  <h2 class="mt-2 font-display text-lg font-bold text-primary group-hover:text-accent">
                    {post.data.title}
                  </h2>
                  <p class="mt-2 line-clamp-3 text-sm text-body">{post.data.description}</p>
                  <p class="mt-auto pt-4 text-xs text-muted">
                    {post.data.publishedAt.toLocaleDateString('es-CO', { day: 'numeric', month: 'short', year: 'numeric' })}
                    · {readingTime(post.body ?? '')} min
                  </p>
                </div>
              </a>
            ))}
          </div>

          <p data-blog-empty class="hidden py-12 text-center text-body">
            No encontramos artículos con esa búsqueda. Prueba con otra palabra.
          </p>
        </>
      )
    }
  </section>
</BaseLayout>

<script>
  import { trackEvent } from '@/lib/analytics';

  const search = document.querySelector<HTMLInputElement>('[data-blog-search]');
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-blog-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-blog-card]')];
  const empty = document.querySelector<HTMLElement>('[data-blog-empty]');

  if (cards.length) {
    const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    let categoria = 'all';

    const apply = () => {
      const q = norm(search?.value.trim() ?? '');
      let visibles = 0;
      for (const card of cards) {
        const okCat = categoria === 'all' || card.dataset.category === categoria;
        const okQ = q.length < 2 || norm(card.dataset.search ?? '').includes(q);
        const show = okCat && okQ;
        card.classList.toggle('hidden', !show);
        if (show) visibles += 1;
      }
      empty?.classList.toggle('hidden', visibles > 0);
    };

    let timer: ReturnType<typeof setTimeout>;
    search?.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        apply();
        const q = search.value.trim();
        if (q.length >= 2) trackEvent('blog_search', { query: q });
      }, 160);
    });

    filters.forEach((btn) =>
      btn.addEventListener('click', () => {
        categoria = btn.dataset.blogFilter!;
        filters.forEach((b) => {
          if (b === btn) b.dataset.active = 'true';
          else delete b.dataset.active;
        });
        apply();
        trackEvent('blog_filter', { category: categoria });
      }),
    );
  }
</script>
