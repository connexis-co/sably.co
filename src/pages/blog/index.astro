---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCountry, DEFAULT_COUNTRY } from '@/lib/countries';
import { blogCover, readingTime } from '@/lib/blog';

const country = getCountry(DEFAULT_COUNTRY);
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const [featured, ...rest] = posts;

const title = 'Blog de Sably | Guías para aprender oficios y emprender';
const description =
  'Guías prácticas, tendencias y consejos para aprender un oficio rentable y emprender en Latinoamérica.';
---

<BaseLayout {title} {description} {country} pathAfterCountry="/" pageType="blog">
  <section class="bg-primary py-14">
    <div class="container-site">
      <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Blog de Sably</h1>
      <p class="mt-3 max-w-2xl text-white/80">{description}</p>
    </div>
  </section>

  <section class="container-site py-14">
    {
      posts.length === 0 ? (
        <p class="text-center text-lg text-body">Muy pronto publicaremos nuestras primeras guías.</p>
      ) : (
        <>
          {featured && (
            <a
              href={`/blog/${featured.id}/`}
              class="group mb-10 grid overflow-hidden rounded-lg border border-surface-200 transition hover:shadow-xl lg:grid-cols-2"
            >
              <div class="h-64 overflow-hidden lg:h-auto">
                <img
                  src={blogCover(featured.data.category, 'hero')}
                  alt=""
                  width="800"
                  height="533"
                  fetchpriority="high"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <div class="flex flex-col justify-center p-8">
                <p class="text-xs font-bold tracking-wide text-accent uppercase">
                  {featured.data.category ?? 'Guía'} · Destacado
                </p>
                <h2 class="mt-3 font-display text-2xl font-bold text-primary group-hover:text-accent sm:text-3xl">
                  {featured.data.title}
                </h2>
                <p class="mt-3 line-clamp-3 text-body">{featured.data.description}</p>
                <p class="mt-4 text-sm text-muted">
                  {featured.data.publishedAt.toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' })}
                  · {readingTime(featured.body ?? '')} min de lectura
                </p>
              </div>
            </a>
          )}
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {rest.map((post) => (
              <a
                href={`/blog/${post.id}/`}
                class="group flex flex-col overflow-hidden rounded-lg border border-surface-200 transition hover:-translate-y-0.5 hover:shadow-lg"
              >
                <div class="h-44 overflow-hidden">
                  <img
                    src={blogCover(post.data.category, 'card')}
                    alt=""
                    width="480"
                    height="320"
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <p class="text-xs font-bold tracking-wide text-accent uppercase">{post.data.category ?? 'Guía'}</p>
                  <h2 class="mt-2 font-display text-lg font-bold text-primary group-hover:text-accent">
                    {post.data.title}
                  </h2>
                  <p class="mt-2 line-clamp-3 text-sm text-body">{post.data.description}</p>
                  <p class="mt-auto pt-4 text-xs text-muted">
                    {post.data.publishedAt.toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' })}
                    · {readingTime(post.body ?? '')} min
                  </p>
                </div>
              </a>
            ))}
          </div>
        </>
      )
    }
  </section>
</BaseLayout>
