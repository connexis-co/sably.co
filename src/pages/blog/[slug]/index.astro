---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCountry, DEFAULT_COUNTRY } from '@/lib/countries';
import { breadcrumbSchema } from '@/lib/seo';
import { SITE } from '@/lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const country = getCountry(DEFAULT_COUNTRY);
const { Content } = await render(post);

const schemas = [
  breadcrumbSchema([
    { name: 'Inicio', url: `${SITE.url}/co/` },
    { name: 'Blog', url: `${SITE.url}/blog/` },
    { name: post.data.title, url: `${SITE.url}/blog/${post.id}/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishedAt.toISOString(),
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
];
---

<BaseLayout
  title={`${post.data.title} | Blog Sably`}
  description={post.data.description}
  {country}
  pathAfterCountry="/"
  {schemas}
  pageType="article"
>
  <article class="container-site max-w-3xl py-14">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <a href="/co/" class="hover:text-accent">Inicio</a> <span aria-hidden="true">›</span>
      <a href="/blog/" class="hover:text-accent">Blog</a>
    </nav>
    <p class="mt-6 text-xs font-bold tracking-wide text-accent uppercase">{post.data.category ?? 'Guía'}</p>
    <h1 class="mt-2 text-3xl leading-tight font-extrabold sm:text-4xl">{post.data.title}</h1>
    <p class="mt-3 text-sm text-muted">
      {post.data.publishedAt.toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' })}
    </p>
    <div
      class="mt-8 space-y-5 text-[15px] leading-relaxed text-body [&_a]:text-accent [&_a]:underline [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-primary [&_h3]:mt-6 [&_h3]:text-lg [&_h3]:font-bold [&_h3]:text-primary [&_li]:ml-5 [&_li]:list-disc [&_strong]:text-heading"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
