---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCountry, DEFAULT_COUNTRY } from '@/lib/countries';
import { breadcrumbSchema } from '@/lib/seo';
import { blogCover, readingTime } from '@/lib/blog';
import { SITE } from '@/lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const country = getCountry(DEFAULT_COUNTRY);
const { Content } = await render(post);

const related = (await getCollection('blog'))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => Number(b.data.category === post.data.category) - Number(a.data.category === post.data.category))
  .slice(0, 3);

const minutes = readingTime(post.body ?? '');

const schemas = [
  breadcrumbSchema([
    { name: 'Inicio', url: `${SITE.url}/co/` },
    { name: 'Blog', url: `${SITE.url}/blog/` },
    { name: post.data.title, url: `${SITE.url}/blog/${post.id}/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: post.data.description,
    image: `${SITE.url}${blogCover(post.data.category, 'hero')}`,
    datePublished: post.data.publishedAt.toISOString(),
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
];
---

<BaseLayout
  title={`${post.data.title} | Blog Sably`}
  description={post.data.description}
  {country}
  pathAfterCountry="/"
  {schemas}
  pageType="article"
>
  <!-- Hero del artículo -->
  <section class="relative overflow-hidden py-20">
    <img
      src={blogCover(post.data.category, 'hero')}
      alt=""
      width="800"
      height="533"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-primary/80" aria-hidden="true"></div>
    <div class="container-site relative max-w-3xl">
      <nav aria-label="Breadcrumb" class="text-sm text-white/60">
        <a href="/co/" class="hover:text-white">Inicio</a> <span aria-hidden="true">›</span>
        <a href="/blog/" class="hover:text-white">Blog</a>
      </nav>
      <p class="mt-5 text-xs font-bold tracking-wide text-accent uppercase">{post.data.category ?? 'Guía'}</p>
      <h1 class="mt-3 text-3xl leading-tight font-extrabold text-white sm:text-4xl">{post.data.title}</h1>
      <p class="mt-4 text-sm text-white/70">
        Por el equipo Sably ·
        {post.data.publishedAt.toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' })}
        · {minutes} min de lectura
      </p>
    </div>
  </section>

  <article class="container-site max-w-3xl py-14">
    <p class="mb-8 rounded-lg bg-off-white p-5 text-[15px] leading-relaxed text-heading">{post.data.description}</p>
    <div
      class="space-y-5 text-[15px] leading-relaxed text-body [&_a]:text-accent [&_a]:underline [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-primary [&_h3]:mt-6 [&_h3]:text-lg [&_h3]:font-bold [&_h3]:text-primary [&_li]:ml-5 [&_li]:list-disc [&_strong]:text-heading"
    >
      <Content />
    </div>

    <!-- CTA -->
    <aside class="mt-12 rounded-lg bg-primary p-8 text-center">
      <h2 class="text-2xl font-extrabold text-white">¿Listo para aprender un oficio de verdad?</h2>
      <p class="mx-auto mt-2 max-w-md text-white/80">
        Cursos online con certificado, acceso de por vida y 40% OFF con el cupón SABLY40.
      </p>
      <a
        href={`/${country.code}/cursos/`}
        class="animate-pulse-soft mt-6 inline-block rounded-md bg-accent px-7 py-3.5 font-bold text-white transition hover:bg-accent-hover"
      >
        Explorar cursos
      </a>
    </aside>
  </article>

  <!-- Relacionados -->
  {
    related.length > 0 && (
      <section class="bg-off-white py-14">
        <div class="container-site">
          <h2 class="text-2xl font-bold">Sigue leyendo</h2>
          <div class="mt-6 grid gap-6 md:grid-cols-3">
            {related.map((p) => (
              <a
                href={`/blog/${p.id}/`}
                class="group flex flex-col overflow-hidden rounded-lg border border-surface-200 bg-white transition hover:-translate-y-0.5 hover:shadow-lg"
              >
                <div class="h-36 overflow-hidden">
                  <img
                    src={blogCover(p.data.category, 'card')}
                    alt=""
                    width="480"
                    height="320"
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                <div class="p-5">
                  <p class="text-xs font-bold tracking-wide text-accent uppercase">{p.data.category ?? 'Guía'}</p>
                  <h3 class="mt-1.5 font-display font-bold text-primary group-hover:text-accent">{p.data.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
