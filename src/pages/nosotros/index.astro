---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { getCountry, DEFAULT_COUNTRY, COUNTRIES } from '@/lib/countries';
import { SITE } from '@/lib/site';
import { breadcrumbSchema } from '@/lib/seo';
import { categoryCover } from '@/lib/categories';

const country = getCountry(DEFAULT_COUNTRY);

const title = 'Sobre Nosotros | Sably — Cursos de Oficios para Latinoamérica';
const description =
  'Sably nace para que cualquier persona en Latinoamérica aprenda un oficio real, se certifique y emprenda. Conoce nuestra historia, misión y el ecosistema Sably.';

const schemas = [
  breadcrumbSchema([
    { name: 'Inicio', url: `${SITE.url}/co/` },
    { name: 'Sobre nosotros', url: `${SITE.url}/nosotros/` },
  ]),
];
---

<BaseLayout {title} {description} {country} pathAfterCountry="/" {schemas} pageType="nosotros">
  <section class="relative overflow-hidden bg-primary py-20">
    <div class="absolute -top-24 -right-24 size-96 rounded-full bg-accent/20 blur-3xl" aria-hidden="true"></div>
    <div class="container-site relative">
      <p class="text-sm font-bold tracking-wide text-accent uppercase">Sobre nosotros</p>
      <h1 class="mt-4 max-w-3xl text-4xl leading-tight font-extrabold text-white sm:text-5xl">
        Creemos en el poder de <span class="text-accent">las manos que saben hacer</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-white/80">
        Sably existe para que cualquier persona en Latinoamérica pueda aprender un oficio real, certificarse y
        convertirlo en su fuente de ingresos — sin títulos costosos ni años de universidad.
      </p>
    </div>
  </section>

  <section class="container-site grid gap-12 py-16 lg:grid-cols-2 lg:items-center">
    <div>
      <SectionHeading eyebrow="Nuestra historia" title="De Colombia para toda Latinoamérica" />
      <div class="mt-5 space-y-4 text-[15px] leading-relaxed text-body">
        <p>
          Sably nace del equipo de <strong class="text-heading">Connexis</strong>, con más de una década construyendo
          proyectos digitales de educación en Colombia — entre ellos nuestra
          <a href="https://academiadebelleza.edu.co" target="_blank" rel="noopener" class="font-semibold text-accent underline">Academia de Belleza</a>,
          que ha formado a miles de estudiantes en el mundo de la estética.
        </p>
        <p>
          Vimos algo claro: mientras todo el mundo habla de inteligencia artificial, los oficios que se hacen con las
          manos — panadería, electricidad, costura, barbería, cocina — tienen más demanda que nunca. Y son
          exactamente las habilidades que ninguna IA puede reemplazar.
        </p>
        <p>
          Por eso construimos Sably: un lugar donde encuentras cursos prácticos, en español, con certificado, a
          precios justos y con acompañamiento real por WhatsApp.
        </p>
      </div>
    </div>
    <img
      src={categoryCover('oficios')}
      alt="Estudiante de oficios trabajando con sus manos"
      width="800"
      height="533"
      loading="lazy"
      class="rounded-lg object-cover shadow-xl"
    />
  </section>

  <section class="bg-off-white py-16">
    <div class="container-site">
      <SectionHeading align="center" eyebrow="Lo que nos mueve" title="Nuestros principios" />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            { icon: '🛠️', title: 'Oficios primero', text: 'Habilidades prácticas con demanda real, no teoría que no se usa.' },
            { icon: '🤝', title: 'Acompañamiento humano', text: 'Un WhatsApp real con personas reales, antes y después de inscribirte.' },
            { icon: '💵', title: 'Precios justos', text: 'Formación de calidad al alcance de cualquier bolsillo en LATAM.' },
            { icon: '📜', title: 'Certificación', text: 'Cada curso respalda tu conocimiento con certificado digital.' },
          ].map((v) => (
            <div class="rounded-lg border border-surface-200 bg-white p-6 text-center">
              <p class="text-3xl" aria-hidden="true">{v.icon}</p>
              <h3 class="mt-3 font-bold text-primary">{v.title}</h3>
              <p class="mt-2 text-sm text-body">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-site py-16">
    <SectionHeading align="center" eyebrow="El ecosistema Sably" title="Más que una plataforma" />
    <div class="mx-auto mt-10 grid max-w-4xl gap-6 sm:grid-cols-3">
      <div class="rounded-lg border border-surface-200 p-6">
        <h3 class="font-bold text-primary">sably.co</h3>
        <p class="mt-2 text-sm text-body">El hub de cursos de oficios para {COUNTRIES.length} países de habla hispana.</p>
      </div>
      <div class="rounded-lg border border-surface-200 p-6">
        <h3 class="font-bold text-primary">Academia de Belleza</h3>
        <p class="mt-2 text-sm text-body">
          Nuestra vertical especializada en belleza y estética:
          <a href="https://academiadebelleza.edu.co" target="_blank" rel="noopener" class="text-accent underline">academiadebelleza.edu.co</a>
        </p>
      </div>
      <div class="rounded-lg border border-surface-200 p-6">
        <h3 class="font-bold text-primary">Homologaciones</h3>
        <p class="mt-2 text-sm text-body">
          <a href="/homologaciones/" class="text-accent underline">Certifica tu experiencia</a> con instituciones de
          formación para el trabajo aliadas.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-primary py-16 text-center">
    <div class="container-site">
      <h2 class="text-3xl font-extrabold text-white">Tu oficio te está esperando</h2>
      <a
        href={`/${country.code}/cursos/`}
        class="animate-pulse-soft mt-7 inline-block rounded-md bg-accent px-8 py-4 font-bold text-white transition hover:bg-accent-hover"
      >
        Explorar los cursos
      </a>
    </div>
  </section>
</BaseLayout>
