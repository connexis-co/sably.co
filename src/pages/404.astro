---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---

<Base title={`Página no encontrada | ${SITE.name}`} description="La página que buscas no existe o fue movida.">
  <section class="mx-auto grid max-w-3xl place-items-center px-4 py-28 text-center sm:px-6">
    <p class="text-7xl font-black text-brand">404</p>
    <h1 class="mt-4 text-2xl font-extrabold text-white sm:text-3xl">
      Esta página no existe (o cambió de lugar)
    </h1>
    <p class="mt-3 max-w-md text-slate-400">
      No te preocupes: tu próxima habilidad sí está aquí. Explora el catálogo de cursos y sigue
      aprendiendo.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="rounded-xl border border-white/15 px-6 py-3 font-semibold text-white transition hover:bg-white/5">
        Ir al inicio
      </a>
      <a href="/cursos" class="rounded-xl bg-brand px-6 py-3 font-bold text-ink transition hover:bg-brand-strong">
        Ver cursos
      </a>
    </div>
  </section>
</Base>
