---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TrustBar from '@/components/TrustBar.astro';
import CourseCard from '@/components/CourseCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import PromoBanner from '@/components/PromoBanner.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { COUNTRIES, getCountry } from '@/lib/countries';
import { CATEGORIES } from '@/lib/categories';
import { countryAlternates, faqSchema } from '@/lib/seo';
import { SITE, CDN_URL } from '@/lib/site';
import { HERO_ASSETS } from '@/lib/hero-assets';

export function getStaticPaths() {
  return COUNTRIES.map((c) => ({ params: { country: c.code } }));
}

const country = getCountry(Astro.params.country!);
const base = `/${country.code}`;

const allCourses = await getCollection('courses');
const featured = [...allCourses]
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.students - a.data.students)
  .slice(0, 8);

const allTestimonials = await getCollection('testimonials');
const localTestimonials = allTestimonials.filter((t) => t.data.countryCode === country.code);
const testimonials = (localTestimonials.length >= 3 ? localTestimonials : allTestimonials).slice(0, 6);

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const faqs = [
  {
    q: `¿Los cursos de Sably están disponibles en ${country.name}?`,
    a: `Sí. Todos nuestros cursos son 100% online y puedes tomarlos desde cualquier ciudad de ${country.name}, a tu ritmo y con acceso de por vida. Los precios se muestran en ${country.currency}.`,
  },
  {
    q: '¿Recibo un certificado al terminar?',
    a: 'Sí, todos los cursos incluyen certificado digital de finalización que puedes compartir en tu hoja de vida y redes profesionales.',
  },
  {
    q: '¿Cómo se realiza el pago?',
    a: `El pago se procesa de forma segura a través de Hotmart, la plataforma líder de cursos online en Latinoamérica. Aceptamos tarjetas y métodos de pago locales de ${country.name}.`,
  },
  {
    q: '¿Qué pasa si el curso no me gusta?',
    a: 'Tienes 7 días de garantía: si el curso no cumple tus expectativas, te devolvemos el 100% de tu dinero.',
  },
  {
    q: '¿Necesito experiencia previa?',
    a: 'No. La mayoría de nuestros cursos parten desde cero y te llevan paso a paso hasta un nivel profesional.',
  },
];

const title = `Cursos Online de Oficios y Habilidades Prácticas en ${country.name} | Sably`;
const description = `Aprende panadería, costura, electricidad, gastronomía y más oficios rentables desde ${country.name}. Cursos online con certificado, acceso de por vida y ${SITE.couponDiscountPct}% OFF.`;
---

<BaseLayout
  {title}
  {description}
  {country}
  pathAfterCountry="/"
  alternates={countryAlternates('/')}
  schemas={[faqSchema(faqs)]}
  pageType="home"
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-primary">
    <div class="absolute -top-24 -right-24 size-96 rounded-full bg-accent/20 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-32 -left-16 size-80 rounded-full bg-info/10 blur-3xl" aria-hidden="true"></div>
    <div class="container-site relative grid items-center gap-6 py-12 sm:py-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,520px)] lg:gap-10 lg:py-24">
      <div class="max-w-2xl">
        <p class="animate-fade-up text-sm font-bold tracking-wide text-accent uppercase">
          {country.flag} Cursos online para {country.name}
        </p>
        <h1 class="animate-fade-up mt-4 text-4xl leading-tight font-extrabold text-white sm:text-5xl">
          Aprende un oficio real.<br />
          <span class="text-accent">Emprende tu futuro.</span>
        </h1>
        <p class="animate-fade-up mt-5 max-w-xl text-lg text-white/80" style="animation-delay: 0.1s">
          Habilidades prácticas que la inteligencia artificial no puede reemplazar: panadería, costura, electricidad,
          barbería y más. Con certificado y acceso de por vida.
        </p>
        <div class="animate-fade-up mt-8 flex flex-wrap gap-3" style="animation-delay: 0.2s">
          <a
            href={`${base}/cursos/`}
            class="animate-pulse-soft rounded-md bg-accent px-6 py-3.5 font-bold text-white transition hover:bg-accent-hover"
          >
            Explorar cursos con {SITE.couponDiscountPct}% OFF
          </a>
          <a
            href="#categorias"
            class="rounded-md border border-white/30 px-6 py-3.5 font-semibold text-white transition hover:bg-white/10"
          >
            Ver categorías
          </a>
        </div>
        <p class="mt-6 text-sm text-white/60">
          ⭐ {SITE.stats.rating}/5 · {SITE.stats.students} estudiantes en {SITE.stats.countries} países
        </p>
      </div>

      <!-- Collage de oficios: WebP con alfa real (chroma-key), distinto por país.
           En móvil va debajo del texto y algo más ancho que el contenedor para
           que se sienta inmersivo sin empujar el CTA fuera del pliegue. -->
      <div class="relative -mx-4 mt-2 sm:mx-0 lg:mt-0">
        <div class="absolute inset-x-4 inset-y-0 -z-10 rounded-full bg-accent/15 blur-3xl" aria-hidden="true"></div>
        <img
          src={`${CDN_URL}/heroes/${HERO_ASSETS[country.code]}`}
          alt={`Profesionales de distintos oficios que estudian en Sably desde ${country.name}`}
          width="900"
          height="491"
          fetchpriority="high"
          decoding="async"
          class="animate-fade-up mx-auto w-full max-w-md drop-shadow-2xl sm:max-w-lg lg:max-w-none"
        />
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- Categorías chips -->
  <section id="categorias" class="container-site py-14">
    <SectionHeading
      eyebrow="Explora por categoría"
      title="¿Qué quieres aprender hoy?"
      subtitle="Oficios y habilidades con demanda real en el mercado."
    />
    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      {
        CATEGORIES.map((cat) => (
          <a
            href={cat.externalUrl ?? `${base}/cursos/${cat.slug}/`}
            class="group flex flex-col items-center gap-2 rounded-lg border border-surface-200 p-5 text-center transition hover:-translate-y-0.5 hover:border-accent hover:shadow-lg"
            {...(cat.externalUrl ? { target: '_blank', rel: 'noopener' } : {})}
          >
            <span class="text-3xl transition-transform group-hover:scale-110" aria-hidden="true">
              {cat.emoji}
            </span>
            <span class="text-sm font-bold text-heading group-hover:text-accent">{cat.name}</span>
            {cat.externalUrl && <span class="rounded-full bg-accent-soft px-2 py-0.5 text-[10px] font-bold text-accent">Academia especializada</span>}
          </a>
        ))
      }
    </div>
  </section>

  <!-- Cursos destacados -->
  {
    featured.length > 0 && (
      <section class="bg-off-white py-14">
        <div class="container-site">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <SectionHeading
              eyebrow="Los favoritos de la comunidad"
              title="Cursos destacados"
              subtitle={`Precios en ${country.currency} para ${country.name}.`}
            />
            <a href={`${base}/cursos/`} class="font-semibold text-accent hover:text-accent-hover">
              Ver todos →
            </a>
          </div>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {featured.map((course) => (
              <CourseCard {course} {country} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ¿Por qué Sably? -->
  <section class="container-site py-14">
    <SectionHeading align="center" eyebrow="¿Por qué Sably?" title="Aprender un oficio nunca fue tan fácil" />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          { icon: '📜', title: 'Certificado incluido', text: 'Certifica tus habilidades y mejora tu hoja de vida al terminar cada curso.' },
          { icon: '⏰', title: 'A tu ritmo', text: 'Acceso de por vida, 24/7, desde el celular o computador. Sin horarios.' },
          { icon: '💬', title: 'Acompañamiento', text: 'Resuelve tus dudas por WhatsApp con nuestro equipo en tu país.' },
          { icon: '🛡️', title: 'Garantía de 7 días', text: 'Si el curso no es para ti, te devolvemos el 100% de tu dinero.' },
        ].map((item) => (
          <div class="rounded-lg border border-surface-200 p-6 text-center">
            <p class="text-3xl" aria-hidden="true">{item.icon}</p>
            <h3 class="mt-3 font-bold text-primary">{item.title}</h3>
            <p class="mt-2 text-sm text-body">{item.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Testimonios -->
  {
    testimonials.length > 0 && (
      <section class="bg-off-white py-14">
        <div class="container-site">
          <SectionHeading
            align="center"
            eyebrow="Historias reales"
            title={`Estudiantes que ya emprendieron en ${country.name} y LATAM`}
          />
          <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {testimonials.map((t) => (
              <TestimonialCard
                name={t.data.name}
                citySlug={t.data.citySlug}
                countryCode={t.data.countryCode}
                text={t.data.text}
                rating={t.data.rating}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <PromoBanner {country} />

  <!-- Ciudades -->
  <section class="container-site py-14">
    <SectionHeading
      eyebrow="Cerca de ti"
      title={`Cursos online en las principales ciudades de ${country.name}`}
      subtitle="Comunidad local, testimonios de tu región y precios en tu moneda."
    />
    <div class="mt-8 flex flex-wrap gap-3">
      {
        country.cities.map((city) => (
          <a
            href={`${base}/${city.slug}/`}
            class="rounded-full border border-surface-200 px-5 py-2.5 text-sm font-semibold text-heading transition hover:border-accent hover:bg-accent-soft hover:text-accent"
          >
            📍 {city.name}
          </a>
        ))
      }
    </div>
  </section>

  <!-- Blog -->
  {
    posts.length > 0 && (
      <section class="bg-off-white py-14">
        <div class="container-site">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <SectionHeading eyebrow="Guías y recursos" title="Aprende gratis en nuestro blog" />
            <a href="/blog/" class="font-semibold text-accent hover:text-accent-hover">
              Ver blog →
            </a>
          </div>
          <div class="mt-8 grid gap-5 md:grid-cols-3">
            {posts.map((post) => (
              <a
                href={`/blog/${post.id}/`}
                class="group rounded-lg border border-surface-200 bg-white p-6 transition hover:-translate-y-0.5 hover:shadow-lg"
              >
                <p class="text-xs font-bold tracking-wide text-accent uppercase">{post.data.category ?? 'Guía'}</p>
                <h3 class="mt-2 font-display text-lg font-bold text-primary group-hover:text-accent">
                  {post.data.title}
                </h3>
                <p class="mt-2 line-clamp-3 text-sm text-body">{post.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <section class="container-site py-14">
    <SectionHeading align="center" eyebrow="Preguntas frecuentes" title="Resolvemos tus dudas" />
    <div class="mx-auto mt-8 max-w-3xl">
      <FaqAccordion {faqs} />
    </div>
  </section>
</BaseLayout>
