---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CourseCard from '@/components/CourseCard.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { COUNTRIES, getCountry } from '@/lib/countries';
import { INTERNAL_CATEGORIES, getCategory } from '@/lib/categories';
import { countryAlternates, breadcrumbSchema, faqSchema } from '@/lib/seo';
import { SITE } from '@/lib/site';

export function getStaticPaths() {
  return COUNTRIES.flatMap((c) =>
    INTERNAL_CATEGORIES.map((cat) => ({ params: { country: c.code, category: cat.slug } })),
  );
}

const country = getCountry(Astro.params.country!);
const category = getCategory(Astro.params.category!);
const base = `/${country.code}`;

const courses = (await getCollection('courses')).filter((c) => c.data.category === category.slug);
const bySubcategory = category.subcategories
  .map((sub) => ({
    sub,
    courses: courses.filter((c) => c.data.subcategory === sub.slug),
  }))
  .filter((g) => g.courses.length > 0);
const uncategorized = courses.filter(
  (c) => !category.subcategories.some((s) => s.slug === c.data.subcategory),
);

const faqs = [
  {
    q: `¿Puedo aprender ${category.name.toLowerCase()} online desde ${country.name}?`,
    a: `Sí. Los cursos de ${category.name.toLowerCase()} de Sably son 100% online, con clases en video paso a paso que puedes ver a tu ritmo desde cualquier ciudad de ${country.name}.`,
  },
  {
    q: '¿Los cursos incluyen certificado?',
    a: 'Sí, al completar cada curso recibes un certificado digital de finalización.',
  },
  {
    q: '¿Cuánto cuestan los cursos?',
    a: `Los precios se muestran en ${country.currency} e incluyen el ${SITE.couponDiscountPct}% de descuento con el cupón ${SITE.defaultCoupon} aplicado automáticamente desde Sably.`,
  },
  {
    q: '¿Por cuánto tiempo tengo acceso?',
    a: 'El acceso es de por vida: pagas una sola vez y puedes repasar las clases cuando quieras.',
  },
];

const title = `Cursos de ${category.name} Online en ${country.name} | Certificado Incluido | Sably`;
const description = `${category.description} Cursos online con certificado para ${country.name}: acceso de por vida, garantía de 7 días y ${SITE.couponDiscountPct}% OFF.`;

const schemas = [
  breadcrumbSchema([
    { name: 'Inicio', url: `${SITE.url}${base}/` },
    { name: 'Cursos', url: `${SITE.url}${base}/cursos/` },
    { name: category.name, url: `${SITE.url}${base}/cursos/${category.slug}/` },
  ]),
  faqSchema(faqs),
];
---

<BaseLayout
  {title}
  {description}
  {country}
  pathAfterCountry={`/cursos/${category.slug}/`}
  alternates={countryAlternates(`/cursos/${category.slug}/`)}
  {schemas}
  pageType="category"
  whatsappContext={`Cursos de ${category.name}`}
>
  <section
    class="py-16"
    style={`background-image: linear-gradient(135deg, ${category.gradient[0]}, ${category.gradient[1]})`}
  >
    <div class="container-site">
      <nav aria-label="Breadcrumb" class="text-sm text-white/70">
        <a href={`${base}/`} class="hover:text-white">Inicio</a> <span aria-hidden="true">›</span>
        <a href={`${base}/cursos/`} class="hover:text-white">Cursos</a> <span aria-hidden="true">›</span>
        <span class="text-white">{category.name}</span>
      </nav>
      <h1 class="mt-4 text-3xl font-extrabold text-white sm:text-4xl">
        <span aria-hidden="true">{category.emoji}</span> Cursos de {category.name} online en {country.name}
      </h1>
      <p class="mt-3 max-w-2xl text-lg text-white/85">{category.description}</p>
      <p class="mt-4 inline-block rounded-full bg-white/15 px-4 py-1.5 text-sm font-semibold text-white">
        {courses.length} {courses.length === 1 ? 'curso disponible' : 'cursos disponibles'} · Certificado incluido
      </p>
    </div>
  </section>

  {
    courses.length === 0 && (
      <section class="container-site py-16 text-center">
        <p class="text-lg text-body">Estamos preparando los cursos de esta categoría. ¡Muy pronto!</p>
      </section>
    )
  }

  {
    bySubcategory.map(({ sub, courses: subCourses }) => (
      <section class="container-site scroll-mt-24 py-10" id={sub.slug}>
        <h2 class="text-2xl font-bold">{sub.name}</h2>
        <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {subCourses.map((course) => (
            <CourseCard {course} {country} />
          ))}
        </div>
      </section>
    ))
  }

  {
    uncategorized.length > 0 && (
      <section class="container-site py-10">
        <h2 class="text-2xl font-bold">Más cursos de {category.name}</h2>
        <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {uncategorized.map((course) => (
            <CourseCard {course} {country} />
          ))}
        </div>
      </section>
    )
  }

  <section class="bg-off-white py-14">
    <div class="container-site">
      <h2 class="text-center text-2xl font-bold">Preguntas frecuentes sobre {category.name.toLowerCase()}</h2>
      <div class="mx-auto mt-8 max-w-3xl">
        <FaqAccordion {faqs} />
      </div>
    </div>
  </section>
</BaseLayout>
