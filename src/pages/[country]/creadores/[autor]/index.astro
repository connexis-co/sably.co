---
/**
 * Perfil público del creador (el productor real publicado en Hotmart) con
 * todos sus cursos del catálogo. Navegable desde la tarjeta «Creado por» de
 * cada ficha de curso.
 *
 * Todo lo que se afirma aquí sale de datos capturados de Hotmart: nombre,
 * biografía, antigüedad, badges y la valoración media real de sus cursos.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CourseCard from '@/components/CourseCard.astro';
import { COUNTRIES, type Country } from '@/lib/countries';
import { creadores, valoracionReal, type Autor } from '@/lib/hotmartLive';
import { countryAlternates, breadcrumbSchema, itemListSchema } from '@/lib/seo';
import { SITE } from '@/lib/site';

export async function getStaticPaths() {
  const cursos = await getCollection('courses');
  return COUNTRIES.flatMap((country) =>
    creadores().map((autor) => ({
      params: { country: country.code, autor: autor.slug },
      props: {
        country,
        autor,
        cursos: cursos.filter((c) => autor.cursos.includes(c.id)),
      },
    })),
  );
}

interface Props {
  country: Country;
  autor: Autor & { slug: string; cursos: string[] };
  cursos: Awaited<ReturnType<typeof getCollection<'courses'>>>;
}
const { country, autor, cursos } = Astro.props;
const base = `/${country.code}`;

/* Media real de las valoraciones de SUS cursos, no una cifra de catálogo. */
const valoraciones = cursos
  .map((c) => valoracionReal(c.id))
  .filter((v): v is NonNullable<typeof v> => v !== null);
const media = valoraciones.length
  ? Math.round((valoraciones.reduce((s, v) => s + v.rating, 0) / valoraciones.length) * 10) / 10
  : null;
const totalValoraciones = valoraciones.reduce((s, v) => s + v.total, 0);

const title = `Cursos de ${autor.nombre} | Sably ${country.name}`;
const description = `${autor.nombre}: ${cursos.length} cursos online con certificado en ${country.name}. ${autor.bio}`.slice(0, 158);

const schemas = [
  breadcrumbSchema([
    { name: 'Inicio', url: `${SITE.url}${base}/` },
    { name: 'Creadores', url: `${SITE.url}${base}/` },
    { name: autor.nombre, url: `${SITE.url}${base}/creadores/${autor.slug}/` },
  ]),
  // ProfilePage + Person: datos REALES capturados de Hotmart (nombre, bio, foto).
  // Da atribución de autor a los LLMs y refuerza E-E-A-T. Sin aggregateRating en
  // la Person (Google no lo usa ahí); las notas reales viven en cada Course.
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    dateModified: new Date().toISOString(),
    mainEntity: {
      '@type': 'Person',
      name: autor.nombre,
      ...(autor.bio ? { description: autor.bio } : {}),
      ...(autor.foto ? { image: autor.foto } : {}),
      url: `${SITE.url}${base}/creadores/${autor.slug}/`,
    },
  },
  // Sus cursos como ItemList: asocia al creador con su catálogo real.
  itemListSchema(cursos.map((c) => ({ name: c.data.title, url: `${SITE.url}${base}/${c.id}/` }))),
];
---

<BaseLayout
  {title}
  {description}
  {country}
  pathAfterCountry={`/creadores/${autor.slug}/`}
  alternates={countryAlternates(`/creadores/${autor.slug}/`)}
  {schemas}
  pageType="creador"
  whatsappContext={`los cursos de ${autor.nombre}`}
>
  <section class="bg-primary text-white">
    <div class="container-site py-12 sm:py-16">
      <nav class="text-sm text-white/60" aria-label="Miga de pan">
        <a href={`${base}/`} class="hover:text-white">Inicio</a>
        <span aria-hidden="true"> › </span>
        <span class="text-white">{autor.nombre}</span>
      </nav>
      <div class="mt-6 flex flex-col items-start gap-6 sm:flex-row sm:items-center">
        {
          autor.foto ? (
            <img
              src={autor.foto}
              alt={autor.nombre}
              width="96"
              height="96"
              class="size-24 rounded-full border-2 border-white/20 object-cover"
            />
          ) : (
            <span
              class="flex size-24 items-center justify-center rounded-full bg-white/10 font-display text-4xl font-bold"
              aria-hidden="true"
            >
              {autor.nombre.charAt(0)}
            </span>
          )
        }
        <div>
          <h1 class="font-display text-3xl font-extrabold sm:text-4xl">{autor.nombre}</h1>
          <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm text-white/80">
            {autor.verificado && <span>✔ Perfil verificado en Hotmart</span>}
            {autor.bestSeller && <span>🏆 Best seller</span>}
            {autor.desde && <span>Desde {autor.desde}</span>}
          </p>
          <p class="mt-3 max-w-2xl text-white/85">{autor.bio}</p>
          <p class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm text-white/80">
            <span>
              <strong class="text-white">{cursos.length}</strong> cursos en el catálogo
            </span>
            {
              media && (
                <span>
                  <span class="text-warning">★</span>
                  <strong class="text-white"> {media.toFixed(1).replace('.', ',')}</strong> de media en{' '}
                  {totalValoraciones.toLocaleString('es-CO')} valoraciones reales
                </span>
              )
            }
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-site py-12">
    <h2 class="text-2xl font-bold text-heading">Todos sus cursos</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {cursos.map((c) => <CourseCard course={c} {country} />)}
    </div>
  </section>
</BaseLayout>
