---
import { load } from '@/lib/page-loaders/city-redirect';
import { loadCustomPage } from '@/lib/page-loaders/custom-page';
import { PageTemplate } from '@/themes';
export const prerender = false;
const customPage = await loadCustomPage(Astro);
const model = customPage ? null : await load(Astro, 'catalog');
if (model) { if(model.status===404)model.headers.set('X-Robots-Tag','noindex, nofollow'); return model; }
---
{customPage && <PageTemplate {...customPage} />}
