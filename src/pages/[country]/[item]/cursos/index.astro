---
/**
 * Catálogo de una ciudad: `/co/bogota/cursos/`.
 *
 * Faltaba y el sitemap ya la listaba, así que las 36 ciudades tenían una URL
 * enviada a Google que devolvía 404 mientras sus hijas por categoría sí
 * existían. Cierra la jerarquía ciudad → cursos → categoría → curso.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CourseCard from '@/components/CourseCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { COUNTRIES, getCountry, getCity } from '@/lib/countries';
import { INTERNAL_CATEGORIES } from '@/lib/categories';
import { breadcrumbSchema, itemListSchema } from '@/lib/seo';
import { SITE } from '@/lib/site';

export function getStaticPaths() {
  return COUNTRIES.flatMap((c) =>
    c.cities.map((city) => ({ params: { country: c.code, item: city.slug } })),
  );
}

const country = getCountry(Astro.params.country!);
const city = getCity(country, Astro.params.item!);
const base = `/${country.code}`;
const raiz = `${base}/${city.slug}`;

const courses = await getCollection('courses');
const byCategory = INTERNAL_CATEGORIES.map((cat) => ({
  cat,
  courses: courses.filter((c) => c.data.category === cat.slug),
})).filter((g) => g.courses.length > 0);

const title = `Cursos Online en ${city.name} | ${courses.length}+ con Certificado | Sably`;
const description = `Catálogo completo de cursos online para estudiar desde ${city.name}: oficios, belleza, gastronomía y más. Certificado incluido y ${SITE.couponDiscountPct}% OFF.`;

const schemas = [
  breadcrumbSchema([
    { name: 'Inicio', url: `${SITE.url}${base}/` },
    { name: city.name, url: `${SITE.url}${raiz}/` },
    { name: 'Cursos', url: `${SITE.url}${raiz}/cursos/` },
  ]),
  // ItemList ayuda a que Google entienda la página como un listado y pueda
  // mostrar enlaces de sitio a las categorías.
  itemListSchema(
    byCategory.map((g) => ({
      name: g.cat.name,
      url: `${SITE.url}${raiz}/cursos/${g.cat.slug}/`,
    })),
  ),
];
---

<BaseLayout {title} {description} {country} pathAfterCountry={`/${city.slug}/cursos/`} {schemas} pageType="catalog">
  <section class="bg-primary py-14">
    <div class="container-site">
      <nav aria-label="Breadcrumb" class="text-sm text-white/60">
        <a href={`${base}/`} class="hover:text-white">Inicio</a> <span aria-hidden="true">›</span>
        <a href={`${raiz}/`} class="hover:text-white">{city.name}</a> <span aria-hidden="true">›</span>
        <span class="text-white">Cursos</span>
      </nav>
      <h1 class="mt-4 text-3xl font-extrabold text-white sm:text-4xl">
        Todos los cursos online desde {city.name}
      </h1>
      <p class="mt-3 max-w-2xl text-white/80">
        Estudia a tu ritmo desde {city.name}, con precios en {country.currency}, certificado
        incluido y acceso de por vida.
      </p>
    </div>
  </section>

  {
    byCategory.map(({ cat, courses: catCourses }) => (
      <section class="container-site py-10" id={cat.slug}>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <SectionHeading eyebrow={cat.emoji} title={cat.name} subtitle={cat.description} />
          <a href={`${raiz}/cursos/${cat.slug}/`} class="font-semibold text-accent hover:text-accent-hover">
            Ver categoría →
          </a>
        </div>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {catCourses.slice(0, 4).map((course) => (
            <CourseCard {course} {country} citySlug={city.slug} />
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>
