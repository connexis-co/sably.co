---
import '@/styles/global.css';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PromoBanner from '@/components/PromoBanner.astro';
import PruebaSocial from '@/components/PruebaSocial.astro';
import GeoDialog from '@/components/GeoDialog.astro';
import SearchModal from '@/components/SearchModal.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import type { Country, City } from '@/lib/countries';
import type { HreflangAlternate } from '@/lib/seo';
import { organizationSchema } from '@/lib/seo';
import { GTM_ID, GA4_ID } from '@/lib/site';

interface Props {
  title: string;
  description: string;
  country: Country;
  city?: City;
  /** Ruta después del código de país, para hreflang/switcher. */
  pathAfterCountry?: string;
  alternates?: HreflangAlternate[];
  schemas?: object[];
  pageType?: string;
  /**
   * Marca la página como «sin cupón»: su creador no acepta el descuento del
   * sitio. Va en el <body> y no en cada enlace porque los CTA salen de cuatro
   * componentes distintos —ficha, barra fija, popup de salida, banner— y
   * olvidarse de uno significa prometer un descuento que el checkout no aplica.
   */
  sinCupon?: boolean;
  whatsappContext?: string;
  noindex?: boolean;
  /** Imagen social de la página (og:image). */
  image?: string;
}

const {
  title,
  description,
  country,
  city,
  pathAfterCountry = '/',
  alternates = [],
  schemas = [],
  pageType = 'page',
  sinCupon = false,
  whatsappContext,
  noindex = false,
  image,
} = Astro.props;

const allSchemas = [organizationSchema(), ...schemas];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1B1B3A" />
    <meta name="generator" content={Astro.generator} />
    <Seo {title} {description} {alternates} schemas={allSchemas} {noindex} {image} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      GTM_ID && (
        <script
          is:inline
          set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${GTM_ID}');`}
        />
      )
    }
    {GA4_ID && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`} />}
    {
      GA4_ID && (
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag('js',new Date());gtag('config','${GA4_ID}');`}
        />
      )
    }
    {/* El píxel de Meta lo inyecta GTM (GTM-56LHZGMK → "Meta Pixel 1414716853721578 - Base"),
        igual que en academiadebelleza.edu.co y cursodeglobosonline.com: un solo dataset para
        toda la red Sably. Aquí se disparaba PUBLIC_META_PIXEL_ID (1711030209407213), un píxel
        distinto al que optimizan las campañas, así que Meta no veía estas conversiones. */}
  </head>
  <body data-page-type={pageType} data-sin-cupon={sinCupon ? '' : undefined}>
    {
      GTM_ID && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-100 focus:bg-white focus:px-4 focus:py-2 focus:text-primary"
    >
      Saltar al contenido
    </a>
    <PromoBanner variante="barra" />
    <Header {country} {city} {pathAfterCountry} />
    <main id="main">
      <slot />
    </main>
    <Footer {country} />
    <PruebaSocial />
    <GeoDialog {pathAfterCountry} />
    <SearchModal {country} />
    <WhatsAppFloat {country} context={whatsappContext} />
  </body>
</html>
