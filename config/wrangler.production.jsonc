{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sably-emdash-production",
  "main": "../src/worker.ts",
  "account_id": "6e36c2fb07c21f30ed3c0d6e824884bc",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/brand/*",
      "!/covers/*",
      "!/creadores/*",
      "!/heroes/*",
      "!/certificado-sably.jpg",
      "!/favicon.ico",
      "!/favicon.svg",
      "!/icon-192.png",
      "!/icon-512.png",
      "!/apple-touch-icon.png",
      "!/site.webmanifest"
    ]
  },
  "placement": {
    "mode": "smart"
  },
  "routes": [
    {
      "pattern": "sably.co",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sably-emdash-production",
      "database_id": "ce18b2f0-d003-4554-abb4-ac80b2f638fd",
      "migrations_dir": "../migrations-emdash"
    },
    {
      "binding": "SABLY_DB",
      "database_name": "sably-operations-production",
      "database_id": "7acb4da2-9c9a-4c03-bec7-90276ab121c0",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "sably-emdash-production-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "6194a8de1f574c4c92ebb93a2c704ad4"
    },
    {
      "binding": "CACHE",
      "id": "178d69f975fd4522a63f79f6e98ba836"
    }
  ],
  "vars": {
    "SABLY_ENVIRONMENT": "production",
    "EMDASH_SITE_URL": "https://sably.co",
    "SABLY_CMS_READY": "true",
    "SABLY_PRODUCTION_ACTIVATED": "true"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
